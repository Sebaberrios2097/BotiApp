                </div>

                <div class="form-group full pack-section" id="crearPackFields" style="display:none">
                    <label class="form-label">Unidad base del pack <span class="req">*</span></label>
                    <div class="pack-unidad-row">
                        <input type="hidden" id="crearIdProductoUnidad" name="IdProductoUnidad" value="0" />
                        <div class="pack-unidad-display" id="crearPackUnidadDisplay" role="button" tabindex="0"
                             onclick="abrirSelectorUnidadCrear()" onkeydown="if(event.key==='Enter'||event.key===' ')abrirSelectorUnidadCrear()">
                            <span class="pack-unidad-empty">Click aquí para seleccionar el producto unidad…</span>
                        </div>
                        <div class="pack-cantidad-wrap">
                            <label class="pack-cantidad-label">Cant. unidades <span class="req">*</span></label>
                            <input type="number" id="crearCantidadUnidades" name="CantidadUnidades" min="2" step="1" value="6" class="form-control" oninput="actualizarPackPreviewCrear()" title="Típico: 6 (SixPack). Mínimo 2." />
                        </div>
                    </div>
                </div>

                <div class="form-group full">
                    <label class="form-label" asp-for="Descripción">Descripción</label>
                    <textarea asp-for="Descripción" class="form-control" rows="2" placeholder="Descripción breve…"></textarea>
                </div>

                <div class="form-group full">
                    <label class="form-label">Imagen</label>
                    <div class="img-drop" onclick="abrirSelectorImagenCrear()">
                        <svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                        <p id="imgDropHintCrear">Clic para seleccionar imagen (JPG, PNG)</p>
                    </div>
                    <input type="file" id="imgFileCrear" name="imagenFile" accept="image/*"
                           style="display:none" onchange="prevImg(this,'imgPreviewCrear')" />
