<!-- Footer -->
<div class="mc-footer">
    <button type="button" class="btn-save" onclick="submitFormAjax('formCrear', true, this)">
        <svg viewBox="0 0 24 24"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
        Guardar producto
    </button>
    <button type="button" class="btn-cancel" onclick="cerrarModal()">Cancelar</button>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
/* ── Lógica de Selectores Buscables ── */
function syncSearchableSelect(wrapperId) {
    const wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;
    const select = wrapper.querySelector('.actual-select');
    const triggerText = wrapper.querySelector('.trigger-text');
    const optionsList = wrapper.querySelector('.panel-options-list');
    
    optionsList.innerHTML = '';
    
    const selectedVal = select.value;
    let selectedText = '— Selecciona —';
    
    Array.from(select.options).forEach(opt => {
        if (opt.value === "") {
            if (selectedVal === "") selectedText = opt.text;
            return;
        }
        
        const isSelected = opt.value === selectedVal;
        if (isSelected) {
            selectedText = opt.text;
        }
        
        const li = document.createElement('li');
        li.className = 'panel-option-item' + (isSelected ? ' selected' : '');
        li.dataset.value = opt.value;
        li.textContent = opt.text;
        
        li.addEventListener('click', (e) => {
            e.stopPropagation();
            select.value = opt.value;
            select.dispatchEvent(new Event('change', { bubbles: true }));
            triggerText.textContent = opt.text;
            closeDropdown(wrapperId);
            syncSearchableSelect(wrapperId);
        });
        
        optionsList.appendChild(li);
    });
    
    triggerText.textContent = selectedText;
}

function initSearchableSelect(wrapperId) {
    const wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;
    
    syncSearchableSelect(wrapperId);
    
    const searchInput = wrapper.querySelector('.panel-search-input');
    searchInput.addEventListener('click', (e) => e.stopPropagation());
}

function toggleDropdown(wrapperId) {
    const wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;
    
    const isOpen = wrapper.classList.contains('open');
    
    document.querySelectorAll('.searchable-select-wrapper').forEach(w => {
        w.classList.remove('open');
    });
    
    if (!isOpen) {
        wrapper.classList.add('open');
        const searchInput = wrapper.querySelector('.panel-search-input');
        if (searchInput) {
            searchInput.value = '';
            filtrarOpciones(wrapperId);
            setTimeout(() => searchInput.focus(), 50);
        }
    }
}

function closeDropdown(wrapperId) {
    const wrapper = document.getElementById(wrapperId);
    if (wrapper) {
        wrapper.classList.remove('open');
    }
}

function filtrarOpciones(wrapperId) {
    const wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;
    const searchInput = wrapper.querySelector('.panel-search-input');
    const filter = searchInput.value.toLowerCase().trim();
    const items = wrapper.querySelectorAll('.panel-option-item');
    const optionsList = wrapper.querySelector('.panel-options-list');
    
    const existingNoRes = optionsList.querySelector('.no-results');
    if (existingNoRes) existingNoRes.remove();
    
    let visibleCount = 0;
    items.forEach(item => {
        const text = item.textContent.toLowerCase();
        if (text.includes(filter)) {
            item.style.display = '';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });
    
    if (visibleCount === 0) {
        const noRes = document.createElement('li');
        noRes.className = 'panel-option-item no-results';
        noRes.textContent = 'Sin resultados';
        optionsList.appendChild(noRes);
    }
}

function handleSearchKey(event, wrapperId) {
    if (event.key === 'Enter') {
        event.preventDefault();
        const wrapper = document.getElementById(wrapperId);
        if (!wrapper) return;
        const visibleOption = wrapper.querySelector('.panel-option-item:not([style*="display: none"]):not(.no-results)');
        if (visibleOption) {
            visibleOption.click();
        }
    }
}

async function abrirCrearOption(tipo, wrapperId) {
    closeDropdown(wrapperId);

    const title = tipo === 'Tipo' ? 'Nuevo Tipo de Producto' : 'Nueva Marca';
    const inputPlaceholder = tipo === 'Tipo' ? 'Ej: Lácteos' : 'Ej: Coca-Cola';
    const apiURL = tipo === 'Tipo' ? '/Productos/Productos/CrearTipoProductoAjax' : '/Productos/Productos/CrearMarcaAjax';

    const { value: nombre } = await Swal.fire({
        title: title,
        input: 'text',
        inputLabel: 'Nombre del nuevo registro',
        inputPlaceholder: inputPlaceholder,
        showCancelButton: true,
        cancelButtonText: 'Cancelar',
        confirmButtonText: 'Guardar',
        confirmButtonColor: 'var(--color-primario)',
        inputValidator: (value) => {
            if (!value || !value.trim()) {
                return 'El nombre es obligatorio';
            }
            if (value.trim().length > 100) {
                return 'El nombre no puede superar los 100 caracteres';
            }
        }
    });

    if (nombre) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const formData = new FormData();
        formData.append('nombre', nombre);
        formData.append('__RequestVerificationToken', token);

        try {
            const resp = await fetch(apiURL, {
                method: 'POST',
                body: formData
            });
            const data = await resp.json();
            if (data.ok) {
                const wrapper = document.getElementById(wrapperId);
                const select = wrapper.querySelector('.actual-select');
                
                const opt = document.createElement('option');
                opt.value = data.id;
                opt.textContent = data.nombre;
                select.appendChild(opt);
                
                select.value = data.id;
                select.dispatchEvent(new Event('change', { bubbles: true }));
                syncSearchableSelect(wrapperId);
                
                Swal.fire({
                    icon: 'success',
                    title: '¡Creado!',
                    text: `${tipo === 'Tipo' ? 'Tipo' : 'Marca'} «${data.nombre}» creado con éxito.`,
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.mensaje || 'No se pudo crear el registro.'
                });
            }
        } catch (err) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error de red al intentar crear el registro.'
            });
        }
    }
}

// Cerrar dropdown al hacer click afuera
document.addEventListener('click', (e) => {
    if (!e.target.closest('.searchable-select-wrapper')) {
        document.querySelectorAll('.searchable-select-wrapper').forEach(w => {
            w.classList.remove('open');
        });
    }
});

// Inicializar buscadores al cargar el modal
setTimeout(() => {
    initSearchableSelect('wrapperTipoProducto');
    initSearchableSelect('wrapperMarca');
}, 50);

function esDispositivoMovilCrear() {
    const uaDataMobile = navigator.userAgentData && navigator.userAgentData.mobile;
    const ua = navigator.userAgent || '';
    const esMobilePorUA = /Android|iPhone|iPad|iPod|IEMobile|Windows Phone|Mobile/i.test(ua);
    const esPantallaTactilCompacta = navigator.maxTouchPoints > 0 && window.matchMedia('(max-width: 1024px)').matches;
    return !!(uaDataMobile || esMobilePorUA || esPantallaTactilCompacta);
}

function abrirSelectorImagenCrear() {
    const input = document.getElementById('imgFileCrear');
    if (!input) return;
    if (esDispositivoMovilCrear()) {
        input.setAttribute('capture', 'environment');
    } else {
        input.removeAttribute('capture');
    }
    input.click();
}

function prevImg(input, previewId) {
    const preview = document.getElementById(previewId);
    if (input.files?.[0]) {
        const file = input.files[0];
        if (!file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };
            reader.readAsDataURL(file);
            return;
        }

        const reader = new FileReader();
        reader.onload = e => {
            const img = new Image();
            img.onload = () => {
                const maxWidth = 500;
                const maxHeight = 500;
                let width = img.width;
                let height = img.height;
                if (width > height) {
                    if (width > maxWidth) {
                        height = Math.round((height * maxWidth) / width);
                        width = maxWidth;
                    }
                } else {
                    if (height > maxHeight) {
                        width = Math.round((width * maxHeight) / height);
                        height = maxHeight;
                    }
                }

                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);

                canvas.toBlob(blob => {
                    if (!blob) return;
                    const compressedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                        type: 'image/jpeg',
                        lastModified: Date.now()
                    });

                    try {
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(compressedFile);
                        input.files = dataTransfer.files;
                    } catch (err) {
                        console.error('Error re-injecting file:', err);
                    }

                    preview.src = URL.createObjectURL(blob);
                    preview.style.display = 'block';
                }, 'image/jpeg', 0.75);
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }
}

(function initImagenMovilCrear() {
    const input = document.getElementById('imgFileCrear');
    const hint = document.getElementById('imgDropHintCrear');
    if (!input) return;
    if (esDispositivoMovilCrear()) {
        input.setAttribute('capture', 'environment');
        if (hint) hint.textContent = 'Toca para tomar una foto (JPG, PNG)';
    }
})();

/* ── Pack: lógica del toggle, bloqueo de Stock y selección de unidad ── */
function togglePackCrear() {
    const chk = document.getElementById('crearEsPack');
    const stockInput = document.getElementById('crearStockInput');
    const packFields = document.getElementById('crearPackFields');
    if (packFields) packFields.style.display = chk.checked ? '' : 'none';
    if (stockInput) {
        if (chk.checked) {
            stockInput.readOnly = true;
            stockInput.classList.add('input-readonly');
            actualizarStockPackCrear();
        } else {
            stockInput.readOnly = false;
            stockInput.classList.remove('input-readonly');
        }
    }
}

function actualizarStockPackCrear() {
    const stockInput = document.getElementById('crearStockInput');
    if (!stockInput) return;
    if (PK_UNIDAD_SELECCIONADA_ID_CREAR && PK_UNIDAD_SELECCIONADA_STOCK_CREAR > 0) {
        const cant = parseInt(document.getElementById('crearCantidadUnidades')?.value) || 0;
        if (cant > 0) stockInput.value = Math.floor(PK_UNIDAD_SELECCIONADA_STOCK_CREAR / cant);
    } else {
        stockInput.value = 0;
    }
}

function actualizarPackPreviewCrear() {
    const chk = document.getElementById('crearEsPack');
    if (chk?.checked) actualizarStockPackCrear();
}

/* Datos serializados desde el servidor (productos disponibles como unidad) */
var PK_UNIDADES_DATA_CREAR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    (ViewBag.ProductosUnidadDisponibles as List<Infraestructura.Entities.BotiApp.ProProductos>
     ?? new List<Infraestructura.Entities.BotiApp.ProProductos>())
    .Select(p => new {
        id          = p.IdProducto,
        nombre      = p.NombreProducto,
        marca       = p.IdMarcaNavigation != null ? p.IdMarcaNavigation.NombreMarca : "—",
        precio      = p.Precio,
        stock       = p.Stock,
        tieneImagen = p.Imagen != null && p.Imagen.Length > 0
    })
).Replace("</", "<\\/"));
var PK_UNIDAD_SELECCIONADA_ID_CREAR = null;
var PK_UNIDAD_SELECCIONADA_NOMBRE_CREAR = '';
var PK_UNIDAD_SELECCIONADA_STOCK_CREAR = 0;

function setUnidadSeleccionadaCrear(p) {
    PK_UNIDAD_SELECCIONADA_ID_CREAR = p.id;
    PK_UNIDAD_SELECCIONADA_NOMBRE_CREAR = p.nombre;
    PK_UNIDAD_SELECCIONADA_STOCK_CREAR = p.stock;
    document.getElementById('crearIdProductoUnidad').value = p.id;
    const display = document.getElementById('crearPackUnidadDisplay');
    display.innerHTML = `
        <img class="pack-unidad-thumb" src="/Productos/Productos/Imagen/${p.id}" onerror="this.style.display='none'" alt="" />
        <div class="pack-unidad-info">
            <div class="pack-unidad-nombre">${esc(p.nombre)}</div>
            <div class="pack-unidad-meta">${esc(p.marca)} · Stock: <strong>${p.stock}</strong></div>
        </div>
        <button type="button" class="pack-unidad-clear" onclick="event.stopPropagation(); limpiarUnidadCrear()" title="Quitar">
            <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
        </button>`;
    display.classList.add('has-value');
    const chk = document.getElementById('crearEsPack');
    if (chk?.checked) actualizarStockPackCrear();
    actualizarPackPreviewCrear();
    cerrarVistaUnidadCrear();
}

function limpiarUnidadCrear() {
    PK_UNIDAD_SELECCIONADA_ID_CREAR = null;
    PK_UNIDAD_SELECCIONADA_NOMBRE_CREAR = '';
    PK_UNIDAD_SELECCIONADA_STOCK_CREAR = 0;
    document.getElementById('crearIdProductoUnidad').value = '0';
    const display = document.getElementById('crearPackUnidadDisplay');
    display.innerHTML = '<span class="pack-unidad-empty">Ningún producto seleccionado</span>';
    display.classList.remove('has-value');
    actualizarPackPreviewCrear();
}

function abrirSelectorUnidadCrear() {
    const form = document.getElementById('formCrear');
    const aside = document.querySelector('#modalBody .mc-aside');
    const view = document.getElementById('crearUnidadSelectorView');
    if (!view) return;
    form.style.display = 'none';
    if (aside) aside.style.display = 'none';
    view.style.display = 'flex';
    renderUnidadGridCrear(PK_UNIDADES_DATA_CREAR);
    setTimeout(() => document.getElementById('crearUnidadBuscador')?.focus(), 50);
}

function cerrarVistaUnidadCrear() {
    const form = document.getElementById('formCrear');
    const aside = document.querySelector('#modalBody .mc-aside');
    const view = document.getElementById('crearUnidadSelectorView');
    if (form) form.style.display = '';
    if (aside) aside.style.display = '';
    if (view) view.style.display = 'none';
}

function renderUnidadGridCrear(lista) {
    const grid = document.getElementById('crearUnidadGrid');
    if (!grid) return;
    if (!lista.length) {
        grid.innerHTML = `<div class="pk-empty"><svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg><p>Sin productos disponibles.</p></div>`;
        return;
    }
    grid.innerHTML = lista.map(p => unidadCardHtmlCrear(p)).join('');
}

function unidadCardHtmlCrear(p) {
    const selected = PK_UNIDAD_SELECCIONADA_ID_CREAR === p.id;
    const imgHtml = p.tieneImagen
        ? `<img src="/Productos/Productos/Imagen/${p.id}" alt="${esc(p.nombre)}">`
        : `<svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>`;
    return `
    <div class="pk-sel-card${selected ? ' selected' : ''}" onclick="confirmarUnidadCrear(${p.id})">
        <div class="pksc-check"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg></div>
        <div class="pksc-img-wrap">${imgHtml}</div>
        <div class="pksc-body">
            <div class="pksc-nombre">${esc(p.nombre)}</div>
            <div class="pksc-marca">${esc(p.marca)} · Stock: <strong>${p.stock}</strong></div>
        </div>
    </div>`;
}

function confirmarUnidadCrear(id) {
    const p = PK_UNIDADES_DATA_CREAR.find(x => x.id === id);
    if (!p) return;
    setUnidadSeleccionadaCrear(p);
}

function filtrarUnidadCrear() {
    const q = normalizarBusqueda(document.getElementById('crearUnidadBuscador')?.value ?? '');
    const filtrados = PK_UNIDADES_DATA_CREAR.filter(p =>
        normalizarBusqueda(p.nombre).includes(q) ||
        normalizarBusqueda(p.marca).includes(q)
    );
    renderUnidadGridCrear(filtrados);
}

function normalizarBusqueda(texto) {
    if (!texto) return '';
    return texto.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}
</script>
</script>
