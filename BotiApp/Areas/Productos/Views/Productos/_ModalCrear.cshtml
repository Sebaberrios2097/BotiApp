                    </div>
                }
            }
        </div>
    </aside>
</div>

<!-- Vista de selección de unidad (transición interna) -->
<div id="crearUnidadSelectorView" class="mc-unidad-view" style="display:none">
    <div class="mc-unidad-header">
        <button type="button" class="btn-back-unidad" onclick="cerrarVistaUnidadCrear()">
            <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Volver al formulario
        </button>
