@model Infraestructura.Entities.BotiApp.ProProductos
@{
    var auditoria = ViewBag.Auditoria as IEnumerable<Infraestructura.Entities.BotiApp.AudProProductos>
                  ?? Enumerable.Empty<Infraestructura.Entities.BotiApp.AudProProductos>();
    var packActual = ViewBag.PackActual as Infraestructura.Entities.BotiApp.ProProductoPack;
    var unidades = ViewBag.ProductosUnidadDisponibles as List<Infraestructura.Entities.BotiApp.ProProductos>
                   ?? new List<Infraestructura.Entities.BotiApp.ProProductos>();
    var esPackInicial = packActual is not null;
}
<style>
    /* Reutiliza los estilos de _ModalCrear excepto specifics */
    .me-header {
        display:flex; align-items:center; justify-content:space-between;
        padding:1.25rem 1.5rem; border-bottom:1px solid #f0ebe5;
        background:var(--color-secundario); border-radius:16px 16px 0 0;
    }
    .me-header-left { display:flex; align-items:center; gap:.65rem; }
    .me-header-left svg { width:22px; height:22px; fill:var(--color-primario); }
    .me-header-left h2 { font-size:1.05rem; font-weight:700; color:#fff; margin:0; line-height:1.3; }
    .me-header-left small { display:block; font-size:.72rem; font-weight:400; color:rgba(255,255,255,.5); margin-top:.05rem; }
    .me-close {
        width:32px; height:32px; border-radius:8px; border:none; cursor:pointer;
        background:rgba(255,255,255,.08); color:rgba(255,255,255,.7);
        display:flex; align-items:center; justify-content:center; transition:background .2s;
    }
    .me-close:hover { background:rgba(255,255,255,.15); color:#fff; }
    .me-close svg { width:18px; height:18px; fill:currentColor; }

    .me-body { display:grid; grid-template-columns:1fr 260px; }
    .me-main { padding:1.5rem; overflow-y:auto; max-height:72vh; }

    .me-aside {
        border-left:1px solid #f0ebe5; background:#faf7f5;
        display:flex; flex-direction:column; overflow:hidden;
    }
    .me-aside-header {
        padding:.9rem 1rem; border-bottom:1px solid #f0ebe5;
        display:flex; align-items:center; gap:.5rem;
    }
    .me-aside-header svg { width:15px; height:15px; fill:var(--color-primario); }
    .me-aside-header span { font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:#7a6050; }
    .me-aside-body { padding:.75rem 1rem; overflow-y:auto; flex:1; }

    /* Timeline de auditoría */
    .audit-timeline { position:relative; }
    .audit-timeline::before {
        content:""; position:absolute; left:11px; top:0; bottom:0;
        width:2px; background:#e8ddd4;
    }
    .audit-item { display:flex; gap:.75rem; margin-bottom:1rem; position:relative; }
    .audit-dot {
        width:24px; height:24px; border-radius:50%; flex-shrink:0;
        background:var(--color-primario); display:flex; align-items:center; justify-content:center;
        z-index:1;
    }
    .audit-dot svg { width:12px; height:12px; fill:#fff; }
    .audit-info { flex:1; min-width:0; }
    .audit-motivo { font-size:.8rem; font-weight:600; color:var(--color-secundario); line-height:1.3; }
    .audit-fecha  { font-size:.72rem; color:#a89080; margin-top:.15rem; }
    .audit-chips  { display:flex; flex-wrap:wrap; gap:.3rem; margin-top:.35rem; }
    .audit-chip {
        padding:.15rem .5rem; border-radius:20px; font-size:.7rem; font-weight:600;
        background:rgba(231,111,46,.1); color:var(--color-primario);
    }
    .audit-chip.estado-on  { background:rgba(34,197,94,.1); color:#16a34a; }
    .audit-chip.estado-off { background:rgba(239,68,68,.1); color:#dc2626; }
    .aside-empty { text-align:center; padding:2rem .5rem; color:#b8a898; font-size:.82rem; }
    .aside-empty svg { width:32px; height:32px; fill:#ddd0c4; display:block; margin:0 auto .5rem; }

    /* Form (mismos estilos que _ModalCrear) */
    .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:.9rem 1.2rem; }
    .form-group { display:flex; flex-direction:column; gap:.3rem; }
    .form-group.full { grid-column:1/-1; }
    .form-label { font-size:.8rem; font-weight:600; color:var(--color-secundario); }
    .form-label .req { color:var(--color-primario); margin-left:2px; }
    .form-control { padding:.55rem .8rem; border:1.5px solid #e0d5cc; border-radius:8px; font-size:.88rem; color:var(--color-secundario); background:#faf7f5; transition:border-color .2s, box-shadow .2s; outline:none; width:100%; }
    .form-control:focus { border-color:var(--color-primario); box-shadow:0 0 0 3px rgba(231,111,46,.13); background:#fff; }
    .form-control.input-error { border-color:#dc2626; }
    .field-error { font-size:.76rem; color:#dc2626; }
    .form-hint { font-size:.74rem; color:#a89080; }
    .pack-preview-box { padding:.55rem .8rem; border:1.5px solid #e0d5cc; border-radius:8px; background:#fff; font-weight:700; color:var(--color-primario); font-size:1.05rem; min-height:42px; display:flex; align-items:center; }
    .input-readonly { background:#f0ebe5 !important; color:#a89080 !important; cursor:not-allowed; }
    .stock-with-pack { display:flex; align-items:center; gap:.6rem; }
    .stock-with-pack .form-control { flex:1; }
    .pack-toggle-label { display:inline-flex; align-items:center; gap:.45rem; cursor:pointer; padding:.35rem .55rem; border-radius:8px; transition:background .15s; user-select:none; flex-shrink:0; }
    .pack-toggle-label:hover { background:rgba(231,111,46,.06); }
    .pack-toggle-text { font-size:.78rem; font-weight:600; color:var(--color-secundario); text-transform:uppercase; letter-spacing:.4px; }
    .pack-inline-toggle { flex-shrink:0; }
    .pack-inline-toggle .toggle-sl:before { width:15px; height:15px; left:2px; top:2px; }
    .pack-inline-toggle input:checked + .toggle-sl:before { transform:translateX(16px); }
    .pack-inline-toggle .toggle-sl { width:36px; height:20px; }
    .pack-unidad-display { display:flex; align-items:center; gap:.65rem; cursor:pointer; padding:.6rem .85rem; border:1.5px solid #e0d5cc; border-radius:8px; background:#faf7f5; min-height:54px; transition:border-color .15s, box-shadow .15s, background .15s; }
    .pack-unidad-display:hover { border-color:var(--color-primario); background:#fff; box-shadow:0 2px 8px rgba(231,111,46,.08); }
    .pack-unidad-display:focus { outline:none; border-color:var(--color-primario); box-shadow:0 0 0 3px rgba(231,111,46,.13); }
    .pack-unidad-display.has-value { background:#fff; border-color:var(--color-primario); }
    .pack-unidad-empty { color:#a89080; font-size:.88rem; font-style:italic; }
    .pack-unidad-thumb { width:40px; height:40px; border-radius:7px; object-fit:cover; background:#f0ebe5; flex-shrink:0; }
    .pack-unidad-info { flex:1; min-width:0; }
    .pack-unidad-nombre { font-size:.9rem; font-weight:600; color:var(--color-secundario); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .pack-unidad-meta { font-size:.74rem; color:#a89080; margin-top:.15rem; }
    .pack-unidad-clear { background:transparent; border:none; color:#a89080; cursor:pointer; padding:6px; border-radius:6px; display:flex; flex-shrink:0; }
    .pack-unidad-clear:hover { background:#f0ebe5; color:#dc2626; }
    .pack-unidad-clear svg { width:16px; height:16px; fill:currentColor; }
    .pack-unidad-row { display:flex; align-items:stretch; gap:.55rem; }
    .pack-unidad-row .pack-unidad-display { flex:1; min-width:0; }
    .pack-cantidad-wrap { display:flex; align-items:center; gap:.4rem; padding:0 .6rem; background:#faf7f5; border:1.5px solid #e0d5cc; border-radius:8px; flex-shrink:0; transition:border-color .15s; }
    .pack-cantidad-wrap:focus-within { border-color:var(--color-primario); background:#fff; }
    .pack-cantidad-label { font-size:.72rem; font-weight:700; color:var(--color-secundario); white-space:nowrap; text-transform:uppercase; letter-spacing:.3px; }
    .pack-cantidad-wrap .form-control { width:64px; padding:.45rem .35rem; border:1.5px solid transparent; background:transparent; text-align:center; font-weight:700; color:var(--color-secundario); -moz-appearance:textfield; }
    .pack-cantidad-wrap .form-control::-webkit-outer-spin-button,
    .pack-cantidad-wrap .form-control::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
    .pack-cantidad-wrap .form-control:focus { border-color:transparent; box-shadow:none; background:transparent; }
    .me-unidad-view { display:flex; flex-direction:column; min-height:70vh; }
    .mc-unidad-header { display:flex; align-items:center; gap:.85rem; padding:1rem 1.5rem; border-bottom:1.5px solid #f0ebe5; }
    .btn-back-unidad { display:inline-flex; align-items:center; gap:.35rem; background:transparent; border:none; color:var(--color-primario); font-size:.86rem; font-weight:600; cursor:pointer; padding:.4rem .6rem; border-radius:7px; }
    .btn-back-unidad:hover { background:rgba(231,111,46,.08); }
    .btn-back-unidad svg { width:18px; height:18px; fill:currentColor; }
    .mc-unidad-title { font-size:1rem; font-weight:700; color:var(--color-secundario); }
    .mc-unidad-search { padding:.85rem 1.5rem; border-bottom:1.5px solid #f0ebe5; display:flex; align-items:center; gap:.5rem; background:#faf7f5; }
    .mc-unidad-search svg { width:18px; height:18px; fill:var(--color-primario); opacity:.7; flex-shrink:0; }
    .mc-unidad-search input { flex:1; border:none; outline:none; font-size:.92rem; padding:.55rem .75rem; border-radius:8px; border:1.5px solid #e0d5cc; background:#fff; color:var(--color-secundario); }
    .mc-unidad-search input:focus { border-color:var(--color-primario); }
    .mc-unidad-body { flex:1; overflow-y:auto; padding:1.25rem 1.5rem; }
    .pk-empty { text-align:center; padding:3rem 1rem; color:#a89080; grid-column:1/-1; }
    .pk-empty svg { width:44px; height:44px; fill:#ddd0c4; margin:0 auto .5rem; display:block; }
    .pk-empty p { font-size:.88rem; }
    .pkm-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(148px,1fr)); gap:.75rem; }
    .pk-sel-card { border:2px solid #e8ddd4; border-radius:12px; background:#faf8f6; cursor:pointer; transition:border-color .15s,box-shadow .15s,background .15s; overflow:hidden; position:relative; user-select:none; }
    .pk-sel-card:hover { border-color:var(--color-primario); box-shadow:0 2px 10px rgba(231,111,46,.12); }
    .pk-sel-card.selected { border-color:var(--color-primario); background:rgba(231,111,46,.04); box-shadow:0 3px 12px rgba(231,111,46,.18); }
    .pk-sel-card .pksc-check { position:absolute; top:.4rem; right:.4rem; width:22px; height:22px; border-radius:50%; background:#e8ddd4; border:2px solid #e8ddd4; display:flex; align-items:center; justify-content:center; transition:background .15s,border-color .15s; }
    .pk-sel-card.selected .pksc-check { background:var(--color-primario); border-color:var(--color-primario); }
    .pk-sel-card .pksc-check svg { width:13px; height:13px; fill:#fff; opacity:0; transition:opacity .15s; }
    .pk-sel-card.selected .pksc-check svg { opacity:1; }
    .pk-sel-card .pksc-img-wrap { width:100%; aspect-ratio:1; background:#f0ebe5; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .pk-sel-card .pksc-img-wrap img { width:100%; height:100%; object-fit:cover; }
    .pk-sel-card .pksc-img-wrap svg { width:40px; height:40px; fill:#c9b8a8; }
    .pk-sel-card .pksc-body { padding:.5rem .6rem; }
    .pk-sel-card .pksc-nombre { font-size:.78rem; font-weight:700; color:var(--color-secundario); line-height:1.3; margin-bottom:.2rem; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
    .pk-sel-card .pksc-marca { font-size:.7rem; color:#a89080; }

    .img-drop { border:2px dashed #e0d5cc; border-radius:10px; padding:1rem; text-align:center; background:#faf7f5; cursor:pointer; transition:border-color .2s; }
    .img-drop:hover { border-color:var(--color-primario); }
    .img-drop svg { width:28px; height:28px; fill:#c9b8a8; }
    .img-drop p { font-size:.78rem; color:#a89080; margin:.3rem 0 0; }
    .img-actual-wrap { display:flex; align-items:center; gap:.75rem; background:#f0ebe5; border-radius:8px; padding:.6rem .8rem; margin-bottom:.6rem; }
    .img-actual-wrap img { width:48px; height:48px; border-radius:6px; object-fit:cover; border:1px solid #e0d5cc; }
    .img-actual-wrap p { font-size:.78rem; color:#a89080; margin:0; }
    #imgPreviewEditar { max-width:100%; max-height:100px; border-radius:8px; margin-top:.5rem; display:none; object-fit:cover; }

    .toggle-w { display:flex; align-items:center; gap:.6rem; padding:.55rem 0; }
    .toggle-sw { position:relative; width:42px; height:23px; flex-shrink:0; }
    .toggle-sw input { opacity:0; width:0; height:0; }
    .toggle-sl { position:absolute; inset:0; background:#ccc; border-radius:24px; cursor:pointer; transition:background .2s; }
    .toggle-sl:before { content:""; position:absolute; width:17px; height:17px; left:3px; top:3px; background:#fff; border-radius:50%; transition:transform .2s; }
    .toggle-sw input:checked + .toggle-sl { background:var(--color-primario); }
    .toggle-sw input:checked + .toggle-sl:before { transform:translateX(19px); }
    .toggle-label { font-size:.86rem; font-weight:600; color:var(--color-secundario); }

    .me-footer {
        padding:1rem 1.5rem; border-top:1px solid #f0ebe5;
        display:flex; gap:.65rem; background:#fff; border-radius:0 0 0 16px;
    }
    .btn-save { display:inline-flex; align-items:center; gap:.4rem; padding:.58rem 1.3rem; background:var(--color-primario); color:#fff; border:none; border-radius:8px; font-size:.88rem; font-weight:600; cursor:pointer; transition:background .2s, transform .15s; }
    .btn-save svg { width:16px; height:16px; fill:currentColor; }
    .btn-save:hover { background:#cf5f22; transform:translateY(-1px); }
    .btn-cancel { display:inline-flex; align-items:center; gap:.4rem; padding:.58rem 1.1rem; background:#f0ebe5; color:var(--color-secundario); border:none; border-radius:8px; font-size:.88rem; font-weight:600; cursor:pointer; transition:background .15s; }
    .btn-cancel:hover { background:#e0d5cc; }

    @@media (max-width:650px) {
        .me-body  { grid-template-columns:1fr; }
        .me-aside { border-left:none; border-top:1px solid #f0ebe5; max-height:180px; }
        .me-main  { max-height:none; }
        .form-grid { grid-template-columns:1fr; }
        .form-group.full { grid-column:1; }
    }
</style>

<!-- Header -->
<div class="me-header">
    <div class="me-header-left">
        <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
        <h2>
            Editar Producto
            <small>@Model.NombreProducto</small>
        </h2>
    </div>
    <button class="me-close" onclick="cerrarModal()" aria-label="Cerrar">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </button>
</div>

<div class="me-body">

    <!-- Formulario principal -->
    <div class="me-main">
        <form id="formEditar"
              asp-area="Productos" asp-controller="Productos" asp-action="EditarAjax"
              asp-route-id="@Model.IdProducto"
              method="post" enctype="multipart/form-data" novalidate
              onsubmit="event.preventDefault(); submitFormAjax('formEditar', false)">
            @Html.AntiForgeryToken()
            <input asp-for="IdProducto" type="hidden" />
            <input asp-for="FechaIngreso" type="hidden" />

            <div class="form-grid">

                <div class="form-group">
                    <label class="form-label" asp-for="NombreProducto">Nombre <span class="req">*</span></label>
                    <input asp-for="NombreProducto" class="form-control" />
                    <span asp-validation-for="NombreProducto" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Codigo">Código / SKU</label>
                    <div style="display:flex;gap:.45rem;align-items:center;">
                        <input asp-for="Codigo" class="form-control" id="editarCodigo" style="flex:1;min-width:0;" />
                        <button type="button" id="editarBtnScan" onclick="prdToggleScanner('editar')" title="Escanear código de barras"
                            style="flex-shrink:0;width:36px;height:36px;border:1.5px solid #e0d5cc;border-radius:7px;background:#faf7f5;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--color-primario);transition:background .15s;">
                            <svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:currentColor;"><path d="M9 2H4C2.9 2 2 2.9 2 4v5h2V4h5V2zm-5 18v-5H2v5c0 1.1.9 2 2 2h5v-2H4zm16 0h-5v2h5c1.1 0 2-.9 2-2v-5h-2v5zm0-16h-5V2h5c1.1 0 2 .9 2 2v5h-2V4zM7 7h10v10H7z"/></svg>
                        </button>
                    </div>
                    <div id="editarScannerWrap" style="display:none;margin-top:.5rem;border-radius:10px;overflow:hidden;background:#000;position:relative;max-height:200px;">
                        <video id="editarScannerVideo" playsinline muted style="width:100%;max-height:200px;object-fit:cover;display:block;"></video>
                        <div style="position:absolute;inset:0;pointer-events:none;display:flex;align-items:center;justify-content:center;">
                            <div style="width:65%;height:68px;border-radius:7px;border:2.5px solid rgba(231,111,46,.95);box-shadow:0 0 0 9999px rgba(0,0,0,.45);"></div>
                        </div>
                        <button type="button" onclick="prdDetenerScanner('editar')" aria-label="Cerrar escáner"
                            style="position:absolute;top:.4rem;right:.4rem;width:26px;height:26px;border-radius:50%;border:none;cursor:pointer;background:rgba(255,255,255,.15);color:#fff;display:flex;align-items:center;justify-content:center;">
                            <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:currentColor;"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                        </button>
                        <p style="color:rgba(255,255,255,.6);font-size:.7rem;text-align:center;margin:.35rem 0;padding:0;">Apunta al código de barras</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="IdTipoProducto">Tipo <span class="req">*</span></label>
                    <select asp-for="IdTipoProducto" asp-items="ViewBag.Tipos" class="form-control">
                        <option value="">— Selecciona —</option>
                    </select>
                    <span asp-validation-for="IdTipoProducto" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="IdMarca">Marca <span class="req">*</span></label>
                    <select asp-for="IdMarca" asp-items="ViewBag.Marcas" class="form-control">
                        <option value="">— Selecciona —</option>
                    </select>
                    <span asp-validation-for="IdMarca" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Precio">Precio ($) <span class="req">*</span></label>
                    <input asp-for="Precio" type="number" min="0" class="form-control" />
                    <span asp-validation-for="Precio" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Stock">Stock <span class="req">*</span></label>
                    <div class="stock-with-pack">
                        @{
                            var stockClass = "form-control" + (esPackInicial ? " input-readonly" : "");
                        }
                        <input asp-for="Stock" type="number" min="0" class="@stockClass" id="editarStockInput" />
                        <label class="pack-toggle-label" title="Marcar este producto como pack">
                            <span class="pack-toggle-text">Es pack</span>
                            <span class="toggle-sw pack-inline-toggle">
                                <input type="checkbox" id="editarEsPack" name="EsPack" value="true" onchange="togglePackEditar()" @(esPackInicial ? "checked" : "") />
                                <span class="toggle-sl"></span>
                            </span>
                        </label>
                    </div>
                    <span asp-validation-for="Stock" class="field-error"></span>
                </div>

                <div class="form-group full pack-section" id="editarPackFields" style="display:@(esPackInicial ? "" : "none")">
                    <label class="form-label">Unidad base del pack <span class="req">*</span></label>
                    <div class="pack-unidad-row">
                        <input type="hidden" id="editarIdProductoUnidad" name="IdProductoUnidad" value="@(packActual?.IdProductoUnidad ?? 0)" />
                        <div class="pack-unidad-display@(packActual is not null ? " has-value" : "")" id="editarPackUnidadDisplay" role="button" tabindex="0"
                             onclick="abrirSelectorUnidadEditar()" onkeydown="if(event.key==='Enter'||event.key===' ')abrirSelectorUnidadEditar()">
                            @if (packActual is not null)
                            {
                                var u = unidades.FirstOrDefault(x => x.IdProducto == packActual.IdProductoUnidad);
                                if (u is not null)
                                {
                                    var marcaU = u.IdMarcaNavigation?.NombreMarca ?? "—";
                                    <img class="pack-unidad-thumb" src="/Productos/Productos/Imagen/@u.IdProducto" onerror="this.style.display='none'" alt="" />
                                    <div class="pack-unidad-info">
                                        <div class="pack-unidad-nombre">@u.NombreProducto</div>
                                        <div class="pack-unidad-meta">@marcaU · Stock: <strong>@u.Stock</strong></div>
                                    </div>
                                    <button type="button" class="pack-unidad-clear" onclick="event.stopPropagation(); limpiarUnidadEditar()" title="Quitar">
                                        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="pack-unidad-empty">Click aquí para seleccionar el producto unidad…</span>
                            }
                        </div>
                        <div class="pack-cantidad-wrap">
                            <label class="pack-cantidad-label">Cant. unidades <span class="req">*</span></label>
                            <input type="number" id="editarCantidadUnidades" name="CantidadUnidades" min="2" step="1" value="@(packActual?.CantidadUnidades ?? 6)" class="form-control" oninput="actualizarPackPreviewEditar()" title="Típico: 6 (SixPack). Mínimo 2." />
                        </div>
                    </div>
                </div>

                <div class="form-group full">
                    <label class="form-label" asp-for="Descripción">Descripción</label>
                    <textarea asp-for="Descripción" class="form-control" rows="2"></textarea>
                </div>

                <div class="form-group full">
                    <label class="form-label">Imagen</label>
                    @if (Model.Imagen is { Length: > 0 })
                    {
                        <div class="img-actual-wrap">
                            <img src="/Productos/Productos/Imagen/@Model.IdProducto" alt="@Model.NombreProducto" />
                            <p>Imagen actual — selecciona una nueva para reemplazarla</p>
                        </div>
                    }
                    <div class="img-drop" onclick="document.getElementById('imgFileEditar').click()">
                        <svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                        <p>Clic para cambiar la imagen</p>
                    </div>
                    <input type="file" id="imgFileEditar" name="imagenFile" accept="image/*"
                           style="display:none" onchange="prevImg(this,'imgPreviewEditar')" />
                    <img id="imgPreviewEditar" alt="Vista previa" />
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Estado">Estado</label>
                    <div class="toggle-w">
                        <label class="toggle-sw">
                            <input asp-for="Estado" type="checkbox" />
                            <span class="toggle-sl"></span>
                        </label>
                        <span class="toggle-label">Activo</span>
                    </div>
                </div>

            </div>
        </form>
    </div>

    <!-- Aside: historial de cambios -->
    <aside class="me-aside">
        <div class="me-aside-header">
            <svg viewBox="0 0 24 24"><path d="M13 3a9 9 0 1 0 0 18A9 9 0 0 0 13 3zm0 16c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7zm.5-11H12v6l5.25 3.15.75-1.23-4.5-2.67V8z"/></svg>
            <span>Historial de cambios</span>
        </div>
        <div class="me-aside-body">
            @if (!auditoria.Any())
            {
                <div class="aside-empty">
                    <svg viewBox="0 0 24 24"><path d="M13 3a9 9 0 1 0 0 18A9 9 0 0 0 13 3zm0 16c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7zm.5-11H12v6l5.25 3.15.75-1.23-4.5-2.67V8z"/></svg>
                    Sin modificaciones registradas
                </div>
            }
            else
            {
                <div class="audit-timeline">
                    @foreach (var a in auditoria)
                    {
                        <div class="audit-item">
                            <div class="audit-dot">
                                <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z"/></svg>
                            </div>
                            <div class="audit-info">
                                <div class="audit-motivo">@a.Motivo</div>
                                <div class="audit-fecha">@a.FechaModificacion.ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="audit-chips">
                                    <span class="audit-chip">$@a.Precio.ToString("N0")</span>
                                    <span class="audit-chip @(a.Estado ? "estado-on" : "estado-off")">
                                        @(a.Estado ? "Activo" : "Inactivo")
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </aside>
</div>

<!-- Vista de selección de unidad (transición interna) -->
<div id="editarUnidadSelectorView" class="me-unidad-view" style="display:none">
    <div class="mc-unidad-header">
        <button type="button" class="btn-back-unidad" onclick="cerrarVistaUnidadEditar()">
            <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
            Volver al formulario
        </button>
        <span class="mc-unidad-title">Selecciona el producto unidad</span>
    </div>
    <div class="mc-unidad-search">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <input type="text" id="editarUnidadBuscador" placeholder="Buscar por nombre o marca…" oninput="filtrarUnidadEditar()" autocomplete="off" />
    </div>
    <div class="mc-unidad-body">
        <div class="pkm-grid" id="editarUnidadGrid"></div>
    </div>
</div>

<!-- Footer -->
<div class="me-footer">
    <button type="submit" form="formEditar" class="btn-save">
        <svg viewBox="0 0 24 24"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
        Guardar cambios
    </button>
    <button type="button" class="btn-cancel" onclick="cerrarModal()">Cancelar</button>
</div>

<script>
function prevImg(input, previewId) {
    const preview = document.getElementById(previewId);
    if (input.files?.[0]) {
        const file = input.files[0];
        if (!file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };
            reader.readAsDataURL(file);
            return;
        }

        const reader = new FileReader();
        reader.onload = e => {
            const img = new Image();
            img.onload = () => {
                const maxWidth = 500;
                const maxHeight = 500;
                let width = img.width;
                let height = img.height;
                if (width > height) {
                    if (width > maxWidth) {
                        height = Math.round((height * maxWidth) / width);
                        width = maxWidth;
                    }
                } else {
                    if (height > maxHeight) {
                        width = Math.round((width * maxHeight) / height);
                        height = maxHeight;
                    }
                }

                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);

                canvas.toBlob(blob => {
                    if (!blob) return;
                    const compressedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                        type: 'image/jpeg',
                        lastModified: Date.now()
                    });

                    try {
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(compressedFile);
                        input.files = dataTransfer.files;
                    } catch (err) {
                        console.error('Error re-injecting file:', err);
                    }

                    preview.src = URL.createObjectURL(blob);
                    preview.style.display = 'block';
                }, 'image/jpeg', 0.75);
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }
}

/* ── Pack: lógica del toggle, bloqueo de Stock y selección de unidad ── */
function togglePackEditar() {
    const chk = document.getElementById('editarEsPack');
    const stockInput = document.getElementById('editarStockInput');
    const packFields = document.getElementById('editarPackFields');
    if (packFields) packFields.style.display = chk.checked ? '' : 'none';
    if (stockInput) {
        if (chk.checked) {
            stockInput.readOnly = true;
            stockInput.classList.add('input-readonly');
            actualizarStockPackEditar();
        } else {
            stockInput.readOnly = false;
            stockInput.classList.remove('input-readonly');
        }
    }
}

function actualizarStockPackEditar() {
    const stockInput = document.getElementById('editarStockInput');
    if (!stockInput) return;
    if (PK_UNIDAD_SELECCIONADA_ID_EDITAR > 0 && PK_UNIDAD_SELECCIONADA_STOCK_EDITAR > 0) {
        const cant = parseInt(document.getElementById('editarCantidadUnidades')?.value) || 0;
        if (cant > 0) stockInput.value = Math.floor(PK_UNIDAD_SELECCIONADA_STOCK_EDITAR / cant);
    } else {
        stockInput.value = 0;
    }
}

function actualizarPackPreviewEditar() {
    const chk = document.getElementById('editarEsPack');
    if (chk?.checked) actualizarStockPackEditar();
}

const PK_UNIDADES_DATA_EDITAR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    (ViewBag.ProductosUnidadDisponibles as List<Infraestructura.Entities.BotiApp.ProProductos>
     ?? new List<Infraestructura.Entities.BotiApp.ProProductos>())
    .Select(p => new {
        id          = p.IdProducto,
        nombre      = p.NombreProducto,
        marca       = p.IdMarcaNavigation != null ? p.IdMarcaNavigation.NombreMarca : "—",
        precio      = p.Precio,
        stock       = p.Stock,
        tieneImagen = p.Imagen != null && p.Imagen.Length > 0
    })
).Replace("</", "<\\/"));
let PK_UNIDAD_SELECCIONADA_ID_EDITAR = @(packActual?.IdProductoUnidad ?? 0);
let PK_UNIDAD_SELECCIONADA_STOCK_EDITAR = @(packActual is not null
    ? (unidades.FirstOrDefault(u => u.IdProducto == packActual.IdProductoUnidad)?.Stock ?? 0)
    : 0);

function setUnidadSeleccionadaEditar(p) {
    PK_UNIDAD_SELECCIONADA_ID_EDITAR = p.id;
    PK_UNIDAD_SELECCIONADA_STOCK_EDITAR = p.stock;
    document.getElementById('editarIdProductoUnidad').value = p.id;
    const display = document.getElementById('editarPackUnidadDisplay');
    display.innerHTML = `
        <img class="pack-unidad-thumb" src="/Productos/Productos/Imagen/${p.id}" onerror="this.style.display='none'" alt="" />
        <div class="pack-unidad-info">
            <div class="pack-unidad-nombre">${esc(p.nombre)}</div>
            <div class="pack-unidad-meta">${esc(p.marca)} · Stock: <strong>${p.stock}</strong></div>
        </div>
        <button type="button" class="pack-unidad-clear" onclick="event.stopPropagation(); limpiarUnidadEditar()" title="Quitar">
            <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
        </button>`;
    display.classList.add('has-value');
    const chk = document.getElementById('editarEsPack');
    if (chk?.checked) actualizarStockPackEditar();
    actualizarPackPreviewEditar();
    cerrarVistaUnidadEditar();
}

function limpiarUnidadEditar() {
    PK_UNIDAD_SELECCIONADA_ID_EDITAR = 0;
    PK_UNIDAD_SELECCIONADA_STOCK_EDITAR = 0;
    document.getElementById('editarIdProductoUnidad').value = 0;
    const display = document.getElementById('editarPackUnidadDisplay');
    display.innerHTML = '<span class="pack-unidad-empty">Ningún producto seleccionado</span>';
    display.classList.remove('has-value');
    actualizarPackPreviewEditar();
}

function abrirSelectorUnidadEditar() {
    const form = document.getElementById('formEditar');
    const aside = document.querySelector('#modalBody .me-aside');
    const view = document.getElementById('editarUnidadSelectorView');
    if (!view) return;
    if (form) form.style.display = 'none';
    if (aside) aside.style.display = 'none';
    view.style.display = 'flex';
    renderUnidadGridEditar(PK_UNIDADES_DATA_EDITAR);
    setTimeout(() => document.getElementById('editarUnidadBuscador')?.focus(), 50);
}

function cerrarVistaUnidadEditar() {
    const form = document.getElementById('formEditar');
    const aside = document.querySelector('#modalBody .me-aside');
    const view = document.getElementById('editarUnidadSelectorView');
    if (form) form.style.display = '';
    if (aside) aside.style.display = '';
    if (view) view.style.display = 'none';
}

function renderUnidadGridEditar(lista) {
    const grid = document.getElementById('editarUnidadGrid');
    if (!grid) return;
    if (!lista.length) {
        grid.innerHTML = `<div class="pk-empty"><svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg><p>Sin productos disponibles.</p></div>`;
        return;
    }
    grid.innerHTML = lista.map(p => unidadCardHtmlEditar(p)).join('');
}

function unidadCardHtmlEditar(p) {
    const selected = PK_UNIDAD_SELECCIONADA_ID_EDITAR === p.id;
    const imgHtml = p.tieneImagen
        ? `<img src="/Productos/Productos/Imagen/${p.id}" alt="${esc(p.nombre)}">`
        : `<svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>`;
    return `
    <div class="pk-sel-card${selected ? ' selected' : ''}" onclick="confirmarUnidadEditar(${p.id})">
        <div class="pksc-check"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg></div>
        <div class="pksc-img-wrap">${imgHtml}</div>
        <div class="pksc-body">
            <div class="pksc-nombre">${esc(p.nombre)}</div>
            <div class="pksc-marca">${esc(p.marca)} · Stock: <strong>${p.stock}</strong></div>
        </div>
    </div>`;
}

function confirmarUnidadEditar(id) {
    const p = PK_UNIDADES_DATA_EDITAR.find(x => x.id === id);
    if (!p) return;
    setUnidadSeleccionadaEditar(p);
}

function filtrarUnidadEditar() {
    const q = normalizarBusqueda(document.getElementById('editarUnidadBuscador')?.value ?? '');
    const filtrados = PK_UNIDADES_DATA_EDITAR.filter(p =>
        normalizarBusqueda(p.nombre).includes(q) ||
        normalizarBusqueda(p.marca).includes(q)
    );
    renderUnidadGridEditar(filtrados);
}

function esc(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function normalizarBusqueda(texto) {
    if (!texto) return '';
    return texto.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}

/* Inicializar estado: si es pack, calcular Stock desde la unidad */
(function initPackEditar() {
    const chk = document.getElementById('editarEsPack');
    const stockInput = document.getElementById('editarStockInput');
    if (chk?.checked && stockInput) {
        // Forzar readonly desde JS por si el navegador lo pierde tras la hidratación.
        stockInput.readOnly = true;
        stockInput.classList.add('input-readonly');
        // Calcular stock en cuanto el DOM esté listo (puede haber datos
        // serializados por Razor que ya están disponibles).
        const tryCalc = () => {
            if (PK_UNIDAD_SELECCIONADA_ID_EDITAR > 0) actualizarStockPackEditar();
        };
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', tryCalc);
        } else {
            tryCalc();
        }
    }
})();
</script>
