    async function ejecutarQuitarProducto(idDetalle) {
        cerrarModal();
        try {
            const r    = await fetch(`/Productos/Promociones/QuitarProductoAjax/${idDetalle}`,
                { method: 'POST', headers: { 'RequestVerificationToken': csrf() } });
            const data = await r.json();
            toast(data.mensaje, data.ok ? 'exito' : 'error');
            if (data.ok) {
                document.getElementById(`det-${idDetalle}`)?.remove();
            }
        } catch { toast('Error al quitar el producto.', 'error'); }
    }

    // ── Abrir modal buscador (idGrupo puede ser null) ─────────────────────────
    function abrirModalBuscar(idPromocion, idGrupo = null) {
        const qs = idGrupo !== null && idGrupo !== undefined
            ? `?idPromocion=${idPromocion}&idGrupo=${idGrupo}`
            : `?idPromocion=${idPromocion}`;
        abrirModal(`/Productos/Promociones/ModalBuscarProducto${qs}`);
    }

    // ── Agregar producto (llamado desde el partial) ──────────────────────────
    async function ejecutarAgregarProducto(idPromocion, idProducto, cantidad, idGrupo) {
        cerrarModal();
        try {
            const fd = new FormData();
            fd.append('idPromocion', idPromocion);
            fd.append('idProducto',  idProducto);
            fd.append('cantidad',    cantidad);
            if (idGrupo) fd.append('idGrupo', idGrupo);

            const r    = await fetch('/Productos/Promociones/AgregarProductoAjax',
                { method: 'POST', headers: { 'RequestVerificationToken': csrf() }, body: fd });
            const data = await r.json();
            toast(data.mensaje, data.ok ? 'exito' : 'error');
            if (data.ok) agregarFilaProducto(idPromocion, data.detalle);
        } catch { toast('Error al agregar el producto.', 'error'); }
    }

    function agregarFilaProducto(idPromocion, d) {
        const img = d.tieneImagen
            ? `<img src="/Productos/Productos/Imagen/${d.idProducto}?t=${Date.now()}" alt="" />`
            : `<svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>`;
        const safeName = esc(d.nombreProducto);
        const marca    = esc(d.nombreMarca);
        const html = `
<div class="prm-item" id="det-${d.idPromocionDetalle}" data-detalle-id="${d.idPromocionDetalle}">
  <div class="prm-item-img">${img}</div>
  <div class="prm-item-info">
    <div class="prm-item-name">${safeName}</div>
    <div class="prm-item-meta">${marca} · $${Number(d.precio).toLocaleString('es-CL')}</div>
  </div>
  <div class="prm-item-qty">×${d.cantidad}</div>
  <button class="prm-item-del edit-only" title="Quitar"
          onclick="confirmarQuitarProducto(${d.idPromocionDetalle},'${safeName.replace(/'/g,"\\'")}')">
    <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1-1H5v2h14V4z"/></svg>
  </button>
</div>`;

        if (d.idGrupo) {
            const grupo = document.getElementById(`grupo-${d.idGrupo}`);
            const items = grupo?.querySelector('.prm-grupo-items');
            if (items) {
                const empty = items.querySelector('.prm-empty');
                if (empty) empty.remove();
                items.insertAdjacentHTML('beforeend', html);
                const cnt = grupo.querySelector('.prm-grupo-count');
                if (cnt) {
                    const n = items.querySelectorAll('.prm-item').length;
                    cnt.textContent = `${n} producto(s)`;
                }
            }
        } else {
            const base = document.getElementById(`base-${idPromocion}`);
            if (base) {
                const empty = base.querySelector('.prm-empty');
                if (empty) empty.remove();
                base.insertAdjacentHTML('beforeend', html);
            }
        }

        // Si el card está en modo edición, hacer visibles los botones delete
        const card = document.getElementById(`card-${idPromocion}`);
        if (card?.classList.contains('edit-mode')) {
            const newDel = card.querySelector(`#det-${d.idPromocionDetalle} .prm-item-del`);
            if (newDel) newDel.style.display = 'inline-flex';
        }
    }

