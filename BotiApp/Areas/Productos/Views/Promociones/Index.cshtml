@model IEnumerable<Infraestructura.Entities.BotiApp.ProPromocion>
@{
    ViewData["Title"] = "Promociones";

    var promos  = Model.ToList();
    var conteos = promos.GroupBy(PromocionesController.EstadoClave)
                        .ToDictionary(g => g.Key, g => g.Count());
    int Conteo(string clave) => conteos.TryGetValue(clave, out var n) ? n : 0;
}

<style>
    /* ── Cabecera ───────────────────────────────────────────────────────── */
    .page-header-card {
        background: #fff; border-radius: 14px; box-shadow: 0 2px 12px rgba(44, 29, 13, .08);
        padding: 1.25rem 1.5rem; margin-bottom: 1.25rem;
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 1rem;
    }
    .page-header-left { display: flex; align-items: center; gap: .85rem; }
    .page-header-icon {
        width: 46px; height: 46px; border-radius: 12px; flex-shrink: 0;
        background: rgba(231, 111, 46, .12);
        display: flex; align-items: center; justify-content: center;
    }
    .page-header-icon svg { width: 24px; height: 24px; fill: var(--color-primario); }
    .page-header-title { font-size: 1.3rem; font-weight: 800; color: var(--color-secundario); margin: 0; }
    .page-header-sub   { font-size: .82rem; color: #9a8070; margin: .1rem 0 0; }

    .btn-nuevo {
        display: inline-flex; align-items: center; gap: .45rem;
        padding: .55rem 1.1rem; background: var(--color-primario); color: #fff;
        border: none; border-radius: 8px; font-size: .88rem; font-weight: 700;
        cursor: pointer; transition: background .2s, transform .15s;
    }
    .btn-nuevo svg { width: 16px; height: 16px; fill: currentColor; }
    .btn-nuevo:hover { background: #cf5f22; transform: translateY(-1px); }

    /* ── Barra de herramientas ──────────────────────────────────────────── */
    .prm-toolbar {
        display: flex; align-items: center; gap: .7rem; flex-wrap: wrap;
        margin-bottom: 1.15rem;
    }
    .prm-search {
        display: flex; align-items: center; gap: .55rem;
        background: #fff; border: 1.5px solid #e8ddd4; border-radius: 8px;
        padding: .45rem .85rem; flex: 1; min-width: 230px; max-width: 380px;
        transition: border-color .15s;
    }
    .prm-search:focus-within { border-color: var(--color-primario); }
    .prm-search svg { width: 17px; height: 17px; fill: var(--color-primario); opacity: .7; flex-shrink: 0; }
    .prm-search input {
        border: none; outline: none; background: transparent;
        font-size: .9rem; width: 100%; color: var(--color-secundario);
    }

    .prm-filtros { display: flex; gap: .35rem; flex-wrap: wrap; }
    .prm-filtro {
        display: inline-flex; align-items: center; gap: .35rem;
        padding: .4rem .8rem; border-radius: 20px; border: 1.5px solid #e8ddd4;
        background: #fff; color: #7a6050; font-size: .8rem; font-weight: 700;
        cursor: pointer; transition: background .15s, border-color .15s, color .15s;
    }
    .prm-filtro:hover { border-color: var(--color-primario); color: var(--color-primario); }
    .prm-filtro.active {
        background: var(--color-primario); border-color: var(--color-primario); color: #fff;
    }
    .prm-filtro-n {
        font-size: .72rem; font-weight: 800; opacity: .75;
        background: rgba(0, 0, 0, .07); border-radius: 10px; padding: 0 .35rem;
    }
    .prm-filtro.active .prm-filtro-n { background: rgba(255, 255, 255, .25); opacity: 1; }

    .prm-orden {
        padding: .45rem .7rem; border: 1.5px solid #e8ddd4; border-radius: 8px;
        background: #fff; font-size: .84rem; color: var(--color-secundario);
        outline: none; cursor: pointer;
    }
    .prm-orden:focus { border-color: var(--color-primario); }
    .prm-conteo { font-size: .8rem; color: #9a8070; margin-left: auto; white-space: nowrap; }

    /* ── Grilla de tarjetas ─────────────────────────────────────────────── */
    .prm-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1rem; align-items: start;
    }
    .prm-card {
        background: #fff; border-radius: 13px; border: 1.5px solid #ede5df;
        box-shadow: 0 2px 10px rgba(44, 29, 13, .05);
        display: flex; flex-direction: column; overflow: hidden;
        transition: box-shadow .2s, transform .15s, border-color .2s;
    }
    .prm-card:hover {
        box-shadow: 0 8px 24px rgba(44, 29, 13, .1);
        transform: translateY(-2px); border-color: #e0d5cc;
    }
    .prm-card.inactiva { background: #fdfcfb; }
    .prm-card.inactiva .prm-card-body { opacity: .72; }
    .prm-card.saliendo { opacity: 0; transform: scale(.97); transition: opacity .22s, transform .22s; }

    .prm-card-body { padding: 1.05rem 1.15rem; flex: 1; }

    .prm-card-top {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: .6rem; margin-bottom: .5rem;
    }
    .prm-card-nombre {
        font-size: 1.02rem; font-weight: 800; color: var(--color-secundario);
        margin: 0; line-height: 1.25; min-width: 0;
    }
    .prm-card-desc {
        font-size: .8rem; color: #a89080; margin: 0 0 .8rem; line-height: 1.4;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    .badge {
        display: inline-flex; align-items: center; padding: .22rem .6rem;
        border-radius: 20px; font-size: .7rem; font-weight: 800; flex-shrink: 0;
        text-transform: uppercase; letter-spacing: .3px;
    }
    .badge.vigente  { background: rgba(34, 197, 94, .13); color: #16a34a; }
    .badge.vencida  { background: rgba(239, 68, 68, .10); color: #dc2626; }
    .badge.inactiva { background: rgba(156, 163, 175, .2); color: #6b7280; }
    .badge.proxima  { background: rgba(234, 179, 8, .15); color: #b45309; }

    /* Precio */
    .prm-precio-row {
        display: flex; align-items: baseline; gap: .55rem;
        flex-wrap: wrap; margin-bottom: .75rem;
    }
    .prm-precio {
        font-size: 1.5rem; font-weight: 800; color: var(--color-primario);
        line-height: 1; font-variant-numeric: tabular-nums;
    }
    .prm-antes { font-size: .82rem; color: #a89080; text-decoration: line-through; }
    .prm-ahorro {
        font-size: .72rem; font-weight: 800; padding: .16rem .5rem; border-radius: 20px;
        background: rgba(34, 197, 94, .13); color: #16a34a;
    }
    .prm-ahorro.malo { background: rgba(239, 68, 68, .1); color: #dc2626; }

    /* Metadatos */
    .prm-metas { display: flex; flex-direction: column; gap: .3rem; margin-bottom: .8rem; }
    .prm-meta {
        display: flex; align-items: center; gap: .4rem;
        font-size: .78rem; color: #7a6050;
    }
    .prm-meta svg { width: 14px; height: 14px; fill: #c9b8a8; flex-shrink: 0; }

    /* Contenido */
    .prm-contenido { display: flex; flex-wrap: wrap; gap: .3rem; }
    .prm-chip {
        display: inline-flex; align-items: center;
        font-size: .72rem; font-weight: 700; padding: .2rem .55rem;
        border-radius: 6px; background: #f5f0eb; color: #7a6050;
        max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .prm-chip.grupo { background: rgba(99, 102, 241, .1); color: #4f46e5; }
    .prm-chip.mas   { background: transparent; color: #a89080; }
    .prm-sin-contenido {
        display: flex; align-items: center; gap: .4rem;
        font-size: .76rem; font-weight: 700; color: #b45309;
        background: rgba(234, 179, 8, .1); border-radius: 8px; padding: .4rem .6rem;
    }
    .prm-sin-contenido svg { width: 14px; height: 14px; fill: currentColor; flex-shrink: 0; }

    /* Pie de tarjeta */
    .prm-card-foot {
        display: flex; align-items: center; gap: .4rem;
        padding: .7rem 1.15rem; border-top: 1px solid #f0ebe5; background: #fdfcfb;
    }
    .prm-btn-editar {
        display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
        flex: 1; padding: .5rem .9rem; border-radius: 8px; border: none;
        background: rgba(231, 111, 46, .1); color: var(--color-primario);
        font-size: .84rem; font-weight: 700; text-decoration: none;
        transition: background .15s;
    }
    .prm-btn-editar svg { width: 15px; height: 15px; fill: currentColor; }
    .prm-btn-editar:hover { background: var(--color-primario); color: #fff; }

    .icon-btn {
        width: 34px; height: 34px; border-radius: 8px; border: none; flex-shrink: 0;
        background: #f5f0eb; color: #7a6050; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: background .15s, color .15s;
    }
    .icon-btn svg { width: 16px; height: 16px; fill: currentColor; }
    .icon-btn:hover { background: #e8ddd4; color: var(--color-secundario); }
    .icon-btn.del:hover { background: rgba(239, 68, 68, .12); color: #dc2626; }
    .icon-btn.on  { background: rgba(34, 197, 94, .12); color: #16a34a; }
    .icon-btn.on:hover  { background: rgba(34, 197, 94, .22); color: #16a34a; }

    /* ── Estados vacíos ─────────────────────────────────────────────────── */
    .empty-page {
        text-align: center; padding: 3.5rem 1rem; background: #fff;
        border-radius: 14px; border: 1.5px dashed #ede5df; color: #a89080;
    }
    .empty-page svg { width: 56px; height: 56px; fill: #ddd0c4; margin-bottom: .75rem; }
    .empty-page h3 {
        font-size: 1.05rem; color: var(--color-secundario); font-weight: 800; margin: 0 0 .35rem;
    }
    .empty-page p { font-size: .88rem; margin: 0 0 1.15rem; }
    .empty-page .btn-nuevo { margin: 0 auto; }
    #sinResultados { display: none; }

    /* ── Modal ──────────────────────────────────────────────────────────── */
    .m-overlay {
        display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, .5);
        z-index: 600; align-items: flex-start; justify-content: center;
        overflow-y: auto; padding: 2rem 1rem;
    }
    .m-overlay.open { display: flex; animation: fadeOverlay .2s ease; }
    @@keyframes fadeOverlay { from { opacity: 0; } to { opacity: 1; } }
    .m-box {
        background: #fff; border-radius: 16px; width: 100%; max-width: 920px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .2);
        animation: slideModal .25s ease; margin: auto; overflow: hidden;
    }
    @@keyframes slideModal { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    .m-spinner {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 4rem 2rem; gap: 1rem; color: #a89080;
    }
    .spinner-ring {
        width: 40px; height: 40px; border: 3px solid #f0ebe5;
        border-top-color: var(--color-primario); border-radius: 50%;
        animation: spin .7s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .m-confirm { padding: 2.2rem 2rem; max-width: 440px; margin: auto; text-align: center; }
    .m-confirm-icon {
        width: 58px; height: 58px; border-radius: 50%; margin: 0 auto 1rem;
        background: rgba(239, 68, 68, .1);
        display: flex; align-items: center; justify-content: center;
    }
    .m-confirm-icon svg { width: 28px; height: 28px; fill: #dc2626; }
    .m-confirm h3 { font-size: 1.05rem; font-weight: 800; color: var(--color-secundario); margin: 0 0 .5rem; }
    .m-confirm p  { font-size: .88rem; color: #7a6050; margin: 0 0 .5rem; }
    .m-confirm .aviso {
        font-size: .78rem; color: #dc2626; background: #fef2f2;
        padding: .5rem .75rem; border-radius: 8px; margin-bottom: 1.25rem;
    }
    .m-confirm-actions { display: flex; gap: .7rem; justify-content: center; margin-top: 1.25rem; }
    .m-confirm-actions button {
        padding: .6rem 1.35rem; border: none; border-radius: 8px;
        font-size: .88rem; font-weight: 700; cursor: pointer; transition: background .15s;
    }
    .btn-cancelar { background: #f0ebe5; color: var(--color-secundario); }
    .btn-cancelar:hover { background: #e5dad0; }
    .btn-eliminar { background: #dc2626; color: #fff; }
    .btn-eliminar:hover { background: #b91c1c; }

    /* ── Toast ──────────────────────────────────────────────────────────── */
    .toast-wrap {
        position: fixed; top: 1.25rem; right: 1.25rem; z-index: 9999;
        display: flex; flex-direction: column; gap: .5rem; pointer-events: none;
    }
    .toast-msg {
        display: flex; align-items: center; gap: .6rem;
        padding: .75rem 1.1rem; border-radius: 10px;
        font-size: .88rem; font-weight: 600;
        box-shadow: 0 4px 16px rgba(0, 0, 0, .12);
        animation: toastIn .3s ease; transition: opacity .25s;
    }
    .toast-msg svg { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; }
    .toast-msg.exito { background: #f0fdf4; color: #16a34a; border-left: 4px solid #16a34a; }
    .toast-msg.error { background: #fef2f2; color: #dc2626; border-left: 4px solid #dc2626; }
    @@keyframes toastIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }

    @@media (max-width: 700px) {
        .prm-grid { grid-template-columns: 1fr; }
        .prm-search { max-width: none; }
        .prm-conteo { margin-left: 0; }
        .btn-nuevo { width: 100%; justify-content: center; }
        .toast-wrap { top: .75rem; right: .75rem; left: .75rem; }
    }
</style>

<div class="toast-wrap" id="toastWrap"></div>
@Html.AntiForgeryToken()

<div class="m-overlay" id="modalOverlay">
    <div class="m-box" id="modalBox">
        <div id="modalBody">
            <div class="m-spinner"><div class="spinner-ring"></div><span>Cargando…</span></div>
        </div>
    </div>
</div>

<!-- ── Cabecera ── -->
<div class="page-header-card">
    <div class="page-header-left">
        <div class="page-header-icon">
            <svg viewBox="0 0 24 24"><path d="M12.79 2.7 20.3 10.2a2 2 0 0 1 0 2.83l-6.36 6.36a2 2 0 0 1-2.83 0L3.6 11.9a2 2 0 0 1-.59-1.41V4a2 2 0 0 1 2-2h6.37a2 2 0 0 1 1.41.59zM7 7a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/></svg>
        </div>
        <div>
            <h1 class="page-header-title">Gestión de Promociones</h1>
            <p class="page-header-sub">Combos y promociones disponibles al momento de vender</p>
        </div>
    </div>
    <button class="btn-nuevo" onclick="abrirModal('/Productos/Promociones/ModalCrear')">
        <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        Nueva promoción
    </button>
</div>

@if (promos.Count == 0)
{
    <div class="empty-page">
        <svg viewBox="0 0 24 24"><path d="M12.79 2.7 20.3 10.2a2 2 0 0 1 0 2.83l-6.36 6.36a2 2 0 0 1-2.83 0L3.6 11.9a2 2 0 0 1-.59-1.41V4a2 2 0 0 1 2-2h6.37a2 2 0 0 1 1.41.59zM7 7a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/></svg>
        <h3>Todavía no hay promociones</h3>
        <p>Crea la primera para empezar a ofrecer combos en caja.</p>
        <button class="btn-nuevo" onclick="abrirModal('/Productos/Promociones/ModalCrear')">
            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            Crear primera promoción
        </button>
    </div>
}
else
{
    <!-- ── Barra de herramientas ── -->
    <div class="prm-toolbar">
        <div class="prm-search">
            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <input type="text" id="buscador" autocomplete="off"
                   placeholder="Buscar por nombre, grupo o producto incluido…" oninput="aplicarFiltros()" />
        </div>

        <div class="prm-filtros" id="filtros">
            <button class="prm-filtro active" data-filtro="todas" onclick="seleccionarFiltro(this)">
                Todas <span class="prm-filtro-n">@promos.Count</span>
            </button>
            <button class="prm-filtro" data-filtro="vigente" onclick="seleccionarFiltro(this)">
                Vigentes <span class="prm-filtro-n">@Conteo("vigente")</span>
            </button>
            <button class="prm-filtro" data-filtro="proxima" onclick="seleccionarFiltro(this)">
                Próximas <span class="prm-filtro-n">@Conteo("proxima")</span>
            </button>
            <button class="prm-filtro" data-filtro="vencida" onclick="seleccionarFiltro(this)">
                Vencidas <span class="prm-filtro-n">@Conteo("vencida")</span>
            </button>
            <button class="prm-filtro" data-filtro="inactiva" onclick="seleccionarFiltro(this)">
                Inactivas <span class="prm-filtro-n">@Conteo("inactiva")</span>
            </button>
        </div>

        <select class="prm-orden" id="orden" onchange="ordenarPromos()">
            <option value="recientes">Más recientes</option>
            <option value="nombre">Nombre (A–Z)</option>
            <option value="precio-asc">Precio (menor a mayor)</option>
            <option value="precio-desc">Precio (mayor a menor)</option>
        </select>

        <span class="prm-conteo" id="conteo"></span>
    </div>

    <!-- ── Tarjetas ── -->
    <div class="prm-grid" id="grid">
        @foreach (var p in promos)
        {
            var clave      = PromocionesController.EstadoClave(p);
            var texto      = PromocionesController.EstadoTexto(p);
            var (nMin, _)  = PromocionesController.PrecioNormal(p);
            var baseItems  = p.ProPromocionDetalle.Where(d => d.IdGrupo == null)
                                                  .OrderBy(d => d.IdProductoNavigation.NombreProducto)
                                                  .ToList();
            var grupos     = p.ProPromocionGrupo.ToList();
            var ahorro     = nMin - p.PrecioPromocion;
            var pct        = nMin > 0 ? (int)Math.Round(ahorro * 100.0 / nMin) : 0;
            var fechaFin   = p.FechaFin?.ToString("dd/MM/yyyy") ?? "sin límite";

            var piezas = new List<(string Texto, bool EsGrupo)>();
            foreach (var d in baseItems)
            {
                piezas.Add(($"{d.Cantidad}× {d.IdProductoNavigation.NombreProducto}", false));
            }
            foreach (var g in grupos)
            {
                var n = p.ProPromocionDetalle.Count(d => d.IdGrupo == g.IdGrupo);
                piezas.Add(($"{(g.EsExcluyente ? "Elige 1" : "Todos")} · {g.Descripcion} ({n})", true));
            }
            var visibles  = piezas.Take(4).ToList();
            var restantes = piezas.Count - visibles.Count;

            var textoBusqueda = string.Join(' ',
                new[] { p.Nombre, p.Descripcion ?? "" }
                    .Concat(p.ProPromocionDetalle.Select(d => d.IdProductoNavigation.NombreProducto))
                    .Concat(grupos.Select(g => g.Descripcion))).ToLowerInvariant();

            <div class="prm-card @(p.Estado ? "" : "inactiva")" id="card-@p.IdPromocion"
                 data-estado="@clave" data-buscar="@textoBusqueda"
                 data-nombre="@p.Nombre" data-precio="@p.PrecioPromocion">

                <div class="prm-card-body">
                    <div class="prm-card-top">
                        <h3 class="prm-card-nombre">@p.Nombre</h3>
                        <span class="badge @clave">@texto</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(p.Descripcion))
                    {
                        <p class="prm-card-desc">@p.Descripcion</p>
                    }

                    <div class="prm-precio-row">
                        <span class="prm-precio">@($"${p.PrecioPromocion:N0}")</span>
                        @if (nMin > 0 && ahorro > 0)
                        {
                            <span class="prm-antes">@($"${nMin:N0}")</span>
                            <span class="prm-ahorro">−@pct%</span>
                        }
                        else if (nMin > 0 && ahorro < 0)
                        {
                            <span class="prm-ahorro malo">Más cara que por separado</span>
                        }
                    </div>

                    <div class="prm-metas">
                        <span class="prm-meta">
                            <svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 16H5V9h14v10z"/></svg>
                            @p.FechaInicio.ToString("dd/MM/yyyy") → @fechaFin
                        </span>
                        <span class="prm-meta">
                            <svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                            @p.ProPromocionDetalle.Count producto(s) · @grupos.Count grupo(s)
                        </span>
                    </div>

                    @if (piezas.Count == 0)
                    {
                        <div class="prm-sin-contenido">
                            <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                            Sin productos: no se ofrecerá en caja
                        </div>
                    }
                    else
                    {
                        <div class="prm-contenido">
                            @foreach (var pieza in visibles)
                            {
                                <span class="prm-chip @(pieza.EsGrupo ? "grupo" : "")" title="@pieza.Texto">@pieza.Texto</span>
                            }
                            @if (restantes > 0)
                            {
                                <span class="prm-chip mas">+@restantes más</span>
                            }
                        </div>
                    }
                </div>

                <div class="prm-card-foot">
                    <a class="prm-btn-editar" href="/Productos/Promociones/Editar/@p.IdPromocion">
                        <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                        Editar promoción
                    </a>
                    <button class="icon-btn @(p.Estado ? "on" : "")" id="btnToggle-@p.IdPromocion"
                            title="@(p.Estado ? "Desactivar" : "Activar")"
                            onclick="toggleEstado(@p.IdPromocion)">
                        @if (p.Estado)
                        {
                            <svg viewBox="0 0 24 24"><path d="M17 7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h10c2.76 0 5-2.24 5-5s-2.24-5-5-5zm0 8c-1.66 0-3-1.35-3-3s1.34-3 3-3 3 1.35 3 3-1.34 3-3 3z"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24"><path d="M17 7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h10c2.76 0 5-2.24 5-5s-2.24-5-5-5zm-10 8c-1.65 0-3-1.35-3-3s1.35-3 3-3 3 1.35 3 3-1.35 3-3 3z"/></svg>
                        }
                    </button>
                    <button class="icon-btn del" title="Eliminar promoción"
                            onclick="eliminarPromo(@p.IdPromocion)">
                        <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="empty-page" id="sinResultados">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        <h3>Sin resultados</h3>
        <p>Ninguna promoción coincide con la búsqueda o el filtro aplicado.</p>
    </div>
}

@section Scripts {
<script>
(function () {
    const overlay = document.getElementById('modalOverlay');
    const csrf = () => document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';

    /* ══ Utilidades ══════════════════════════════════════════════════════ */
    function esc(s) {
        return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;')
                              .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function toast(msg, tipo) {
        const iconos = {
            exito: '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>',
            error: '<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>'
        };
        const t = document.createElement('div');
        t.className = `toast-msg ${tipo}`;
        t.innerHTML = `${iconos[tipo]}<span>${esc(msg)}</span>`;
        document.getElementById('toastWrap').appendChild(t);
        setTimeout(() => t.style.opacity = '0', 3500);
        setTimeout(() => t.remove(), 3800);
    }

    /* ══ Modal ═══════════════════════════════════════════════════════════ */
    function setHtmlConScripts(el, html) {
        el.innerHTML = html;
        el.querySelectorAll('script').forEach(s => {
            const n = document.createElement('script');
            n.textContent = s.textContent;
            s.replaceWith(n);
        });
    }

    async function abrirModal(url) {
        overlay.classList.add('open');
        document.getElementById('modalBody').innerHTML =
            '<div class="m-spinner"><div class="spinner-ring"></div><span>Cargando…</span></div>';
        try {
            const r = await fetch(url);
            if (!r.ok) throw new Error();
            setHtmlConScripts(document.getElementById('modalBody'), await r.text());
        } catch {
            cerrarModal();
            toast('No se pudo cargar el contenido.', 'error');
        }
    }

    function cerrarModal() {
        overlay.classList.remove('open');
        setTimeout(() => { document.getElementById('modalBody').innerHTML = ''; }, 250);
    }

    overlay.addEventListener('click', e => { if (e.target === overlay) cerrarModal(); });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && overlay.classList.contains('open')) cerrarModal();
    });

    /* ══ Crear promoción ═════════════════════════════════════════════════ */
    /* Al crearla se abre su vista de edición: una promo sin productos no sirve. */
    async function submitCrearPromo(formId) {
        const form = document.getElementById(formId);
        if (!form) return;
        const btn = form.querySelector('[type=submit]') ??
                    document.querySelector('.btn-guardar');
        const etiquetaBtn = btn?.textContent;
        if (btn) { btn.disabled = true; btn.textContent = 'Guardando…'; }

        document.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
        document.querySelectorAll('.field-error').forEach(el => el.textContent = '');

        try {
            const r    = await fetch(form.action, { method: 'POST', body: new FormData(form) });
            const data = await r.json();
            if (data.ok) {
                sessionStorage.setItem('promoFlash', data.mensaje);
                location.href = `/Productos/Promociones/Editar/${data.idPromocion}`;
                return;
            }
            Object.entries(data.errores ?? {}).forEach(([campo, msg]) => {
                const input = document.querySelector(`[name="${campo}"]`);
                if (!input) return;
                input.classList.add('input-error');
                let span = input.parentElement.querySelector('.field-error');
                if (!span) { span = document.createElement('span'); span.className = 'field-error'; input.after(span); }
                span.textContent = msg;
            });
            if (data.mensaje) toast(data.mensaje, 'error');
        } catch {
            toast('Error de conexión.', 'error');
        } finally {
            if (btn) { btn.disabled = false; btn.textContent = etiquetaBtn; }
        }
    }

    /* ══ Estado / eliminación ════════════════════════════════════════════ */
    const ICONO_ACTIVA   = '<svg viewBox="0 0 24 24"><path d="M17 7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h10c2.76 0 5-2.24 5-5s-2.24-5-5-5zm0 8c-1.66 0-3-1.35-3-3s1.34-3 3-3 3 1.35 3 3-1.34 3-3 3z"/></svg>';
    const ICONO_INACTIVA = '<svg viewBox="0 0 24 24"><path d="M17 7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h10c2.76 0 5-2.24 5-5s-2.24-5-5-5zm-10 8c-1.65 0-3-1.35-3-3s1.35-3 3-3 3 1.35 3 3-1.35 3-3 3z"/></svg>';

    async function toggleEstado(id) {
        try {
            const r = await fetch(`/Productos/Promociones/ToggleEstadoAjax/${id}`,
                { method: 'POST', headers: { 'RequestVerificationToken': csrf() } });
            const data = await r.json();
            if (!data.ok) { toast(data.mensaje, 'error'); return; }
            toast(data.mensaje, 'exito');

            const card = document.getElementById(`card-${id}`);
            if (card) {
                card.dataset.estado = data.estadoClave;
                card.classList.toggle('inactiva', !data.estado);

                const badge = card.querySelector('.badge');
                if (badge) {
                    badge.textContent = data.estadoTexto;
                    badge.className   = 'badge ' + data.estadoClave;
                }
                const btn = document.getElementById(`btnToggle-${id}`);
                if (btn) {
                    btn.innerHTML = data.estado ? ICONO_ACTIVA : ICONO_INACTIVA;
                    btn.title     = data.estado ? 'Desactivar' : 'Activar';
                    btn.classList.toggle('on', data.estado);
                }
            }
            actualizarContadores();
            aplicarFiltros();
        } catch { toast('No se pudo cambiar el estado.', 'error'); }
    }

    /** Recalcula los números de cada chip de filtro a partir de las tarjetas presentes. */
    function actualizarContadores() {
        const cards = Array.from(document.querySelectorAll('.prm-card'));
        document.querySelectorAll('.prm-filtro').forEach(btn => {
            const clave = btn.dataset.filtro;
            const n = clave === 'todas'
                ? cards.length
                : cards.filter(c => c.dataset.estado === clave).length;
            const span = btn.querySelector('.prm-filtro-n');
            if (span) span.textContent = n;
        });
    }

    function eliminarPromo(id) {
        const nombre = document.getElementById(`card-${id}`)?.dataset.nombre ?? '';
        overlay.classList.add('open');
        setHtmlConScripts(document.getElementById('modalBody'), `
            <div class="m-confirm">
                <div class="m-confirm-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 2L1 21h22L12 2zm0 6l7.53 13H4.47L12 8zm-1 4v3h2v-3h-2zm0 5v2h2v-2h-2z"/></svg>
                </div>
                <h3>¿Eliminar la promoción?</h3>
                <p>Vas a eliminar <strong>«${esc(nombre)}»</strong> de forma permanente.</p>
                <p class="aviso">Se quitarán también sus grupos y todos los productos asociados.</p>
                <div class="m-confirm-actions">
                    <button class="btn-cancelar" id="cfNo">Cancelar</button>
                    <button class="btn-eliminar" id="cfSi">Sí, eliminar</button>
                </div>
            </div>`);
        document.getElementById('cfNo').onclick = cerrarModal;
        document.getElementById('cfSi').onclick = () => ejecutarEliminar(id);
    }

    async function ejecutarEliminar(id) {
        cerrarModal();
        try {
            const r = await fetch(`/Productos/Promociones/EliminarAjax/${id}`,
                { method: 'POST', headers: { 'RequestVerificationToken': csrf() } });
            const data = await r.json();
            toast(data.mensaje, data.ok ? 'exito' : 'error');
            if (!data.ok) return;

            const card = document.getElementById(`card-${id}`);
            if (card) {
                card.classList.add('saliendo');
                setTimeout(() => {
                    card.remove();
                    actualizarContadores();
                    aplicarFiltros();
                }, 220);
            }
        } catch { toast('No se pudo eliminar la promoción.', 'error'); }
    }

    /* ══ Filtros, búsqueda y orden ═══════════════════════════════════════ */
    let filtroActivo = 'todas';

    function seleccionarFiltro(btn) {
        document.querySelectorAll('.prm-filtro').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filtroActivo = btn.dataset.filtro;
        aplicarFiltros();
    }

    function aplicarFiltros() {
        const q     = (document.getElementById('buscador')?.value ?? '').toLowerCase().trim();
        const cards = document.querySelectorAll('.prm-card');

        let visibles = 0;
        cards.forEach(c => {
            const pasaTexto  = !q || (c.dataset.buscar ?? '').includes(q);
            const pasaEstado = filtroActivo === 'todas' || c.dataset.estado === filtroActivo;
            const visible    = pasaTexto && pasaEstado;
            c.style.display = visible ? '' : 'none';
            if (visible) visibles++;
        });

        const conteo = document.getElementById('conteo');
        if (conteo) {
            conteo.textContent = visibles === cards.length
                ? `${cards.length} promoción(es)`
                : `${visibles} de ${cards.length} promoción(es)`;
        }

        const vacio = document.getElementById('sinResultados');
        if (vacio) vacio.style.display = (visibles === 0 && cards.length > 0) ? 'block' : 'none';
    }

    function ordenarPromos() {
        const grid  = document.getElementById('grid');
        if (!grid) return;
        const modo  = document.getElementById('orden').value;
        const cards = Array.from(grid.querySelectorAll('.prm-card'));

        // «recientes» es el orden con que el servidor entregó las tarjetas
        if (modo !== 'recientes') {
            cards.sort((a, b) => {
                if (modo === 'nombre') {
                    return (a.dataset.nombre ?? '').localeCompare(b.dataset.nombre ?? '', 'es');
                }
                const pa = Number(a.dataset.precio) || 0;
                const pb = Number(b.dataset.precio) || 0;
                return modo === 'precio-asc' ? pa - pb : pb - pa;
            });
        } else {
            cards.sort((a, b) => Number(a.dataset.orden) - Number(b.dataset.orden));
        }
        cards.forEach(c => grid.appendChild(c));
    }

    /* ══ Exponer para los onclick del markup y el modal de creación ══════ */
    window.abrirModal        = abrirModal;
    window.cerrarModal       = cerrarModal;
    window.submitCrearPromo  = submitCrearPromo;
    window.toggleEstado      = toggleEstado;
    window.eliminarPromo     = eliminarPromo;
    window.seleccionarFiltro = seleccionarFiltro;
    window.aplicarFiltros    = aplicarFiltros;
    window.ordenarPromos     = ordenarPromos;
    window.toast             = toast;

    /* ══ Init ════════════════════════════════════════════════════════════ */
    // Conserva el orden original para poder volver a «Más recientes»
    document.querySelectorAll('.prm-card').forEach((c, i) => c.dataset.orden = i);

    const flash = sessionStorage.getItem('promoFlash');
    if (flash) { sessionStorage.removeItem('promoFlash'); toast(flash, 'exito'); }

    aplicarFiltros();
})();
</script>
}
