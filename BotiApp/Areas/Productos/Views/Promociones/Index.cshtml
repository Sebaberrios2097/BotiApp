    <div class="prm-section prm-base-section">
      <div class="prm-section-head">
        <div class="prm-section-title">
          <svg viewBox="0 0 24 24"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L21 8l-9 9z"/></svg>
          Productos base
          <span class="prm-section-count">0</span>
        </div>
        <div class="prm-section-actions">
          <button class="btn-section primary edit-only" onclick="abrirModalBuscar(${p.idPromocion},null)">
            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            Agregar producto
          </button>
        </div>
      </div>
      <div class="prm-grupo-items" id="base-${p.idPromocion}">
        <div class="prm-empty">Aún no agregaste productos base. Pulsa <strong>Editar</strong> y luego «+ Agregar producto».</div>
      </div>
    </div>
  </div>
</div>`;

        const list = document.getElementById('promoList');
        list.insertAdjacentHTML('afterbegin', html);
    }

    // ── Errores / Toast / Utils ─────────────────────────────────────────────
    function mostrarErrores(errores) {
        Object.entries(errores).forEach(([campo, msg]) => {
            const input = document.querySelector(`[name="${campo}"]`);
            if (!input) return;
            input.classList.add('input-error');
            let span = input.parentElement.querySelector('.field-error');
            if (!span) { span = document.createElement('span'); span.className = 'field-error'; input.after(span); }
            span.textContent = msg;
        });
    }
    function limpiarErrores() {
        document.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
        document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
    }

    function toast(msg, tipo) {
        const iconos = {
            exito: '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>',
            error: '<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>'
        };
        const w = document.getElementById('toastWrap');
        const t = document.createElement('div');
        t.className = `toast-msg ${tipo}`;
        t.innerHTML = `${iconos[tipo]}<span>${msg}</span>`;
        w.appendChild(t);
        setTimeout(() => t.style.opacity = '0', 3500);
        setTimeout(() => t.remove(), 3800);
    }

    function esc(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Editar nombre de grupo ────────────────────────────────────────────────
    function editarNombreGrupo(idGrupo) {
        const grupo = document.getElementById(`grupo-${idGrupo}`);
        if (!grupo) return;
        const name   = document.getElementById(`grupoName-${idGrupo}`);
        const form   = document.getElementById(`grupoEditForm-${idGrupo}`);
        const input  = document.getElementById(`grupoEditInput-${idGrupo}`);
        if (!name || !form || !input) return;
        name.style.display = 'none';
        form.classList.add('visible');
        input.focus();
        input.select();
    }

    function cancelarEditarGrupo(idGrupo) {
        const name = document.getElementById(`grupoName-${idGrupo}`);
        const form = document.getElementById(`grupoEditForm-${idGrupo}`);
        if (!name || !form) return;
        name.style.display = '';
        form.classList.remove('visible');
    }

    async function guardarNombreGrupo(idGrupo) {
        const input  = document.getElementById(`grupoEditInput-${idGrupo}`);
        const chk    = document.getElementById(`grupoEditExcl-${idGrupo}`);
        if (!input) return;
        const desc = input.value.trim();
        if (!desc) { input.focus(); return; }

        const fd = new FormData();
        fd.append('idGrupo',     idGrupo);
        fd.append('descripcion', desc);
        fd.append('esExcluyente', chk?.checked ?? false);

        try {
            const r    = await fetch('/Productos/Promociones/RenombrarGrupoAjax',
                { method: 'POST', headers: { 'RequestVerificationToken': csrf() }, body: fd });
            const data = await r.json();
            if (data.ok) {
                toast(data.mensaje, 'exito');
                // Actualizar DOM
                const nameEl = document.querySelector(`#grupoName-${idGrupo} .prm-grupo-name-text`);
                if (nameEl) nameEl.textContent = data.grupo.descripcion;
                const tagEl  = document.getElementById(`grupoTag-${idGrupo}`);
                if (tagEl) {
                    tagEl.textContent = data.grupo.esExcluyente ? 'Excluyente' : 'Libre';
                    tagEl.className  = 'prm-grupo-tag ' + (data.grupo.esExcluyente ? 'excl' : 'libre');
                }
                const addBtn = document.querySelector(`#grupo-${idGrupo} .prm-add-here`);
                if (addBtn) {
                    addBtn.lastChild.textContent = ` Agregar producto a «${data.grupo.descripcion}»`;
                }
                // Actualizar data-nombre en botones de acción
                const grupo = document.getElementById(`grupo-${idGrupo}`);
                if (grupo) {
                    grupo.querySelectorAll('[onclick*="confirmarEliminarGrupo"]').forEach(b => {
                        b.setAttribute('onclick',
                            `confirmarEliminarGrupo(${idGrupo},'${esc(data.grupo.descripcion).replace(/'/g,"\\'")}')`);
                    });
                }
                cancelarEditarGrupo(idGrupo);
            } else {
                toast(data.mensaje, 'error');
            }
        } catch { toast('Error al renombrar el grupo.', 'error'); }
    }

    // ── Init ─────────────────────────────────────────────────────────────────
    aplicarFiltros();

    // Export interactive functions to window
    window.abrirModal = abrirModal;
    window.cerrarModal = cerrarModal;
    window.submitCrearPromo = submitCrearPromo;
    window.toggleEstado = toggleEstado;
    window.toggleModoEdicion = toggleModoEdicion;
    window.toggleCard = toggleCard;
    window.mostrarFormGrupo = mostrarFormGrupo;
    window.ocultarFormGrupo = ocultarFormGrupo;
    window.crearGrupo = crearGrupo;
    window.confirmarEliminarGrupo = confirmarEliminarGrupo;
    window.ejecutarEliminarGrupo = ejecutarEliminarGrupo;
    window.confirmarQuitarProducto = confirmarQuitarProducto;
    window.ejecutarQuitarProducto = ejecutarQuitarProducto;
    window.abrirModalBuscar = abrirModalBuscar;
    window.ejecutarAgregarProducto = ejecutarAgregarProducto;
    window.agregarFilaProducto = agregarFilaProducto;
    window.agregarGrupoEnCard = agregarGrupoEnCard;
    window.confirmarEliminarPromo = confirmarEliminarPromo;
    window.ejecutarEliminarPromo = ejecutarEliminarPromo;
    window.editarNombreGrupo = editarNombreGrupo;
    window.cancelarEditarGrupo = cancelarEditarGrupo;
    window.guardarNombreGrupo = guardarNombreGrupo;
    window.aplicarFiltros = aplicarFiltros;
    window.toast = toast;
    window.esc = esc;
})();
</script>
}
