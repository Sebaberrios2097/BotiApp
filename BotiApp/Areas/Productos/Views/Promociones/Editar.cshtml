@model Infraestructura.Entities.BotiApp.ProPromocion
@{
    ViewData["Title"] = $"Editar — {Model.Nombre}";
    var estadoClave = PromocionesController.EstadoClave(Model);
    var estadoTexto = PromocionesController.EstadoTexto(Model);
}

<style>
    .ed-page { max-width: 1220px; margin: 0 auto; }

    /* ── Volver ─────────────────────────────────────────────────────────── */
    .ed-back {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .85rem; font-weight: 700; color: var(--color-primario);
        text-decoration: none; padding: .4rem .75rem; border-radius: 8px;
        background: rgba(231, 111, 46, .08); border: none; cursor: pointer;
        transition: background .15s; margin-bottom: 1rem;
    }
    .ed-back:hover { background: rgba(231, 111, 46, .18); }
    .ed-back svg { width: 16px; height: 16px; fill: currentColor; }

    /* ── Cabecera ───────────────────────────────────────────────────────── */
    .ed-header {
        background: #fff; border-radius: 14px; box-shadow: 0 2px 12px rgba(44, 29, 13, .08);
        padding: 1.15rem 1.4rem; margin-bottom: 1.25rem;
        display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    }
    .ed-header-icon {
        width: 48px; height: 48px; border-radius: 12px; flex-shrink: 0;
        background: rgba(231, 111, 46, .12);
        display: flex; align-items: center; justify-content: center;
    }
    .ed-header-icon svg { width: 25px; height: 25px; fill: var(--color-primario); }
    .ed-header-main { flex: 1; min-width: 220px; }
    .ed-header-top { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
    .ed-header-top h1 {
        font-size: 1.28rem; font-weight: 800; color: var(--color-secundario); margin: 0;
    }
    .ed-header-meta {
        display: flex; gap: .4rem; flex-wrap: wrap; margin-top: .4rem;
    }
    .ed-meta-chip {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: .74rem; font-weight: 700; color: #7a6050;
        background: #f5f0eb; border-radius: 20px; padding: .2rem .6rem;
    }
    .ed-meta-chip svg { width: 12px; height: 12px; fill: #a89080; }

    .badge {
        display: inline-flex; align-items: center; padding: .24rem .65rem;
        border-radius: 20px; font-size: .72rem; font-weight: 800;
        text-transform: uppercase; letter-spacing: .3px;
    }
    .badge.vigente  { background: rgba(34, 197, 94, .13); color: #16a34a; }
    .badge.vencida  { background: rgba(239, 68, 68, .10); color: #dc2626; }
    .badge.inactiva { background: rgba(156, 163, 175, .2); color: #6b7280; }
    .badge.proxima  { background: rgba(234, 179, 8, .15); color: #b45309; }

    /* ── Grilla principal ───────────────────────────────────────────────── */
    .ed-grid {
        display: grid; grid-template-columns: minmax(0, 1fr) 300px;
        gap: 1.15rem; align-items: start;
    }
    @@media (max-width: 1000px) { .ed-grid { grid-template-columns: 1fr; } }

    .ed-col { display: flex; flex-direction: column; gap: 1.15rem; min-width: 0; }
    .ed-aside { position: sticky; top: 1rem; }

    /* ── Cards ──────────────────────────────────────────────────────────── */
    .ed-card {
        background: #fff; border-radius: 13px; border: 1.5px solid #ede5df;
        box-shadow: 0 2px 10px rgba(44, 29, 13, .05); padding: 1.15rem 1.25rem;
    }
    .ed-card-head {
        display: flex; align-items: center; justify-content: space-between;
        gap: .75rem; flex-wrap: wrap; margin-bottom: 1rem;
    }
    .ed-card-title { display: flex; align-items: center; gap: .6rem; min-width: 0; }
    .ed-card-title > svg { width: 20px; height: 20px; fill: var(--color-primario); flex-shrink: 0; }
    .ed-card-title h2 {
        font-size: .95rem; font-weight: 800; color: var(--color-secundario); margin: 0;
    }
    .ed-card-title p { font-size: .76rem; color: #a89080; margin: .1rem 0 0; }
    .ed-count {
        background: #f0ebe5; color: #7a6050; border-radius: 20px;
        padding: .12rem .55rem; font-size: .74rem; font-weight: 800; flex-shrink: 0;
    }
    .ed-card-acciones { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }

    /* ── Formulario ─────────────────────────────────────────────────────── */
    .ed-form-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: .9rem 1.1rem;
    }
    .ed-field { display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
    .ed-field.full { grid-column: 1 / -1; }
    .ed-field label { font-size: .78rem; font-weight: 700; color: var(--color-secundario); }
    .ed-field label .req { color: var(--color-primario); }
    .ed-field label .opt { color: #a89080; font-weight: 500; }
    .ed-field input, .ed-field select, .ed-field textarea {
        width: 100%; padding: .55rem .75rem; border: 1.5px solid #e0d5cc;
        border-radius: 8px; font-size: .88rem; color: var(--color-secundario);
        background: #fff; outline: none; transition: border-color .15s, box-shadow .15s;
    }
    .ed-field textarea { resize: vertical; min-height: 62px; }
    .ed-field input:focus, .ed-field select:focus, .ed-field textarea:focus {
        border-color: var(--color-primario); box-shadow: 0 0 0 3px rgba(231, 111, 46, .12);
    }
    .ed-field input.input-error, .ed-field select.input-error { border-color: #dc2626; }
    .field-error { font-size: .74rem; color: #dc2626; min-height: 0; }

    .ed-form-footer {
        display: flex; align-items: center; justify-content: flex-end;
        gap: .6rem; flex-wrap: wrap; margin-top: 1rem;
        padding-top: .9rem; border-top: 1px solid #f0ebe5;
    }
    .ed-dirty {
        margin-right: auto; font-size: .78rem; font-weight: 700; color: #b45309;
        display: none; align-items: center; gap: .35rem;
    }
    .ed-dirty.visible { display: inline-flex; }
    .ed-dirty::before {
        content: ''; width: 7px; height: 7px; border-radius: 50%; background: #f59e0b;
    }

    /* ── Botones ────────────────────────────────────────────────────────── */
    .ed-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
        padding: .5rem .95rem; border: none; border-radius: 8px;
        font-size: .82rem; font-weight: 700; cursor: pointer;
        transition: background .15s, transform .12s, opacity .15s;
    }
    .ed-btn svg { width: 14px; height: 14px; fill: currentColor; }
    .ed-btn:disabled { opacity: .5; cursor: not-allowed; }
    .ed-btn-primary { background: var(--color-primario); color: #fff; }
    .ed-btn-primary:hover:not(:disabled) { background: #cf5f22; transform: translateY(-1px); }
    .ed-btn-ghost { background: rgba(99, 102, 241, .1); color: #4f46e5; }
    .ed-btn-ghost:hover:not(:disabled) { background: rgba(99, 102, 241, .2); }
    .ed-btn-plain { background: #f0ebe5; color: var(--color-secundario); }
    .ed-btn-plain:hover:not(:disabled) { background: #e5dad0; }
    .ed-btn-danger { background: #dc2626; color: #fff; }
    .ed-btn-danger:hover:not(:disabled) { background: #b91c1c; }
    .ed-btn-danger-soft {
        background: rgba(239, 68, 68, .09); color: #dc2626;
        border: 1.5px solid rgba(239, 68, 68, .22);
    }
    .ed-btn-danger-soft:hover:not(:disabled) { background: rgba(239, 68, 68, .18); }

    .ed-icon {
        width: 30px; height: 30px; border-radius: 7px; border: none; flex-shrink: 0;
        background: #faf7f5; color: #7a6050; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        transition: background .15s, color .15s;
    }
    .ed-icon svg { width: 15px; height: 15px; fill: currentColor; }
    .ed-icon:hover { background: #ede5df; color: var(--color-secundario); }
    .ed-icon.danger:hover { background: rgba(239, 68, 68, .12); color: #dc2626; }

    /* ── Resumen de precio ──────────────────────────────────────────────── */
    .ed-precio-card { padding: 1rem 1.25rem; }
    .ed-precio-row {
        display: flex; align-items: center; justify-content: space-between;
        gap: .75rem; padding: .28rem 0;
    }
    .ed-precio-lbl { font-size: .82rem; color: #7a6050; font-weight: 600; }
    .ed-precio-val {
        font-size: .95rem; font-weight: 800; color: var(--color-secundario);
        font-variant-numeric: tabular-nums;
    }
    .ed-precio-val.destacado { color: var(--color-primario); font-size: 1.1rem; }
    .ed-precio-sep { height: 1px; background: #f0ebe5; margin: .45rem 0; }
    .ed-precio-nota { font-size: .74rem; color: #a89080; margin: .5rem 0 0; line-height: 1.4; }
    .ed-ahorro {
        display: inline-flex; align-items: center; padding: .22rem .65rem;
        border-radius: 20px; font-size: .82rem; font-weight: 800;
    }
    .ed-ahorro.bueno  { background: rgba(34, 197, 94, .13); color: #16a34a; }
    .ed-ahorro.neutro { background: #f0ebe5; color: #7a6050; }
    .ed-ahorro.malo   { background: rgba(239, 68, 68, .1); color: #dc2626; }

    /* ── Items de producto ──────────────────────────────────────────────── */
    .ed-items { display: flex; flex-direction: column; gap: .45rem; }
    .ed-item {
        display: flex; align-items: center; gap: .7rem;
        background: #fdfcfb; border: 1.5px solid #f0ebe5; border-radius: 10px;
        padding: .5rem .7rem; transition: border-color .15s, background .15s;
    }
    .ed-item:hover { border-color: #e0d5cc; background: #fff; }
    .ed-item.saliendo { opacity: 0; transform: translateX(-10px); transition: opacity .2s, transform .2s; }
    .ed-item-img {
        width: 40px; height: 40px; border-radius: 7px; flex-shrink: 0; overflow: hidden;
        background: #f5f0eb; display: flex; align-items: center; justify-content: center;
    }
    .ed-item-img img { width: 100%; height: 100%; object-fit: cover; }
    .ed-item-img svg { width: 19px; height: 19px; fill: #c9b8a8; }
    .ed-item-info { flex: 1; min-width: 0; }
    .ed-item-nombre {
        font-size: .85rem; font-weight: 700; color: var(--color-secundario);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ed-item-meta { font-size: .72rem; color: #a89080; }
    .ed-item-subtotal {
        font-size: .85rem; font-weight: 800; color: var(--color-primario);
        font-variant-numeric: tabular-nums; min-width: 68px; text-align: right; flex-shrink: 0;
    }

    .ed-qty {
        display: inline-flex; align-items: center; flex-shrink: 0;
        background: #fff; border: 1.5px solid #e0d5cc; border-radius: 7px; padding: 1px;
    }
    .ed-qty button {
        width: 24px; height: 24px; border: none; background: transparent;
        color: var(--color-secundario); font-size: .95rem; font-weight: 800;
        cursor: pointer; border-radius: 5px; line-height: 1;
    }
    .ed-qty button:hover { background: #f0ebe5; }
    .ed-qty input {
        width: 36px; height: 24px; border: none; background: transparent;
        text-align: center; font-size: .8rem; font-weight: 800;
        color: var(--color-secundario); outline: none; -moz-appearance: textfield;
    }
    .ed-qty input::-webkit-outer-spin-button,
    .ed-qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

    .ed-mover {
        flex-shrink: 0; max-width: 140px; padding: .32rem .5rem;
        border: 1.5px solid #e0d5cc; border-radius: 7px; background: #fff;
        font-size: .74rem; font-weight: 600; color: #7a6050;
        outline: none; cursor: pointer;
    }
    .ed-mover:focus { border-color: var(--color-primario); }

    @@media (max-width: 620px) {
        .ed-item { flex-wrap: wrap; }
        .ed-item-info { flex-basis: 100%; order: -1; }
        .ed-mover { max-width: 100%; flex: 1; }
    }

    /* ── Grupos ─────────────────────────────────────────────────────────── */
    .ed-grupo {
        background: #faf7f5; border: 1.5px solid #e8ddd4; border-radius: 11px;
        padding: .85rem .95rem; margin-bottom: .75rem;
    }
    .ed-grupo:last-of-type { margin-bottom: 0; }
    .ed-grupo.recien-creado { animation: edResaltar 1.8s ease; }
    @@keyframes edResaltar {
        0%, 35% { border-color: var(--color-primario); background: #fff5ee;
                  box-shadow: 0 0 0 3px rgba(231, 111, 46, .16); }
        100%    { border-color: #e8ddd4; background: #faf7f5; box-shadow: none; }
    }
    .ed-grupo-head {
        display: flex; align-items: center; gap: .5rem;
        flex-wrap: wrap; margin-bottom: .65rem;
    }
    .ed-grupo-ident { display: flex; align-items: center; gap: .5rem; flex: 1; flex-wrap: wrap; min-width: 0; }
    .ed-grupo-nombre { font-size: .88rem; font-weight: 800; color: var(--color-secundario); }
    .ed-grupo-count { font-size: .74rem; color: #a89080; font-weight: 600; }
    .ed-grupo-acciones { display: flex; gap: .3rem; flex-shrink: 0; }
    .ed-tag {
        font-size: .68rem; font-weight: 800; padding: .12rem .5rem;
        border-radius: 20px; text-transform: uppercase; letter-spacing: .3px;
    }
    .ed-tag.excl  { background: rgba(239, 68, 68, .12); color: #dc2626; }
    .ed-tag.libre { background: rgba(34, 197, 94, .14); color: #16a34a; }

    .ed-grupo-edit { display: none; align-items: center; gap: .45rem; flex-wrap: wrap; flex: 1; }
    .ed-grupo-edit.visible { display: flex; }
    .ed-grupo-edit input[type=text] {
        flex: 1; min-width: 150px; padding: .4rem .6rem;
        border: 1.5px solid #c7d2fe; border-radius: 7px;
        font-size: .84rem; background: #fff; outline: none;
    }
    .ed-grupo-edit input[type=text]:focus { border-color: #4f46e5; }

    .ed-check {
        display: inline-flex; align-items: center; gap: .35rem;
        font-size: .78rem; font-weight: 700; color: #4f46e5;
        cursor: pointer; white-space: nowrap; user-select: none;
    }
    .ed-check input { width: 15px; height: 15px; accent-color: #4f46e5; cursor: pointer; }

    .ed-grupo-form {
        display: none; align-items: center; gap: .5rem; flex-wrap: wrap;
        background: #f5f4ff; border: 1.5px solid #c7d2fe; border-radius: 10px;
        padding: .7rem .85rem; margin-bottom: .85rem;
    }
    .ed-grupo-form.visible { display: flex; }
    .ed-grupo-form input[type=text] {
        flex: 1; min-width: 190px; padding: .45rem .7rem;
        border: 1.5px solid #c7d2fe; border-radius: 7px;
        font-size: .85rem; background: #fff; outline: none;
    }
    .ed-grupo-form input[type=text]:focus { border-color: #4f46e5; }

    .ed-add-here {
        display: flex; align-items: center; justify-content: center; gap: .4rem;
        width: 100%; margin-top: .6rem; padding: .48rem;
        background: transparent; border: 1.5px dashed #d4c4b7; border-radius: 8px;
        color: #7a6050; font-size: .78rem; font-weight: 700; cursor: pointer;
        transition: border-color .15s, color .15s, background .15s;
    }
    .ed-add-here svg { width: 13px; height: 13px; fill: currentColor; }
    .ed-add-here:hover {
        border-color: var(--color-primario); color: var(--color-primario);
        background: rgba(231, 111, 46, .04);
    }

    /* ── Vacíos ─────────────────────────────────────────────────────────── */
    .ed-empty {
        text-align: center; padding: 1.6rem 1rem;
        background: #fdfcfb; border: 1.5px dashed #ede5df; border-radius: 10px;
    }
    .ed-empty svg { width: 30px; height: 30px; fill: #ddd0c4; margin-bottom: .4rem; }
    .ed-empty p { font-size: .85rem; font-weight: 700; color: #7a6050; margin: 0; }
    .ed-empty span { font-size: .78rem; color: #b8a898; }
    .ed-empty.compacta { padding: .8rem; }

    /* ── Aside ──────────────────────────────────────────────────────────── */
    .ed-help h3 {
        font-size: .82rem; font-weight: 800; color: var(--color-secundario);
        margin: 0 0 .6rem; display: flex; align-items: center; gap: .4rem;
    }
    .ed-help h3 svg { width: 16px; height: 16px; fill: #4f46e5; }
    .ed-help dl { margin: 0; font-size: .79rem; line-height: 1.5; }
    .ed-help dt { font-weight: 800; color: var(--color-secundario); margin-top: .55rem; }
    .ed-help dt:first-child { margin-top: 0; }
    .ed-help dd { margin: 0; color: #7a6050; }

    .ed-danger { border-color: rgba(239, 68, 68, .25); }
    .ed-danger h3 {
        font-size: .82rem; font-weight: 800; color: #dc2626; margin: 0 0 .35rem;
    }
    .ed-danger p { font-size: .78rem; color: #7a6050; margin: 0 0 .75rem; line-height: 1.45; }
    .ed-danger .ed-btn { width: 100%; }

    /* ── Modal ──────────────────────────────────────────────────────────── */
    .m-overlay {
        display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, .5);
        z-index: 600; align-items: flex-start; justify-content: center;
        overflow-y: auto; padding: 2rem 1rem;
    }
    .m-overlay.open { display: flex; animation: fadeOverlay .2s ease; }
    @@keyframes fadeOverlay { from { opacity: 0; } to { opacity: 1; } }
    .m-box {
        background: #fff; border-radius: 16px; width: 100%; max-width: 920px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .2);
        animation: slideModal .25s ease; margin: auto; overflow: hidden;
    }
    @@keyframes slideModal { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    .m-spinner {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 4rem 2rem; gap: 1rem; color: #a89080;
    }
    .spinner-ring {
        width: 40px; height: 40px; border: 3px solid #f0ebe5;
        border-top-color: var(--color-primario); border-radius: 50%;
        animation: spin .7s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Confirmación */
    .m-confirm { padding: 2.2rem 2rem; max-width: 440px; margin: auto; text-align: center; }
    .m-confirm-icon {
        width: 58px; height: 58px; border-radius: 50%; margin: 0 auto 1rem;
        background: rgba(239, 68, 68, .1);
        display: flex; align-items: center; justify-content: center;
    }
    .m-confirm-icon svg { width: 28px; height: 28px; fill: #dc2626; }
    .m-confirm h3 {
        font-size: 1.05rem; font-weight: 800; color: var(--color-secundario); margin: 0 0 .5rem;
    }
    .m-confirm p { font-size: .88rem; color: #7a6050; margin: 0 0 .5rem; }
    .m-confirm .aviso {
        font-size: .78rem; color: #dc2626; background: #fef2f2;
        padding: .5rem .75rem; border-radius: 8px; margin-bottom: 1.25rem;
    }
    .m-confirm-actions { display: flex; gap: .7rem; justify-content: center; margin-top: 1.25rem; }
    .m-confirm-actions .ed-btn { padding: .6rem 1.35rem; font-size: .88rem; }

    /* ── Toast ──────────────────────────────────────────────────────────── */
    .toast-wrap {
        position: fixed; top: 1.25rem; right: 1.25rem; z-index: 9999;
        display: flex; flex-direction: column; gap: .5rem; pointer-events: none;
    }
    .toast-msg {
        display: flex; align-items: center; gap: .6rem;
        padding: .75rem 1.1rem; border-radius: 10px;
        font-size: .88rem; font-weight: 600;
        box-shadow: 0 4px 16px rgba(0, 0, 0, .12);
        animation: toastIn .3s ease; transition: opacity .25s;
    }
    .toast-msg svg { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; }
    .toast-msg.exito { background: #f0fdf4; color: #16a34a; border-left: 4px solid #16a34a; }
    .toast-msg.error { background: #fef2f2; color: #dc2626; border-left: 4px solid #dc2626; }
    @@keyframes toastIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
</style>

<div class="toast-wrap" id="toastWrap"></div>
@Html.AntiForgeryToken()

<div class="m-overlay" id="modalOverlay">
    <div class="m-box" id="modalBox">
        <div id="modalBody">
            <div class="m-spinner"><div class="spinner-ring"></div><span>Cargando…</span></div>
        </div>
    </div>
</div>

<div class="ed-page" data-id-promocion="@Model.IdPromocion">

    <a class="ed-back" href="/Productos/Promociones" onclick="return volverAlListado(event);">
        <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
        Volver a promociones
    </a>

    <!-- ── Cabecera ── -->
    <div class="ed-header">
        <div class="ed-header-icon">
            <svg viewBox="0 0 24 24"><path d="M12.79 2.7 20.3 10.2a2 2 0 0 1 0 2.83l-6.36 6.36a2 2 0 0 1-2.83 0L3.6 11.9a2 2 0 0 1-.59-1.41V4a2 2 0 0 1 2-2h6.37a2 2 0 0 1 1.41.59zM7 7a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/></svg>
        </div>
        <div class="ed-header-main">
            <div class="ed-header-top">
                <h1 id="edTitulo">@Model.Nombre</h1>
                <span class="badge @estadoClave" id="edBadge">@estadoTexto</span>
            </div>
            <div class="ed-header-meta" id="edHeaderMeta">
                <span class="ed-meta-chip">
                    <svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                    <span id="edChipProductos"></span>
                </span>
                <span class="ed-meta-chip">
                    <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                    <span id="edChipGrupos"></span>
                </span>
                <span class="ed-meta-chip">ID @Model.IdPromocion</span>
            </div>
        </div>
    </div>

    <div class="ed-grid">
        <!-- ── Columna principal ── -->
        <div class="ed-col">

            <!-- Datos de la promoción -->
            <div class="ed-card">
                <div class="ed-card-head">
                    <div class="ed-card-title">
                        <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                        <div>
                            <h2>Datos de la promoción</h2>
                            <p>Nombre, precio, vigencia y estado</p>
                        </div>
                    </div>
                </div>

                <form id="formDatos" onsubmit="guardarDatos(); return false;">
                    <input type="hidden" name="IdPromocion" value="@Model.IdPromocion" />
                    <div class="ed-form-grid">
                        <div class="ed-field full">
                            <label for="Nombre">Nombre <span class="req">*</span></label>
                            <input id="Nombre" name="Nombre" maxlength="100" required
                                   value="@Model.Nombre" placeholder="Ej: Promo Verano 2026" />
                            <span class="field-error"></span>
                        </div>

                        <div class="ed-field full">
                            <label for="Descripcion">Descripción <span class="opt">(opcional)</span></label>
                            <textarea id="Descripcion" name="Descripcion" maxlength="150"
                                      placeholder="Breve descripción que ayude a identificarla">@Model.Descripcion</textarea>
                            <span class="field-error"></span>
                        </div>

                        <div class="ed-field">
                            <label for="PrecioPromocion">Precio promocional <span class="req">*</span></label>
                            <input id="PrecioPromocion" name="PrecioPromocion" type="number" min="1" required
                                   value="@Model.PrecioPromocion" oninput="actualizarResumenPrecio()" />
                            <span class="field-error"></span>
                        </div>

                        <div class="ed-field">
                            <label for="Estado">Estado</label>
                            <select id="Estado" name="Estado">
                                <option value="true"  selected="@(Model.Estado ? "selected" : null)">Activa</option>
                                <option value="false" selected="@(!Model.Estado ? "selected" : null)">Inactiva</option>
                            </select>
                            <span class="field-error"></span>
                        </div>

                        <div class="ed-field">
                            <label for="FechaInicio">Fecha de inicio <span class="req">*</span></label>
                            <input id="FechaInicio" name="FechaInicio" type="date" required
                                   value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                            <span class="field-error"></span>
                        </div>

                        <div class="ed-field">
                            <label for="FechaFin">Fecha de término <span class="opt">(sin límite si se deja vacía)</span></label>
                            <input id="FechaFin" name="FechaFin" type="date"
                                   value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                            <span class="field-error"></span>
                        </div>
                    </div>

                    <div class="ed-form-footer">
                        <span class="ed-dirty" id="edDirty">Tienes cambios sin guardar</span>
                        <button type="button" class="ed-btn ed-btn-plain" id="btnDescartar"
                                onclick="descartarCambios()" disabled>Descartar</button>
                        <button type="submit" class="ed-btn ed-btn-primary" id="btnGuardar" disabled>
                            <svg viewBox="0 0 24 24"><path d="M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4zm-5 16a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm3-10H5V5h10v4z"/></svg>
                            Guardar cambios
                        </button>
                    </div>
                </form>
            </div>

            <!-- Contenido: resumen de precio + productos + grupos -->
            <div class="ed-col" id="edContenido">
                <partial name="_ContenidoPromo" model="Model" />
            </div>
        </div>

        <!-- ── Aside ── -->
        <div class="ed-col ed-aside">
            <div class="ed-card ed-help">
                <h3>
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                    Cómo se arma una promoción
                </h3>
                <dl>
                    <dt>Productos base</dt>
                    <dd>Van siempre incluidos en el combo.</dd>
                    <dt>Grupo «Elige 1»</dt>
                    <dd>El cliente escoge solo uno de los productos del grupo.</dd>
                    <dt>Grupo «Todos incluidos»</dt>
                    <dd>Se incluyen todos los productos del grupo.</dd>
                    <dt>Varias unidades a elección</dt>
                    <dd>
                        Para «2 vinos a elección» crea un grupo «Elige 1» con las variedades
                        y <strong>duplícalo</strong>: dos grupos iguales permiten repetir la
                        misma variedad o combinarlas. No pongas esos productos también en la base.
                    </dd>
                </dl>
                <p style="font-size:.76rem;color:#a89080;margin:.8rem 0 0;line-height:1.45;">
                    Los productos y grupos se guardan al instante. Los datos del formulario
                    requieren pulsar <strong>Guardar cambios</strong>.
                </p>
            </div>

            <div class="ed-card ed-danger">
                <h3>Eliminar promoción</h3>
                <p>Se borrarán también sus grupos y todos los productos asociados. No se puede deshacer.</p>
                <button type="button" class="ed-btn ed-btn-danger-soft" onclick="eliminarPromo()">
                    <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                    Eliminar esta promoción
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const ID_PROMO = @Model.IdPromocion;
    const overlay  = document.getElementById('modalOverlay');
    const csrf = () => document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';

    /* ══ Utilidades ══════════════════════════════════════════════════════ */
    function esc(s) {
        return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;')
                              .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    const money = n => '$' + Number(n || 0).toLocaleString('es-CL');

    function toast(msg, tipo) {
        const iconos = {
            exito: '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>',
            error: '<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>'
        };
        const t = document.createElement('div');
        t.className = `toast-msg ${tipo}`;
        t.innerHTML = `${iconos[tipo]}<span>${esc(msg)}</span>`;
        document.getElementById('toastWrap').appendChild(t);
        setTimeout(() => t.style.opacity = '0', 3500);
        setTimeout(() => t.remove(), 3800);
    }

    async function post(url, campos) {
        const fd = new FormData();
        Object.entries(campos ?? {}).forEach(([k, v]) => {
            if (v !== null && v !== undefined) fd.append(k, v);
        });
        try {
            const r = await fetch(url, {
                method: 'POST',
                headers: { 'RequestVerificationToken': csrf() },
                body: fd
            });
            if (!r.ok) return { ok: false, mensaje: `Error del servidor (${r.status}).` };
            return await r.json();
        } catch {
            return { ok: false, mensaje: 'Error de conexión.' };
        }
    }

    /* ══ Modal genérico ══════════════════════════════════════════════════ */
    function setHtmlConScripts(el, html) {
        el.innerHTML = html;
        el.querySelectorAll('script').forEach(s => {
            const n = document.createElement('script');
            n.textContent = s.textContent;
            s.replaceWith(n);
        });
    }

    async function abrirModal(url) {
        overlay.classList.add('open');
        document.getElementById('modalBody').innerHTML =
            '<div class="m-spinner"><div class="spinner-ring"></div><span>Cargando…</span></div>';
        try {
            const r = await fetch(url);
            if (!r.ok) throw new Error();
            setHtmlConScripts(document.getElementById('modalBody'), await r.text());
        } catch {
            cerrarModal();
            toast('No se pudo cargar el contenido.', 'error');
        }
    }

    function cerrarModal() {
        overlay.classList.remove('open');
        setTimeout(() => { document.getElementById('modalBody').innerHTML = ''; }, 250);
    }

    overlay.addEventListener('click', e => { if (e.target === overlay) cerrarModal(); });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && overlay.classList.contains('open')) cerrarModal();
    });

    /* Confirmación reutilizable — resuelve a true/false */
    function confirmar({ titulo, texto, aviso, boton = 'Sí, continuar' }) {
        return new Promise(resolve => {
            overlay.classList.add('open');
            setHtmlConScripts(document.getElementById('modalBody'), `
                <div class="m-confirm">
                    <div class="m-confirm-icon">
                        <svg viewBox="0 0 24 24"><path d="M12 2L1 21h22L12 2zm0 6l7.53 13H4.47L12 8zm-1 4v3h2v-3h-2zm0 5v2h2v-2h-2z"/></svg>
                    </div>
                    <h3>${esc(titulo)}</h3>
                    <p>${texto}</p>
                    ${aviso ? `<p class="aviso">${esc(aviso)}</p>` : ''}
                    <div class="m-confirm-actions">
                        <button type="button" class="ed-btn ed-btn-plain"  id="cfNo">Cancelar</button>
                        <button type="button" class="ed-btn ed-btn-danger" id="cfSi">${esc(boton)}</button>
                    </div>
                </div>`);
            document.getElementById('cfNo').onclick = () => { cerrarModal(); resolve(false); };
            document.getElementById('cfSi').onclick = () => { cerrarModal(); resolve(true); };
        });
    }

    /* ══ Recarga del contenido (productos + grupos + resumen) ════════════ */
    async function refrescarContenido() {
        try {
            const r = await fetch(`/Productos/Promociones/ContenidoPromo/${ID_PROMO}`);
            if (!r.ok) throw new Error();
            document.getElementById('edContenido').innerHTML = await r.text();
            actualizarResumenPrecio();
            actualizarMetricas();
        } catch {
            toast('No se pudo actualizar el contenido. Recarga la página.', 'error');
        }
    }

    function actualizarMetricas() {
        const m = document.getElementById('edMetricas');
        if (!m) return;
        const productos = Number(m.dataset.productos) || 0;
        const unidades  = Number(m.dataset.unidades)  || 0;
        const grupos    = Number(m.dataset.grupos)    || 0;
        document.getElementById('edChipProductos').textContent =
            `${productos} producto${productos === 1 ? '' : 's'} · ${unidades} unidad${unidades === 1 ? '' : 'es'}`;
        document.getElementById('edChipGrupos').textContent =
            `${grupos} grupo${grupos === 1 ? '' : 's'}`;
    }

    /** Recalcula el ahorro con el precio que hay ahora mismo en el formulario. */
    function actualizarResumenPrecio() {
        const card = document.getElementById('edPrecioCard');
        if (!card) return;
        const min    = Number(card.dataset.normalMin) || 0;
        const precio = parseInt(document.getElementById('PrecioPromocion').value, 10) || 0;

        document.getElementById('edPrecioPromo').textContent = money(precio);

        const box = document.getElementById('edAhorro');
        if (min <= 0) {
            box.innerHTML = '<span class="ed-ahorro neutro">Agrega productos</span>';
            return;
        }
        const ahorro = min - precio;
        if (ahorro > 0) {
            const pct = Math.round(ahorro * 100 / min);
            box.innerHTML = `<span class="ed-ahorro bueno">${money(ahorro)} · ${pct}%</span>`;
        } else if (ahorro === 0) {
            box.innerHTML = '<span class="ed-ahorro neutro">Sin ahorro</span>';
        } else {
            box.innerHTML = `<span class="ed-ahorro malo">Cuesta ${money(-ahorro)} más</span>`;
        }
    }

    /* ══ Formulario de datos ════════════════════════════════════════════ */
    const form = document.getElementById('formDatos');
    const CAMPOS = ['Nombre', 'Descripcion', 'PrecioPromocion', 'Estado', 'FechaInicio', 'FechaFin'];
    let original = {};
    // Se activa cuando el usuario ya decidió salir: evita el aviso del navegador
    let saliendo = false;

    function snapshot() {
        original = {};
        CAMPOS.forEach(c => original[c] = document.getElementById(c).value);
        marcarSucio();
    }

    function estaSucio() {
        if (saliendo) return false;
        return CAMPOS.some(c => document.getElementById(c).value !== original[c]);
    }

    function marcarSucio() {
        const sucio = estaSucio();
        document.getElementById('edDirty').classList.toggle('visible', sucio);
        document.getElementById('btnGuardar').disabled   = !sucio;
        document.getElementById('btnDescartar').disabled = !sucio;
    }

    form.addEventListener('input',  marcarSucio);
    form.addEventListener('change', marcarSucio);

    function limpiarErrores() {
        form.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
        form.querySelectorAll('.field-error').forEach(el => el.textContent = '');
    }

    function mostrarErrores(errores) {
        Object.entries(errores ?? {}).forEach(([campo, msg]) => {
            const input = document.getElementById(campo);
            if (!input) return;
            input.classList.add('input-error');
            const span = input.parentElement.querySelector('.field-error');
            if (span) span.textContent = msg;
        });
    }

    async function guardarDatos() {
        limpiarErrores();
        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;

        const data = await post('/Productos/Promociones/EditarAjax', {
            IdPromocion:     ID_PROMO,
            Nombre:          document.getElementById('Nombre').value.trim(),
            Descripcion:     document.getElementById('Descripcion').value.trim(),
            PrecioPromocion: document.getElementById('PrecioPromocion').value,
            Estado:          document.getElementById('Estado').value,
            FechaInicio:     document.getElementById('FechaInicio').value,
            FechaFin:        document.getElementById('FechaFin').value
        });

        if (!data.ok) {
            mostrarErrores(data.errores);
            toast(data.mensaje ?? 'Revisa los campos marcados.', 'error');
            marcarSucio();
            return;
        }

        toast(data.mensaje, 'exito');
        document.getElementById('edTitulo').textContent = data.promo.nombre;
        document.title = `Editar — ${data.promo.nombre} — BotiApp`;

        const badge = document.getElementById('edBadge');
        badge.textContent = data.promo.estadoTexto;
        badge.className   = 'badge ' + data.promo.estadoClave;

        snapshot();
        actualizarResumenPrecio();
    }

    function descartarCambios() {
        CAMPOS.forEach(c => document.getElementById(c).value = original[c]);
        limpiarErrores();
        marcarSucio();
        actualizarResumenPrecio();
    }

    function volverAlListado(e) {
        if (!estaSucio()) return true;
        e.preventDefault();
        confirmar({
            titulo: 'Salir sin guardar',
            texto:  'Los cambios del formulario que no guardaste se perderán.',
            boton:  'Salir sin guardar'
        }).then(ok => { if (ok) { saliendo = true; location.href = '/Productos/Promociones'; } });
        return false;
    }

    window.addEventListener('beforeunload', e => {
        if (estaSucio()) { e.preventDefault(); e.returnValue = ''; }
    });

    /* ══ Productos ══════════════════════════════════════════════════════ */
    function agregarProductos(idGrupo) {
        const qs = idGrupo !== null && idGrupo !== undefined
            ? `?idPromocion=${ID_PROMO}&idGrupo=${idGrupo}`
            : `?idPromocion=${ID_PROMO}`;
        abrirModal(`/Productos/Promociones/ModalBuscarProducto${qs}`);
    }

    async function quitarProducto(idDetalle) {
        const fila   = document.getElementById(`det-${idDetalle}`);
        const nombre = fila?.dataset.nombre ?? 'este producto';
        const ok = await confirmar({
            titulo: '¿Quitar producto?',
            texto:  `<strong>«${esc(nombre)}»</strong> dejará de formar parte de la promoción.`,
            boton:  'Sí, quitar'
        });
        if (!ok) return;

        fila?.classList.add('saliendo');
        const data = await post(`/Productos/Promociones/QuitarProductoAjax/${idDetalle}`);
        toast(data.mensaje, data.ok ? 'exito' : 'error');
        await refrescarContenido();
    }

    /** Guarda la cantidad con un pequeño retardo para no disparar una petición por clic. */
    const timersCantidad = new Map();
    function guardarCantidad(idDetalle, cantidad) {
        clearTimeout(timersCantidad.get(idDetalle));
        timersCantidad.set(idDetalle, setTimeout(async () => {
            timersCantidad.delete(idDetalle);
            const data = await post('/Productos/Promociones/ActualizarCantidadAjax',
                { id: idDetalle, cantidad });
            if (!data.ok) { toast(data.mensaje, 'error'); }
            await refrescarContenido();
        }, 450));
    }

    function cambiarCantidad(idDetalle, delta) {
        const input = document.getElementById(`cant-${idDetalle}`);
        if (!input) return;
        const nuevo = Math.min(99, Math.max(1, (parseInt(input.value, 10) || 1) + delta));
        input.value = nuevo;
        guardarCantidad(idDetalle, nuevo);
    }

    function fijarCantidad(idDetalle, valor) {
        const input = document.getElementById(`cant-${idDetalle}`);
        const nuevo = Math.min(99, Math.max(1, parseInt(valor, 10) || 1));
        if (input) input.value = nuevo;
        guardarCantidad(idDetalle, nuevo);
    }

    async function moverProducto(idDetalle, idGrupo) {
        const data = await post('/Productos/Promociones/MoverProductoAjax',
            { id: idDetalle, idGrupo: idGrupo === '' ? null : idGrupo });
        toast(data.mensaje, data.ok ? 'exito' : 'error');
        await refrescarContenido();
    }

    /* ══ Grupos ═════════════════════════════════════════════════════════ */
    function abrirFormGrupo() {
        document.getElementById('edFormGrupo').classList.add('visible');
        setTimeout(() => document.getElementById('edGrupoNombre')?.focus(), 30);
    }

    function cerrarFormGrupo() {
        document.getElementById('edFormGrupo')?.classList.remove('visible');
        const input = document.getElementById('edGrupoNombre');
        if (input) input.value = '';
    }

    async function crearGrupo() {
        const input = document.getElementById('edGrupoNombre');
        const desc  = input?.value.trim();
        if (!desc) { input?.focus(); return; }

        const data = await post('/Productos/Promociones/CrearGrupoAjax', {
            idPromocion:  ID_PROMO,
            descripcion:  desc,
            esExcluyente: document.getElementById('edGrupoExcl')?.checked ?? true
        });
        toast(data.mensaje, data.ok ? 'exito' : 'error');
        if (data.ok) {
            await refrescarContenido();
            resaltarGrupo(data.grupo.idGrupo);
        }
    }

    /** Crea un grupo «elige 1» con una copia de los productos base. */
    async function replicarBaseEnGrupo() {
        const data = await post(`/Productos/Promociones/ReplicarBaseEnGrupoAjax/${ID_PROMO}`,
            { esExcluyente: true });
        toast(data.mensaje, data.ok ? 'exito' : 'error');
        if (!data.ok) return;
        await refrescarContenido();
        resaltarGrupo(data.grupo.idGrupo);
    }

    /** Duplica el grupo con su tipo, productos y cantidades. */
    async function duplicarGrupo(idGrupo) {
        const data = await post(`/Productos/Promociones/DuplicarGrupoAjax/${idGrupo}`);
        toast(data.mensaje, data.ok ? 'exito' : 'error');
        if (!data.ok) return;
        await refrescarContenido();
        resaltarGrupo(data.grupo.idGrupo);
    }

    /** Lleva la vista al grupo y lo destaca un momento para no perderlo de vista. */
    function resaltarGrupo(idGrupo) {
        const el = document.getElementById(`grupo-${idGrupo}`);
        if (!el) return;
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.add('recien-creado');
        setTimeout(() => el.classList.remove('recien-creado'), 1800);
    }

    function editarGrupo(idGrupo) {
        document.getElementById(`grupoIdent-${idGrupo}`).style.display    = 'none';
        document.getElementById(`grupoAcciones-${idGrupo}`).style.display = 'none';
        document.getElementById(`grupoEdit-${idGrupo}`).classList.add('visible');
        const input = document.getElementById(`grupoInput-${idGrupo}`);
        input?.focus();
        input?.select();
    }

    function cancelarEditarGrupo(idGrupo) {
        document.getElementById(`grupoIdent-${idGrupo}`).style.display    = '';
        document.getElementById(`grupoAcciones-${idGrupo}`).style.display = '';
        document.getElementById(`grupoEdit-${idGrupo}`).classList.remove('visible');
    }

    async function guardarGrupo(idGrupo) {
        const input = document.getElementById(`grupoInput-${idGrupo}`);
        const desc  = input?.value.trim();
        if (!desc) { input?.focus(); return; }

        const data = await post('/Productos/Promociones/RenombrarGrupoAjax', {
            idGrupo,
            descripcion:  desc,
            esExcluyente: document.getElementById(`grupoExcl-${idGrupo}`)?.checked ?? false
        });
        toast(data.mensaje, data.ok ? 'exito' : 'error');
        if (data.ok) await refrescarContenido();
        else cancelarEditarGrupo(idGrupo);
    }

    async function eliminarGrupo(idGrupo) {
        const nombre = document.getElementById(`grupo-${idGrupo}`)?.dataset.nombre ?? 'este grupo';
        const ok = await confirmar({
            titulo: '¿Eliminar grupo?',
            texto:  `Se eliminará el grupo <strong>«${esc(nombre)}»</strong>.`,
            aviso:  'También se quitarán todos los productos que contiene.',
            boton:  'Sí, eliminar'
        });
        if (!ok) return;

        const data = await post(`/Productos/Promociones/EliminarGrupoAjax/${idGrupo}`);
        toast(data.mensaje, data.ok ? 'exito' : 'error');
        await refrescarContenido();
    }

    /* ══ Eliminar promoción ═════════════════════════════════════════════ */
    async function eliminarPromo() {
        const nombre = document.getElementById('edTitulo').textContent;
        const ok = await confirmar({
            titulo: '¿Eliminar la promoción?',
            texto:  `Vas a eliminar <strong>«${esc(nombre)}»</strong> de forma permanente.`,
            aviso:  'Se quitarán también sus grupos y todos los productos asociados.',
            boton:  'Sí, eliminar'
        });
        if (!ok) return;

        const data = await post(`/Productos/Promociones/EliminarAjax/${ID_PROMO}`);
        if (!data.ok) { toast(data.mensaje, 'error'); return; }
        saliendo = true;   // la promo ya no existe: no avisar de cambios sin guardar
        sessionStorage.setItem('promoFlash', data.mensaje);
        location.href = '/Productos/Promociones';
    }

    /* ══ Exponer lo que usan los onclick del markup y el modal buscador ══ */
    window.guardarDatos            = guardarDatos;
    window.descartarCambios        = descartarCambios;
