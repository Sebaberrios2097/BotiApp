@using System.Text.Json
@model BotiApp.Areas.Ventas.Models.HistorialVentasViewModel
@{
    ViewData["Title"] = "Historial de Ventas";

    var boletasJson = JsonSerializer.Serialize(Model.Boletas.Select(b => new
    {
        id         = b.IdBoleta,
        correlativoDiario = b.CorrelativoDiario,
        fecha      = b.FechaEmision,
        anio       = b.FechaEmision != "—" && b.FechaEmision.Length >= 10
                         ? (int?)int.Parse(b.FechaEmision.Substring(6, 4)) : null,
        mes        = b.FechaEmision != "—" && b.FechaEmision.Length >= 5
                         ? (int?)int.Parse(b.FechaEmision.Substring(3, 2)) : null,
        dia        = b.FechaEmision != "—" && b.FechaEmision.Length >= 2
                         ? (int?)int.Parse(b.FechaEmision.Substring(0, 2)) : null,
        estado     = b.Estado,
        idEstado   = b.IdEstado,
        idVendedor = b.IdVendedor,
        vendedor   = b.Vendedor,
        idCajero   = b.IdCajero,
        cajero     = b.Cajero,
        total      = b.MontoTotal,
        detalle    = b.Detalle.Select(d => new
        {
            nombre         = d.Nombre,
            cantidad       = d.Cantidad,
            precioUnitario = d.PrecioUnitario,
            precioNormal   = d.PrecioNormal,
            subtotal       = d.Subtotal,
            nombrePromocion = d.NombrePromocion,
            nombreOferta    = d.NombreOferta
        })
    }));

    var vendedoresJson = JsonSerializer.Serialize(Model.Vendedores.Select(v => new
    {
        id     = v.IdUsuario,
        nombre = v.Nombre
    }));
}

<style>
/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   HEADER CARD
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
