@using System.Text.Json
@model BotiApp.Areas.Ventas.Models.HistorialVentasViewModel
@{
    ViewData["Title"] = "Historial de Ventas";

    // Solo se serializa la primera página (la que ya pidió el servidor con los
    // mismos filtros por defecto que muestra la UI). El resto de páginas y los
    // cambios de filtro se piden por AJAX a HistorialAjax — el historial completo
    // ya no se envuelve entero en el HTML.
    static object BoletaAJson(BotiApp.Areas.Ventas.Models.BoletaResumenDto b) => new
    {
        id = b.IdBoleta,
        correlativoDiario = b.CorrelativoDiario,
        fecha = b.FechaEmision,
        estado = b.Estado,
        idEstado = b.IdEstado,
        idVendedor = b.IdVendedor,
        vendedor = b.Vendedor,
        idCajero = b.IdCajero,
        cajero = b.Cajero,
        total = b.MontoTotal,
        detalle = b.Detalle.Select(d => new
        {
            nombre = d.Nombre,
            cantidad = d.Cantidad,
            precioUnitario = d.PrecioUnitario,
            precioNormal = d.PrecioNormal,
            subtotal = d.Subtotal,
            nombrePromocion = d.NombrePromocion,
            nombreOferta = d.NombreOferta
        })
    };

    var boletasJson = JsonSerializer.Serialize(Model.Boletas.Select(BoletaAJson));

    var vendedoresJson = JsonSerializer.Serialize(Model.Vendedores.Select(v => new
    {
        id     = v.IdUsuario,
        nombre = v.Nombre
    }));

    var aniosJson = JsonSerializer.Serialize(Model.AniosDisponibles);
    var hoy = DateTime.Today;
}

<style>
