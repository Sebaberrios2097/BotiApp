<div class="hist-panel">
    <div class="hist-panel-header">
        <svg viewBox="0 0 24 24"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.95-2.05L6.64 18.36A9 9 0 1 0 13 3zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>
        <span>@(Model.EsCajero ? "Tickets gestionados" : "Ventas registradas")</span>
        <span class="cnt-badge" id="cntBoletas">@Model.TotalBoletas</span>
    </div>

    @if (Model.EsAdmin || Model.Boletas.Any())
    {
        <div class="filtros-wrap">
            <div class="search-bar">
                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <input type="text" id="txtBuscar"
                       placeholder="@(Model.EsCajero ? "Buscar por N° ticket, vendedor o fecha…" : "Buscar por N° boleta, vendedor o fecha…")"
                       oninput="aplicarFiltros()" autocomplete="off" />
                <button class="clr" id="btnClr" onclick="limpiarQ()" title="Limpiar">✕</button>
            </div>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;">
                <select class="fil-estado" id="selEstado" onchange="aplicarFiltros()">
                    <option value="0">Todos los estados</option>
                    <option value="1">Pendiente</option>
                    <option value="3">Pagada</option>
                    <option value="2">Anulada</option>
                    <option value="4">Fiado</option>
                </select>
                <select class="fil-estado" id="selAnio" onchange="aplicarFiltros()">
                    <option value="">Todos los años</option>
                    @foreach (var anio in Model.AniosDisponibles)
                    {
                        if (anio == hoy.Year)
                        {
                            <option value="@anio" selected>@anio</option>
                        }
                        else
                        {
                            <option value="@anio">@anio</option>
                        }
                    }
                </select>
                <select class="fil-estado" id="selMes" onchange="aplicarFiltros()">
                    <option value="">Todos los meses</option>
                    @{ var mesesNombres = new[]{"","Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"}; }
                    @for (int m = 1; m <= 12; m++)
                    {
                        if (m == hoy.Month)
                        {
                            <option value="@m" selected>Mes: @mesesNombres[m]</option>
                        }
                        else
                        {
                            <option value="@m">Mes: @mesesNombres[m]</option>
                        }
                    }
                </select>
                <select class="fil-estado" id="selDia" onchange="aplicarFiltros()">
                    <option value="">Todos los días</option>
                    @for (int d = 1; d <= 31; d++)
                    {
                        <option value="@d">Día: @d</option>
                    }
                </select>
            </div>

            @if (Model.EsAdmin)
            {
                <div class="pills-row" id="pillsVendedores">
                    <button class="pill active" data-vendedor="0" onclick="selVendedor(0)">Todas las ventas</button>
                    <button class="pill" data-vendedor="@Model.IdUsuarioActual" onclick="selVendedor(@Model.IdUsuarioActual)">Mis ventas</button>
                    @foreach (var v in Model.Vendedores.Where(v => v.IdUsuario != Model.IdUsuarioActual))
                    {
                        <button class="pill" data-vendedor="@v.IdUsuario" onclick="selVendedor(@v.IdUsuario)">@v.Nombre</button>
                    }
                </div>
            }
        </div>
    }

    <div class="boletas-list-wrap">
        <div class="boletas-list" id="boletasList"></div>
        <div class="hist-spinner-overlay" id="histSpinner"><div class="hist-spinner"></div></div>
    </div>
    <div class="pag-wrap" id="pagWrap" style="display:none;"></div>
</div>

@section Scripts {
<script>
(function () {

    /* â”€â”€ Datos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    var BOLETAS_INICIAL = @Html.Raw(boletasJson);
    var TOTAL_INICIAL   = @Model.TotalBoletas;
    var ES_ADMIN   = @Html.Raw(Model.EsAdmin.ToString().ToLower());
    var ES_CAJERO  = @Html.Raw(Model.EsCajero.ToString().ToLower());
    var ID_USUARIO = @Model.IdUsuarioActual;
    var URL_HISTORIAL_AJAX = '@Url.Action("HistorialAjax", "Ventas", new { area = "Ventas" })';

    /* â”€â”€ Estado paginaciÃ³n â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    var POR_PAG        = 10;
    var paginaActual   = 1;
    var totalActual    = TOTAL_INICIAL;
    var boletasPagina  = BOLETAS_INICIAL;
    var vendedorActivo = 0;
    var debounceTimer  = null;
    var fetchCtrl      = null;

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       FILTROS
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    window.selVendedor = function (id) {
        vendedorActivo = id;
        document.querySelectorAll('#pillsVendedores .pill')
            .forEach(function(p) { p.classList.toggle('active', +p.dataset.vendedor === id); });
        aplicarFiltros();
    };

    // Los cambios de filtro reinician a la página 1 y piden esa página al
    // servidor, con un pequeño debounce para no disparar una consulta por cada
    // tecla mientras el usuario escribe en el buscador.
    window.aplicarFiltros = function () {
        paginaActual = 1;
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(cargarPagina, 300);
    };

    window.limpiarQ = function () {
        document.getElementById('txtBuscar').value = '';
        paginaActual = 1;
        clearTimeout(debounceTimer);
        cargarPagina();
    };

    function cargarPagina() {
        var texto  = (document.getElementById('txtBuscar')?.value ?? '').trim();
        var estado = +(document.getElementById('selEstado')?.value ?? 0) || 0;
        var anio   = document.getElementById('selAnio')?.value ?? '';
        var mes    = document.getElementById('selMes')?.value  ?? '';
        var dia    = document.getElementById('selDia')?.value  ?? '';

        document.getElementById('btnClr')?.classList.toggle('on', texto.length > 0);

        var qs = new URLSearchParams();
        qs.set('pagina', paginaActual);
        if (estado) qs.set('estado', estado);
        if (anio)   qs.set('anio', anio);
        if (mes)    qs.set('mes', mes);
        if (dia)    qs.set('dia', dia);
        if (texto)  qs.set('texto', texto);
        if (ES_ADMIN && vendedorActivo) qs.set('idVendedorFiltro', vendedorActivo);

        if (fetchCtrl) fetchCtrl.abort();
        fetchCtrl = new AbortController();

        var spinner = document.getElementById('histSpinner');
        // Pequeño retraso antes de mostrar el spinner: si la respuesta llega
        // rápido (página ya cacheada por el navegador, red local, etc.) evita el
        // parpadeo de mostrar y ocultar el spinner en menos de un instante.
        var spinnerTimer = setTimeout(function() { spinner.classList.add('visible'); }, 120);

        fetch(URL_HISTORIAL_AJAX + '?' + qs.toString(), { signal: fetchCtrl.signal, credentials: 'same-origin' })
            .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function(d) {
                boletasPagina = d.boletas;
                totalActual   = d.total;
                paginaActual  = d.pagina;
                document.getElementById('cntBoletas').textContent = totalActual;
                var phc = document.getElementById('phcBadgeTotal');
                if (phc) phc.textContent = totalActual;
                renderLista(boletasPagina);
                renderControlesPag(Math.max(1, Math.ceil(totalActual / d.porPagina)), totalActual);
            })
            .catch(function(err) { if (err.name !== 'AbortError') console.error('Error cargando historial:', err); })
            .finally(function() {
                clearTimeout(spinnerTimer);
                spinner.classList.remove('visible');
            });
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       PAGINACIÃ“N
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function renderControlesPag(paginas, total) {
        var wrap = document.getElementById('pagWrap');
        if (paginas <= 1) { wrap.style.display = 'none'; return; }
        wrap.style.display = 'flex';

        var html = '';
        html += '<button class="pag-btn" onclick="irPag(' + (paginaActual - 1) + ')" ' + (paginaActual === 1 ? 'disabled' : '') + '>‹</button>';

        // Ventana de pÃ¡ginas: mÃ¡ximo 5 botones visibles
        var desde = Math.max(1, paginaActual - 2);
        var hasta  = Math.min(paginas, desde + 4);
        if (hasta - desde < 4) desde = Math.max(1, hasta - 4);

        for (var i = desde; i <= hasta; i++) {
            html += '<button class="pag-btn' + (i === paginaActual ? ' active' : '') + '" onclick="irPag(' + i + ')">' + i + '</button>';
        }

        html += '<button class="pag-btn" onclick="irPag(' + (paginaActual + 1) + ')" ' + (paginaActual === paginas ? 'disabled' : '') + '>›</button>';
        html += '<span class="pag-info">' + total + ' boletas</span>';
        wrap.innerHTML = html;
    }

    window.irPag = function(p) {
        var paginas = Math.max(1, Math.ceil(totalActual / POR_PAG));
        if (p < 1 || p > paginas) return;
        paginaActual = p;
        cargarPagina();
        document.getElementById('boletasList').scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       RENDER LISTA
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function renderLista(lista) {
        var cont = document.getElementById('boletasList');

        if (!lista.length) {
            cont.innerHTML = `
            <div class="boletas-empty">
                <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                No hay ventas para mostrar
            </div>`;
            return;
        }

        var diaSel = document.getElementById('selDia')?.value ?? '';
        if (diaSel) {
            cont.innerHTML = lista.map(renderBoletaCard).join('');
        } else {
            cont.innerHTML = renderListaAgrupadaPorDia(lista);
        }
    }

    // Agrupa la página actual por día calendario cuando el filtro "Todos los
    // días" está activo: encabezado "Lunes 28" seguido de las ventas de ese día.
    var DIAS_ES = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
    function renderListaAgrupadaPorDia(lista) {
        var html = '';
        var claveGrupoActual = null;
        lista.forEach(function(b) {
            var claveFecha = String(b.fecha ?? '').substring(0, 10); // dd/MM/yyyy
            if (claveFecha !== claveGrupoActual) {
                claveGrupoActual = claveFecha;
                html += '<div class="bl-dia-header">' + x(etiquetaDia(claveFecha)) + '</div>';
            }
            html += renderBoletaCard(b);
        });
        return html;
    }

    function etiquetaDia(claveFecha) {
        var partes = claveFecha.split(/[\/\-]/);
        if (partes.length < 3) return claveFecha;
        var d = +partes[0], m = +partes[1], y = +partes[2];
        var fechaObj = new Date(y, m - 1, d);
        if (isNaN(fechaObj.getTime())) return claveFecha;
        return DIAS_ES[fechaObj.getDay()] + ' ' + d;
    }

    function renderBoletaCard(b) {
            var estadoClass = b.idEstado === 1 ? 'est-1'
                            : b.idEstado === 2 ? 'est-2'
                            : b.idEstado === 3 ? 'est-3'
                            : b.idEstado === 4 ? 'est-4'
                            : 'est-other';
            var infoHtml = ES_ADMIN
                ? '<span class="bl-cajero"><strong>Vendedor:</strong> ' + x(b.vendedor) + '</span>' + (b.cajero ? ' <span class="bl-cajero"><strong>Cajero:</strong> ' + x(b.cajero) + '</span>' : '')
                : ES_CAJERO
                    ? '<span class="bl-cajero"><strong>Vendedor:</strong> ' + x(b.vendedor) + '</span>'
                    : '';
            // Separar ítems con y sin promoción
            var promoItems   = b.detalle.filter(function(d) { return !!d.nombrePromocion; });
            var noPromoItems = b.detalle.filter(function(d) { return !d.nombrePromocion; });

            // Agrupar ítems de promo por nombre de promoción
            var promoMap = new Map();
            promoItems.forEach(function(d) {
                if (!promoMap.has(d.nombrePromocion))
                    promoMap.set(d.nombrePromocion, { subtotal: 0, items: [] });
                var g = promoMap.get(d.nombrePromocion);
                g.subtotal += d.subtotal;
                g.items.push(d);
            });

            var detalleRows = '';

            // Rendir grupos de promoción
            promoMap.forEach(function(g, nombrePromo) {
                // Consolidar productos repetidos (promo añadida varias veces)
                var itemMap = new Map();
                g.items.forEach(function(d) {
                    var key = d.nombre + '|' + d.precioUnitario;
                    if (!itemMap.has(key))
                        itemMap.set(key, { nombre: d.nombre, precioUnitario: d.precioUnitario, precioNormal: d.precioNormal, cantidad: 0, subtotal: 0 });
                    var it = itemMap.get(key);
                    it.cantidad += d.cantidad;
                    it.subtotal += d.subtotal;
                });
                // Cabecera de la promo
                detalleRows += '<tr class="promo-gr-head">'
                    + '<td colspan="3"><span class="etq-promo">Promo: ' + x(nombrePromo) + '</span></td>'
                    + '<td style="text-align:right;font-weight:700;color:#d97706;">$' + fmt(g.subtotal) + '</td>'
                    + '</tr>';
                // Ítems de la promo
                itemMap.forEach(function(d) {
                    detalleRows += '<tr class="promo-gr-item">'
                        + '<td>' + x(d.nombre) + '</td>'
                        + '<td style="text-align:center;">' + d.cantidad + '</td>'
                        + '<td style="text-align:right;"></td>'
                        + '<td style="text-align:right;"></td>'
                        + '</tr>';
                });
                // Separador visual
                detalleRows += '<tr class="promo-gr-sep"><td colspan="4"></td></tr>';
            });

            // Rendir ítems individuales (sin promo)
            noPromoItems.forEach(function(d) {
                var esEnvase = d.precioNormal === 0 && !d.nombrePromocion && !d.nombreOferta;
                var tieneDescuento = d.precioNormal > d.precioUnitario;
                var badge = esEnvase ? ' <span class="etq-envase">⚡ ENVASE</span>' : (d.nombreOferta ? ' <span class="etq-oferta">✦ Oferta</span>' : '');
                var precioHtml = esEnvase ? '$' + fmt(d.precioUnitario) : (tieneDescuento
                    ? '<span class="precio-normal-tachado">$' + fmt(d.precioNormal) + '</span><span class="precio-descuento">$' + fmt(d.precioUnitario) + '</span>'
                    : '$' + fmt(d.precioUnitario));
                detalleRows += '<tr>'
                    + '<td>' + x(d.nombre) + badge + '</td>'
                    + '<td style="text-align:center;">' + d.cantidad + '</td>'
                    + '<td style="text-align:right;">' + precioHtml + '</td>'
                    + '<td style="text-align:right;">$' + fmt(d.subtotal) + '</td>'
                    + '</tr>';
            });

            var totalLabel = b.idEstado === 4 ? 'Monto fiado' : b.idEstado === 1 ? 'Monto pendiente' : 'Total pagado';

            return '<div class="bl-card" id="blc-' + b.id + '">' +
                '<div class="bl-card-top" onclick="toggleDetalle(' + b.id + ')">' +
                    '<span class="bl-num">' + 'Ticket #' + (b.correlativoDiario || b.id) +
                        (b.correlativoDiario ? '<span class="bl-id">ID: ' + b.id + '</span>' : '') + '</span>' +
                    '<span class="bl-fecha">' + x(b.fecha) + '</span>' +
                    infoHtml +
                    '<span class="bl-estado ' + estadoClass + '">' + x(b.estado) + '</span>' +
                    '<span class="bl-total">$' + fmt(b.total) + '</span>' +
                    '<svg class="bl-chevron" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>' +
                '</div>' +
                '<div class="bl-detalle">' +
                    '<table class="bl-det-table">' +
                        '<thead><tr><th>Producto</th><th style="text-align:center;">Cant.</th><th style="text-align:right;">P. Unit.</th><th style="text-align:right;">Subtotal</th></tr></thead>' +
                        '<tbody>' + detalleRows + '</tbody>' +
                    '</table>' +
                    '<div class="bl-det-total"><span class="lbl">' + totalLabel + '</span><span class="val">$' + fmt(b.total) + '</span></div>' +
                    '<div style="display:flex;justify-content:flex-end;margin-top:.55rem;gap:.5rem;flex-wrap:wrap;">' +
                        '<button class="bl-reimprimir" onclick="event.stopPropagation();reimprimir(' + b.id + ', \'cliente\')">' +
                            '<svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/></svg>' +
                            'Reimprimir Ticket Cliente' +
                        '</button>' +
                        '<button class="bl-reimprimir" onclick="event.stopPropagation();reimprimir(' + b.id + ', \'vendedor\')">' +
                            '<svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/></svg>' +
                            'Reimprimir Ticket Vendedor' +
                        '</button>' +
                    '</div>' +
                '</div>' +
            '</div>';
    }

    /* â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• 
       TOGGLE DETALLE
    â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â•  */
    window.toggleDetalle = function (id) {
        var card = document.getElementById('blc-' + id);
        if (!card) return;
        card.classList.toggle('open');
    };

    /* â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• 
       UTILIDADES
    â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â•  */
    function fmt(n) { return Number(n).toLocaleString('es-CL'); }
    function x(s) {
        return String(s ?? '')
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* ══════════════════════════════════════════════════════════════════════
       REIMPRIMIR
    ══════════════════════════════════════════════════════════════════════ */
    window.reimprimir = function (id, tipo) {
        var b = boletasPagina.find(function(b) { return b.id === id; });
        if (!b) return;
        mostrarTicketHistorial(b, tipo);
    };

    function mostrarTicketHistorial(b, tipo) {
        var NOMBRE_LOCAL = 'Cuatro Ases';
        var lineas = '';

        var envases      = b.detalle.filter(function(d) { return d.precioNormal === 0 && !d.nombrePromocion && !d.nombreOferta; });
        var promoItems   = b.detalle.filter(function(d) { return d.nombrePromocion; });
        var individuales = b.detalle.filter(function(d) { return !d.nombrePromocion && !(d.precioNormal === 0 && !d.nombreOferta); });

        var promoMap = new Map();
        promoItems.forEach(function(d) {
            if (!promoMap.has(d.nombrePromocion)) promoMap.set(d.nombrePromocion, { subtotalReal: 0, subtotalNormal: 0, items: [] });
            var g = promoMap.get(d.nombrePromocion);
            g.subtotalReal   += d.subtotal;
            g.subtotalNormal += d.precioNormal * d.cantidad;
            g.items.push(d);
        });

        promoMap.forEach(function(g, nombrePromo) {
            var itemMap = new Map();
            g.items.forEach(function(d) {
                var key = d.nombre + '|' + d.precioNormal;
                if (!itemMap.has(key)) itemMap.set(key, Object.assign({}, d, { cantidad: 0 }));
                itemMap.get(key).cantidad += d.cantidad;
            });
            lineas += '<hr class="ticket-hr">';
            lineas += '<div class="ticket-row ticket-promo-tag"><span class="tk-l">Promo: ' + x(nombrePromo) + '</span><span class="tk-r ticket-bold">$' + fmt(g.subtotalReal) + '</span></div>';
            itemMap.forEach(function(d) {
                lineas += '<div class="ticket-row ticket-grid" style="padding-left:.8rem;">' +
                    '<span class="tk-l">' + x(d.nombre) + '</span>' +
                    '<span class="tk-q">' + d.cantidad + '</span>' +
                    '<span class="tk-m"></span>' +
                    '<span class="tk-r"></span>' +
                '</div>';
            });
        });

        var indivMap = new Map();
        individuales.forEach(function(d) {
            var key = d.nombre + '|' + d.precioUnitario + '|' + (d.nombreOferta ?? '');
            if (!indivMap.has(key)) indivMap.set(key, Object.assign({}, d, { cantidad: 0, subtotal: 0 }));
            var g = indivMap.get(key);
            g.cantidad += d.cantidad;
            g.subtotal += d.subtotal;
        });

        var hayIndiv = false;
        indivMap.forEach(function(d) {
            if (!hayIndiv) { lineas += '<hr class="ticket-hr">'; hayIndiv = true; }
            var tieneOferta = d.precioNormal > d.precioUnitario;
            var precioHtml  = tieneOferta
                ? '<span class="ticket-strike">$' + fmt(d.precioNormal) + '</span> $' + fmt(d.precioUnitario)
                : '$' + fmt(d.precioUnitario);
            var badge = d.nombreOferta ? ' <em>(oferta)</em>' : '';
            var subtotalItem = d.precioUnitario * d.cantidad;
            lineas += '<div class="ticket-row ticket-grid">' +
                '<span class="tk-l">' + x(d.nombre) + badge + '</span>' +
                '<span class="tk-q">' + d.cantidad + '</span>' +
                '<span class="tk-m">' + precioHtml + '</span>' +
                '<span class="tk-r">$' + fmt(subtotalItem) + '</span>' +
            '</div>';
        });

        var subtotal = b.detalle
            .filter(function(d) { return !(d.precioNormal === 0 && !d.nombrePromocion && !d.nombreOferta); })
            .reduce(function(acc, d) { return acc + d.precioNormal * d.cantidad; }, 0);

        var descPromos = [];
        promoMap.forEach(function(g, nombre) {
            var ahorro = g.subtotalNormal - g.subtotalReal;
            if (ahorro > 0) descPromos.push({ nombre: nombre, ahorro: ahorro });
        });

        var descOfertas = [];
        individuales.filter(function(d) { return d.nombreOferta && d.precioNormal > d.precioUnitario; }).forEach(function(d) {
            var ahorro = (d.precioNormal - d.precioUnitario) * d.cantidad;
            if (ahorro > 0) descOfertas.push({ nombre: d.nombre, ahorro: ahorro });
        });

        var descTotal = descPromos.reduce(function(a,v) { return a + v.ahorro; }, 0)
                      + descOfertas.reduce(function(a,v) { return a + v.ahorro; }, 0);

        lineas += '<hr class="ticket-hr-sol">';
        lineas += '<div class="ticket-row"><span class="tk-l">Subtotal</span><span class="tk-r">$' + fmt(subtotal) + '</span></div>';
        descPromos.forEach(function(v) { lineas += '<div class="ticket-row ticket-desc"><span class="tk-l">Promo: ' + x(v.nombre) + '</span><span class="tk-r">-$' + fmt(v.ahorro) + '</span></div>'; });
        descOfertas.forEach(function(v) { lineas += '<div class="ticket-row ticket-desc"><span class="tk-l">Oferta: ' + x(v.nombre) + '</span><span class="tk-r">-$' + fmt(v.ahorro) + '</span></div>'; });
        if (descTotal > 0) lineas += '<div class="ticket-row ticket-desc ticket-bold"><span class="tk-l">Total descuentos</span><span class="tk-r">-$' + fmt(descTotal) + '</span></div>';

        if (envases.length > 0) {
            lineas += '<hr class="ticket-hr">';
            envases.forEach(function(d) {
                lineas += '<div class="ticket-row ticket-bottle-charge"><span class="tk-l">Envase: ' + x(d.nombre) + '</span><span class="tk-r">+$' + fmt(d.subtotal) + '</span></div>';
            });
        }

        lineas += '<div class="ticket-row ticket-total"><span class="tk-l">TOTAL</span><span class="tk-r">$' + fmt(b.total) + '</span></div>';

        var pickingMap = new Map();
        b.detalle.forEach(function(d) {
            var esEnvase = d.precioNormal === 0 && !d.nombrePromocion && !d.nombreOferta;
            if (esEnvase) return;
            if (!pickingMap.has(d.nombre)) {
                pickingMap.set(d.nombre, 0);
            }
            pickingMap.set(d.nombre, pickingMap.get(d.nombre) + d.cantidad);
        });

        var lineasVendedor = '';
        pickingMap.forEach(function(cantTotal, nombre) {
            lineasVendedor += '<div class="ticket-row">' +
                '<span class="tk-l">' + x(nombre) + '</span>' +
                '<span class="tk-r ticket-bold">' + cantTotal + '</span>' +
            '</div>';
        });

        var html = '<div class="ticket-overlay" id="ticketOverlay">' +
            '<div class="ticket-wrap">' +
                '<div class="ticket-actions">' +
                    '<button class="btn-print" onclick="window.print()">Imprimir</button>' +
                    '<button class="btn-cerrar" onclick="document.getElementById(\'ticketOverlay\').remove()">✕ Cerrar</button>' +
                '</div>';

        if (tipo === 'cliente') {
            html += '<div class="ticket ticket-cliente">' +
                '<div class="ticket-title ticket-bold">' + x(NOMBRE_LOCAL) + '</div>' +
                '<div class="ticket-subtitle ticket-bold" style="margin-top:2px;">TICKET N° ' + (b.correlativoDiario ?? b.id) + '</div>' +
                '<div class="ticket-sub-label">TICKET INTERNO</div>' +
                '<hr class="ticket-hr-sol">' +
                '<div class="ticket-row"><span class="tk-l">Fecha</span><span class="tk-r">' + x(b.fecha) + '</span></div>' +
                '<hr class="ticket-hr-sol">' +
                '<div class="ticket-row ticket-bold ticket-grid"><span class="tk-l">ARTÍCULO</span><span class="tk-q">CANT</span><span class="tk-m">P.UNIT</span><span class="tk-r">TOTAL</span></div>' +
                lineas +
                '<hr class="ticket-hr">' +
                '<div class="ticket-sub-label" style="margin-top:.5rem;">¡Gracias por su compra!</div>' +
            '</div>';
        } else if (tipo === 'vendedor') {
            html += '<div class="ticket ticket-vendedor">' +
                '<div class="ticket-title ticket-bold">LISTA DE DESPACHO</div>' +
                '<div class="ticket-subtitle ticket-bold" style="margin-top:2px;">TICKET N° ' + (b.correlativoDiario ?? b.id) + '</div>' +
                '<div class="ticket-sub-label">COPIA VENDEDOR</div>' +
                '<hr class="ticket-hr-sol">' +
                '<div class="ticket-row"><span class="tk-l">Fecha</span><span class="tk-r">' + x(b.fecha) + '</span></div>' +
                '<hr class="ticket-hr-sol">' +
                '<div class="ticket-row ticket-bold"><span class="tk-l">ARTÍCULO</span><span class="tk-r">CANT.</span></div>' +
                lineasVendedor +
                '<hr class="ticket-hr">' +
            '</div>';
        }

        html += '</div></div>';

        document.getElementById('ticketOverlay')?.remove();
        document.body.insertAdjacentHTML('beforeend', html);
    }

    /* â”€â”€ Inicializar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    // Primer render: usa la página que ya trajo el servidor con los mismos
    // filtros por defecto que muestran los selects, sin volver a pedirla por AJAX.
    renderLista(boletasPagina);
    renderControlesPag(Math.max(1, Math.ceil(totalActual / POR_PAG)), totalActual);

})();
</script>
}
