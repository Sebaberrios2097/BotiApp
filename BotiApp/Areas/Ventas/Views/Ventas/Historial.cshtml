.hist-panel-header .cnt-badge { margin-left:auto; background:var(--color-primario); color:#fff; border-radius:20px; padding:.1rem .55rem; font-size:.7rem; font-weight:700; }

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   FILTROS
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
.filtros-wrap { padding:.85rem 1rem; border-bottom:1px solid #f0ebe5; background:#faf7f5; display:flex; flex-direction:column; gap:.65rem; flex-shrink:0; }
.search-bar { display:flex; align-items:center; gap:.5rem; background:#fff; border:1.5px solid #e0d5cc; border-radius:8px; padding:.45rem .8rem; }
.search-bar svg { width:16px; height:16px; fill:var(--color-primario); opacity:.7; flex-shrink:0; }
.search-bar input { border:none; outline:none; font-size:.88rem; width:100%; background:transparent; color:var(--color-secundario); }
.search-bar .clr { background:none; border:none; cursor:pointer; color:#c9b8a8; font-size:1rem; display:none; flex-shrink:0; line-height:1; }
.search-bar .clr.on { display:block; }
.pills-row { display:flex; flex-wrap:wrap; gap:.35rem; }
.pill { padding:.3rem .75rem; border-radius:20px; font-size:.75rem; font-weight:600; border:1.5px solid #e0d5cc; background:#fff; color:#7a6050; cursor:pointer; transition:border-color .15s,background .15s,color .15s; white-space:nowrap; }
.pill:hover { border-color:var(--color-primario); color:var(--color-primario); }
.pill.active { background:var(--color-primario); border-color:var(--color-primario); color:#fff; }

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   LISTA DE BOLETAS
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
.boletas-list { padding:.75rem 1rem; display:flex; flex-direction:column; gap:.55rem; }

/* Card de boleta */
.bl-card { border:1.5px solid #ede5df; border-radius:11px; overflow:hidden; transition:border-color .15s,box-shadow .15s; }
.bl-card:hover { border-color:var(--color-primario); box-shadow:0 2px 10px rgba(231,111,46,.10); }
.bl-card.open { border-color:var(--color-primario); }

.bl-card-top { display:flex; align-items:center; gap:.75rem; padding:.6rem .9rem; cursor:pointer; background:#faf7f5; flex-wrap:wrap; user-select:none; }
.bl-card-top:hover { background:#f5efe9; }

.bl-num { font-size:.85rem; font-weight:700; color:var(--color-secundario); flex-shrink:0; min-width:70px; }
.bl-fecha { font-size:.78rem; color:#7a6050; flex-shrink:0; }
.bl-cajero { font-size:.78rem; color:#7a6050; flex:1; min-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.bl-cajero strong { color:var(--color-secundario); font-weight:700; }
.bl-estado { font-size:.68rem; font-weight:700; padding:.2rem .55rem; border-radius:20px; flex-shrink:0; }
.bl-estado.est-1 { background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0; }
.bl-estado.est-2 { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
.bl-estado.est-3 { background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0; }
.bl-estado.est-4 { background:#fffbeb; color:#d97706; border:1px solid #fde68a; }
.bl-estado.est-other { background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; }
.bl-total { font-size:.88rem; font-weight:700; color:var(--color-primario); flex-shrink:0; margin-left:auto; }
.bl-chevron { width:18px; height:18px; fill:#c9b8a8; flex-shrink:0; transition:transform .2s; }
.bl-card.open .bl-chevron { transform:rotate(180deg); fill:var(--color-primario); }

/* Detalle expandido */
.bl-detalle { display:none; padding:.5rem .9rem .75rem; border-top:1px solid #f0ebe5; background:#fff; }
.bl-card.open .bl-detalle { display:block; }

.bl-det-table { width:100%; border-collapse:collapse; font-size:.78rem; }
.bl-det-table th { text-align:left; padding:.3rem .5rem; color:#a89080; font-weight:600; border-bottom:1.5px solid #f0ebe5; }
.bl-det-table th:last-child, .bl-det-table td:last-child { text-align:right; }
.bl-det-table td { padding:.3rem .5rem; color:var(--color-secundario); border-bottom:1px solid #f8f4f1; }
.bl-det-table tr:last-child td { border-bottom:none; }
.bl-det-total { display:flex; justify-content:flex-end; gap:.5rem; align-items:center; margin-top:.55rem; padding-top:.45rem; border-top:1.5px solid #f0ebe5; }
.bl-det-total .lbl { font-size:.78rem; color:#a89080; font-weight:600; }
.bl-det-total .val { font-size:.95rem; font-weight:700; color:var(--color-primario); }
.etq-promo  { font-size:.62rem; font-weight:700; background:#fef3c7; color:#d97706; border-radius:4px; padding:.1rem .35rem; vertical-align:middle; white-space:nowrap; }
.etq-oferta { font-size:.62rem; font-weight:700; background:#ede9fe; color:#7c3aed; border-radius:4px; padding:.1rem .35rem; vertical-align:middle; white-space:nowrap; }
.etq-envase { font-size:.62rem; font-weight:700; background:#000 !important; color:#fff !important; border-radius:4px; padding:.1rem .35rem; vertical-align:middle; white-space:nowrap; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
.promo-gr-head td { background:#fffbeb; border-bottom:none !important; padding:.45rem .5rem !important; }
.promo-gr-item td { padding:.2rem .5rem .2rem 1.4rem !important; font-size:.75rem; color:#78716c; }
.promo-gr-sep td  { padding:0 !important; border-bottom:2px solid #fde68a !important; }
.precio-normal-tachado { text-decoration:line-through; color:#b8a898; font-size:.72rem; display:block; line-height:1.2; }
.precio-descuento { color:#16a34a; font-weight:700; }

/* Estado vacío */
.boletas-empty { text-align:center; padding:3.5rem 1rem; color:#b8a898; font-size:.88rem; }
.boletas-empty svg { width:52px; height:52px; fill:#ddd0c4; display:block; margin:0 auto .75rem; }

/* Paginación */
.pag-wrap { display:flex; align-items:center; justify-content:center; gap:.35rem; padding:.75rem 1rem; border-top:1px solid #f0ebe5; flex-shrink:0; }
.pag-btn { padding:.3rem .65rem; border-radius:7px; border:1.5px solid #e0d5cc; background:#fff; color:#7a6050; font-size:.78rem; font-weight:600; cursor:pointer; transition:border-color .13s,background .13s,color .13s; }
.pag-btn:hover { border-color:var(--color-primario); color:var(--color-primario); }
.pag-btn.active { background:var(--color-primario); border-color:var(--color-primario); color:#fff; }
.pag-btn:disabled { opacity:.4; cursor:default; border-color:#e0d5cc; background:#fff; color:#c9b8a8; }
.pag-info { font-size:.75rem; color:#a89080; padding:0 .35rem; }

/* Filtro estado */
.fil-estado { padding:.32rem .7rem; border:1.5px solid #e0d5cc; border-radius:8px; font-size:.8rem; color:var(--color-secundario); background:#fff; cursor:pointer; outline:none; transition:border-color .13s; }
.fil-estado:focus { border-color:var(--color-primario); }

/* Toast */
.toast-wrap { position:fixed; top:1.25rem; right:1.25rem; z-index:9999; display:flex; flex-direction:column; gap:.5rem; pointer-events:none; }
.toast-msg { display:flex; align-items:center; gap:.6rem; padding:.75rem 1.1rem; border-radius:10px; font-size:.88rem; font-weight:600; box-shadow:0 4px 16px rgba(0,0,0,.12); animation:toastIn .3s ease; }
.toast-msg svg { width:18px; height:18px; fill:currentColor; flex-shrink:0; }
.toast-msg.exito { background:#f0fdf4; color:#16a34a; border-left:4px solid #16a34a; }
.toast-msg.error { background:#fef2f2; color:#dc2626; border-left:4px solid #dc2626; }
@@keyframes toastIn { from{opacity:0;transform:translateX(30px)} to{opacity:1;transform:translateX(0)} }

/* ══════════════════════════════════════════════════════
   REIMPRIMIR
══════════════════════════════════════════════════════ */
.bl-reimprimir { display:inline-flex; align-items:center; gap:.4rem; padding:.38rem .85rem; border-radius:8px; border:1.5px solid var(--color-primario); background:#fff; color:var(--color-primario); font-size:.78rem; font-weight:700; cursor:pointer; transition:background .15s,color .15s; }
.bl-reimprimir:hover { background:var(--color-primario); color:#fff; }
.bl-reimprimir svg { width:15px; height:15px; fill:currentColor; }

/* ══════════════════════════════════════════════════════
   TICKET MODAL
══════════════════════════════════════════════════════ */
.ticket-overlay { position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:10000; display:flex; align-items:center; justify-content:center; animation:fadeInT .2s ease; }
@@keyframes fadeInT { from{opacity:0} to{opacity:1} }
.ticket-wrap { background:#fff; width:300px; max-height:92vh; overflow-y:auto; border-radius:8px; box-shadow:0 8px 32px rgba(0,0,0,.25); display:flex; flex-direction:column; }
.ticket-actions { display:flex; gap:.5rem; padding:.65rem .8rem; border-bottom:1px solid #eee; flex-shrink:0; background:#fff; position:sticky; top:0; z-index:1; }
.ticket-actions button { flex:1; padding:.5rem; border-radius:7px; border:none; font-size:.82rem; font-weight:700; cursor:pointer; transition:opacity .15s; }
.ticket-actions button:hover { opacity:.85; }
.btn-print  { background:var(--color-secundario); color:#fff; }
.btn-cerrar { background:#f0ebe5; color:var(--color-secundario); }
.ticket { font-family: 'Consolas', 'Lucida Console', 'Courier New', monospace; font-size:13px; line-height:1.35; padding: 0 .6rem .5rem .6rem; color:#000; }
.ticket-hr     { border:none !important; border-top:1px dashed #555 !important; margin:.25rem 0 !important; opacity:1 !important; }
.ticket-hr-sol { border:none !important; border-top:1px solid #555 !important;  margin:.25rem 0 !important; opacity:1 !important; }
.ticket-row { display:flex; justify-content:space-between; margin-bottom:1px; }
.ticket-row .tk-l { flex:1; min-width:0; overflow:hidden; text-overflow:clip; }
.ticket-row .tk-r { flex-shrink:0; padding-left:.5rem; text-align:right; }

/* Grid columns for ticket items */
.ticket-row.ticket-grid { font-size:11px; }
.ticket-row.ticket-grid .tk-l { flex:1; min-width:0; overflow:hidden; text-overflow:clip; }
.ticket-row.ticket-grid .tk-q { flex-shrink:0; padding-left:.25rem; text-align:right; width:35px; }
.ticket-row.ticket-grid .tk-m { flex-shrink:0; padding-left:.25rem; text-align:right; width:65px; }
.ticket-row.ticket-grid .tk-r { flex-shrink:0; padding-left:.25rem; text-align:right; width:70px; }
.ticket-total     { font-size:20px; font-weight:700; }
.ticket-bold      { font-weight:700; }
.ticket-center    { text-align:center; }
.ticket-desc      { color:#000; }
.ticket-promo-tag { font-size:13px; font-weight:700; }
.ticket-title { font-size:14px; font-weight:700; text-align:center; }
.ticket-subtitle { font-size:13px; font-weight:700; text-align:center; }
.ticket-sub-label { font-size:11px; text-align:center; }
.ticket-small { font-size:11px; }
.ticket-strike { text-decoration:line-through; font-size:10px; }
.ticket-bottle-charge {
    background-color: #000 !important;
    color: #fff !important;
    font-size: 11px;
    font-weight: bold;
    padding: 3px 6px;
    margin: 3px 0;
    border-radius: 2px;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
}
.ticket-bottle-charge * { color: #fff !important; }
@@page { size:80mm auto; margin:0; }
@@media print {
    html,body { margin:0 !important; padding:0 !important; background:#fff !important; }
    body > * { display:none !important; }
    .ticket-overlay { display:block !important; position:static !important; background:none !important; inset:auto !important; animation:none !important; }
    .ticket-actions { display:none !important; }
    .ticket-wrap { box-shadow:none !important; border-radius:0 !important; max-height:none !important; overflow:visible !important; width:80mm !important; }
    .ticket { padding: 0 2mm !important; font-size:11pt !important; line-height:1.4 !important; }
    .ticket-total { font-size:17pt !important; }
    .ticket-title { font-size:12pt !important; }
    .ticket-subtitle { font-size:11pt !important; }
    .ticket-sub-label { font-size:9.5pt !important; }
    .ticket-small { font-size:9.5pt !important; }
    .ticket-strike { font-size:8.5pt !important; }
    .ticket-bottle-charge { font-size:9.5pt !important; }
}
</style>

<div class="toast-wrap" id="toastWrap"></div>

<div class="page-header-card">
    <div class="phc-icon">
        <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/></svg>
    </div>
    <div>
        <h1 class="phc-title">Historial de Ventas</h1>
        <p class="phc-sub">Consulta y reimprime boletas registradas</p>
    </div>
    <div class="phc-badges">
        <span class="phc-badge naranja">
            <svg viewBox="0 0 24 24"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.95-2.05L6.64 18.36A9 9 0 1 0 13 3zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>
            @Model.Boletas.Count() registros
        </span>
    </div>
</div>

<div class="hist-panel">
    <div class="hist-panel-header">
        <svg viewBox="0 0 24 24"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.95-2.05L6.64 18.36A9 9 0 1 0 13 3zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>
        <span>Ventas registradas</span>
        <span class="cnt-badge" id="cntBoletas">@Model.Boletas.Count()</span>
    </div>

    @if (Model.EsAdmin || Model.Boletas.Any())
    {
        <div class="filtros-wrap">
            <div class="search-bar">
                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <input type="text" id="txtBuscar" placeholder="Buscar por N° boleta o cajero…"
                       oninput="aplicarFiltros()" autocomplete="off" />
                <button class="clr" id="btnClr" onclick="limpiarQ()" title="Limpiar">✕</button>
            </div>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;">
                <select class="fil-estado" id="selRangoFecha" onchange="aplicarFiltros()">
                    <option value="dia">Ventas del día</option>
                    <option value="historicas">Históricas (Todas)</option>
                </select>
                <select class="fil-estado" id="selEstado" onchange="aplicarFiltros()">
                    <option value="0">Todos los estados</option>
                    <option value="1">Pendiente</option>
                    <option value="3">Pagada</option>
                    <option value="2">Anulada</option>
                    <option value="4">Fiado</option>
                </select>
                <select class="fil-estado" id="selAnio" onchange="aplicarFiltros(true)">
                    <option value="">Todos los años</option>
                    @{
                        var anioActual = DateTime.Now.Year.ToString();
                        var aniosDisp  = Model.Boletas
                            .Where(b => b.FechaEmision != "—" && b.FechaEmision.Length >= 10)
                            .Select(b => b.FechaEmision.Substring(6, 4))
                            .Distinct()
                            .OrderByDescending(y => y);
                    }
                    @foreach (var anio in aniosDisp)
                    {
                        if (anio == anioActual)
                        {
                            <option value="@anio" selected>@anio</option>
                        }
                        else
                        {
                            <option value="@anio">@anio</option>
                        }
                    }
                </select>
                <select class="fil-estado" id="selMes" onchange="aplicarFiltros(true)">
                    <option value="">Todos los meses</option>
                    @{ var mesesNombres = new[]{"","Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"}; }
                    @for (int m = 1; m <= 12; m++)
                    {
                        if (m == DateTime.Now.Month)
                        {
                            <option value="@m" selected>Mes: @mesesNombres[m]</option>
                        }
                        else
                        {
                            <option value="@m">Mes: @mesesNombres[m]</option>
                        }
                    }
                </select>
                <select class="fil-estado" id="selDia" onchange="aplicarFiltros(true)">
                    <option value="">Todos los días</option>
                    @for (int d = 1; d <= 31; d++)
                    {
                        <option value="@d">Día: @d</option>
                    }
                </select>
            </div>

            @if (Model.EsAdmin)
            {
                <div class="pills-row" id="pillsVendedores">
                    <button class="pill active" data-vendedor="0" onclick="selVendedor(0)">Todas las ventas</button>
                    <button class="pill" data-vendedor="@Model.IdUsuarioActual" onclick="selVendedor(@Model.IdUsuarioActual)">Mis ventas</button>
                    @foreach (var v in Model.Vendedores.Where(v => v.IdUsuario != Model.IdUsuarioActual))
                    {
                        <button class="pill" data-vendedor="@v.IdUsuario" onclick="selVendedor(@v.IdUsuario)">@v.Nombre</button>
                    }
                </div>
            }
        </div>
    }

    <div class="boletas-list" id="boletasList"></div>
    <div class="pag-wrap" id="pagWrap" style="display:none;"></div>
</div>

@section Scripts {
<script>
(function () {

    /* â”€â”€ Datos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    var BOLETAS    = @Html.Raw(boletasJson);
    var ES_ADMIN   = @Html.Raw(Model.EsAdmin.ToString().ToLower());
    var ES_CAJERO  = @Html.Raw(Model.EsCajero.ToString().ToLower());
    var ID_USUARIO = @Model.IdUsuarioActual;

    // Ordenar DESC por N° de boleta una sola vez
    BOLETAS.sort(function(a, b) { return b.id - a.id; });

    /* â”€â”€ Estado paginaciÃ³n â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    var POR_PAG       = 10;
    var paginaActual  = 1;
    var vendedorActivo = 0;
    var boletasFiltradas = [];

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       FILTROS
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function parseFechaEmision(fechaStr) {
        if (!fechaStr || fechaStr === '—') return null;
        var parts = fechaStr.split(' ');
        var dParts = parts[0].split('/');
        var tParts = parts[1].split(':');
        return new Date(+dParts[2], +dParts[1] - 1, +dParts[0], +tParts[0], +tParts[1]);
    }

    function obtenerInicioDiaComercial() {
        var now = new Date();
        var inicio = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 8, 0, 0, 0);
        if (now.getHours() < 8) {
            inicio.setDate(inicio.getDate() - 1);
        }
        return inicio;
    }

    window.selVendedor = function (id) {
        vendedorActivo = id;
        document.querySelectorAll('#pillsVendedores .pill')
            .forEach(function(p) { p.classList.toggle('active', +p.dataset.vendedor === id); });
        aplicarFiltros();
    };

    window.aplicarFiltros = function (fromCalendarChange) {
        var q         = (document.getElementById('txtBuscar')?.value ?? '').trim().toLowerCase();
        var estadoSel = +(document.getElementById('selEstado')?.value ?? 0);
        var rangoSelEl = document.getElementById('selRangoFecha');
        var rangoSel  = rangoSelEl?.value ?? 'dia';
        
        if (fromCalendarChange && rangoSelEl && rangoSel === 'dia') {
            rangoSelEl.value = 'historicas';
            rangoSel = 'historicas';
        }
        
        var anioSel   = 0;
        var mesSel    = 0;
        var diaSel    = 0;
        
        if (rangoSel !== 'dia') {
            anioSel = +document.getElementById('selAnio')?.value || 0;
            mesSel  = +document.getElementById('selMes')?.value  || 0;
            diaSel  = +document.getElementById('selDia')?.value  || 0;
        }

        document.getElementById('btnClr')?.classList.toggle('on', q.length > 0);

        var inicioDia = obtenerInicioDiaComercial();

        boletasFiltradas = BOLETAS.filter(function(b) {
            var okRango = true;
            if (rangoSel === 'dia') {
                var dt = parseFechaEmision(b.fecha);
                okRango = dt && dt >= inicioDia;
            }

            var okVendedor = vendedorActivo === 0 || b.idVendedor === vendedorActivo;
            var okEstado   = estadoSel === 0 || b.idEstado  === estadoSel;
            var okAnio     = anioSel   === 0 || b.anio      === anioSel;
            var okMes      = mesSel    === 0 || b.mes       === mesSel;
            var okDia      = diaSel    === 0 || b.dia       === diaSel;
            var okQ = q === ''
                || String(b.id).includes(q)
                || String(b.correlativoDiario ?? '').includes(q)
                || b.vendedor.toLowerCase().includes(q)
                || b.fecha.toLowerCase().includes(q);
            return okRango && okVendedor && okEstado && okAnio && okMes && okDia && okQ;
        });

        paginaActual = 1;
        renderPagina();
    };

    window.limpiarQ = function () {
        document.getElementById('txtBuscar').value = '';
        aplicarFiltros();
    };

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       PAGINACIÃ“N
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function renderPagina() {
        var total  = boletasFiltradas.length;
        var paginas = Math.max(1, Math.ceil(total / POR_PAG));
        if (paginaActual > paginas) paginaActual = paginas;

        var inicio = (paginaActual - 1) * POR_PAG;
        var pagina = boletasFiltradas.slice(inicio, inicio + POR_PAG);

        document.getElementById('cntBoletas').textContent = total;
        renderLista(pagina);
        renderControlesPag(paginas, total);
    }

    function renderControlesPag(paginas, total) {
        var wrap = document.getElementById('pagWrap');
        if (paginas <= 1) { wrap.style.display = 'none'; return; }
        wrap.style.display = 'flex';

        var html = '';
        html += '<button class="pag-btn" onclick="irPag(' + (paginaActual - 1) + ')" ' + (paginaActual === 1 ? 'disabled' : '') + '>‹</button>';

        // Ventana de pÃ¡ginas: mÃ¡ximo 5 botones visibles
        var desde = Math.max(1, paginaActual - 2);
        var hasta  = Math.min(paginas, desde + 4);
        if (hasta - desde < 4) desde = Math.max(1, hasta - 4);

        for (var i = desde; i <= hasta; i++) {
            html += '<button class="pag-btn' + (i === paginaActual ? ' active' : '') + '" onclick="irPag(' + i + ')">' + i + '</button>';
        }

        html += '<button class="pag-btn" onclick="irPag(' + (paginaActual + 1) + ')" ' + (paginaActual === paginas ? 'disabled' : '') + '>›</button>';
        html += '<span class="pag-info">' + total + ' boletas</span>';
        wrap.innerHTML = html;
    }

    window.irPag = function(p) {
        var paginas = Math.max(1, Math.ceil(boletasFiltradas.length / POR_PAG));
        if (p < 1 || p > paginas) return;
        paginaActual = p;
        renderPagina();
        document.getElementById('boletasList').scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       RENDER LISTA
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function renderLista(lista) {
        var cont = document.getElementById('boletasList');

        if (!lista.length) {
            cont.innerHTML = `
            <div class="boletas-empty">
                <svg viewBox="0 0 24 24"><path d="M20 6h-2.18c.07-.44.18-.88.18-1.33C18 2.99 16.01 1 13.67 1c-1.32 0-2.4.75-3.17 1.69L10 3.5l-.5-.82C8.73 1.75 7.65 1 6.33 1 4 1 2 2.99 2 5.33c0 .45.1.89.18 1.33H0v2h20V6zm-8.5-.17c.38-.61.96-2.33 2.17-2.33 1 0 1.83.83 1.83 1.83 0 .67-.36 1.15-.88 1.5L12 8.5l-1.62-1.67.12-1zm-3 0L7.88 7.83C7.36 7.48 7 7 7 6.33 7 5.33 7.83 4.5 8.83 4.5c1.21 0 1.79 1.72 2.17 2.33zM4 20c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10H4v10z"/></svg>
                No hay ventas para mostrar
            </div>`;
            return;
        }

        cont.innerHTML = lista.map(function(b) {
            var estadoClass = b.idEstado === 1 ? 'est-1'
                            : b.idEstado === 2 ? 'est-2'
                            : b.idEstado === 3 ? 'est-3'
                            : b.idEstado === 4 ? 'est-4'
                            : 'est-other';
            var infoHtml = ES_ADMIN
                ? '<span class="bl-cajero"><strong>Vendedor:</strong> ' + x(b.vendedor) + '</span>' + (b.cajero ? ' <span class="bl-cajero"><strong>Cajero:</strong> ' + x(b.cajero) + '</span>' : '')
                : ES_CAJERO
                    ? '<span class="bl-cajero"><strong>Vendedor:</strong> ' + x(b.vendedor) + '</span>'
                    : '';
            // Separar ítems con y sin promoción
            var promoItems   = b.detalle.filter(function(d) { return !!d.nombrePromocion; });
            var noPromoItems = b.detalle.filter(function(d) { return !d.nombrePromocion; });

            // Agrupar ítems de promo por nombre de promoción
            var promoMap = new Map();
            promoItems.forEach(function(d) {
                if (!promoMap.has(d.nombrePromocion))
                    promoMap.set(d.nombrePromocion, { subtotal: 0, items: [] });
                var g = promoMap.get(d.nombrePromocion);
                g.subtotal += d.subtotal;
                g.items.push(d);
            });

            var detalleRows = '';

            // Rendir grupos de promoción
            promoMap.forEach(function(g, nombrePromo) {
                // Consolidar productos repetidos (promo añadida varias veces)
                var itemMap = new Map();
                g.items.forEach(function(d) {
                    var key = d.nombre + '|' + d.precioUnitario;
                    if (!itemMap.has(key))
                        itemMap.set(key, { nombre: d.nombre, precioUnitario: d.precioUnitario, precioNormal: d.precioNormal, cantidad: 0, subtotal: 0 });
                    var it = itemMap.get(key);
                    it.cantidad += d.cantidad;
                    it.subtotal += d.subtotal;
                });
                // Cabecera de la promo
                detalleRows += '<tr class="promo-gr-head">'
                    + '<td colspan="3"><span class="etq-promo">Promo: ' + x(nombrePromo) + '</span></td>'
                    + '<td style="text-align:right;font-weight:700;color:#d97706;">$' + fmt(g.subtotal) + '</td>'
                    + '</tr>';
                // Ítems de la promo
                itemMap.forEach(function(d) {
                    detalleRows += '<tr class="promo-gr-item">'
                        + '<td>' + x(d.nombre) + '</td>'
                        + '<td style="text-align:center;">' + d.cantidad + '</td>'
                        + '<td style="text-align:right;"></td>'
                        + '<td style="text-align:right;"></td>'
                        + '</tr>';
                });
                // Separador visual
                detalleRows += '<tr class="promo-gr-sep"><td colspan="4"></td></tr>';
            });

            // Rendir ítems individuales (sin promo)
            noPromoItems.forEach(function(d) {
                var esEnvase = d.precioNormal === 0 && !d.nombrePromocion && !d.nombreOferta;
                var tieneDescuento = d.precioNormal > d.precioUnitario;
                var badge = esEnvase ? ' <span class="etq-envase">⚡ ENVASE</span>' : (d.nombreOferta ? ' <span class="etq-oferta">✦ Oferta</span>' : '');
                var precioHtml = esEnvase ? '$' + fmt(d.precioUnitario) : (tieneDescuento
                    ? '<span class="precio-normal-tachado">$' + fmt(d.precioNormal) + '</span><span class="precio-descuento">$' + fmt(d.precioUnitario) + '</span>'
                    : '$' + fmt(d.precioUnitario));
                detalleRows += '<tr>'
                    + '<td>' + x(d.nombre) + badge + '</td>'
                    + '<td style="text-align:center;">' + d.cantidad + '</td>'
                    + '<td style="text-align:right;">' + precioHtml + '</td>'
                    + '<td style="text-align:right;">$' + fmt(d.subtotal) + '</td>'
                    + '</tr>';
            });

            var totalLabel = b.idEstado === 4 ? 'Monto fiado' : b.idEstado === 1 ? 'Monto pendiente' : 'Total pagado';

            return '<div class="bl-card" id="blc-' + b.id + '">' +
                '<div class="bl-card-top" onclick="toggleDetalle(' + b.id + ')">' +
                    '<span class="bl-num">' + (b.correlativoDiario ? 'Ticket #' + b.correlativoDiario : 'Ticket #' + b.id) + '</span>' +
                    '<span class="bl-fecha">' + x(b.fecha) + '</span>' +
                    infoHtml +
                    '<span class="bl-estado ' + estadoClass + '">' + x(b.estado) + '</span>' +
                    '<span class="bl-total">$' + fmt(b.total) + '</span>' +
                    '<svg class="bl-chevron" viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>' +
                '</div>' +
                '<div class="bl-detalle">' +
                    '<table class="bl-det-table">' +
                        '<thead><tr><th>Producto</th><th style="text-align:center;">Cant.</th><th style="text-align:right;">P. Unit.</th><th style="text-align:right;">Subtotal</th></tr></thead>' +
                        '<tbody>' + detalleRows + '</tbody>' +
                    '</table>' +
                    '<div class="bl-det-total"><span class="lbl">' + totalLabel + '</span><span class="val">$' + fmt(b.total) + '</span></div>' +
                    '<div style="display:flex;justify-content:flex-end;margin-top:.55rem;gap:.5rem;flex-wrap:wrap;">' +
                        '<button class="bl-reimprimir" onclick="event.stopPropagation();reimprimir(' + b.id + ', \'cliente\')">' +
                            '<svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/></svg>' +
                            'Reimprimir Ticket Cliente' +
                        '</button>' +
                        '<button class="bl-reimprimir" onclick="event.stopPropagation();reimprimir(' + b.id + ', \'vendedor\')">' +
                            '<svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/></svg>' +
                            'Reimprimir Ticket Vendedor' +
                        '</button>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }).join('');
    }

    /* â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• 
       TOGGLE DETALLE
    â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â•  */
    window.toggleDetalle = function (id) {
        var card = document.getElementById('blc-' + id);
        if (!card) return;
        card.classList.toggle('open');
    };

    /* â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• 
       UTILIDADES
    â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â• â•  */
    function fmt(n) { return Number(n).toLocaleString('es-CL'); }
    function x(s) {
        return String(s ?? '')
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /* ══════════════════════════════════════════════════════════════════════
       REIMPRIMIR
    ══════════════════════════════════════════════════════════════════════ */
    window.reimprimir = function (id, tipo) {
        var b = BOLETAS.find(function(b) { return b.id === id; });
        if (!b) return;
        mostrarTicketHistorial(b, tipo);
    };

    function mostrarTicketHistorial(b, tipo) {
        var NOMBRE_LOCAL = 'Cuatro Ases';
        var lineas = '';

        var envases      = b.detalle.filter(function(d) { return d.precioNormal === 0 && !d.nombrePromocion && !d.nombreOferta; });
        var promoItems   = b.detalle.filter(function(d) { return d.nombrePromocion; });
        var individuales = b.detalle.filter(function(d) { return !d.nombrePromocion && !(d.precioNormal === 0 && !d.nombreOferta); });

        var promoMap = new Map();
        promoItems.forEach(function(d) {
            if (!promoMap.has(d.nombrePromocion)) promoMap.set(d.nombrePromocion, { subtotalReal: 0, subtotalNormal: 0, items: [] });
            var g = promoMap.get(d.nombrePromocion);
            g.subtotalReal   += d.subtotal;
            g.subtotalNormal += d.precioNormal * d.cantidad;
            g.items.push(d);
        });

        promoMap.forEach(function(g, nombrePromo) {
            var itemMap = new Map();
            g.items.forEach(function(d) {
                var key = d.nombre + '|' + d.precioNormal;
                if (!itemMap.has(key)) itemMap.set(key, Object.assign({}, d, { cantidad: 0 }));
                itemMap.get(key).cantidad += d.cantidad;
            });
            lineas += '<hr class="ticket-hr">';
            lineas += '<div class="ticket-row ticket-promo-tag"><span class="tk-l">Promo: ' + x(nombrePromo) + '</span><span class="tk-r ticket-bold">$' + fmt(g.subtotalReal) + '</span></div>';
            itemMap.forEach(function(d) {
                lineas += '<div class="ticket-row ticket-grid" style="padding-left:.8rem;">' +
                    '<span class="tk-l">' + x(d.nombre) + '</span>' +
                    '<span class="tk-q">' + d.cantidad + '</span>' +
                    '<span class="tk-m"></span>' +
                    '<span class="tk-r"></span>' +
                '</div>';
            });
        });

        var indivMap = new Map();
        individuales.forEach(function(d) {
            var key = d.nombre + '|' + d.precioUnitario + '|' + (d.nombreOferta ?? '');
            if (!indivMap.has(key)) indivMap.set(key, Object.assign({}, d, { cantidad: 0, subtotal: 0 }));
            var g = indivMap.get(key);
            g.cantidad += d.cantidad;
            g.subtotal += d.subtotal;
        });

        var hayIndiv = false;
        indivMap.forEach(function(d) {
            if (!hayIndiv) { lineas += '<hr class="ticket-hr">'; hayIndiv = true; }
            var tieneOferta = d.precioNormal > d.precioUnitario;
            var precioHtml  = tieneOferta
                ? '<span class="ticket-strike">$' + fmt(d.precioNormal) + '</span> $' + fmt(d.precioUnitario)
                : '$' + fmt(d.precioUnitario);
            var badge = d.nombreOferta ? ' <em>(oferta)</em>' : '';
            var subtotalItem = d.precioUnitario * d.cantidad;
            lineas += '<div class="ticket-row ticket-grid">' +
                '<span class="tk-l">' + x(d.nombre) + badge + '</span>' +
                '<span class="tk-q">' + d.cantidad + '</span>' +
                '<span class="tk-m">' + precioHtml + '</span>' +
                '<span class="tk-r">$' + fmt(subtotalItem) + '</span>' +
            '</div>';
        });

        var subtotal = b.detalle
            .filter(function(d) { return !(d.precioNormal === 0 && !d.nombrePromocion && !d.nombreOferta); })
            .reduce(function(acc, d) { return acc + d.precioNormal * d.cantidad; }, 0);

        var descPromos = [];
        promoMap.forEach(function(g, nombre) {
            var ahorro = g.subtotalNormal - g.subtotalReal;
            if (ahorro > 0) descPromos.push({ nombre: nombre, ahorro: ahorro });
        });

        var descOfertas = [];
        individuales.filter(function(d) { return d.nombreOferta && d.precioNormal > d.precioUnitario; }).forEach(function(d) {
            var ahorro = (d.precioNormal - d.precioUnitario) * d.cantidad;
            if (ahorro > 0) descOfertas.push({ nombre: d.nombre, ahorro: ahorro });
        });

        var descTotal = descPromos.reduce(function(a,v) { return a + v.ahorro; }, 0)
                      + descOfertas.reduce(function(a,v) { return a + v.ahorro; }, 0);

        lineas += '<hr class="ticket-hr-sol">';
        lineas += '<div class="ticket-row"><span class="tk-l">Subtotal</span><span class="tk-r">$' + fmt(subtotal) + '</span></div>';
        descPromos.forEach(function(v) { lineas += '<div class="ticket-row ticket-desc"><span class="tk-l">Promo: ' + x(v.nombre) + '</span><span class="tk-r">-$' + fmt(v.ahorro) + '</span></div>'; });
        descOfertas.forEach(function(v) { lineas += '<div class="ticket-row ticket-desc"><span class="tk-l">Oferta: ' + x(v.nombre) + '</span><span class="tk-r">-$' + fmt(v.ahorro) + '</span></div>'; });
        if (descTotal > 0) lineas += '<div class="ticket-row ticket-desc ticket-bold"><span class="tk-l">Total descuentos</span><span class="tk-r">-$' + fmt(descTotal) + '</span></div>';

        if (envases.length > 0) {
            lineas += '<hr class="ticket-hr">';
            envases.forEach(function(d) {
                lineas += '<div class="ticket-row ticket-bottle-charge"><span class="tk-l">Envase: ' + x(d.nombre) + '</span><span class="tk-r">+$' + fmt(d.subtotal) + '</span></div>';
            });
        }

        lineas += '<div class="ticket-row ticket-total"><span class="tk-l">TOTAL</span><span class="tk-r">$' + fmt(b.total) + '</span></div>';

        var pickingMap = new Map();
        b.detalle.forEach(function(d) {
            var esEnvase = d.precioNormal === 0 && !d.nombrePromocion && !d.nombreOferta;
            if (esEnvase) return;
            if (!pickingMap.has(d.nombre)) {
                pickingMap.set(d.nombre, 0);
            }
            pickingMap.set(d.nombre, pickingMap.get(d.nombre) + d.cantidad);
        });

        var lineasVendedor = '';
        pickingMap.forEach(function(cantTotal, nombre) {
            lineasVendedor += '<div class="ticket-row">' +
                '<span class="tk-l">' + x(nombre) + '</span>' +
                '<span class="tk-r ticket-bold">' + cantTotal + '</span>' +
            '</div>';
        });

        var html = '<div class="ticket-overlay" id="ticketOverlay">' +
            '<div class="ticket-wrap">' +
                '<div class="ticket-actions">' +
                    '<button class="btn-print" onclick="window.print()">Imprimir</button>' +
                    '<button class="btn-cerrar" onclick="document.getElementById(\'ticketOverlay\').remove()">✕ Cerrar</button>' +
                '</div>';

        if (tipo === 'cliente') {
            html += '<div class="ticket ticket-cliente">' +
                '<div class="ticket-title ticket-bold">' + x(NOMBRE_LOCAL) + '</div>' +
                '<div class="ticket-subtitle ticket-bold" style="margin-top:2px;">TICKET N° ' + (b.correlativoDiario ?? b.id) + '</div>' +
                '<div class="ticket-sub-label">TICKET INTERNO</div>' +
                '<hr class="ticket-hr-sol">' +
                '<div class="ticket-row"><span class="tk-l">Fecha</span><span class="tk-r">' + x(b.fecha) + '</span></div>' +
                '<hr class="ticket-hr-sol">' +
                '<div class="ticket-row ticket-bold ticket-grid"><span class="tk-l">ARTÍCULO</span><span class="tk-q">CANT</span><span class="tk-m">P.UNIT</span><span class="tk-r">TOTAL</span></div>' +
                lineas +
                '<hr class="ticket-hr">' +
                '<div class="ticket-sub-label" style="margin-top:.5rem;">¡Gracias por su compra!</div>' +
            '</div>';
        } else if (tipo === 'vendedor') {
            html += '<div class="ticket ticket-vendedor">' +
                '<div class="ticket-title ticket-bold">LISTA DE DESPACHO</div>' +
                '<div class="ticket-subtitle ticket-bold" style="margin-top:2px;">TICKET N° ' + (b.correlativoDiario ?? b.id) + '</div>' +
                '<div class="ticket-sub-label">COPIA VENDEDOR</div>' +
                '<hr class="ticket-hr-sol">' +
                '<div class="ticket-row"><span class="tk-l">Fecha</span><span class="tk-r">' + x(b.fecha) + '</span></div>' +
                '<hr class="ticket-hr-sol">' +
                '<div class="ticket-row ticket-bold"><span class="tk-l">ARTÍCULO</span><span class="tk-r">CANT.</span></div>' +
                lineasVendedor +
                '<hr class="ticket-hr">' +
            '</div>';
        }

        html += '</div></div>';

        document.getElementById('ticketOverlay')?.remove();
        document.body.insertAdjacentHTML('beforeend', html);
    }

    /* â”€â”€ Inicializar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    aplicarFiltros();

})();
</script>
}
