}
.hist-spinner-overlay.visible { display:flex; }
.hist-spinner { width:32px; height:32px; border:3px solid #ede5df; border-top-color:var(--color-primario); border-radius:50%; animation:histSpin .7s linear infinite; }
@@keyframes histSpin { to { transform:rotate(360deg); } }

/* Paginación */
.pag-wrap { display:flex; align-items:center; justify-content:center; gap:.35rem; padding:.75rem 1rem; border-top:1px solid #f0ebe5; flex-shrink:0; }
.pag-btn { padding:.3rem .65rem; border-radius:7px; border:1.5px solid #e0d5cc; background:#fff; color:#7a6050; font-size:.78rem; font-weight:600; cursor:pointer; transition:border-color .13s,background .13s,color .13s; }
.pag-btn:hover { border-color:var(--color-primario); color:var(--color-primario); }
.pag-btn.active { background:var(--color-primario); border-color:var(--color-primario); color:#fff; }
.pag-btn:disabled { opacity:.4; cursor:default; border-color:#e0d5cc; background:#fff; color:#c9b8a8; }
.pag-info { font-size:.75rem; color:#a89080; padding:0 .35rem; }

/* Filtro estado */
.fil-estado { padding:.32rem .7rem; border:1.5px solid #e0d5cc; border-radius:8px; font-size:.8rem; color:var(--color-secundario); background:#fff; cursor:pointer; outline:none; transition:border-color .13s; }
.fil-estado:focus { border-color:var(--color-primario); }

/* Toast */
.toast-wrap { position:fixed; top:1.25rem; right:1.25rem; z-index:9999; display:flex; flex-direction:column; gap:.5rem; pointer-events:none; }
.toast-msg { display:flex; align-items:center; gap:.6rem; padding:.75rem 1.1rem; border-radius:10px; font-size:.88rem; font-weight:600; box-shadow:0 4px 16px rgba(0,0,0,.12); animation:toastIn .3s ease; }
.toast-msg svg { width:18px; height:18px; fill:currentColor; flex-shrink:0; }
.toast-msg.exito { background:#f0fdf4; color:#16a34a; border-left:4px solid #16a34a; }
.toast-msg.error { background:#fef2f2; color:#dc2626; border-left:4px solid #dc2626; }
@@keyframes toastIn { from{opacity:0;transform:translateX(30px)} to{opacity:1;transform:translateX(0)} }

/* ══════════════════════════════════════════════════════
   REIMPRIMIR
══════════════════════════════════════════════════════ */
.bl-reimprimir { display:inline-flex; align-items:center; gap:.4rem; padding:.38rem .85rem; border-radius:8px; border:1.5px solid var(--color-primario); background:#fff; color:var(--color-primario); font-size:.78rem; font-weight:700; cursor:pointer; transition:background .15s,color .15s; }
