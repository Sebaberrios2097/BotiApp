                generarBoleta(false, true);
            }
        });
    };

    // ── NAVEGACIÓN EN GRILLA CON FLECHAS DE DIRECCIÓN ────────────────────
    function navigateGrid(key) {
        const cards = Array.from(document.querySelectorAll('.tab-pane:not(.hidden) .prod-card:not(.sin-stock), .tab-pane:not(.hidden) .promo-card:not(.sin-stock-promo)'));
        if (cards.length === 0) return;

        const active = document.activeElement;
        const index = cards.indexOf(active);
        if (index === -1) {
            cards[0].focus();
            return;
        }

        let nextIndex = index;
        if (key === 'ArrowLeft') {
            nextIndex = Math.max(0, index - 1);
        } else if (key === 'ArrowRight') {
            nextIndex = Math.min(cards.length - 1, index + 1);
        } else if (key === 'ArrowUp' || key === 'ArrowDown') {
            const activeRect = active.getBoundingClientRect();
            const activeLeft = activeRect.left;
            
            let bestMatch = null;
            let minDiff = Infinity;

            for (let i = 0; i < cards.length; i++) {
                if (i === index) continue;
                const cardRect = cards[i].getBoundingClientRect();
                
                if (key === 'ArrowUp' && cardRect.bottom <= activeRect.top + 5) {
                    const diff = Math.abs(cardRect.left - activeLeft);
                    if (diff < minDiff || (diff === minDiff && cardRect.top > (bestMatch ? bestMatch.rect.top : -Infinity))) {
                        minDiff = diff;
                        bestMatch = { index: i, rect: cardRect };
                    }
                } else if (key === 'ArrowDown' && cardRect.top >= activeRect.bottom - 5) {
                    const diff = Math.abs(cardRect.left - activeLeft);
                    if (diff < minDiff || (diff === minDiff && cardRect.top < (bestMatch ? bestMatch.rect.top : Infinity))) {
                        minDiff = diff;
                        bestMatch = { index: i, rect: cardRect };
                    }
                }
            }
            if (bestMatch !== null) {
                nextIndex = bestMatch.index;
            }
        }

        if (nextIndex !== index && cards[nextIndex]) {
            cards[nextIndex].focus();
        }
    }

    // ── LECTOR DE CÓDIGO DE BARRAS (SCANNER) Y ATAJOS DE TECLADO ──────────
    let barcodeBuffer = '';
    let lastKeyTime   = Date.now();

    if (window._cajaKeyDownHandler) {
        window.removeEventListener('keydown', window._cajaKeyDownHandler);
        window._cajaKeyDownHandler = null;
    }

    if (window._generarVentaKeyDownHandler) {
        window.removeEventListener('keydown', window._generarVentaKeyDownHandler, true);
    }

    window._generarVentaKeyDownHandler = function (e) {
        if (e.key === 'Shift' || e.key === 'Control' || e.key === 'Alt' || e.key === 'Meta') {
            return;
        }

        // 0. Si el modal de envase está abierto:
        const envaseOverlay = document.getElementById('envaseOverlay');
        if (envaseOverlay && envaseOverlay.style.display === 'flex') {
            if (e.key === 'Enter' || e.code === 'NumpadEnter') {
                e.preventDefault();
                e.stopPropagation();
                confirmarEnvase(true);
                return;
            }
            if (e.key === ' ' || e.code === 'Space' || e.key === 'Spacebar') {
                e.preventDefault();
                e.stopPropagation();
                confirmarEnvase(false);
                return;
            }
            if (e.key === 'Escape') {
                e.preventDefault();
                cerrarDialogoEnvase();
                return;
            }
        }

        // 1. Si SweetAlert2 está visible (confirmaciones)
        if (Swal.isVisible()) {
            if (e.key === 'Enter' || e.code === 'NumpadEnter') {
                e.preventDefault();
                e.stopPropagation();
                Swal.clickConfirm();
                return;
            }
            if (e.key === 'Escape') {
                e.preventDefault();
                e.stopPropagation();
                Swal.clickCancel();
                return;
            }
        }

        // 2. Tecla Delete / Suprimir -> Limpiar carrito
        if (e.key === 'Delete' || e.code === 'Delete') {
            if (carrito.size > 0 || promoCarrito.size > 0) {
                e.preventDefault();
                e.stopPropagation();
                confirmarLimpiarCarrito();
            }
            return;
        }

        // 3. Atajos absolutos (NumpadEnter, F1, F2, F4)
        if (e.code === 'NumpadEnter' || e.key === 'F1' || e.key === 'F2' || e.key === 'F4') {
            if (carrito.size === 0 && promoCarrito.size === 0) return;
            e.preventDefault();
            e.stopPropagation();

            if (Swal.isVisible()) {
                Swal.clickConfirm();
            } else if (e.key === 'F4') {
                confirmarPostergarVenta();
            } else {
                confirmarVentaShortcut(e.key === 'F2');
            }
            return;
        }

        // 2. F3: Guardar venta sin emitir ticket (si hay productos en el carrito);
        //    si el carrito está vacío, enfocar y seleccionar el buscador
        if (e.key === 'F3') {
            e.preventDefault();
            e.stopPropagation();

            if (carrito.size > 0 || promoCarrito.size > 0) {
                if (Swal.isVisible()) {
                    Swal.clickConfirm();
                } else {
                    confirmarVentaSinTicket();
                }
                return;
            }

            const txtBuscar = document.getElementById('txtBuscar');
            if (txtBuscar) {
                txtBuscar.focus();
                txtBuscar.select();
            }
            return;
        }

        // 3. Escape: Limpiar buscador o cerrar overlays
        if (e.key === 'Escape') {
            e.preventDefault();
            const txtBuscar = document.getElementById('txtBuscar');
            if (txtBuscar && document.activeElement === txtBuscar) {
                txtBuscar.value = '';
                aplicarFiltros();
                txtBuscar.blur();
            } else if (document.getElementById('gruposOverlay')?.style.display === 'flex') {
                cerrarDialogoGrupos();
            } else if (document.getElementById('envaseOverlay')?.style.display === 'flex') {
                cerrarDialogoEnvase();
            } else if (document.getElementById('ticketOverlay')) {
                document.getElementById('ticketOverlay').remove();
            }
            return;
        }

        // 4. Navegación por flechas de dirección (si una tarjeta está enfocada)
        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
            const active = document.activeElement;
            if (active && (active.classList.contains('prod-card') || active.classList.contains('promo-card'))) {
                e.preventDefault();
                navigateGrid(e.key);
                return;
            }
        }

        // 5. Enter
        if (e.key === 'Enter') {
            // Si hay buffer de escaneo, procesarlo primero como escáner
            if (barcodeBuffer.length > 0) {
                const code = barcodeBuffer.trim();
                barcodeBuffer = '';

                const prod = CATALOGO.find(p => p.codigo && p.codigo.trim() === code);
                if (prod) {
                    e.preventDefault();
                    e.stopPropagation();

                    const txtBuscar = document.getElementById('txtBuscar');
                    if (txtBuscar && document.activeElement === txtBuscar) {
                        txtBuscar.value = '';
                        aplicarFiltros();
                    }

                    toggleProducto(prod.id, prod.nombre, prod.precio, prod.stock);
                } else {
                    if (code.length >= 3) {
                        e.preventDefault();
                        e.stopPropagation();

                        const txtBuscar = document.getElementById('txtBuscar');
                        if (txtBuscar && document.activeElement === txtBuscar) {
                            txtBuscar.value = '';
                            aplicarFiltros();
                        }
                        toast(`Código "${code}" no encontrado`, 'error');
                    }
                }
                return;
            }

            // Si SweetAlert está visible, enter confirma
            if (Swal.isVisible()) {
                return;
            }

            // Si está enfocada una tarjeta, hacer click (agregar)
            const active = document.activeElement;
            if (active && (active.classList.contains('prod-card') || active.classList.contains('promo-card'))) {
                e.preventDefault();
                active.click();
                return;
            }

            // Si no estamos en el buscador, y presionan enter
            const txtBuscar = document.getElementById('txtBuscar');
            if (txtBuscar && document.activeElement !== txtBuscar) {
                if (carrito.size > 0 || promoCarrito.size > 0) {
                    e.preventDefault();
                    confirmarVentaShortcut(false);
                }
            }
            return;
        }

        // 6. Espacio en tarjeta enfocada
        if (e.key === ' ' || e.code === 'Space') {
            const active = document.activeElement;
            if (active && (active.classList.contains('prod-card') || active.classList.contains('promo-card'))) {
                e.preventDefault();
                active.click();
                return;
            }
        }

        // 7. Lectura de teclas del escáner
        const currentTime = Date.now();
        const timeDiff = currentTime - lastKeyTime;
        lastKeyTime = currentTime;

        if (timeDiff > 50) {
            barcodeBuffer = '';
        }

        if (e.key.length === 1) {
            barcodeBuffer += e.key;
        }
    };

    // Se registra en fase de captura para que se ejecute antes que el listener
    // interno de SweetAlert2 (que corre en fase de burbuja sobre document y
    // detiene la propagación), garantizando que F1/F2/F3/F4 puedan reconfirmar
    // el diálogo abierto con una segunda pulsación.
    window.addEventListener('keydown', window._generarVentaKeyDownHandler, true);

    renderGrid(CATALOGO);
    renderPromoGrid();
    actualizarTotales(); // Mostrar $0 desde el inicio
    cargarPostergadas();

})();
</script>
}
