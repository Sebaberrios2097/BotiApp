@using System.Text.Json
@model BotiApp.Areas.Ventas.Models.GenerarVentaViewModel
@{
    ViewData["Title"] = "Generar Venta";

    // Mapa idProducto → mejor precio oferta activa
    var ofertasMap = Model.Ofertas
        .GroupBy(o => o.IdProducto)
        .ToDictionary(g => g.Key, g => g.Min(o => o.PrecioOferta));

    // Mapa idProducto → id de la oferta activa con menor precio
    var ofertaIdMap = Model.Ofertas
        .GroupBy(o => o.IdProducto)
        .ToDictionary(g => g.Key, g => g.OrderBy(o => o.PrecioOferta).First().IdOfertaProducto);

    var catalogoJson = JsonSerializer.Serialize(Model.Productos.Where(p => p.IdProducto != 0).Select(p => new
    {
        id          = p.IdProducto,
        nombre      = p.NombreProducto,
        descripcion = p.Descripción ?? "",
        codigo      = p.Codigo ?? "",
        precio      = p.Precio,
        stock       = p.Stock,
        idTipo      = p.IdTipoProducto,
        idMarca     = p.IdMarca,
        marca       = p.IdMarcaNavigation?.NombreMarca ?? "",
        tipo        = p.IdTipoProductoNavigation?.NombreTipoProducto ?? "",
        tieneImagen = p.Imagen is { Length: > 0 },
        ofertaPrecio = ofertasMap.TryGetValue(p.IdProducto, out var op) ? (int?)op : null,
        ofertaId     = ofertaIdMap.TryGetValue(p.IdProducto, out var oid) ? (int?)oid : null,
        retornable   = p.ProProductosRetornables != null
                       ? new { valorEnvase = p.ProProductosRetornables.ValorEnvase, soloEfectivo = p.ProProductosRetornables.SoloEfectivo }
                       : (object?)null
    }));

    var promosJson = JsonSerializer.Serialize(Model.Promociones.Select(p => new
    {
        id     = p.IdPromocion,
        nombre = p.Nombre,
        precio = p.PrecioPromocion,
        // Productos sin grupo → siempre requeridos
        productosBase = p.ProPromocionDetalle
            .Where(d => d.IdGrupo == null)
            .Select(d => new { idProducto = d.IdProducto, cantidad = d.Cantidad }),
        // Grupos con su flag de exclusividad y sus productos
        grupos = p.ProPromocionGrupo.Select(g => new
        {
            idGrupo      = g.IdGrupo,
            esExcluyente = g.EsExcluyente,
            productos    = p.ProPromocionDetalle
                .Where(d => d.IdGrupo == g.IdGrupo)
                .Select(d => new { idProducto = d.IdProducto, cantidad = d.Cantidad })
        })
    }));

    var urlImagen = Url.Action("Imagen", "Productos", new { area = "Productos", id = 0 })!.Replace("/0", "");
    var urlCrear  = Url.Action("CrearBoletaAjax", "Ventas", new { area = "Ventas" });

    var urlPostergar         = Url.Action("PostergarVentaAjax",           "Ventas", new { area = "Ventas" });
    var urlPostergadas       = Url.Action("VentasPostergadasAjax",        "Ventas", new { area = "Ventas" });
    var urlRecuperarPostergada = Url.Action("RecuperarVentaPostergadaAjax", "Ventas", new { area = "Ventas" });
    var urlDescartarPostergada = Url.Action("DescartarVentaPostergadaAjax", "Ventas", new { area = "Ventas" });
}

<style>
/* ══════════════════════════════════════════════════════
   LAYOUT
══════════════════════════════════════════════════════ */
.gv-wrap { display:grid; grid-template-columns: 1fr 1fr 208px; gap:1.25rem; align-items:stretch; }
