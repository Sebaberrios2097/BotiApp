            }
        });
    };

    // ── CONFIRMACIÓN DE VENTA SIN EMITIR TICKET (F3) ──────────────────────
    window.confirmarVentaSinTicket = function () {
        if (carrito.size === 0 && promoCarrito.size === 0) return;

        if (Swal.isVisible()) {
            return;
        }

        Swal.fire({
            title: '¿Confirmar venta?',
