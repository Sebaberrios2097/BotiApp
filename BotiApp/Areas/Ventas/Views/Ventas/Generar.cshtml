.grupos-promo-nombre { font-size:1rem; font-weight:700; color:var(--color-secundario); margin-bottom:1rem; }
.grupos-section { margin-bottom:.9rem; }
.grupos-section-lbl { font-size:.74rem; font-weight:700; color:#92400e; text-transform:uppercase; letter-spacing:.04em; margin-bottom:.4rem; }
.grupos-opts { display:flex; flex-direction:column; gap:.3rem; }
.goc { background:#faf7f5; border:1.5px solid #ede5df; border-radius:9px; padding:.55rem .75rem; cursor:pointer; display:flex; align-items:center; gap:.5rem; transition:border-color .12s,background .12s; }
.goc:hover:not(.goc-sin) { border-color:var(--color-primario); background:rgba(231,111,46,.05); }
.goc.goc-sel { border-color:#22c55e; background:rgba(34,197,94,.08); }
.goc.goc-sin { opacity:.45; cursor:not-allowed; }
.goc-check { width:18px; height:18px; border-radius:50%; border:2px solid #c9b8a8; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:.75rem; color:transparent; }
.goc.goc-sel .goc-check { border-color:#22c55e; background:#22c55e; color:#fff; }
.goc-nombre { flex:1; font-size:.86rem; font-weight:600; color:var(--color-secundario); min-width:0; }
.goc-stock { font-size:.72rem; font-weight:700; color:#a89080; flex-shrink:0; }

/* ══════════════════════════════════════════════════════
   PANEL BOLETA
 ══════════════════════════════════════════════════════ */
.boleta-panel { background:#fff; border-radius:14px; box-shadow:0 2px 12px rgba(44,29,13,.07); overflow:hidden; display:flex; flex-direction:column; height:calc(100vh - 85px); }
.boleta-header { display:flex; align-items:center; gap:.65rem; padding:.85rem 1.15rem; background:var(--color-secundario); color:#fff; flex-shrink:0; }
.boleta-header svg { width:18px; height:18px; fill:var(--color-primario); }
.boleta-header .boleta-title { font-size:.92rem; font-weight:700; flex:1; }
.boleta-header-right { display:flex; align-items:center; gap:.4rem; margin-left:auto; }
.cart-badge { background:rgba(255,255,255,.15); color:#fff; border-radius:20px; padding:.2rem .6rem; font-size:.78rem; font-weight:700; white-space:nowrap; flex-shrink:0; }
.cart-badge.promo-badge { background:#d97706; color:#fff; font-weight:800; }
.btn-limpiar-carrito { display:flex; align-items:center; gap:.35rem; padding:.35rem .75rem; background:rgba(239,68,68,.2); border:1px solid rgba(239,68,68,.4); border-radius:8px; color:#ff8585; font-size:.8rem; font-weight:700; cursor:pointer; transition:background .15s,color .15s,border-color .15s; flex-shrink:0; margin-left:.25rem; }
.btn-limpiar-carrito:hover:not(:disabled) { background:#dc2626; border-color:#dc2626; color:#fff; }
.btn-limpiar-carrito svg { width:14px; height:14px; fill:currentColor; }
.btn-limpiar-carrito:disabled { opacity:.4; cursor:not-allowed; background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.12); color:rgba(255,255,255,.4); }
.cart-items { overflow-y:auto; flex:1 1 0%; min-height:0; padding:.65rem .85rem 3.5rem; display:flex; flex-direction:column; gap:.5rem; }
.cart-items.split-cols { display:grid; grid-template-columns:1fr 1fr; gap:.75rem; align-items:stretch; }
.cart-col-promos, .cart-col-prods { display:flex; flex-direction:column; gap:.5rem; min-width:0; }
.cart-col-header { font-size:.75rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em; color:#d97706; padding:.25rem .4rem; border-bottom:1.5px solid #fde68a; margin-bottom:.2rem; }
.cart-col-prods .cart-col-header { color:var(--color-secundario); border-bottom-color:#ede5df; }

/* Item en carrito: Todo en 1 fila horizontal */
/* Fila apilada: el nombre siempre arriba, en su propia línea, y debajo la
   cantidad, los precios y el subtotal. Así el nombre nunca compite por ancho. */
.ci-item { background:#faf7f5; border:1.5px solid #ede5df; border-radius:10px; padding:.65rem .9rem; display:flex; flex-direction:column; align-items:stretch; gap:.45rem; flex-shrink:0; }
.ci-nombre-wrap { min-width:0; display:flex; align-items:center; gap:.4rem; }
.ci-nombre { font-size:.95rem; font-weight:700; color:var(--color-secundario); line-height:1.25; overflow-wrap:anywhere; }
.ci-controls-row { display:flex; align-items:center; justify-content:flex-end; gap:.85rem; flex-wrap:wrap; }
.ci-controls-row .ci-qty-wrap { margin-right:auto; }
.ci-qty-wrap { display:flex; align-items:center; gap:.4rem; flex-shrink:0; }
.ci-qty-label { font-size:.88rem; font-weight:600; color:#7a6050; }
.ci-qty { display:flex; align-items:center; gap:.3rem; }
.ci-qty button { width:26px; height:26px; border-radius:6px; border:1.5px solid #e0d5cc; background:#fff; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.95rem; font-weight:700; color:var(--color-secundario); transition:background .12s,border-color .12s; }
.ci-qty button:hover { background:#f5f0eb; border-color:var(--color-primario); }
.ci-qty span { font-size:.92rem; font-weight:800; min-width:24px; text-align:center; color:var(--color-secundario); }
.ci-unit-price { display:flex; flex-direction:column; align-items:flex-end; font-size:.88rem; color:#7a6050; flex-shrink:0; white-space:nowrap; }
.ci-price-old { font-size:.75rem; color:#a89080; text-decoration:line-through; }
.ci-price-current { font-size:.88rem; font-weight:600; color:#7a6050; }
.ci-subtotal { font-size:1.1rem; font-weight:800; color:var(--color-primario); flex-shrink:0; white-space:nowrap; min-width:70px; text-align:right; }
.ci-del { width:26px; height:26px; border-radius:6px; border:none; cursor:pointer; background:rgba(239,68,68,.08); color:#dc2626; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background .15s,transform .1s; }
.ci-del:hover { background:rgba(239,68,68,.2); transform:scale(1.05); }
.ci-del svg { width:14px; height:14px; fill:currentColor; }
.ci-oferta-badge { font-size:.68rem; font-weight:700; background:#ede9fe; color:#7c3aed; border-radius:4px; padding:.1rem .4rem; flex-shrink:0; }

/* Promo Card en Carrito: Mismas filas horizontales que productos + desglose inferior */
.ci-promo-card { background:#fff; border:1.5px solid #d97706; border-radius:10px; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 2px 6px rgba(217,119,6,.08); flex-shrink:0; min-height:80px; }
.ci-promo-main-row { background:#fffbeb; padding:.65rem .9rem; display:flex; flex-direction:column; align-items:stretch; gap:.45rem; border-bottom:1px solid #fde68a; }
.ci-promo-tag { background:#d97706; color:#fff; font-size:.72rem; font-weight:800; padding:.15rem .45rem; border-radius:4px; margin-right:.2rem; white-space:nowrap; flex-shrink:0; }
.ci-promo-body { padding:.5rem .9rem; background:#ffffff; display:flex; flex-direction:column; gap:.3rem; }
.ci-promo-body-title { font-size:.72rem; font-weight:700; color:#92400e; text-transform:uppercase; letter-spacing:.03em; margin-bottom:.1rem; }
.ci-promo-item-row { display:flex; align-items:center; justify-content:space-between; font-size:.82rem; color:#451a03; padding:.25rem .5rem; background:#fffcf8; border-radius:5px; border:1px dashed #fde68a; }
.ci-promo-item-nombre { font-weight:600; flex:1; }
.ci-promo-item-cant { font-size:.75rem; font-weight:700; color:#d97706; background:#fef3c7; padding:.1rem .4rem; border-radius:4px; }
.ci-promo-item-del:hover { opacity:1; }
.ci-promo-item-del svg { width:12px; height:12px; fill:currentColor; }

.cart-empty { text-align:center; padding:2.5rem 1rem; color:#b8a898; font-size:.9rem; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.cart-empty svg { width:48px !important; height:48px !important; max-width:48px !important; max-height:48px !important; fill:#ddd0c4 !important; display:block; margin:0 auto .6rem; flex-shrink:0; }

/* Info boleta */
.boleta-info-sec { padding:.75rem 1.1rem; border-top:1px solid #f0ebe5; display:flex; flex-direction:column; gap:.35rem; flex-shrink:0; }
.bi-row { display:flex; justify-content:space-between; font-size:.88rem; }
.bi-row .lbl { color:#7a6050; font-weight:600; }
.bi-row .val { color:var(--color-secundario); font-weight:700; text-align:right; }

/* Totales */
.boleta-totales { padding:.75rem 1.1rem; border-top:1px solid #f0ebe5; flex-shrink:0; }
.tot-line { display:flex; justify-content:space-between; font-size:.9rem; color:#7a6050; padding:.18rem 0; }
.tot-line.descuento      { font-size:.85rem; color:#16a34a; }
.tot-line.descuento-total{ font-size:.88rem; font-weight:700; color:#16a34a; border-top:1px dashed #d1fae5; padding-top:.35rem; margin-top:.2rem; }
.tot-line.gran { font-size:1.25rem; font-weight:800; color:var(--color-secundario); padding-top:.55rem; border-top:1.5px solid #f0ebe5; margin-top:.35rem; }
.tot-line.gran span:last-child { color:var(--color-primario); font-weight:800; }

.boleta-footer { padding:1rem 1.1rem; border-top:1px solid #f0ebe5; flex-shrink:0; display:flex; gap:.6rem; align-items:stretch; }
.btn-postergar { display:flex; align-items:center; justify-content:center; gap:.4rem; padding:.85rem 1rem; background:#fff; color:#7a6050; border:1.5px solid #e0d5cc; border-radius:10px; font-size:.9rem; font-weight:800; cursor:pointer; white-space:nowrap; transition:background .2s, border-color .2s, color .2s; flex-shrink:0; }
.btn-postergar svg { width:16px; height:16px; fill:currentColor; }
.btn-postergar:hover:not(:disabled) { background:#fff5ee; border-color:var(--color-primario); color:var(--color-primario); }
.btn-postergar:disabled { opacity:.45; cursor:not-allowed; }
.btn-generar { display:flex; align-items:center; justify-content:center; gap:.5rem; width:100%; padding:.85rem; background:var(--color-primario); color:#fff; border:none; border-radius:10px; font-size:1.05rem; font-weight:800; cursor:pointer; transition:background .2s,transform .15s; }
.btn-generar svg { width:16px; height:16px; fill:currentColor; }
.btn-generar:hover:not(:disabled) { background:#cf5f22; transform:translateY(-1px); }
.btn-generar:disabled { opacity:.5; cursor:not-allowed; }
.spin-sm { width:15px; height:15px; border:2px solid rgba(255,255,255,.3); border-top-color:#fff; border-radius:50%; animation:spinR .65s linear infinite; display:inline-block; flex-shrink:0; }
@@keyframes spinR { to { transform:rotate(360deg); } }

/* Toast */
.toast-wrap { position:fixed; top:1.25rem; right:1.25rem; z-index:9999; display:flex; flex-direction:column; gap:.5rem; pointer-events:none; }
.toast-msg { display:flex; align-items:center; gap:.6rem; padding:.75rem 1.1rem; border-radius:10px; font-size:.88rem; font-weight:600; box-shadow:0 4px 16px rgba(0,0,0,.12); animation:toastIn .3s ease; }
.toast-msg svg { width:18px; height:18px; fill:currentColor; flex-shrink:0; }
.toast-msg.exito { background:#f0fdf4; color:#16a34a; border-left:4px solid #16a34a; }
.toast-msg.error { background:#fef2f2; color:#dc2626; border-left:4px solid #dc2626; }
@@keyframes toastIn { from{opacity:0;transform:translateX(30px)} to{opacity:1;transform:translateX(0)} }

/* ══════════════════════════════════════════════════════
   MODAL TICKET POS
══════════════════════════════════════════════════════ */
.ticket-overlay {
    position:fixed; inset:0; background:rgba(0,0,0,.55);
    z-index:10000; display:flex; align-items:center; justify-content:center;
    animation:fadeIn .2s ease;
}
@@keyframes fadeIn { from{opacity:0} to{opacity:1} }

.ticket-wrap {
    background:#fff; width:300px; max-height:92vh;
    overflow-y:auto; border-radius:8px;
    box-shadow:0 8px 32px rgba(0,0,0,.25);
    display:flex; flex-direction:column;
}
.ticket-actions {
    display:flex; gap:.5rem; padding:.65rem .8rem;
    border-bottom:1px solid #eee; flex-shrink:0; background:#fff;
    position:sticky; top:0; z-index:1;
}
.ticket-actions button {
    flex:1; padding:.5rem; border-radius:7px; border:none;
    font-size:.82rem; font-weight:700; cursor:pointer; transition:opacity .15s;
}
.ticket-actions button:hover { opacity:.85; }
.btn-print  { background:var(--color-secundario); color:#fff; }
.btn-cerrar { background:#f0ebe5; color:var(--color-secundario); }

/* El ticket propiamente. Verdana/Arial: fuentes del sistema (sin descarga ni
   carrera de carga), con el 0 como óvalo simple, sin raya ni punto. */
.ticket {
    font-family: Verdana, Arial, 'Helvetica Neue', Helvetica, sans-serif;
    font-size:12px;
    line-height:1.4;
    padding: 0 .6rem .5rem .6rem;
    color:#000;
}
.ticket-hr     { border:none !important; border-top:1px dashed #000 !important; margin:.25rem 0 !important; opacity:1 !important; }
.ticket-hr-sol { border:none !important; border-top:1px solid #000 !important;  margin:.25rem 0 !important; opacity:1 !important; }
.ticket-row {
    display:flex;
    justify-content:space-between;
    margin-bottom:1px;      /* antes no tenía, el line-height lo inflaba */
}
.ticket-row .tk-l { flex:1; min-width:0; overflow:hidden; text-overflow:clip; }
.ticket-row .tk-r { flex-shrink:0; padding-left:.5rem; text-align:right; }

/* Grid columns for ticket items */
.ticket-row.ticket-grid { font-size:11px; }
.ticket-row.ticket-grid .tk-l { flex:1; min-width:0; overflow:hidden; text-overflow:clip; }
.ticket-row.ticket-grid .tk-q { flex-shrink:0; padding-left:.25rem; text-align:right; width:35px; }
.ticket-row.ticket-grid .tk-m { flex-shrink:0; padding-left:.25rem; text-align:right; width:65px; }
.ticket-row.ticket-grid .tk-r { flex-shrink:0; padding-left:.25rem; text-align:right; width:70px; }
.ticket-total  { font-size:20px; font-weight:700; }
.ticket-desc   { color:#000; }
.ticket-promo-tag { font-size:13px; font-weight:700; }
.ticket-center { text-align:center; }
.ticket-bold { font-weight:700; }
.ticket-title { font-size:14px; font-weight:700; text-align:center; }
.ticket-subtitle { font-size:13px; font-weight:700; text-align:center; }
.ticket-sub-label { font-size:11px; text-align:center; }
.ticket-small { font-size:11px; }
.ticket-strike { text-decoration:line-through; font-size:10px; }
.ticket-bottle-charge {
    background-color: #000 !important;
    color: #fff !important;
    font-size: 11px;
    font-weight: bold;
    padding: 3px 6px;
    margin: 3px 0;
    border-radius: 2px;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
}
.ticket-bottle-charge * { color: #fff !important; }
.ticket-cut {
    text-align:center; font-size:11px; letter-spacing:1px; color:#000;
    border-top:1px dashed #000; border-bottom:1px dashed #000;
    padding:3px 0; margin:.6rem 0;
}

/* Impresión POS (80 mm — cambiar a 58mm si tu impresora es de ese ancho) */
@@page {
    size: 80mm auto;   /* ancho fijo, alto = lo que ocupe el contenido */
    margin: 0;
}
@@media print {
    html, body { margin:0 !important; padding:0 !important; background:#fff !important; color:#000 !important; }
    body > *          { display:none !important; }
    .ticket-overlay   {
        display:block !important; position:static !important;
        background:none !important; inset:auto !important;
        animation:none !important;
    }
    .ticket-actions   { display:none !important; }
    .ticket-wrap      {
        box-shadow:none !important; border-radius:0 !important;
        max-height:none !important; overflow:visible !important;
        width:80mm !important;
    }
    .ticket {
        padding: 0 2mm !important;
        font-weight: bold !important; /* Fuerza negrita para trazos más gruesos y legibles */
        font-size:11pt !important;
        line-height:1.4 !important;
        -webkit-font-smoothing: none !important;
        -moz-osx-font-smoothing: grayscale !important;
        text-rendering: optimizeSpeed !important;
    }
    .ticket-total { font-size:17pt !important; }
    .ticket-title { font-size:12pt !important; }
    .ticket-subtitle { font-size:11pt !important; }
    .ticket-sub-label { font-size:9.5pt !important; }
    .ticket-small { font-size:9.5pt !important; }
    .ticket-strike { font-size:8.5pt !important; }
    .ticket-bottle-charge {
        background-color: #000 !important;
        color: #fff !important;
        font-size: 9.5pt !important;
        font-weight: bold !important;
        padding: 3px 6px !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
    .ticket-bottle-charge * { color: #fff !important; }
    /* Fuerza corte de papel entre boleta cliente y lista vendedor */
    .ticket-cliente { break-after: page !important; }
    .ticket-cut     { display:none !important; }
}
</style>

<div class="toast-wrap" id="toastWrap"></div>
<div class="envase-overlay" id="envaseOverlay" onclick="cerrarDialogoEnvase()"></div>
<div class="grupos-overlay" id="gruposOverlay" onclick="cerrarDialogoGrupos()"></div>
@Html.AntiForgeryToken()

<div class="gv-wrap">

    <!-- ══ CATÁLOGO ══ -->
    <div class="cat-panel">
        <div class="cat-panel-header">
            <svg viewBox="0 0 24 24"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
            <span>Productos disponibles</span>
            <span class="cnt-badge" id="cntProductos">@Model.Productos.Count()</span>
        </div>

        @if (Model.Promociones.Any())
        {
            <div class="filtros-wrap">
                <div class="search-bar">
                    <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    <input type="text" id="txtBuscar" placeholder="Buscar por producto o promoción…"
                           oninput="aplicarFiltros()" autocomplete="off" />
                    <button class="clr" id="btnClr" onclick="limpiarQ()" title="Limpiar">✕</button>
                </div>
            </div>
            <!-- Tab nav -->
            <div class="tab-nav">
                <button class="tab-btn active" id="tabBtnProductos" onclick="selTab('productos')">
                    <svg viewBox="0 0 24 24"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
                    Productos
                </button>
                <button class="tab-btn" id="tabBtnPromociones" onclick="selTab('promociones')">
                    <svg viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .59 1.42l9 9A2 2 0 0 0 13 22a2 2 0 0 0 1.41-.59l7-7A2 2 0 0 0 22 13a2 2 0 0 0-.59-1.42z"/></svg>
                    Promociones
                    <span class="tab-cnt">@Model.Promociones.Count()</span>
                </button>
            </div>
            <!-- Tab: Productos -->
            <div class="tab-pane" id="tabProductos">
                <div class="productos-grid" id="productosGrid"></div>
            </div>
            <!-- Tab: Promociones -->
            <div class="tab-pane hidden" id="tabPromociones">
                <div class="promo-grid" id="promoGrid"></div>
            </div>
        }
        else
        {
            <div class="filtros-wrap">
                <div class="search-bar">
                    <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    <input type="text" id="txtBuscar" placeholder="Buscar por producto o promoción…"
                           oninput="aplicarFiltros()" autocomplete="off" />
                    <button class="clr" id="btnClr" onclick="limpiarQ()" title="Limpiar">✕</button>
                </div>
            </div>
            <div class="productos-grid" id="productosGrid"></div>
        }
    </div>

    <!-- ══ BOLETA ══ -->
    <div class="boleta-panel">
        <div class="boleta-header">
            <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 5.9 17 7 17h14v-2H7.42a.25.25 0 0 1-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 23.46 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2z"/></svg>
            <span class="boleta-title">Detalle venta</span>
            <div class="boleta-header-right">
                <span class="cart-badge promo-badge" id="cartCntPromos" style="display:none;" title="Promociones en el carrito">0 Promos</span>
                <span class="cart-badge" id="cartCntDistintos" title="Productos distintos">0 prods.</span>
                <span class="cart-badge" id="cartCntUnidades" title="Unidades totales">0 un.</span>
                <button class="btn-limpiar-carrito" id="btnLimpiarCarrito" onclick="confirmarLimpiarCarrito()" disabled title="Vaciar todos los productos del carrito">
                    <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                    Limpiar
                </button>
            </div>
        </div>

        <div class="cart-items" id="cartItems">
            <div class="cart-empty">
                <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 5.9 17 7 17h14v-2H7.42a.25.25 0 0 1-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 23.46 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2z"/></svg>
                Selecciona productos del catálogo
            </div>
        </div>

        <!-- Totales -->
        <div class="boleta-totales">
            <div class="tot-line">
                <span>Subtotal</span>
                <span id="totSub">$0</span>
            </div>
            <!-- Líneas de descuento generadas dinámicamente por JS -->
            <div id="descuentosContainer"></div>
            <div class="tot-line descuento-total">
                <span>Total descuentos</span>
                <span id="totDescTotal">-$0</span>
            </div>
            <div class="tot-line gran">
                <span>Total</span>
                <span id="totTotal">$0</span>
            </div>
        </div>

        <div class="boleta-footer">
            <button class="btn-postergar" id="btnPostergar" disabled onclick="confirmarPostergarVenta()"
                    title="F4 — Guarda esta venta para atender a otro cliente y retomarla después">
                <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
                Postergar
            </button>
            <button class="btn-generar" id="btnGenerar" disabled onclick="confirmarVentaShortcut(false)">
                <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                Generar venta
            </button>
        </div>
    </div>

    <!-- ══ VENTAS POSTERGADAS ══ -->
    <div class="post-panel">
        <div class="post-panel-header">
            <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
            <span class="post-title">Postergadas</span>
            <span class="post-cnt" id="postCnt">0</span>
        </div>
        <div class="post-list" id="postList">
            <div class="post-empty">Cargando…</div>
        </div>
    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
(function () {

    /* ── Datos del servidor ──────────────────────────────────────────────── */
    const CATALOGO    = @Html.Raw(catalogoJson);
    const PROMOS      = @Html.Raw(promosJson);
    const URL_CREAR   = '@urlCrear';
    const URL_IMG     = '@urlImagen';
    const URL_POSTERGAR            = '@urlPostergar';
    const URL_POSTERGADAS          = '@urlPostergadas';
    const URL_RECUPERAR_POSTERGADA = '@urlRecuperarPostergada';
    const URL_DESCARTAR_POSTERGADA = '@urlDescartarPostergada';
    const CSRF        = () => document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';

    const OFERTAS_MAP    = {};                  // idProducto → precioOferta
    const OFERTAS_ID_MAP = {};                  // idProducto → idOfertaProducto
    CATALOGO.forEach(p => {
        if (p.ofertaPrecio != null) {
            OFERTAS_MAP[p.id]    = p.ofertaPrecio;
            OFERTAS_ID_MAP[p.id] = p.ofertaId;
        }
    });

    const NOMBRE_MAP = {};                      // idProducto → nombre
    CATALOGO.forEach(p => { NOMBRE_MAP[p.id] = p.nombre; });

    const RETORNABLES_MAP = {};                 // idProducto → {valorEnvase, soloEfectivo}
    CATALOGO.forEach(p => { if (p.retornable) RETORNABLES_MAP[p.id] = p.retornable; });

    /* ── Estado ──────────────────────────────────────────────────────────── */
    let cartSeqCounter  = 0;
    const carrito       = new Map();            // id → {id, nombre, precio, cantidad, stock, _seq}
    const promoCarrito  = new Map();            // idPromo → {idPromo, nombre, precio, cantidad, _seq}
    const envasesMap    = new Map();            // idProducto → {valorEnvase, soloEfectivo}
    let pendingEnvase   = null;                 // producto pendiente de confirmación envase

    /* ══════════════════════════════════════════════════════════════════════
       TABS
    ══════════════════════════════════════════════════════════════════════ */
    window.selTab = function (tab) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
        const key = tab.charAt(0).toUpperCase() + tab.slice(1);
        document.getElementById('tabBtn' + key)?.classList.add('active');
        document.getElementById('tab'    + key)?.classList.remove('hidden');
    };

    /* ══════════════════════════════════════════════════════════════════════
       FILTROS
    ══════════════════════════════════════════════════════════════════════ */
    window.aplicarFiltros = function () {
        const q = document.getElementById('txtBuscar').value.trim().toLowerCase();
        document.getElementById('btnClr').classList.toggle('on', q.length > 0);
        const f = q === '' ? CATALOGO : CATALOGO.filter(p =>
            p.nombre.toLowerCase().includes(q)
            || p.marca.toLowerCase().includes(q)
            || p.descripcion.toLowerCase().includes(q)
            || (p.codigo || '').toLowerCase().includes(q)
        );
        renderGrid(f);
        renderPromoGrid(q);
    };

    window.limpiarQ = function () {
        document.getElementById('txtBuscar').value = '';
        aplicarFiltros();
    };

    /* ══════════════════════════════════════════════════════════════════════
       GRID DE PRODUCTOS
    ══════════════════════════════════════════════════════════════════════ */
    function renderGrid(lista) {
        const grid = document.getElementById('productosGrid');
        document.getElementById('cntProductos').textContent = lista.length;
        if (!lista.length) {
            grid.innerHTML = `<div class="grid-empty">
                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                Sin productos para los filtros aplicados</div>`;
            return;
        }

        const { consumidoEnPromo } = calcularDescuentos();

        grid.innerHTML = lista.map(p => {
            const it        = carrito.get(p.id);
            const totalCant = it ? it.cantidad : 0;
            const consumido = consumidoEnPromo.get(p.id) ?? 0;
            const cantFuera = Math.max(0, totalCant - consumido);
            const enCart    = cantFuera > 0;
            const oferta    = OFERTAS_MAP[p.id];
            const sinStock  = false;
            const imgHtml = p.tieneImagen
                ? `<img src="${URL_IMG}/${p.id}" alt="${x(p.nombre)}" loading="lazy">`
                : `<svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>`;
            const nomSafe = p.nombre.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
            const precioHtml = oferta != null
                ? `<span class="prod-card-precio tachado">$${fmt(p.precio)}</span>
                   <span class="prod-card-oferta">$${fmt(oferta)}</span>`
                : `<span class="prod-card-precio">$${fmt(p.precio)}</span>`;
            const stockClass = totalCant > p.stock ? 'prod-card-stock-num' : 'prod-card-stock-num ok';
            const badgeHtml = enCart
                ? `<div class="prod-card-stock-qty">
                       <div class="prod-card-qty-btn">
                           <button onclick="event.stopPropagation();cambiarCantidad(${p.id},-1)">−</button>
                           <span>${cantFuera}</span>
                           <button onclick="event.stopPropagation();cambiarCantidad(${p.id},+1)">+</button>
                       </div>
                       <span class="prod-card-stock-lbl">/ Stock: <span class="${stockClass}">${p.stock}</span></span>
                   </div>`
                : sinStock
                ? `<span class="prod-card-sin-stock-lbl">Sin stock</span>`
                : `<span class="prod-card-stock">Stock: ${p.stock}</span>`;
            let extraClass = enCart ? ' en-carrito' : (sinStock ? ' sin-stock' : (oferta != null ? ' tiene-oferta' : ''));
            const onclickAttr = sinStock ? '' : `onclick="toggleProducto(${p.id},'${nomSafe}',${p.precio},${p.stock})"`;
            const tabAttr = sinStock ? '' : 'tabindex="0"';
            return `
            <div class="prod-card${extraClass}" id="pc-${p.id}" ${onclickAttr} ${tabAttr}>
                <div class="prod-img-wrap">${imgHtml}</div>
                <div class="prod-card-body">
                    <div class="prod-card-nombre">${x(p.nombre)}</div>
                    <div class="prod-card-meta">${x(p.marca)}</div>
                    ${p.codigo ? `<div class="prod-card-codigo" style="font-size:0.68rem; color:#a89080; margin-top:2px;">Código: ${x(p.codigo)}</div>` : ''}
                </div>
                <div class="prod-card-footer">
                    ${precioHtml}
                    ${badgeHtml}
                </div>
            </div>`;
        }).join('');
    }

    /* ══════════════════════════════════════════════════════════════════════
       GRID DE PROMOCIONES
    ══════════════════════════════════════════════════════════════════════ */
    function renderPromoGrid(filtroText = '') {
        const grid = document.getElementById('promoGrid');
        if (!grid) return;

        const q = filtroText.trim().toLowerCase();
        const promosFiltradas = PROMOS.filter(p => {
            if (!q) return true;
            if (p.nombre.toLowerCase().includes(q)) return true;
            const prodMatchBase = p.productosBase.some(r => {
                const prod = CATALOGO.find(c => c.id === r.idProducto);
                return prod && prod.nombre.toLowerCase().includes(q);
            });
            if (prodMatchBase) return true;
            const prodMatchGrupo = p.grupos.some(g => g.productos.some(r => {
                const prod = CATALOGO.find(c => c.id === r.idProducto);
                return prod && prod.nombre.toLowerCase().includes(q);
            }));
            return prodMatchGrupo;
        });

        promosFiltradas.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es', { sensitivity: 'base' }));

        if (promosFiltradas.length === 0) {
            grid.innerHTML = `<div class="grid-empty" style="grid-column: 1/-1; text-align:center; padding:2rem; color:#b8a898;">
                <svg viewBox="0 0 24 24" style="width:40px;height:40px;fill:#ddd0c4;display:block;margin:0 auto .5rem;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                No se encontraron promociones</div>`;
            return;
        }

        grid.innerHTML = promosFiltradas.map(p => {
            const enCart  = promoCarrito.has(p.id);
            const cant    = enCart ? promoCarrito.get(p.id).cantidad : 0;
            const nomSafe = p.nombre.replace(/\\/g,'\\\\').replace(/'/g,"\\'");

            // ── Desglose de productos con stock en tiempo real ──────────────
            let tieneSinStock = false;
            const prodRows = [];

            // Productos base (siempre requeridos)
            p.productosBase.forEach(req => {
                const prod = CATALOGO.find(c => c.id === req.idProducto);
                if (!prod) return;
                const usado    = carrito.get(req.idProducto)?.cantidad ?? 0;
                const stockDisp = prod.stock - usado;
                const cls = stockDisp <= 0 ? 'sin' : stockDisp <= 3 ? 'poco' : '';
                prodRows.push(`<div class="promo-prod-item">
                    <span class="promo-prod-nombre" title="${x(prod.nombre)}">${x(prod.nombre)}</span>
                    <span class="promo-prod-req">×${req.cantidad}</span>
                    <span class="promo-prod-stock ${cls}">Stock: ${stockDisp}</span>
                </div>`);
            });

            // Grupos
            const selGrupos = (() => {
                const entry = promoCarrito.get(p.id);
                if (!entry) return {};
                const u = entry.unidades;
                return (u && u.length > 0) ? u[u.length - 1] : (entry.seleccionGrupos ?? {});
            })();
            p.grupos.forEach(g => {
                if (g.esExcluyente) {
                    prodRows.push(`<div class="promo-prod-grupo-sep">Elige uno:</div>`);
                    g.productos.forEach(r => {
                        const prod = CATALOGO.find(c => c.id === r.idProducto);
                        if (!prod) return;
                        const usado     = carrito.get(r.idProducto)?.cantidad ?? 0;
                        const stockDisp = prod.stock - usado;
                        const cls       = stockDisp <= 0 ? 'sin' : stockDisp <= 3 ? 'poco' : '';
                        const esSel     = selGrupos[g.idGrupo] === r.idProducto;
                        const itemCls   = esSel ? ' selected-opt' : '';
                        prodRows.push(`<div class="promo-prod-item${itemCls}">
                            <span class="promo-prod-nombre" title="${x(prod.nombre)}">${esSel ? '✓ ' : ''}${x(prod.nombre)}</span>
                            <span class="promo-prod-req">×${r.cantidad}</span>
                            <span class="promo-prod-stock ${cls}">Stock: ${stockDisp}</span>
                        </div>`);
                    });
                } else {
                    g.productos.forEach(req => {
                        const prod = CATALOGO.find(c => c.id === req.idProducto);
                        if (!prod) return;
                        const usado    = carrito.get(req.idProducto)?.cantidad ?? 0;
                        const stockDisp = prod.stock - usado;
                        const cls = stockDisp <= 0 ? 'sin' : stockDisp <= 3 ? 'poco' : '';
                        prodRows.push(`<div class="promo-prod-item">
                            <span class="promo-prod-nombre" title="${x(prod.nombre)}">${x(prod.nombre)}</span>
                            <span class="promo-prod-req">×${req.cantidad}</span>
                            <span class="promo-prod-stock ${cls}">Stock: ${stockDisp}</span>
                        </div>`);
                    });
                }
            });

            const desgloseHtml = `<div class="promo-prod-list">${prodRows.join('')}</div>`;

            const badgeHtml = enCart
                ? `<div class="promo-card-cant">
                       <div class="promo-card-qty-btn">
                           <button onclick="event.stopPropagation();cambiarCantidadPromo(${p.id},-1)">−</button>
                           <span>${cant}</span>
                           <button onclick="event.stopPropagation();cambiarCantidadPromo(${p.id},+1)">+</button>
                       </div>
                   </div>`
                : `<button class="btn-promo-precio" onclick="event.stopPropagation();togglePromo(${p.id})">$${fmt(p.precio)}</button>`;

            let extraClass = enCart ? ' en-carrito' : '';

            return `
            <div class="promo-card${extraClass}" id="pmc-${p.id}" tabindex="0"
                 onclick="togglePromo(${p.id})">
                 <div class="promo-card-header">
                     <span class="promo-card-nombre" title="${x(p.nombre)}">${x(p.nombre)}</span>
                 </div>
                 ${desgloseHtml}
                 <div class="promo-card-footer">
                     ${badgeHtml}
                 </div>
            </div>`;
        }).join('');
    }

    window.togglePromo = function (idPromo) {
        const promo = PROMOS.find(p => p.id === idPromo);
        if (!promo) return;

        // Validar stock (general; para grupos excluyentes el diálogo filtra con stock real)
        const check = validarStockPromo(idPromo, 1);
        if (!check.ok) {
            toast(`Sin stock suficiente para la promo: "${check.nombre}" (disponible: ${check.disponible})`, 'error');
            return;
        }

        // Si tiene grupos excluyentes → siempre mostrar diálogo (primera vez y sucesivas)
        const gruposExcl = promo.grupos.filter(g => g.esExcluyente && g.productos.length > 1);
        if (gruposExcl.length > 0) {
            mostrarDialogoGrupos(idPromo, gruposExcl);
            return;
        }

        // Sin grupos excluyentes: agregar directo
        if (promoCarrito.has(idPromo)) {
            const it = promoCarrito.get(idPromo);
            it.cantidad++;
            it.unidades = it.unidades ?? [];
            it.unidades.push({});
            it._seq = ++cartSeqCounter;
        } else {
            promoCarrito.set(idPromo, { idPromo: promo.id, nombre: promo.nombre, precio: promo.precio, cantidad: 1, seleccionGrupos: {}, unidades: [{}], _seq: ++cartSeqCounter });
        }
        agregarProductosDePromo(idPromo, 1, {});
        renderPromoGrid();
        renderCarrito();
        actualizarTarjetasProductos();
    };

    /* ── Diálogo grupos excluyentes ─────────────────────────────────────── */
    let _dialogoIdPromo = null;

    function mostrarDialogoGrupos(idPromo, gruposExcl) {
        _dialogoIdPromo = idPromo;
        const promo = PROMOS.find(p => p.id === idPromo);

        const seccionesHtml = gruposExcl.map(g => {
            const optsHtml = g.productos.map(r => {
                const prod = CATALOGO.find(c => c.id === r.idProducto);
                if (!prod) return '';
                const usado     = carrito.get(r.idProducto)?.cantidad ?? 0;
                const stockDisp = prod.stock - usado;
                const sinStock  = false;
                const cls       = '';
                const sinCls    = '';
                const clickFn   = `onclick="seleccionarOpcionGrupo(this,'${g.idGrupo}')"`;
                return `<div class="goc" data-grupo="${g.idGrupo}" data-producto="${r.idProducto}" ${clickFn}>
                    <div class="goc-check">✓</div>
                    <span class="goc-nombre">${x(prod.nombre)} <small style="font-weight:400;color:#a89080">×${r.cantidad}</small></span>
                    <span class="goc-stock">Stock: ${stockDisp}</span>
                </div>`;
            }).join('');
            return `<div class="grupos-section">
                <div class="grupos-section-lbl">Elige una opción:</div>
                <div class="grupos-opts" data-grupo="${g.idGrupo}">${optsHtml}</div>
            </div>`;
        }).join('');

        const overlay = document.getElementById('gruposOverlay');
        overlay.innerHTML = `
        <div class="grupos-card" onclick="event.stopPropagation()">
            <div class="grupos-titulo">Personaliza tu promo</div>
            <div class="grupos-promo-nombre">${x(promo.nombre)}</div>
            ${seccionesHtml}
            <div class="grupos-btns">
                <button class="grupos-btn cancelar" onclick="cerrarDialogoGrupos()">Cancelar</button>
                <button class="grupos-btn confirmar" id="btnConfirmarGrupos" onclick="confirmarDialogoGrupos()" disabled>Agregar al carrito</button>
            </div>
        </div>`;
        overlay.style.display = 'flex';
    }

    window.seleccionarOpcionGrupo = function (el, idGrupo) {
        // Deseleccionar todas las opciones del mismo grupo
        el.closest('.grupos-opts').querySelectorAll('.goc').forEach(c => c.classList.remove('goc-sel'));
        el.classList.add('goc-sel');
        actualizarBtnConfirmarGrupos();
    };

    function actualizarBtnConfirmarGrupos() {
        const overlay = document.getElementById('gruposOverlay');
        const grupos  = overlay.querySelectorAll('.grupos-opts[data-grupo]');
        const todosSeleccionados = Array.from(grupos).every(g => g.querySelector('.goc.goc-sel'));
        document.getElementById('btnConfirmarGrupos').disabled = !todosSeleccionados;
    }

    window.confirmarDialogoGrupos = function () {
        const idPromo = _dialogoIdPromo;
        const promo   = PROMOS.find(p => p.id === idPromo);
        if (!promo) { cerrarDialogoGrupos(); return; }

        const overlay         = document.getElementById('gruposOverlay');
        const seleccionGrupos = {};
        overlay.querySelectorAll('.goc.goc-sel').forEach(el => {
            seleccionGrupos[el.dataset.grupo] = parseInt(el.dataset.producto);
        });

        const check = validarStockPromo(idPromo, 1, seleccionGrupos);
        if (!check.ok) {
            toast(`Sin stock suficiente: "${check.nombre}" (disponible: ${check.disponible})`, 'error');
            cerrarDialogoGrupos();
            return;
        }

        if (promoCarrito.has(idPromo)) {
            const entry = promoCarrito.get(idPromo);
            entry.cantidad++;
            entry.seleccionGrupos = seleccionGrupos;   // last selection (for promoGrid display)
            entry.unidades        = entry.unidades ?? [];
            entry.unidades.push(seleccionGrupos);
            entry._seq = ++cartSeqCounter;
        } else {
            promoCarrito.set(idPromo, {
                idPromo: promo.id, nombre: promo.nombre, precio: promo.precio,
                cantidad: 1, seleccionGrupos, unidades: [seleccionGrupos], _seq: ++cartSeqCounter
            });
        }

        agregarProductosDePromo(idPromo, 1, seleccionGrupos);
        cerrarDialogoGrupos();
        renderPromoGrid();
        renderCarrito();
        actualizarTarjetasProductos();
    };

    window.cerrarDialogoGrupos = function () {
        document.getElementById('gruposOverlay').style.display = 'none';
        _dialogoIdPromo = null;
    };

    /* Verifica si todos los productos de la promo tienen stock suficiente
       considerando lo que ya hay en el carrito.
       Retorna { ok: true } o { ok: false, nombre, disponible } */
    function validarStockPromo(idPromo, cantidadAgregar, seleccionGrupos = {}) {
        return { ok: true };
    }

    function agregarProductosDePromo(idPromo, cantidad, seleccionGrupos = {}) {
        const promo = PROMOS.find(p => p.id === idPromo);
        if (!promo) return;
        
        promo.productosBase.forEach(req => {
            const prod = CATALOGO.find(c => c.id === req.idProducto);
            if (!prod) return;
            if (carrito.has(req.idProducto)) {
                const it = carrito.get(req.idProducto);
                it.cantidad += req.cantidad * cantidad;
            } else if (RETORNABLES_MAP[req.idProducto]) {
                const p = RETORNABLES_MAP[req.idProducto];
                agregarConEnvase(req.idProducto, prod.nombre, prod.precio, prod.stock, p.valorEnvase, p.soloEfectivo, req.cantidad * cantidad);
            } else {
                carrito.set(req.idProducto, { id: req.idProducto, nombre: prod.nombre, precio: prod.precio, cantidad: req.cantidad * cantidad, stock: prod.stock });
            }
        });
        
        promo.grupos.forEach(g => {
            // Elegir el producto: selección guardada para grupos excluyentes, fallback al primero con stock
            let elegido;
            if (g.esExcluyente) {
                const selId = seleccionGrupos[g.idGrupo];
                if (selId) {
                    elegido = g.productos.find(r => r.idProducto === selId);
                }
                if (!elegido) {
                    elegido = g.productos.find(r => {
                        const pr = CATALOGO.find(c => c.id === r.idProducto);
                        const us = carrito.get(r.idProducto)?.cantidad ?? 0;
                        return pr && (pr.stock - us) >= r.cantidad;
                    }) ?? g.productos[0];
                }
            } else {
                elegido = g.productos[0];
            }
            if (!elegido) return;
            const prod = CATALOGO.find(c => c.id === elegido.idProducto);
            if (!prod) return;
            for (let i = 0; i < cantidad; i++) {
                if (carrito.has(elegido.idProducto)) {
                    carrito.get(elegido.idProducto).cantidad += elegido.cantidad;
                } else if (RETORNABLES_MAP[elegido.idProducto]) {
                    const p = RETORNABLES_MAP[elegido.idProducto];
                    agregarConEnvase(elegido.idProducto, prod.nombre, prod.precio, prod.stock, p.valorEnvase, p.soloEfectivo, elegido.cantidad);
                } else {
                    carrito.set(elegido.idProducto, { id: elegido.idProducto, nombre: prod.nombre, precio: prod.precio, cantidad: elegido.cantidad, stock: prod.stock });
                }
            }
        });
    }

    function agregarConEnvase(id, nombre, precio, stock, valorEnvase, soloEfectivo, cantidad) {
        envasesMap.set(id, { valorEnvase, soloEfectivo });
        carrito.set(id, { id, nombre, precio, cantidad, stock, _seq: ++cartSeqCounter });
    }

    /* Quita del carrito los productos de exactamente 1 unidad de la promo,
       usando la selección guardada para grupos excluyentes. */
    function removerUnaUnidadDePromo(idPromo, seleccionGrupos = {}) {
        const promo = PROMOS.find(p => p.id === idPromo);
        if (!promo) return;

        promo.productosBase.forEach(req => {
            if (carrito.has(req.idProducto)) {
                const it    = carrito.get(req.idProducto);
                const nueva = it.cantidad - req.cantidad;
                if (nueva <= 0) { carrito.delete(req.idProducto); envasesMap.delete(req.idProducto); }
                else it.cantidad = nueva;
            }
        });

        promo.grupos.forEach(g => {
            const idElegido = g.esExcluyente
                ? (seleccionGrupos[g.idGrupo] ?? g.productos[0].idProducto)
                : g.productos[0].idProducto;
            const req = g.productos.find(r => r.idProducto === idElegido) ?? g.productos[0];
            if (carrito.has(req.idProducto)) {
                const it    = carrito.get(req.idProducto);
                const nueva = it.cantidad - req.cantidad;
                if (nueva <= 0) { carrito.delete(req.idProducto); envasesMap.delete(req.idProducto); }
                else it.cantidad = nueva;
            }
        });
    }

    window.cambiarCantidadPromo = function (idPromo, delta) {
        if (!promoCarrito.has(idPromo)) return;
        const entry = promoCarrito.get(idPromo);

        if (delta > 0) {
            // Reusar la última variante seleccionada para esa promo
            const promoInfo = PROMOS.find(p => p.id === idPromo);
            if (!promoInfo) return;

            const lastVariant = (entry.unidades && entry.unidades.length > 0)
                ? entry.unidades[entry.unidades.length - 1]
                : (entry.seleccionGrupos ?? {});

            const check = validarStockPromo(idPromo, 1, lastVariant);
            if (!check.ok) {
                toast(`Sin stock suficiente para la promo: "${check.nombre}" (disponible: ${check.disponible})`, 'error');
                return;
            }

            entry.cantidad++;
            entry.unidades = entry.unidades ?? [];
            entry.unidades.push({ ...lastVariant });
            entry._seq = ++cartSeqCounter;

            agregarProductosDePromo(idPromo, 1, lastVariant);

            renderPromoGrid();
            renderCarrito();
            actualizarTarjetasProductos();
            return;
        }

        // delta < 0
        const nueva = entry.cantidad + delta;
        if (nueva <= 0) {
            eliminarPromoCompleta(idPromo);
        } else {
            const unidades = entry.unidades ?? [];
            const lastSel  = unidades.length > 0 ? unidades.pop() : (entry.seleccionGrupos ?? {});
            entry.cantidad = nueva;
            entry.seleccionGrupos = unidades.length > 0 ? unidades[unidades.length - 1] : (entry.seleccionGrupos ?? {});
            entry._seq = ++cartSeqCounter;
            removerUnaUnidadDePromo(idPromo, lastSel);
        }

        renderPromoGrid();
        renderCarrito();
        actualizarTarjetasProductos();
    };

    window.cambiarCantidadPromoAuto = function (idPromoStr, delta) {
        const idPromo = parseInt(idPromoStr);
        const promo = PROMOS.find(p => p.id === idPromo);
        if (!promo) return;

        if (delta > 0) {
            promo.productosBase.forEach(req => {
                if (carrito.has(req.idProducto)) {
                    const it = carrito.get(req.idProducto);
                    it.cantidad += req.cantidad;
                    it._seq = ++cartSeqCounter;
                }
            });
            promo.grupos.forEach(g => {
                const prodId = g.productos[0].idProducto;
                if (carrito.has(prodId)) {
                    const it = carrito.get(prodId);
                    it.cantidad += g.productos[0].cantidad;
                    it._seq = ++cartSeqCounter;
                }
            });
        } else {
            promo.productosBase.forEach(req => {
                quitarDePromo(req.idProducto, req.cantidad);
            });
            promo.grupos.forEach(g => {
                quitarDePromo(g.productos[0].idProducto, g.productos[0].cantidad);
            });
        }
        renderCarrito();
        renderPromoGrid();
        actualizarTarjetasProductos();
    };

    window.borrarPromoTotalmente = function (idPromoInput) {
        const idPromo = parseInt(idPromoInput);

        if (promoCarrito.has(idPromo)) {
            eliminarPromoCompleta(idPromo);
        }

        let maxLoops = 100;
        while (maxLoops-- > 0) {
            const { instancias } = calcularDescuentos();
            const inst = instancias.find(i => i.promoId === idPromo);
            if (!inst) break;
            inst.itemsActivos.forEach(({ id, cantReq }) => {
                if (carrito.has(id)) {
                    const it = carrito.get(id);
                    const nueva = it.cantidad - cantReq;
                    if (nueva <= 0) {
                        carrito.delete(id);
                        envasesMap.delete(id);
                    } else {
                        it.cantidad = nueva;
                    }
                }
            });
        }

        renderCarrito();
        renderPromoGrid();
        actualizarTarjetasProductos();
    };

    window.quitarDePromoAuto = window.borrarPromoTotalmente;

    function eliminarPromoCompleta(idPromo) {
        const entry = promoCarrito.get(idPromo);
        if (!entry || entry.cantidad === 0) { promoCarrito.delete(idPromo); return; }

        if (entry.unidades && entry.unidades.length > 0) {
            entry.unidades.forEach(sel => removerUnaUnidadDePromo(idPromo, sel));
        } else {
            const selAct = entry.seleccionGrupos ?? {};
            for (let i = 0; i < entry.cantidad; i++) {
                removerUnaUnidadDePromo(idPromo, selAct);
            }
        }

        promoCarrito.delete(idPromo);
    }

    function actualizarTarjetasProductos() {
        CATALOGO.forEach(p => actualizarTarjeta(p.id));
        aplicarFiltros();
    }

    window.quitarPromoCompleta = window.borrarPromoTotalmente;

    /* ══════════════════════════════════════════════════════════════════════
       CARRITO
    ══════════════════════════════════════════════════════════════════════ */
    window.toggleProducto = function (id, nombre, precio, stock) {
        if (RETORNABLES_MAP[id] != null) {
            pendingEnvase = { id, nombre, precio, stock };
            mostrarDialogoEnvase(nombre, RETORNABLES_MAP[id].valorEnvase, RETORNABLES_MAP[id].soloEfectivo);
            return;
        }

        if (carrito.has(id)) {
            const it = carrito.get(id);
            it.cantidad++;
            it._seq = ++cartSeqCounter;
            carrito.delete(id);
            carrito.set(id, it);
        } else {
            carrito.delete(id);
            carrito.set(id, { id, nombre, precio, cantidad: 1, stock, _seq: ++cartSeqCounter });
        }
        renderCarrito();
        actualizarTarjeta(id);
        renderPromoGrid();
    };

    window.confirmarEnvase = function (trajoEnvase) {
        cerrarDialogoEnvase();
        if (!pendingEnvase) return;
        const { id, nombre, precio, stock } = pendingEnvase;
        pendingEnvase = null;

        const retData = RETORNABLES_MAP[id];
        const currentEnv = envasesMap.get(id) || {
            cobrados: 0,
            valorEnvase: retData ? retData.valorEnvase : 0,
            soloEfectivo: retData ? retData.soloEfectivo : false
        };

        if (!trajoEnvase) {
            currentEnv.cobrados++;
        }
        envasesMap.set(id, currentEnv);

        if (carrito.has(id)) {
            const it = carrito.get(id);
            it.cantidad++;
            it._seq = ++cartSeqCounter;
            carrito.delete(id);
            carrito.set(id, it);
        } else {
            carrito.delete(id);
            carrito.set(id, { id, nombre, precio, cantidad: 1, stock, _seq: ++cartSeqCounter });
        }

        renderCarrito();
        actualizarTarjeta(id);
        renderPromoGrid();
    };

    function mostrarDialogoEnvase(nombre, valorEnvase, soloEfectivo) {
        const nota = soloEfectivo
            ? `<div class="envase-nota-ef"><svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>Este cargo debe abonarse en <strong>efectivo</strong></div>`
            : '';
        document.getElementById('envaseOverlay').innerHTML = `
        <div class="envase-card" onclick="event.stopPropagation()">
            <div class="envase-icon">
                <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            </div>
            <div class="envase-titulo">Producto Retornable</div>
            <div class="envase-nombre">${x(nombre)}</div>
            <div class="envase-pregunta">¿El cliente trajo su envase?</div>
            ${nota}
            <div class="envase-btns">
                <button class="envase-btn si" onclick="confirmarEnvase(true)">
                    <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                    Sí, trajo envase
                </button>
                <button class="envase-btn no" onclick="confirmarEnvase(false)">
                    <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    No — cobrar envase ($${fmt(valorEnvase)})
                </button>
            </div>
        </div>`;
        document.getElementById('envaseOverlay').style.display = 'flex';
    }

    function cerrarDialogoEnvase() {
        document.getElementById('envaseOverlay').style.display = 'none';
    }

    window.cambiarCantidad = function (id, delta) {
        if (!carrito.has(id)) return;
        const it = carrito.get(id);

        if (delta > 0 && RETORNABLES_MAP[id] != null) {
            const p = CATALOGO.find(c => c.id === id);
            pendingEnvase = { id, nombre: p ? p.nombre : it.nombre, precio: it.precio, stock: it.stock };
            mostrarDialogoEnvase(
                p ? p.nombre : it.nombre,
                RETORNABLES_MAP[id].valorEnvase,
                RETORNABLES_MAP[id].soloEfectivo
            );
            return;
        }

        const nueva = it.cantidad + delta;
        if (nueva <= 0) {
            carrito.delete(id);
            envasesMap.delete(id);
        } else {
            it.cantidad = nueva;
            it._seq = ++cartSeqCounter;
            carrito.delete(id);
            carrito.set(id, it);
            if (envasesMap.has(id)) {
                const env = envasesMap.get(id);
                if (env.cobrados > nueva) env.cobrados = Math.max(0, nueva);
                if (env.cobrados <= 0 && nueva <= 0) envasesMap.delete(id);
            }
        }
        renderCarrito();
        actualizarTarjeta(id);
        renderPromoGrid();
    };

    window.quitarItem = function (id) {
        carrito.delete(id);
        envasesMap.delete(id);
        renderCarrito();
        actualizarTarjeta(id);
        renderPromoGrid();
        actualizarTarjetasProductos();
    };

    window.quitarDePromo = function (id, cantReq) {
        if (!carrito.has(id)) return;
        const it    = carrito.get(id);
        const nueva = it.cantidad - cantReq;
        if (nueva <= 0) { carrito.delete(id); envasesMap.delete(id); }
        else            it.cantidad = nueva;
        renderCarrito();
        actualizarTarjeta(id);
        renderPromoGrid();
        actualizarTarjetasProductos();
    };

    function actualizarTarjeta(id) {
        const card = document.getElementById(`pc-${id}`);
        if (!card) return;
        const p = CATALOGO.find(c => c.id === id);
        if (!p) return;

        const { consumidoEnPromo } = calcularDescuentos();
        const it        = carrito.get(id);
        const totalCant = it ? it.cantidad : 0;
        const consumido = consumidoEnPromo.get(id) ?? 0;
        const cantFuera = Math.max(0, totalCant - consumido);
        const enCart    = cantFuera > 0;

        const oferta   = OFERTAS_MAP[id];
        const sinStock = false;

        card.classList.remove('en-carrito', 'tiene-oferta', 'sin-stock');
        if (enCart) card.classList.add('en-carrito');
        else if (sinStock) card.classList.add('sin-stock');
        else if (oferta != null) card.classList.add('tiene-oferta');

        // Actualizar onclick
        if (sinStock) {
            card.removeAttribute('onclick');
        } else {
            const nomSafe = p.nombre.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
            card.setAttribute('onclick', `toggleProducto(${p.id},'${nomSafe}',${p.precio},${p.stock})`);
        }

        const footer   = card.querySelector('.prod-card-footer');
        if (footer) {
            const oldBadge = footer.querySelector('.prod-card-stock, .prod-card-stock-qty, .prod-card-sin-stock-lbl');
            if (oldBadge) oldBadge.remove();
            const stockClass = totalCant > p.stock ? 'prod-card-stock-num' : 'prod-card-stock-num ok';
            const badgeHtml = enCart
                ? `<div class="prod-card-stock-qty">
                       <div class="prod-card-qty-btn">
                           <button onclick="event.stopPropagation();cambiarCantidad(${p.id},-1)">−</button>
                           <span>${cantFuera}</span>
                           <button onclick="event.stopPropagation();cambiarCantidad(${p.id},+1)">+</button>
                       </div>
                       <span class="prod-card-stock-lbl">/ Stock: <span class="${stockClass}">${p.stock}</span></span>
                   </div>`
                : sinStock
                ? `<span class="prod-card-sin-stock-lbl">Sin stock</span>`
                : `<span class="prod-card-stock">Stock: ${p.stock}</span>`;
            footer.insertAdjacentHTML('beforeend', badgeHtml);
        }
    }

    /* ══════════════════════════════════════════════════════════════════════
       MOTOR DE PROMOCIONES
       ─────────────────────────────────────────────────────────────────────
       Algoritmo: para cada promo se itera en bucle consumiendo unidades del
       "saldo restante" hasta que ya no se pueda formar otra instancia.
       Esto permite promos acumulables y mezcla de opciones excluyentes por
       instancia (ej.: instancia 1 → jamón; instancia 2 → queso).

       Retorna:
         instancias         → [{promoNombre, promoPrecio, itemsActivos:[{id,nombre,precio,cantReq}], ahorro}]
         consumidoEnPromo   → Map<id, cantidadTotalConsumida>
         remaining          → Map<id, cantidadRestante>  (= carrito - consumido)
         descuentosPromoLines  → [{nombre, ahorro}]  (una línea por instancia)
         descuentosOfertaLines → [{nombre, ahorro}]  (una línea por producto con oferta)
         descTotal          → number
    ══════════════════════════════════════════════════════════════════════ */
    function calcularDescuentos() {
        // Saldo disponible para asignar (se va consumiendo por instancias de promo)
        const remaining = new Map();
        carrito.forEach((it, id) => remaining.set(id, it.cantidad));

        const instancias = [];

        for (const promo of PROMOS) {
            // eslint-disable-next-line no-constant-condition
            while (true) {
                // Saldo de trabajo: cada requisito que se da por cubierto se descuenta
                // aquí mismo, para que una misma unidad del carrito no alcance para dos
                // requisitos distintos de la promo (el mismo producto en base y en un
                // grupo, o repetido en dos grupos, como en «2 vinos a elección»).
                const disp = new Map(remaining);
                const reservar = req => {
                    const hay = disp.get(req.idProducto) ?? 0;
                    if (hay < req.cantidad) return false;
                    disp.set(req.idProducto, hay - req.cantidad);
                    return true;
                };

                // ── 1. Productos base (sin grupo) ─────────────────────────
                if (!promo.productosBase.every(req => reservar(req))) break;

                // ── 2. Grupos ─────────────────────────────────────────────
                let gruposOk = true;
                const gruposResueltos = []; // array de arrays de {idProducto, cantidad}
                for (const grupo of promo.grupos) {
                    if (grupo.esExcluyente) {
                        // Primer producto del grupo con saldo aún sin reservar gana
                        const ganador = grupo.productos.find(
                            req => (disp.get(req.idProducto) ?? 0) >= req.cantidad
                        );
                        if (!ganador) { gruposOk = false; break; }
                        reservar(ganador);
                        gruposResueltos.push([ganador]);
                    } else {
                        if (!grupo.productos.every(req => reservar(req))) { gruposOk = false; break; }
                        gruposResueltos.push([...grupo.productos]);
                    }
                }
                if (!gruposOk) break;

                // ── Guard: si la promo no tiene ningún requerimiento no se puede aplicar ─
                const totalReqs = promo.productosBase.length
                    + gruposResueltos.reduce((a, g) => a + g.length, 0);
                if (totalReqs === 0) break;

                // ── 3. Consumir y registrar ───────────────────────────────
                const itemsActivos = [];

                const consumir = req => {
                    remaining.set(req.idProducto, (remaining.get(req.idProducto) ?? 0) - req.cantidad);
                    const it = carrito.get(req.idProducto);
                    if (it) itemsActivos.push({ id: it.id, nombre: it.nombre, precio: it.precio, cantReq: req.cantidad });
                };

                promo.productosBase.forEach(consumir);
                gruposResueltos.forEach(ganadores => ganadores.forEach(consumir));

                const sumaNormal = itemsActivos.reduce((acc, { precio, cantReq }) => acc + precio * cantReq, 0);
                const ahorro     = Math.max(0, sumaNormal - promo.precio);

                instancias.push({
                    promoId:     promo.id,
                    promoNombre: promo.nombre,
                    promoPrecio: promo.precio,
                    itemsActivos,
                    ahorro
                });
            }
        }

        // ── Mapa de unidades totales consumidas por promo ─────────────────
        const consumidoEnPromo = new Map();
        instancias.forEach(inst =>
            inst.itemsActivos.forEach(({ id, cantReq }) =>
                consumidoEnPromo.set(id, (consumidoEnPromo.get(id) ?? 0) + cantReq)
            )
        );

        // ── Líneas de descuento para el panel de totales (agrupadas por promo) ──
        const promoAhorroMap = new Map();
        instancias.forEach(inst => {
            if (!promoAhorroMap.has(inst.promoId)) {
                promoAhorroMap.set(inst.promoId, { nombre: inst.promoNombre, ahorro: 0, veces: 0 });
            }
            const entry = promoAhorroMap.get(inst.promoId);
            entry.ahorro += inst.ahorro;
            entry.veces++;
        });
        const descuentosPromoLines = [...promoAhorroMap.values()].map(({ nombre, ahorro, veces }) => ({
            nombre: veces > 1 ? `${nombre} (x${veces})` : nombre,
            ahorro
        }));

        const descuentosOfertaLines = [];
        carrito.forEach((it, id) => {
            if (OFERTAS_MAP[id] == null) return;
            const cantFuera = it.cantidad - (consumidoEnPromo.get(id) ?? 0);
            if (cantFuera <= 0) return;
            const ahorro = (it.precio - OFERTAS_MAP[id]) * cantFuera;
            if (ahorro > 0) descuentosOfertaLines.push({ nombre: it.nombre, ahorro });
        });

        const descuentoPromos  = descuentosPromoLines.reduce((a, l) => a + l.ahorro, 0);
        const descuentoOfertas = descuentosOfertaLines.reduce((a, l) => a + l.ahorro, 0);
        const descTotal        = descuentoPromos + descuentoOfertas;

        return { instancias, consumidoEnPromo, remaining, descuentosPromoLines, descuentosOfertaLines, descTotal };
    }

    function buildPromoProdBreakdownHtml(promoInfo, unidades, cantidad, seleccionGrupos) {
        if (!promoInfo) return '';
        const prodCounts = new Map();

        // Productos base
        (promoInfo.productosBase || []).forEach(req => {
            if (req && req.idProducto) {
                prodCounts.set(req.idProducto, (prodCounts.get(req.idProducto) || 0) + (req.cantidad || 1) * cantidad);
            }
        });

        // Grupos
        const unitsList = (unidades && unidades.length > 0)
            ? unidades
            : Array(cantidad).fill(seleccionGrupos || {});

        unitsList.forEach(sel => {
            (promoInfo.grupos || []).forEach(g => {
                if (!g || !g.productos || g.productos.length === 0) return;
                const selId = g.esExcluyente
                    ? (sel[g.idGrupo] || g.productos[0].idProducto)
                    : g.productos[0].idProducto;
                const req = g.productos.find(r => r.idProducto === selId) || g.productos[0];
                if (req && req.idProducto) {
                    prodCounts.set(req.idProducto, (prodCounts.get(req.idProducto) || 0) + (req.cantidad || 1));
                }
            });
        });

        return renderFilasDesglosePromo(prodCounts);
    }

    /* Desglose real de una promo detectada automáticamente: se arma con los
       productos que el motor asignó a cada instancia, no suponiendo que de cada
       grupo excluyente sale su primer producto. Sin esto, una promo con dos
       grupos iguales (p. ej. «2 vinos a elección») siempre mostraría dos veces
       la primera variedad, aunque el cliente llevara otras. */
    function buildPromoBreakdownDesdeInstancias(instList) {
        const prodCounts = new Map();
        instList.forEach(inst => {
            (inst.itemsActivos || []).forEach(({ id, cantReq }) => {
                prodCounts.set(id, (prodCounts.get(id) || 0) + cantReq);
            });
        });
        return renderFilasDesglosePromo(prodCounts);
    }

    function renderFilasDesglosePromo(prodCounts) {
        const rows = [];
        prodCounts.forEach((cantTotal, idProd) => {
            const prod = CATALOGO.find(c => c.id === idProd);
            if (prod) {
                rows.push(`
                <div class="ci-promo-item-row">
                    <span class="ci-promo-item-nombre">• ${x(prod.nombre)}</span>
                    <span class="ci-promo-item-cant">${cantTotal} u.</span>
                </div>`);
            }
        });

        if (rows.length === 0) {
            return `<div class="ci-promo-item-row"><span class="ci-promo-item-nombre">• Productos incluidos en la promoción</span></div>`;
        }

        return rows.join('');
    }

    /* ══════════════════════════════════════════════════════════════════════
       RENDER CARRITO
    ══════════════════════════════════════════════════════════════════════ */
    function renderCarrito() {
        const cont    = document.getElementById('cartItems');
        const btnGen  = document.getElementById('btnGenerar');
        const btnPost = document.getElementById('btnPostergar');

        if (carrito.size === 0 && promoCarrito.size === 0) {
            cont.innerHTML = `<div class="cart-empty">
                <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 5.9 17 7 17h14v-2H7.42a.25.25 0 0 1-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 23.46 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2z"/></svg>
                Selecciona productos del catálogo</div>`;
            if (btnGen)  btnGen.disabled  = true;
            if (btnPost) btnPost.disabled = true;
            actualizarTotales();
            return;
        }
        if (btnPost) btnPost.disabled = false;

        const { instancias, remaining } = calcularDescuentos();
        const entries = [];

        // ── 0 & 1. Promociones Unificadas (Directas + Automáticas por Promo ID) ──
        const allPromoIds = new Set([
            ...promoCarrito.keys(),
            ...instancias.map(i => i.promoId)
        ]);

        allPromoIds.forEach((idPromo) => {
            const promoInfo = PROMOS.find(pr => pr.id === idPromo);
            if (!promoInfo) return;

            const pDirect = promoCarrito.get(idPromo);
            const cantDirect = pDirect ? pDirect.cantidad : 0;

            const instList = instancias.filter(i => i.promoId === idPromo);
            const cantAuto = instList.length;

            const totalCantidad = Math.max(cantDirect, cantAuto);
            if (totalCantidad <= 0) return;

            const tagText = 'Promo';
            const subtotal = promoInfo.precio * totalCantidad;

            // Si el motor ya emparejó instancias, esos son los productos que
            // realmente se están descontando: se muestran tal cual. La suposición
            // por selección de grupos queda solo para promos sin instancia aún.
            const prodRowsHtml = instList.length > 0
                ? buildPromoBreakdownDesdeInstancias(instList)
                : buildPromoProdBreakdownHtml(
                    promoInfo,
                    pDirect ? pDirect.unidades : null,
                    totalCantidad,
                    pDirect ? pDirect.seleccionGrupos : null
                  );

            const seqDirect = pDirect ? (pDirect._seq || 0) : 0;
            const seqAuto = Math.max(...instList.flatMap(i => (i.itemsActivos || []).map(it => carrito.get(it.id)?._seq || 0)), 0);
            const maxSeq = Math.max(seqDirect, seqAuto);

            const deleteOnClick = `borrarPromoTotalmente(${idPromo})`;
            const changeQtyOnClick = cantDirect > 0 ? `cambiarCantidadPromo(${idPromo}` : `cambiarCantidadPromoAuto('${idPromo}'`;

            let pHtml = `
            <div class="ci-promo-card">
                <div class="ci-promo-main-row">
                    <div class="ci-nombre-wrap">
                        <span class="ci-promo-tag">${tagText}</span>
                        <span class="ci-nombre" title="${x(promoInfo.nombre)}">${x(promoInfo.nombre)}</span>
                    </div>
                    <div class="ci-controls-row">
                        <div class="ci-qty-wrap">
                            <span class="ci-qty-label">Cantidad:</span>
                            <div class="ci-qty">
                                <button onclick="${changeQtyOnClick},-1)">−</button>
                                <span>${totalCantidad}</span>
                                <button onclick="${changeQtyOnClick},+1)">+</button>
                            </div>
                        </div>
                        <div class="ci-unit-price">
                            <span class="ci-price-current">$${fmt(promoInfo.precio)} c/u</span>
                        </div>
                        <div class="ci-subtotal">$${fmt(subtotal)}</div>
                        <button class="ci-del" onclick="${deleteOnClick}" title="Eliminar promoción">
                            <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                        </button>
                    </div>
                </div>
                <div class="ci-promo-body">
                    <div class="ci-promo-body-title">Productos incluidos:</div>
                    ${prodRowsHtml}
                </div>
            </div>`;

            entries.push({ seq: maxSeq, html: pHtml });
        });

        // ── 2. Ítems individuales ────
        carrito.forEach(it => {
            const cantRest = remaining.get(it.id) ?? 0;
            if (cantRest <= 0) return;
            const tieneOferta    = OFERTAS_MAP[it.id] != null;
            const precioEfectivo = tieneOferta ? OFERTAS_MAP[it.id] : it.precio;
            let iHtml = `
            <div class="ci-item">
                <div class="ci-nombre-wrap">
                    <span class="ci-nombre" title="${x(it.nombre)}">${x(it.nombre)}</span>
                    ${tieneOferta ? '<span class="ci-oferta-badge">Oferta</span>' : ''}
                </div>
                <div class="ci-controls-row">
                    <div class="ci-qty-wrap">
                        <span class="ci-qty-label">Cantidad:</span>
                        <div class="ci-qty">
                            <button onclick="cambiarCantidad(${it.id},-1)">−</button>
                            <span>${cantRest}</span>
                            <button onclick="cambiarCantidad(${it.id},+1)">+</button>
                        </div>
                    </div>
                    <div class="ci-unit-price">
                        ${tieneOferta
                            ? `<span class="ci-price-old">$${fmt(it.precio)}</span>
                               <span class="ci-price-current">$${fmt(OFERTAS_MAP[it.id])} c/u</span>`
                            : `<span class="ci-price-current">$${fmt(it.precio)} c/u</span>`}
                    </div>
                    <div class="ci-subtotal">$${fmt(precioEfectivo * cantRest)}</div>
                    <button class="ci-del" onclick="quitarDePromo(${it.id},${cantRest})" title="Eliminar producto">
                        <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                    </button>
                </div>
            </div>`;

            const envase = envasesMap.get(it.id);
            if (envase && envase.cobrados > 0) {
                const totalEnvaseVal = envase.valorEnvase * envase.cobrados;
                const efHtml = envase.soloEfectivo ? ' <em class="ci-envase-ef">solo efectivo</em>' : '';
                iHtml += `
            <div class="ci-envase${envase.soloEfectivo ? ' solo-ef' : ''}">
                <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                <span class="ci-envase-lbl">Envase (${envase.cobrados} u. cobrada${envase.cobrados > 1 ? 's' : ''})${efHtml}</span>
                <span class="ci-envase-precio">$${fmt(totalEnvaseVal)}</span>
            </div>`;
            }

            entries.push({ seq: it._seq ?? 0, html: iHtml });
        });

        // ── Ordenar de más reciente (arriba) a más antiguo (abajo) ────
        entries.sort((a, b) => b.seq - a.seq);

        cont.classList.remove('split-cols');
        cont.innerHTML = entries.map(e => e.html).join('');
        cont.scrollTop = 0;
        btnGen.disabled = false;
        actualizarTotales();
        actualizarInfoFecha();
    }

    window.confirmarLimpiarCarrito = function () {
        if (carrito.size === 0 && promoCarrito.size === 0) return;

        // Vaciar es la forma de dar por terminada una venta postergada sin emitirla
        const desdePostergada = postergadaActiva != null;

        Swal.fire({
            title: '¿Vaciar carrito?',
            text: desdePostergada
                ? `Se eliminarán todos los productos y la venta postergada N° ${numeroPostergada(postergadaActiva)} se descartará del panel.`
                : 'Se eliminarán todos los productos agregados a esta venta.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#7a6050',
            confirmButtonText: 'Sí, vaciar carrito',
            cancelButtonText: 'Cancelar'
        }).then(async (result) => {
            if (result.isConfirmed) {
                carrito.clear();
                promoCarrito.clear();
                envasesMap.clear();
                renderCarrito();
                renderPromoGrid();
                actualizarTarjetasProductos();
                await consumirPostergadaActiva();
                toast('Carrito limpiado correctamente', 'exito');
            }
        });
    };

    /* ══════════════════════════════════════════════════════════════════════
       TOTALES (siempre visibles, líneas dinámicas)
    ══════════════════════════════════════════════════════════════════════ */
    function actualizarTotales() {
        let subtotal = 0, unidades = 0;
        carrito.forEach(it => { subtotal += it.precio * it.cantidad; unidades += it.cantidad; });

        const { instancias, descuentosPromoLines, descuentosOfertaLines, descTotal } = calcularDescuentos();

        // Cargo de envases
        let totalEnvases = 0;
        envasesMap.forEach((env, id) => {
            if (carrito.has(id) && env.cobrados > 0) {
                totalEnvases += env.valorEnvase * env.cobrados;
            }
        });

        const totalFinal = Math.max(0, subtotal - descTotal) + totalEnvases;

        document.getElementById('totSub').textContent   = `$${fmt(subtotal)}`;
        document.getElementById('totTotal').textContent = `$${fmt(totalFinal)}`;
        
        const distintos = carrito.size + promoCarrito.size;
        const elDist = document.getElementById('cartCntDistintos');
        const elUni  = document.getElementById('cartCntUnidades');
        const btnLim = document.getElementById('btnLimpiarCarrito');
        if (elDist) elDist.textContent = `${distintos} prod${distintos === 1 ? '' : 's'}.`;
        if (elUni)  elUni.textContent  = `${unidades} un.`;
        if (btnLim) btnLim.disabled    = (distintos === 0);

        // Promos badge count
        let numPromos = 0;
        promoCarrito.forEach(p => numPromos += p.cantidad);
        numPromos += instancias.length;

        const elPromos = document.getElementById('cartCntPromos');
        if (elPromos) {
            if (numPromos > 0) {
                elPromos.textContent = `${numPromos} Promo${numPromos === 1 ? '' : 's'}`;
                elPromos.style.display = 'inline-block';
            } else {
                elPromos.style.display = 'none';
            }
        }

        // Construir líneas de descuento individuales
        let linesHtml = '';
        for (const { nombre, ahorro } of descuentosPromoLines) {
            linesHtml += `
            <div class="tot-line descuento">
                <span>Promo: ${x(nombre)}</span>
                <span>-$${fmt(ahorro)}</span>
            </div>`;
        }
        for (const { nombre, ahorro } of descuentosOfertaLines) {
            linesHtml += `
            <div class="tot-line descuento">
                <span>Oferta: ${x(nombre)}</span>
                <span>-$${fmt(ahorro)}</span>
            </div>`;
        }
        if (totalEnvases > 0) {
            linesHtml += `
            <div class="tot-line cargo-envase">
                <span>Cargo envases</span>
                <span>+$${fmt(totalEnvases)}</span>
            </div>`;
        }
        document.getElementById('descuentosContainer').innerHTML = linesHtml;
        document.getElementById('totDescTotal').textContent = `-$${fmt(descTotal)}`;
    }

    function actualizarInfoFecha() {
        const n   = new Date();
        const pad = v => String(v).padStart(2, '0');
        const el  = document.getElementById('infoFecha');
        if (el) el.textContent = `${pad(n.getDate())}/${pad(n.getMonth()+1)}/${n.getFullYear()} ${pad(n.getHours())}:${pad(n.getMinutes())}`;
    }

    /* ══════════════════════════════════════════════════════════════════════
       VENTAS POSTERGADAS  (estado 5 «Sin Finalizar»)
       ─────────────────────────────────────────────────────────────────────
       Se guarda el carrito «en crudo»: los productos y sus envases, sin
       resolver promociones. Al recuperarlo, el motor vuelve a detectar las
       promos por su cuenta, así que no hace falta persistir ese estado.
       Postergar no mueve stock: la venta no se emitió y los productos siguen
       disponibles para otro cliente.

       Al recuperar una postergada NO se borra: queda marcada como activa en el
       panel para poder alternar entre varias sin perderlas. Se descarta recién
       al emitir la venta o al vaciar el carrito.
    ══════════════════════════════════════════════════════════════════════ */
    let ventasPostergadas = [];
    let postergadaActiva  = null;   // idBoleta cargada en el carrito, o null
    let postergadaFirma   = null;   // firma del carrito al momento de cargarla

    /* Número visible de una postergada (correlativo diario, con el id interno
       solo como respaldo). El id sigue siendo la clave que viaja al servidor. */
    function numeroPostergada(idBoleta) {
        const v = ventasPostergadas.find(p => p.idBoleta === idBoleta);
        return v ? (v.numero ?? v.idBoleta) : idBoleta;
    }

    /* Huella del carrito para detectar si el vendedor lo modificó después de
       cargar una postergada (y solo entonces advertir al cambiar de venta). */
    function firmaCarrito() {
        const prods   = [...carrito].map(([id, it]) => `p${id}:${it.cantidad}`).sort();
        const promos  = [...promoCarrito].map(([id, p]) => `m${id}:${p.cantidad}`).sort();
        const envases = [...envasesMap].map(([id, e]) => `e${id}:${e.cobrados || 0}`).sort();
        return [...prods, ...promos, ...envases].join('|');
    }

    /* Descarta en el servidor sin confirmar ni avisar: la usan los flujos donde
       la venta postergada ya cumplió su propósito (se emitió o se vació). */
    async function descartarPostergadaSilencioso(idBoleta) {
        try {
            await fetch(URL_DESCARTAR_POSTERGADA, {
                method : 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': CSRF() },
                body   : JSON.stringify({ idBoleta })
            });
        } catch { /* si falla, la postergada simplemente sigue en el panel */ }
    }

    /* Suelta la postergada cargada: la borra del servidor y refresca el panel. */
    async function consumirPostergadaActiva() {
        if (postergadaActiva == null) return;
        const id = postergadaActiva;
        postergadaActiva = null;
        postergadaFirma  = null;
        await descartarPostergadaSilencioso(id);
        await cargarPostergadas();
    }

    function itemsCarritoCrudo() {
        const items = [];
        carrito.forEach((it, id) => {
            const precioUnitario = OFERTAS_MAP[id] != null ? OFERTAS_MAP[id] : it.precio;
            items.push({
                idProducto: id, cantidad: it.cantidad,
                precioNormal: it.precio, precioUnitario,
                subtotal: precioUnitario * it.cantidad,
                idPromocion: null, idOfertaProducto: OFERTAS_ID_MAP[id] ?? null
            });
        });
        // Los envases viajan como fila con precioNormal 0, igual que en la venta real,
        // con la cantidad de envases efectivamente cobrados
        envasesMap.forEach((env, id) => {
            const it = carrito.get(id);
            if (!it || !(env.cobrados > 0)) return;
            items.push({
                idProducto: id, cantidad: env.cobrados,
                precioNormal: 0, precioUnitario: env.valorEnvase,
                subtotal: env.valorEnvase * env.cobrados,
                idPromocion: null, idOfertaProducto: null
            });
        });
        return items;
    }

    function totalCarritoActual() {
        const { descTotal } = calcularDescuentos();
        let subtotal = 0;
        carrito.forEach(it => { subtotal += it.precio * it.cantidad; });
        let envases = 0;
        envasesMap.forEach((env, id) => {
            const it = carrito.get(id);
            if (it && env.cobrados > 0) envases += env.valorEnvase * env.cobrados;
        });
        return Math.max(0, subtotal - descTotal) + envases;
    }

    function vaciarCarrito() {
        const ids = [...carrito.keys()];
        carrito.clear();
        promoCarrito.clear();
        envasesMap.clear();
        renderCarrito();
        ids.forEach(id => actualizarTarjeta(id));
        renderPromoGrid();
    }

    window.confirmarPostergarVenta = function () {
        if (carrito.size === 0 && promoCarrito.size === 0) return;
        if (Swal.isVisible()) return;

        Swal.fire({
            title: '¿Postergar esta venta?',
            text: 'Se guardará para retomarla después y el carrito quedará libre para atender a otro cliente.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: 'var(--color-primario, #e76f2e)',
            cancelButtonColor: '#7a6050',
            confirmButtonText: 'Sí, postergar',
            cancelButtonText: 'Cancelar'
        }).then(r => { if (r.isConfirmed) postergarVenta(); });
    };

    async function postergarVenta() {
        const btn = document.getElementById('btnPostergar');
        const htmlPrevio = btn.innerHTML;
        btn.disabled  = true;
        btn.innerHTML = `<span class="spin-sm" style="border-color:rgba(122,96,80,.3);border-top-color:#7a6050;"></span> Guardando…`;

        try {
            const resp = await fetch(URL_POSTERGAR, {
                method : 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': CSRF() },
                // Si venía de una postergada se actualiza esa misma venta, para que
                // conserve su número en lugar de aparecer como una nueva
                body   : JSON.stringify({
                    items      : itemsCarritoCrudo(),
                    montoTotal : totalCarritoActual(),
                    idBoleta   : postergadaActiva
                })
            });
            const data = await resp.json();
            if (!data.ok) { toast(data.mensaje ?? 'No se pudo postergar la venta.', 'error'); return; }

            postergadaActiva = null;
            postergadaFirma  = null;
            vaciarCarrito();
            toast(data.mensaje, 'exito');
            await cargarPostergadas(data.venta?.idBoleta);
        } catch {
            toast('Error de conexión al postergar la venta.', 'error');
        } finally {
            btn.innerHTML = htmlPrevio;
            btn.disabled  = carrito.size === 0 && promoCarrito.size === 0;
        }
    }

    window.cargarPostergadas = async function (resaltarId) {
        try {
            const r = await fetch(URL_POSTERGADAS);
            if (!r.ok) throw new Error();
            ventasPostergadas = await r.json();
        } catch {
            ventasPostergadas = [];
        }
        renderPostergadas(resaltarId);
    };

    function renderPostergadas(resaltarId) {
        const cont = document.getElementById('postList');
        const cnt  = document.getElementById('postCnt');
        if (!cont) return;
        if (cnt) cnt.textContent = ventasPostergadas.length;

        // Si la que estaba cargada ya no existe (la descartó otro cajero), se
        // suelta la marca para no dejar el carrito atado a una venta fantasma
        if (postergadaActiva != null && !ventasPostergadas.some(v => v.idBoleta === postergadaActiva)) {
            postergadaActiva = null;
            postergadaFirma  = null;
        }

        if (ventasPostergadas.length === 0) {
            cont.innerHTML = `<div class="post-empty">
                <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
                Sin ventas postergadas</div>`;
            return;
        }

        cont.innerHTML = ventasPostergadas.map(v => {
            const activa = v.idBoleta === postergadaActiva;
            return `
            <div class="post-card${v.idBoleta === resaltarId ? ' recien' : ''}${activa ? ' activa' : ''}"
                 onclick="recuperarPostergada(${v.idBoleta})"
                 title="${activa ? 'Cargada en el carrito' : 'Cargar esta venta en el carrito'} — ${x(v.vendedor)} · ${x(v.fechaEmision)}">
                <button class="post-card-del" title="Descartar esta venta"
                        onclick="event.stopPropagation(); descartarPostergada(${v.idBoleta});">
                    <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                </button>
                ${activa ? '<div class="post-card-activa">En el carrito</div>' : ''}
                <div class="post-card-num">N° ${v.numero ?? v.idBoleta}</div>
                <div class="post-card-monto">$${fmt(v.montoTotal)}</div>
                <div class="post-card-meta">${v.cantProductos} ítem(s) · ${x(v.hora)}</div>
            </div>`;
        }).join('');
    }

    window.recuperarPostergada = async function (idBoleta) {
        // Ya está cargada y sin cambios: no hay nada que rehacer
        if (idBoleta === postergadaActiva && firmaCarrito() === postergadaFirma) return;

        // Solo se advierte por lo que se perdería de verdad: un carrito armado a
        // mano, o los cambios hechos sobre una postergada ya cargada. Alternar
        // entre postergadas sin tocarlas no pierde nada, así que no interrumpe.
        const hayCarrito = carrito.size > 0 || promoCarrito.size > 0;
        const hayCambios = postergadaActiva == null
            ? hayCarrito
            : firmaCarrito() !== postergadaFirma;

        if (hayCambios) {
            const r = await Swal.fire({
                title: postergadaActiva == null ? 'El carrito tiene productos' : 'Hay cambios sin guardar',
                text: postergadaActiva == null
                    ? 'Se descartarán para cargar la venta postergada. Si quieres conservarlos, postérgalos primero.'
                    : `Los cambios hechos sobre la venta N° ${numeroPostergada(postergadaActiva)} se perderán. La venta postergada se conserva tal como se guardó.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#7a6050',
                confirmButtonText: 'Descartar y recuperar',
                cancelButtonText: 'Cancelar'
            });
            if (!r.isConfirmed) return;
        }

        try {
            const resp = await fetch(URL_RECUPERAR_POSTERGADA, {
                method : 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': CSRF() },
                body   : JSON.stringify({ idBoleta })
            });
            const data = await resp.json();
            if (!data.ok) {
                toast(data.mensaje, 'error');
                if (idBoleta === postergadaActiva) { postergadaActiva = null; postergadaFirma = null; }
                await cargarPostergadas();
                return;
            }

            const idsPrevios = [...carrito.keys()];
            carrito.clear();
            promoCarrito.clear();
            envasesMap.clear();

            (data.items ?? []).forEach(it => {
                const prod = CATALOGO.find(p => p.id === it.idProducto);
                if (!prod) return;
                if (it.precioNormal === 0) {
                    // Fila de envase: se vuelve a cobrar la garantía por las
                    // mismas unidades que se cobraron al postergar
                    envasesMap.set(it.idProducto, {
                        cobrados    : it.cantidad,
                        valorEnvase : it.precioUnitario,
                        soloEfectivo: prod.retornable?.soloEfectivo ?? false
                    });
                } else {
                    carrito.set(it.idProducto, {
                        id: it.idProducto, nombre: prod.nombre, precio: prod.precio,
                        cantidad: it.cantidad, stock: prod.stock, _seq: ++cartSeqCounter
                    });
                }
            });

            // La venta sigue guardada: queda marcada como activa en el panel
            postergadaActiva = idBoleta;

            renderCarrito();
            new Set([...idsPrevios, ...carrito.keys()]).forEach(id => actualizarTarjeta(id));
            renderPromoGrid();
            postergadaFirma = firmaCarrito();
            renderPostergadas();
            toast(data.mensaje, 'exito');
        } catch {
            toast('Error de conexión al recuperar la venta.', 'error');
        }
    };

    window.descartarPostergada = async function (idBoleta) {
        const esActiva = idBoleta === postergadaActiva;
        const numero   = numeroPostergada(idBoleta);
        const r = await Swal.fire({
            title: '¿Descartar la venta postergada?',
            html: esActiva
                ? `Se eliminará la venta <strong>N° ${numero}</strong> del panel. Sus productos siguen en el carrito, que queda como una venta nueva.`
                : `Se eliminará la venta <strong>N° ${numero}</strong> sin devolver sus productos al carrito.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#7a6050',
            confirmButtonText: 'Sí, descartar',
            cancelButtonText: 'Cancelar'
        });
        if (!r.isConfirmed) return;

        try {
            const resp = await fetch(URL_DESCARTAR_POSTERGADA, {
                method : 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': CSRF() },
                body   : JSON.stringify({ idBoleta })
            });
            const data = await resp.json();
            if (esActiva) { postergadaActiva = null; postergadaFirma = null; }
            toast(data.mensaje, data.ok ? 'exito' : 'error');
            await cargarPostergadas();
        } catch {
            toast('Error de conexión al descartar la venta.', 'error');
        }
    };

    /* ══════════════════════════════════════════════════════════════════════
       GENERAR BOLETA
    ══════════════════════════════════════════════════════════════════════ */
    window.generarBoleta = async function (soloCliente = false, sinTicket = false) {
        if (carrito.size === 0 && promoCarrito.size === 0) return;

        const btn     = document.getElementById('btnGenerar');
        btn.disabled  = true;
        btn.innerHTML = `<span class="spin-sm"></span> Generando…`;

        const { instancias, remaining, descuentosPromoLines, descuentosOfertaLines, descTotal } = calcularDescuentos();

        // ── Snapshot del carrito para el ticket (antes de limpiar) ────────
        const snapshotInstancias    = instancias;
        const snapshotRemaining     = new Map(remaining);
        const snapshotCarrito       = new Map(carrito);
        const snapshotDescPromos    = descuentosPromoLines;
        const snapshotDescOfertas   = descuentosOfertaLines;
        const snapshotDescTotal     = descTotal;

        let subtotalSnapshot = 0;
        carrito.forEach(it => { subtotalSnapshot += it.precio * it.cantidad; });

        // ── Construir items para el servidor ──────────────────────────────
        const snapshotEnvases = new Map(envasesMap);
        const items = [];
        instancias.forEach(inst => {
            const sumaNormal = inst.itemsActivos.reduce(
                (acc, { precio, cantReq }) => acc + precio * cantReq, 0
            );
            let subtotalRestante = inst.promoPrecio;
            const lastIdx = inst.itemsActivos.length - 1;
            inst.itemsActivos.forEach(({ id, precio, cantReq }, idx) => {
                let subtotal;
                if (idx === lastIdx) {
                    // El último ítem absorbe el redondeo para que la suma sea exactamente promoPrecio
                    subtotal = subtotalRestante;
                } else {
                    subtotal = sumaNormal > 0
                        ? Math.round((precio * cantReq / sumaNormal) * inst.promoPrecio)
                        : precio * cantReq;
                    subtotalRestante -= subtotal;
                }
                const precioUnitario = Math.round(subtotal / cantReq);
                items.push({ idProducto: id, cantidad: cantReq, precioNormal: precio, precioUnitario, subtotal, idPromocion: inst.promoId, idOfertaProducto: null });
            });
        });
        carrito.forEach((it, id) => {
            const cantRest = remaining.get(id) ?? 0;
            if (cantRest <= 0) return;
            const precioUnitario = OFERTAS_MAP[id] != null ? OFERTAS_MAP[id] : it.precio;
            items.push({ idProducto: id, cantidad: cantRest, precioNormal: it.precio, precioUnitario, idPromocion: null, idOfertaProducto: OFERTAS_ID_MAP[id] ?? null });
        });
        // Ítems de envase (cargo extra por envase no traído): sólo las unidades
        // marcadas como «no trajo envase», no toda la cantidad del producto.
        snapshotEnvases.forEach((env, id) => {
            const it = carrito.get(id);
            if (!it || !(env.cobrados > 0)) return;
            items.push({ idProducto: id, cantidad: env.cobrados, precioNormal: 0, precioUnitario: env.valorEnvase, idPromocion: null, idOfertaProducto: null });
        });

        try {
            const resp = await fetch(URL_CREAR, {
                method : 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': CSRF() },
                // Al emitir una postergada se reutiliza su boleta: conserva el
                // número que el vendedor venía viendo en el panel
                body   : JSON.stringify({ items, idBoletaPostergada: postergadaActiva })
            });
            const data = await resp.json();

            if (data.ok) {
                // Decrementar stock localmente en CATALOGO para reflejar la venta
                items.forEach(item => {
                    if (item.idProducto !== 0 && item.precioNormal > 0) {
                        const prod = CATALOGO.find(p => p.id === item.idProducto);
                        if (prod) {
                            prod.stock -= item.cantidad;
                        }
                    }
                });

                // Limpiar carrito (incluye promoCarrito: si no, una promo agregada
                // desde su tarjeta quedaba en el panel después de vender)
                vaciarCarrito();

                // La postergada ya no está postergada: el servidor la emitió sobre
                // su misma boleta, así que solo hay que refrescar el panel
                if (postergadaActiva != null) {
                    postergadaActiva = null;
                    postergadaFirma  = null;
                    await cargarPostergadas();
                }

                if (sinTicket) {
                    // Venta guardada sin emitir ticket: aviso breve que se cierra solo
                    Swal.fire({
                        icon: 'success',
                        title: 'Venta guardada',
                        text: `Venta N° ${data.boleta.correlativoDiario ?? data.boleta.idBoleta} guardada sin emitir ticket.`,
                        timer: 5000,
                        timerProgressBar: true,
                        showConfirmButton: false
                    });
                } else {
                    // Mostrar ticket con el snapshot
                    mostrarTicket({
                        idBoleta:          data.boleta.idBoleta,
                        correlativoDiario: data.boleta.correlativoDiario,
                        @* cajero:       data.boleta.cajero, *@
                        fechaEmision: data.boleta.fechaEmision,
                        instancias:   snapshotInstancias,
                        remaining:    snapshotRemaining,
                        carritoSnap:  snapshotCarrito,
                        descPromos:   snapshotDescPromos,
                        descOfertas:  snapshotDescOfertas,
                        descTotal:    snapshotDescTotal,
                        subtotal:     subtotalSnapshot,
                        envases:      snapshotEnvases,
                        soloCliente
                    });
                }
            } else {
                toast(data.mensaje ?? 'Error al generar la venta.', 'error');
            }
        } catch {
            toast('Error de conexión. Inténtalo de nuevo.', 'error');
        } finally {
            btn.disabled  = false;
            btn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg> Generar venta`;
        }
    };

    /* ══════════════════════════════════════════════════════════════════════
       TICKET POS
    ══════════════════════════════════════════════════════════════════════ */
    function mostrarTicket({ idBoleta, correlativoDiario, cajero, fechaEmision, instancias, remaining, carritoSnap, descPromos, descOfertas, descTotal, subtotal, envases, soloCliente = false }) {
        const NOMBRE_LOCAL = 'Cuatro Ases';
        const total = Math.max(0, subtotal - descTotal);
        const pad58  = (l, r) => {
            const lStr = String(l ?? '');
            const rStr = String(r ?? '');
            const dots = Math.max(1, 28 - lStr.length - rStr.length);
            return `${lStr}${' '.repeat(dots)}${rStr}`;
        };

        let lineas = '';

        // ── Ítems de promo (agrupados por idPromo) ────────────────────────
        const promoTicketMap = new Map();
        instancias.forEach(inst => {
            if (!promoTicketMap.has(inst.promoId)) {
                promoTicketMap.set(inst.promoId, {
                    nombre: inst.promoNombre,
                    precioUnitario: inst.promoPrecio,
                    veces: 0,
                    ahorroTotal: 0,
                    productosQty: new Map() // idProducto → { nombre, precio, cantTotal }
                });
            }
            const g = promoTicketMap.get(inst.promoId);
            g.veces++;
            g.ahorroTotal += inst.ahorro;
            inst.itemsActivos.forEach(({ id, nombre, cantReq, precio }) => {
                if (!g.productosQty.has(id)) g.productosQty.set(id, { nombre, precio, cantTotal: 0 });
                g.productosQty.get(id).cantTotal += cantReq;
            });
        });

        promoTicketMap.forEach(g => {
            const label = 'Promo: ' + (g.veces > 1 ? `${g.nombre} (x${g.veces})` : g.nombre);
            lineas += `
            <hr class="ticket-hr">
            <div class="ticket-row ticket-promo-tag">
                <span class="tk-l">${x(label)}</span>
                <span class="tk-r ticket-bold">$${fmt(g.precioUnitario * g.veces)}</span>
            </div>`;
            g.productosQty.forEach(({ nombre, precio, cantTotal }) => {
                lineas += `
            <div class="ticket-row ticket-grid" style="padding-left:.8rem;">
                <span class="tk-l">${x(nombre)}</span>
                <span class="tk-q">${cantTotal}</span>
                <span class="tk-m"></span>
                <span class="tk-r"></span>
            </div>`;
            });
        });

        // ── Ítems individuales ────────────────────────────────────────────
        let hayIndiv = false;
        carritoSnap.forEach((it, id) => {
            const cantRest = remaining.get(id) ?? 0;
            if (cantRest <= 0) return;
            if (!hayIndiv) { lineas += `<hr class="ticket-hr">`; hayIndiv = true; }
            const tieneOferta = OFERTAS_MAP[id] != null;
            const precioFinal = tieneOferta ? OFERTAS_MAP[id] : it.precio;
            const precioHtml  = tieneOferta
                ? `<span class="ticket-strike">$${fmt(it.precio)}</span> $${fmt(precioFinal)}`
                : `$${fmt(precioFinal)}`;
            lineas += `
            <div class="ticket-row ticket-grid">
                <span class="tk-l">${x(it.nombre)}${tieneOferta ? ' <em>(oferta)</em>' : ''}</span>
                <span class="tk-q">${cantRest}</span>
                <span class="tk-m">${precioHtml}</span>
                <span class="tk-r">$${fmt(precioFinal * cantRest)}</span>
            </div>`;
        });

        // ── Totales ───────────────────────────────────────────────────────
        lineas += `<hr class="ticket-hr-sol">`;
        lineas += `<div class="ticket-row"><span class="tk-l">Subtotal</span><span class="tk-r">$${fmt(subtotal)}</span></div>`;

        descPromos.forEach(({ nombre, ahorro }) => {
            lineas += `<div class="ticket-row ticket-desc"><span class="tk-l">Promo: ${x(nombre)}</span><span class="tk-r">-$${fmt(ahorro)}</span></div>`;
        });
        descOfertas.forEach(({ nombre, ahorro }) => {
            lineas += `<div class="ticket-row ticket-desc"><span class="tk-l">Oferta: ${x(nombre)}</span><span class="tk-r">-$${fmt(ahorro)}</span></div>`;
        });
        if (descTotal > 0) {
            lineas += `<div class="ticket-row ticket-desc ticket-bold"><span class="tk-l">Total descuentos</span><span class="tk-r">-$${fmt(descTotal)}</span></div>`;
        }

        // Envases en el ticket: sólo las unidades cobradas (cliente no trajo envase)
        let totalEnvasesTicket = 0;
        let lineasEnvases = '';
        if (envases && envases.size > 0) {
            envases.forEach((env, id) => {
                const it = carritoSnap.get(id);
                if (!it || !(env.cobrados > 0)) return;
                const montoEnvase = env.valorEnvase * env.cobrados;
                totalEnvasesTicket += montoEnvase;
                const efLabel = env.soloEfectivo ? ' (SOLO EFECTIVO)' : '';
                const uLabel  = env.cobrados > 1 ? ` x${env.cobrados}` : '';
                lineasEnvases += `<div class="ticket-row ticket-bottle-charge"><span class="tk-l">Envase: ${x(it.nombre)}${uLabel}${efLabel}</span><span class="tk-r">+$${fmt(montoEnvase)}</span></div>`;
            });
        }
        if (lineasEnvases) {
            lineas += `<hr class="ticket-hr">` + lineasEnvases;
        }

        lineas += `<hr class="ticket-hr-sol">`;
        lineas += `<div class="ticket-row ticket-total"><span class="tk-l">TOTAL</span><span class="tk-r">$${fmt(total + totalEnvasesTicket)}</span></div>`;

        // ── Ticket vendedor: picking list (todos los productos con cantidad) ──
        const pickingMap = new Map(); // idProducto → { nombre, cantTotal }
        instancias.forEach(inst => {
            inst.itemsActivos.forEach(({ id, nombre, cantReq }) => {
                if (!pickingMap.has(id)) pickingMap.set(id, { nombre, cantTotal: 0 });
                pickingMap.get(id).cantTotal += cantReq;
            });
        });
        carritoSnap.forEach((it, id) => {
            const cantRest = remaining.get(id) ?? 0;
            if (cantRest <= 0) return;
            if (!pickingMap.has(id)) pickingMap.set(id, { nombre: it.nombre, cantTotal: 0 });
            pickingMap.get(id).cantTotal += cantRest;
        });

        let lineasVendedor = '';
        pickingMap.forEach(({ nombre, cantTotal }) => {
            lineasVendedor += `
            <div class="ticket-row">
                <span class="tk-l">${x(nombre)}</span>
                <span class="tk-r ticket-bold">${cantTotal}</span>
            </div>`;
        });

        const html = `
        <div class="ticket-overlay" id="ticketOverlay">
            <div class="ticket-wrap">
                <div class="ticket ticket-cliente">
                    <div class="ticket-title ticket-bold">${x(NOMBRE_LOCAL)}</div>
                    <div class="ticket-subtitle ticket-bold" style="margin-top:2px;">TICKET N° ${correlativoDiario ?? idBoleta}</div>
                    <div class="ticket-sub-label">TICKET INTERNO</div>
                    <hr class="ticket-hr-sol">
                    <div class="ticket-row"><span class="tk-l">Fecha</span><span class="tk-r">${fechaEmision}</span></div>
                    <hr class="ticket-hr-sol">
                    <div class="ticket-row ticket-bold ticket-grid"><span class="tk-l">ARTÍCULO</span><span class="tk-q">CANT</span><span class="tk-m">P.UNIT</span><span class="tk-r">TOTAL</span></div>
                    ${lineas}
                    <hr class="ticket-hr">
                    <div class="ticket-sub-label" style="margin-top:.5rem;">¡Gracias por su compra!</div>
                </div>
                ${soloCliente ? '' : `
                <div class="ticket-cut">✂ &nbsp; CORTAR &nbsp; ✂</div>
                <div class="ticket ticket-vendedor">
                    <div class="ticket-title ticket-bold">LISTA DE DESPACHO</div>
                    <div class="ticket-subtitle ticket-bold" style="margin-top:2px;">TICKET N° ${correlativoDiario ?? idBoleta}</div>
                    <div class="ticket-sub-label">COPIA VENDEDOR</div>
                    <hr class="ticket-hr-sol">
                    <div class="ticket-row"><span class="tk-l">Fecha</span><span class="tk-r">${fechaEmision}</span></div>
                    <hr class="ticket-hr-sol">
                    <div class="ticket-row ticket-bold"><span class="tk-l">ARTÍCULO</span><span class="tk-r">CANT.</span></div>
                    ${lineasVendedor}
                    <hr class="ticket-hr">
                </div>`}
            </div>
        </div>`;

        // Quitar ticket anterior si existe
        document.getElementById('ticketOverlay')?.remove();
        document.body.insertAdjacentHTML('beforeend', html);

        // Escuchar cuando finalice la impresión (o se cancele) para remover el elemento del DOM
        window.addEventListener('afterprint', () => {
            document.getElementById('ticketOverlay')?.remove();
        }, { once: true });

        // Dar un pequeño tiempo (100ms) para que el navegador procese y dibuje el nuevo HTML en el DOM
        // antes de abrir el diálogo de impresión (evita que la hoja salga en blanco)
        setTimeout(() => {
            window.print();
            toast(`Venta N° ${idBoleta} enviada a impresión`, 'exito');
        }, 100);
    }

    /* ══════════════════════════════════════════════════════════════════════
       UTILIDADES
    ══════════════════════════════════════════════════════════════════════ */
    function fmt(n) { return Number(n).toLocaleString('es-CL'); }
    function x(s) {
        return String(s ?? '')
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function toast(msg, tipo) {
        const ico = {
            exito: '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>',
            error: '<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>'
        };
        const w = document.getElementById('toastWrap');
        const t = document.createElement('div');
        t.className = `toast-msg ${tipo}`;
        t.innerHTML = `${ico[tipo]}<span>${msg}</span>`;
        w.appendChild(t);
        setTimeout(() => t.style.opacity = '0', 3500);
        setTimeout(() => t.remove(), 3800);
    }

    // ── CONFIRMACIÓN DE VENTA CON SWEETALERT ─────────────────────────────
    let currentVentaSoloCliente = false;

    window.confirmarVentaShortcut = function (soloCliente = false) {
        if (carrito.size === 0 && promoCarrito.size === 0) return;
        
        currentVentaSoloCliente = soloCliente;

        if (Swal.isVisible()) {
            return;
        }

        Swal.fire({
            title: '¿Confirmar venta?',
            text: soloCliente ? 'Se generará la venta y se imprimirá SOLO la copia del cliente.' : 'Se generará la venta y se imprimirán ambas copias.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: 'var(--color-primario, #e76f2e)',
