.fiado-client-list { display:flex; flex-direction:column; gap:.3rem; }
.fiado-client-item { display:flex; align-items:center; gap:.65rem; padding:.5rem .75rem; border:1.5px solid #ede5df; border-radius:9px; cursor:pointer; transition:border-color .12s,background .12s; }
