    window.confirmarEnvase = function (trajoEnvase) {
        cerrarDialogoEnvase();
        if (!pendingEnvase) return;
        const { p, qty, nextItems, nextIds } = pendingEnvase;
        pendingEnvase = null;
        _agregarProductoADetalle(p, qty, !trajoEnvase);
        toast(`${x(p.nombre)} ×${qty} agregado.`, 'exito');

        if (nextItems && nextItems.length > 0) {
            procesarItemsAgregados(nextItems);
        } else if (nextIds && nextIds.length > 0) {
            procesarItemsAgregados(nextIds, qty);
        } else {
            evaluarPromocionesAutomaticasEnDetalle();
            renderDetalle();
            _autoGuardarDebounce();
        }
    };

    /* ════════════════════════════════════════════════════
       SELECCIÓN DE PROMOCIÓN
    ════════════════════════════════════════════════════ */
    let _dialogoIdPromo = null;

    window.seleccionarPromo = function (idPromo) {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        if (!puedeAgregarPromo(idPromo)) { toast('Sin stock suficiente para esta promoción.', 'error'); return; }
        const promo = PROMOS.find(p => p.id === idPromo);
        if (!promo) return;
        const gruposExcl = promo.grupos.filter(g => g.esExcluyente && g.productos.length > 1);
        if (gruposExcl.length > 0) {
            mostrarDialogoGruposCaja(idPromo, gruposExcl);
        } else {
            agregarPromoDeCaja(idPromo, {});
        }
    };

    /* ════════════════════════════════════════════════════
       DIÁLOGO GRUPOS EXCLUYENTES
    ════════════════════════════════════════════════════ */
    function mostrarDialogoGruposCaja(idPromo, gruposExcl) {
        _dialogoIdPromo = idPromo;
        const promo = PROMOS.find(p => p.id === idPromo);

        const seccionesHtml = gruposExcl.map(g => {
            const optsHtml = g.productos.map(r => {
                const prod = CATALOGO.find(c => c.id === r.idProducto);
                if (!prod) return '';
                const stockDisp = prod.stock;
                const sinStock  = false;
                const cls       = '';
                const sinCls    = '';
                const clickFn   = `onclick="seleccionarOpcionGrupo(this,'${g.idGrupo}')"`;
                return `<div class="goc" data-grupo="${g.idGrupo}" data-producto="${r.idProducto}" ${clickFn}>
                    <div class="goc-check">✓</div>
                    <span class="goc-nombre">${x(prod.nombre)} <small style="font-weight:400;color:#a89080">×${r.cantidad}</small></span>
                    <span class="goc-stock">Stock: ${stockDisp}</span>
                </div>`;
            }).join('');
            return `<div class="grupos-section">
                <div class="grupos-section-lbl">Elige una opción:</div>
                <div class="grupos-opts" data-grupo="${g.idGrupo}">${optsHtml}</div>
            </div>`;
        }).join('');

        const overlay = document.getElementById('gruposOverlay');
        overlay.innerHTML = `
        <div class="grupos-card" onclick="event.stopPropagation()">
            <div class="grupos-titulo">Personaliza tu promo</div>
            <div class="grupos-promo-nombre">${x(promo.nombre)}</div>
            ${seccionesHtml}
            <div class="grupos-btns">
                <button class="grupos-btn cancelar" onclick="cerrarDialogoGrupos()">Cancelar</button>
                <button class="grupos-btn confirmar" id="btnConfirmarGrupos" onclick="confirmarDialogoGruposCaja()" disabled>Agregar a boleta</button>
            </div>
        </div>`;
        overlay.style.display = 'flex';
    }

    window.seleccionarOpcionGrupo = function (el, idGrupo) {
        el.closest('.grupos-opts').querySelectorAll('.goc').forEach(c => c.classList.remove('goc-sel'));
        el.classList.add('goc-sel');
        const overlay = document.getElementById('gruposOverlay');
        const grupos  = overlay.querySelectorAll('.grupos-opts[data-grupo]');
        const todos   = Array.from(grupos).every(g => g.querySelector('.goc.goc-sel'));
        document.getElementById('btnConfirmarGrupos').disabled = !todos;
    };

    window.confirmarDialogoGruposCaja = function () {
        const idPromo = _dialogoIdPromo;
        if (!idPromo) { cerrarDialogoGrupos(); return; }
        const overlay         = document.getElementById('gruposOverlay');
        const seleccionGrupos = {};
        overlay.querySelectorAll('.goc.goc-sel').forEach(el => {
            seleccionGrupos[el.dataset.grupo] = parseInt(el.dataset.producto);
        });
        cerrarDialogoGrupos();
        agregarPromoDeCaja(idPromo, seleccionGrupos);
    };

    window.cerrarDialogoGrupos = function () {
        document.getElementById('gruposOverlay').style.display = 'none';
        _dialogoIdPromo = null;
    };

    /* ════════════════════════════════════════════════════
       AGREGAR PROMO A DETALLEACTUAL
    ════════════════════════════════════════════════════ */
    function agregarPromoDeCaja(idPromo, seleccionGrupos) {
        const promo = PROMOS.find(p => p.id === idPromo);
        if (!promo) return;

        // Collect all products of this promo instance
        const promoItems = [];  // [{idProducto, nombre, precioNormal, cantidad}]

        promo.productosBase.forEach(req => {
            const prod = CATALOGO.find(c => c.id === req.idProducto);
            if (!prod) return;
            promoItems.push({ idProducto: prod.id, nombre: prod.nombre, precioNormal: prod.precio, cantidad: req.cantidad, retornable: prod.retornable });
        });

        promo.grupos.forEach(g => {
            let elegido;
            if (g.esExcluyente) {
                const selId = seleccionGrupos[g.idGrupo];
                elegido = selId ? g.productos.find(r => r.idProducto === selId) : null;
                if (!elegido) {
                    elegido = g.productos.find(r => {
                        const pr = CATALOGO.find(c => c.id === r.idProducto);
                        return pr && pr.stock >= r.cantidad;
                    }) ?? g.productos[0];
                }
            } else {
                elegido = g.productos[0];
            }
            if (!elegido) return;
            const prod = CATALOGO.find(c => c.id === elegido.idProducto);
            if (!prod) return;
            promoItems.push({ idProducto: prod.id, nombre: prod.nombre, precioNormal: prod.precio, cantidad: elegido.cantidad, retornable: prod.retornable });
        });

        if (!promoItems.length) return;

        const instId = ++_promoInstCounter;

        // Distribute promo.precio proportionally across items
        const sumaNormal = promoItems.reduce((s, it) => s + it.precioNormal * it.cantidad, 0);
        let restante = promo.precio;
        promoItems.forEach((it, idx) => {
            let subtotal;
            if (idx === promoItems.length - 1) {
                subtotal = restante;
            } else {
                subtotal = sumaNormal > 0
                    ? Math.round((it.precioNormal * it.cantidad / sumaNormal) * promo.precio)
                    : it.precioNormal * it.cantidad;
                restante -= subtotal;
            }
            const precioUnitario = it.cantidad > 0 ? Math.round(subtotal / it.cantidad) : 0;

            // Push to detalleActual (always as new row for promo instance)
            detalleActual.push({
                idProducto:     it.idProducto,
                nombre:         it.nombre,
                cantidad:       it.cantidad,
                precioNormal:   it.precioNormal,
                precioUnitario: precioUnitario,
                subtotal:       subtotal,
                idPromocion:    idPromo,
                nombrePromocion:promo.nombre,
                idOferta:       null,
                tieneOferta:    false,
                esEnvase:       false,
                promoInstId:    instId
            });

            // Envase handling for promo products
            if (it.retornable) {
                const ve = it.retornable.valorEnvase;
                detalleActual.push({
                    idProducto:     it.idProducto,
                    nombre:         `Envase ${it.nombre}`,
                    cantidad:       it.cantidad,
                    precioNormal:   0,
                    precioUnitario: ve,
                    subtotal:       it.cantidad * ve,
                    idPromocion:    null,
                    nombrePromocion:null,
                    idOferta:       null,
                    tieneOferta:    false,
                    esEnvase:       true,
                    promoInstId:    instId
                });
            }
        });

        renderDetalle();
        _autoGuardarDebounce();
        toast(`Promoción "${promo.nombre}" agregada.`, 'exito');
    }

    /* ════════════════════════════════════════════════════
       BUSCAR BOLETA
    ════════════════════════════════════════════════════ */
    window.buscarBoleta = async function () {
        const id = parseInt(document.getElementById('inputNBoleta').value);
        if (!id || id < 1) { toast('Ingresa un N° de boleta válido.', 'error'); return; }
        const btn = document.getElementById('btnBuscar');
        setBotonCargando(btn, true);
        const res = await post(URL_BUSCAR, { idBoleta: id });
        setBotonCargando(btn, false);
        if (!res.ok) { toast(res.mensaje, 'error'); return; }
        cargarBoleta(res.boleta);
    };

    /* ════════════════════════════════════════════════════
       CARGAR BOLETA EN UI
    ════════════════════════════════════════════════════ */
    function cargarBoleta(b) {
        boletaActual  = b;
        detalleActual = b.detalle.map(d => ({ ...d }));
        metodosCobro  = [];

        /* Reconstruct promoInstId for rows loaded from the server.
           The backend stores each promo instance as separate rows (no merging).
           Strategy: for each idPromocion, use the first base product as an
           anchor — each anchor row = one instance. Exclusive-group products
           are assigned to instances in the same order they appear in the array. */
        detalleActual.forEach(d => {
            d.promoInstId = null;
            if (d.esEnvase == null) d.esEnvase = false;
        });

        // Group non-envase rows by idPromocion
        const byPromo = {};
        detalleActual.forEach(d => {
            if (d.idPromocion && !d.esEnvase) {
                (byPromo[d.idPromocion] ??= []).push(d);
            }
        });

        Object.entries(byPromo).forEach(([idPromoStr, rows]) => {
            const idPromo = Number(idPromoStr);
            const promoDef = PROMOS.find(p => p.id === idPromo);

            if (!promoDef || !promoDef.productosBase?.length) {
                // No definition found — treat all rows as one instance
                const instId = ++_promoInstCounter;
                rows.forEach(r => r.promoInstId = instId);
                return;
            }

            // Anchor: first base product. Each row of it = one instance.
            const anchorId = promoDef.productosBase[0].idProducto;
            const anchorRows = rows.filter(r => r.idProducto === anchorId);
            const nInst = anchorRows.length || 1;

            // Allocate one instId per instance
            const instIds = Array.from({ length: nInst }, () => ++_promoInstCounter);

            // Assign anchor rows first (one per instance, in order)
            anchorRows.forEach((r, i) => { r.promoInstId = instIds[i]; });

            // Assign remaining base products (non-anchor) in order
            promoDef.productosBase.slice(1).forEach(bp => {
                rows.filter(r => r.idProducto === bp.idProducto && !r.promoInstId)
                    .forEach((r, i) => { r.promoInstId = instIds[i] ?? instIds[0]; });
            });

            // Assign non-exclusive group products in order
            promoDef.grupos.filter(g => !g.esExcluyente).forEach(g => {
                g.productos.forEach(gp => {
                    rows.filter(r => r.idProducto === gp.idProducto && !r.promoInstId)
                        .forEach((r, i) => { r.promoInstId = instIds[i] ?? instIds[0]; });
                });
            });

            // Assign exclusive group products in order (one per instance)
            promoDef.grupos.filter(g => g.esExcluyente).forEach(g => {
                const exclIds = g.productos.map(p => p.idProducto);
                rows.filter(r => exclIds.includes(r.idProducto) && !r.promoInstId)
                    .forEach((r, i) => { r.promoInstId = instIds[i] ?? instIds[0]; });
            });

            // Fallback: any still-unassigned rows get the first instId
            rows.filter(r => !r.promoInstId)
                .forEach(r => { r.promoInstId = instIds[0]; });
        });

        // Assign envase rows (esEnvase && no idPromocion) to their promo inst
        // by matching idProducto to a promo row already tagged
        detalleActual.forEach(d => {
            if (d.esEnvase && !d.promoInstId) {
                const promoRow = detalleActual.find(r => !r.esEnvase && r.promoInstId && r.idProducto === d.idProducto);
                if (promoRow) d.promoInstId = promoRow.promoInstId;
            }
        });

        const esPagada   = b.idEstado === 3;
        const esAnulada  = b.idEstado === 2;
        const esEditable = b.idEstado === 1;

        const estadoClass = esPagada ? 'est-3' : esAnulada ? 'est-2' : 'est-1';
        const numTicket = b.correlativoDiario ? b.correlativoDiario : b.idBoleta;

        document.getElementById('headerBoleta').textContent = 'Detalle del Ticket';

        document.getElementById('bolInfoHeader').innerHTML =
            `<span class="bol-info-item"><span class="lbl">Ticket N°</span><span class="val">${numTicket}</span></span>` +
            `<span class="bol-info-item"><span class="lbl">Fecha</span><span class="val">${x(b.fechaEmision)}</span></span>` +
            `<span class="bol-info-item"><span class="lbl">Vendedor</span><span class="val">${x(b.vendedor)}</span></span>` +
            (b.cajero ? `<span class="bol-info-item"><span class="lbl">Cajero</span><span class="val">${x(b.cajero)}</span></span>` : '') +
            `<span class="bol-info-item"><span class="lbl">Estado</span><span class="val"><span class="estado-badge ${estadoClass}">${x(b.estado)}</span></span></span>` +
            `<div class="bol-info-total-header"><span class="lbl-tot">Total:</span><span class="val-tot" id="bolHeaderTotal">${fmt(b.montoTotal)}</span></div>`;

        document.getElementById('btnAbrirModal').disabled = !esEditable;
        document.getElementById('btnAnular').disabled     = !esEditable;
        const btnCobrar = document.getElementById('btnCobrar');
        if (btnCobrar) btnCobrar.disabled = !esEditable;
        const btnFiado = document.getElementById('btnFiado');
        if (btnFiado) btnFiado.disabled = !esEditable;
        const buttons = document.querySelectorAll('.btn-metodo-pago');
        buttons.forEach(btn => btn.disabled = !esEditable);
        const inputOtros = document.getElementById('inputOtrosMonto');
        if (inputOtros) {
            const itemOtros = detalleActual.find(d => d.idProducto === 0 && !d.idPromocion);
            inputOtros.value = itemOtros ? itemOtros.subtotal : '';
            inputOtros.disabled = !esEditable;
        }

        document.getElementById('estadoPagada').style.display  = esPagada  ? 'block' : 'none';
        document.getElementById('estadoAnulada').style.display = esAnulada ? 'block' : 'none';

        if (PUEDE_COBRAR) {
            const cPl = document.getElementById('cobroPlaceholder');
            if (cPl) cPl.style.display = esEditable ? 'none' : 'block';
            const cobroForm = document.getElementById('cobroForm');
            if (cobroForm) cobroForm.style.display = esEditable ? 'flex' : 'none';
            const resTot = document.getElementById('resTotalBoleta');
            if (resTot) resTot.textContent = fmt(b.montoTotal);
            /* Inicializar cobro con método principal */
            if (esEditable) {
                inicializarCobro(b.montoTotal);
            }
        }

        renderDetalle();

        const bolPl = document.getElementById('bolPlaceholder');
        if (bolPl) bolPl.style.display = 'none';
        const bolInf = document.getElementById('bolInfo');
        if (bolInf) bolInf.classList.add('visible');
    }

    /* ════════════════════════════════════════════════════
       COBRO
    ════════════════════════════════════════════════════ */

    /* Retorna el monto total que DEBE pagarse en efectivo (soloEfectivo) */
    function calcMontoSoloEfectivo() {
        return detalleActual
            .filter(d => d.esEnvase && RETORNABLES_MAP[d.idProducto]?.soloEfectivo)
            .reduce((s, d) => s + d.subtotal, 0);
    }

    /* Al cargar boleta o abrir modal, seleccionar automáticamente Efectivo si hay envases, o el primer método */
    function inicializarCobro(montoTotal) {
        metodosCobro = [];
        adicionalVisible = false;
        const cAdic = document.getElementById('cobroAdicionalSection');
        if (cAdic) cAdic.style.display = 'none';
        const btnTog = document.getElementById('btnToggleAdicional');
        if (btnTog) btnTog.textContent = '+ Pago Dividido / Múltiples Métodos';
        
        const montoSoloEf = calcMontoSoloEfectivo();
        if (montoSoloEf > 0) {
            const efecMet = METODOS_PAGO.find(m => m.esEfectivo);
            if (efecMet) {
                metodosCobro.push({
                    idMetodoPago: efecMet.id,
                    nombre: efecMet.nombre + " (Garantía Envase)",
                    monto: montoSoloEf,
                    esEfectivo: true,
                    esEnvase: true,
                    bloqueado: true,
                    esPrincipal: false
                });
            }
        }

        let defaultId = activeMetodoPagoId;
        if (!defaultId || !METODOS_PAGO.some(m => m.id === defaultId)) {
            if (METODOS_PAGO.length > 0) {
                defaultId = METODOS_PAGO[0].id;
            }
        }

        activeMetodoPagoId = defaultId;
        if (activeMetodoPagoId) {
            seleccionarMetodoPrincipal(activeMetodoPagoId, montoTotal);
        }
    }

    window.seleccionarMetodoPrincipalBtn = function (btn) {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        const id = parseInt(btn.dataset.id);
        seleccionarMetodoPrincipal(id);
    };

    window.seleccionarMetodoPrincipal = function (id, montoForzado) {
        if (!id) return;
        activeMetodoPagoId = id;

        // Update active class on buttons / cards
        const buttons = document.querySelectorAll('.btn-metodo-pago-card, .btn-metodo-pago');
        buttons.forEach(btn => {
            const btnId = parseInt(btn.dataset.id);
            if (btnId === id) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });

        const targetMetodo = METODOS_PAGO.find(m => m.id === id);
        if (!targetMetodo) return;

        const nombre = targetMetodo.nombre;
        const efec   = targetMetodo.esEfectivo;

        // Mantener únicamente filas adicionales no-principales (incluyendo envases bloqueados)
        const extrasNoP = metodosCobro.filter(m => !m.esPrincipal).reduce((s, m) => s + m.monto, 0);
        const totalBol  = boletaActual?.montoTotal ?? (montoForzado || 0);
        const montoPrinc = Math.max(0, totalBol - extrasNoP);

        /* Actualizar o insertar el método principal */
        const idxPrinc = metodosCobro.findIndex(m => m.esPrincipal);
        if (idxPrinc >= 0) {
            metodosCobro[idxPrinc] = { idMetodoPago: id, nombre, monto: montoPrinc, esEfectivo: efec, esPrincipal: true };
        } else {
            metodosCobro.unshift({ idMetodoPago: id, nombre, monto: montoPrinc, esEfectivo: efec, esPrincipal: true });
        }

        renderMetodosCobro();
    };

    window.toggleAdicional = function () {
        adicionalVisible = !adicionalVisible;
        const cAdic = document.getElementById('cobroAdicionalSection');
        if (cAdic) cAdic.style.display = adicionalVisible ? 'flex' : 'none';
        const btnTog = document.getElementById('btnToggleAdicional');
        if (btnTog) btnTog.textContent = adicionalVisible
            ? '− Ocultar pago dividido'
            : '+ Pago Dividido / Múltiples Métodos';
    };

    window.agregarMetodoAdicional = function () {
        const sel   = document.getElementById('selMetodoAdicional');
        if (!sel) return;
        const inpM  = document.getElementById('inputMontoAdicional');
        const monto = parseInt(inpM?.value);
        if (!monto || monto < 1) { toast('Ingresa un monto válido.', 'error'); return; }
        const id     = parseInt(sel.value);
        const nombre = sel.selectedOptions[0].dataset.nombre;
        const efec   = METODOS_PAGO.find(m => m.id === id)?.esEfectivo ?? false;

        /* Ajustar el método principal para cubrir solo el resto */
        const totalExtra  = metodosCobro.filter(m => !m.esPrincipal).reduce((s, m) => s + m.monto, 0) + monto;
        const totalBoleta = boletaActual?.montoTotal ?? 0;
        const nuevoPrinc  = Math.max(0, totalBoleta - totalExtra);

        metodosCobro = metodosCobro.map(m => m.esPrincipal ? { ...m, monto: nuevoPrinc } : m);
        metodosCobro.push({ idMetodoPago: id, nombre, monto, esEfectivo: efec, esPrincipal: false });

        if (inpM) inpM.value = '';
        renderMetodosCobro();
    };

    window.quitarMetodo = function (i) {
        if (metodosCobro[i]?.bloqueado) return;  // pago obligatorio, no se puede quitar
        const quitado = metodosCobro[i];
        metodosCobro.splice(i, 1);
        /* Si quita uno adicional, devolver su monto al principal */
        if (!quitado.esPrincipal) {
            const princ = metodosCobro.find(m => m.esPrincipal);
            if (princ) princ.monto += quitado.monto;
        }
        renderMetodosCobro();
    };

    function renderMetodosCobro() {
        const list = document.getElementById('cobroList');
        if (list) {
            list.innerHTML = '';
            metodosCobro.forEach((m, i) => {
                if (m.monto <= 0 && m.esPrincipal && metodosCobro.length > 1) return;
                const div = document.createElement('div');
                div.className = 'cobro-item' + (m.bloqueado ? ' bloqueado' : '');
                const envaseTag = m.bloqueado ? '<span class="cobro-item-envase-tag" style="background:#fee2e2; color:#dc2626; padding:0.15rem 0.4rem; border-radius:4px; font-weight:800; font-size:0.75rem; margin-left:0.4rem;">Garantía Envase (Efectivo)</span>' : '';
                const princTag = (m.esPrincipal && !m.bloqueado) ? '<span style="background:#eef2ff; color:#4f46e5; padding:0.15rem 0.4rem; border-radius:4px; font-weight:800; font-size:0.75rem; margin-left:0.4rem;">Principal</span>' : '';
                
                div.innerHTML =
                    `<span class="cobro-item-nombre" style="font-weight:700; font-size:0.9rem;">${x(m.nombre)}${envaseTag}${princTag}</span>` +
                    `<span class="cobro-item-monto" style="font-weight:900; font-size:1rem; color:var(--color-primario); margin-left:auto;">${fmt(m.monto)}</span>` +
                    (m.bloqueado
                        ? `<span class="cobro-item-lock" title="Pago obligatorio en efectivo" style="color:#dc2626; margin-left:0.5rem;"><svg viewBox="0 0 24 24" style="width:16px; height:16px; fill:currentColor;"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></span>`
                        : (!m.esPrincipal
                            ? `<button class="btn-quitar-metodo" onclick="quitarMetodo(${i})" title="Quitar método" style="margin-left:0.5rem; background:rgba(239,68,68,0.1); border:none; border-radius:6px; color:#dc2626; padding:0.25rem 0.45rem; cursor:pointer; font-weight:800;">✕</button>`
                            : ''));
                list.appendChild(div);
            });
        }

        const totalReg = metodosCobro.reduce((s, m) => s + m.monto, 0);
        const total = boletaActual?.montoTotal ?? 0;
        const saldoRestante = Math.max(0, total - totalReg);
        const totalEfectivo = metodosCobro.filter(m => m.esEfectivo).reduce((s, m) => s + m.monto, 0);

        // Actualizar tarjetas de resumen en modal
        const resSaldoModal = document.getElementById('resSaldoRestanteModal');
        if (resSaldoModal) {
            resSaldoModal.textContent = fmt(saldoRestante);
            resSaldoModal.style.color = saldoRestante > 0 ? "#dc2626" : "#16a34a";
        }
        const lblEstadoSaldo = document.getElementById('lblEstadoSaldo');
        if (lblEstadoSaldo) {
            lblEstadoSaldo.textContent = "SALDO PENDIENTE";
            lblEstadoSaldo.style.color = saldoRestante > 0 ? "#dc2626" : "#16a34a";
        }

        // Actualizar sección de efectivo y layout dinámico del modal
        const lblTotEfec = document.getElementById('lblTotalEfectivoRequerido');
        if (lblTotEfec) lblTotEfec.textContent = fmt(totalEfectivo);

        const seccionEf = document.getElementById('seccionEfectivoInferior');
        if (seccionEf) seccionEf.style.display = totalEfectivo > 0 ? 'flex' : 'none';

        const modalBox = document.querySelector('.cobro-modal-box');
        if (modalBox) {
            if (totalEfectivo > 0) {
                modalBox.classList.add('con-efectivo');
            } else {
                modalBox.classList.remove('con-efectivo');
            }
        }

        // Recalcular vuelto modal
        recalcVuelto();
    }

    window.recalcVuelto = function () {
        calcularVueltoModal();
    };

    window.finalizarCobro = async function () {
        if (!boletaActual || boletaActual.idEstado !== 1) return;

        const montoEfec  = metodosCobro.filter(m => m.esEfectivo).reduce((s, m) => s + m.monto, 0);
        const recibidoVal = document.getElementById('inputRecibido')?.value;
        const recibido   = recibidoVal ? (parseInt(recibidoVal) || 0) : montoEfec;
        const vuelto     = montoEfec > 0 ? Math.max(0, recibido - montoEfec) : 0;
        const vueltoHtml = montoEfec > 0 ? `<br><span style="font-size:.85em;">Vuelto: <strong>${fmt(vuelto)}</strong></span>` : '';

        const result = await Swal.fire({
            title: '¿Finalizar cobro?',
            html: `Boleta N° <strong>${boletaActual.idBoleta}</strong><br>` +
                  `Total: <strong>${fmt(boletaActual.montoTotal)}</strong>${vueltoHtml}`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, finalizar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#e76f2e',
            cancelButtonColor: '#6b7280',
            reverseButtons: true
        });
        if (!result.isConfirmed) return;

        const btn = document.getElementById('btnFinalizar');
        setBotonCargando(btn, true);
        const pagos = metodosCobro.filter(m => m.monto > 0).map(m => ({ idMetodoPago: m.idMetodoPago, monto: m.monto }));
        const res   = await post(URL_COBRAR, { idBoleta: boletaActual.idBoleta, metodosPago: pagos });
        setBotonCargando(btn, false);
        if (!res.ok) { toast(res.mensaje, 'error'); return; }
        toast(res.mensaje, 'exito');
        cargarBoleta(res.boleta);
        cargarBoletasPendientes();
    };

    /* ════════════════════════════════════════════════════
       DETALLE BOLETA
    ════════════════════════════════════════════════════ */
    function renderDetalle() {
        const tbody  = document.getElementById('detalleTbody');
        const esEdit = boletaActual?.idEstado === 1;
        tbody.innerHTML = '';
        let total = 0;
        let haySoloEfectivo = false;

        /* ── 1. Renderizar SIEMPRE al inicio absoluto (primera fila): OTROS ── */
        const itemOtros = detalleActual.find(d => d.idProducto === 0 && !d.idPromocion);
        const otrosSubtotal = itemOtros ? itemOtros.subtotal : 0;
        total += otrosSubtotal;

        if (esEdit) {
            const otrosTr = document.createElement('tr');
            otrosTr.className = 'tr-otros-row';
            otrosTr.style.background = '#faf7f5';
            otrosTr.innerHTML =
                `<td class="td-nombre">` +
                    `<span style="font-weight:700; color:var(--color-secundario);">Otros</span> ` +
                    `<span style="font-size:0.68rem; color:#a89080; font-weight:600; background:#ede5df; padding:1px 6px; border-radius:4px; margin-left:2px;">no en sistema (opcional)</span>` +
                `</td>` +
                `<td colspan="2">` +
                    `<div style="display:flex; align-items:center; gap:4px;">` +
                        `<span style="font-size:0.82rem; font-weight:700; color:#a89080;">$</span>` +
                        `<input type="number" id="inputOtrosMontoTable" style="width:100px; padding:3px 6px; border:1.5px solid #e0d5cc; border-radius:6px; font-size:0.85rem; font-weight:700; color:var(--color-secundario);" placeholder="0" min="0" value="${otrosSubtotal > 0 ? otrosSubtotal : ''}" onchange="actualizarOtrosDesdeTabla(this.value)" onkeydown="if(event.key==='Enter'){event.preventDefault(); this.blur();}" />` +
                    `</div>` +
                `</td>` +
                `<td style="font-weight:700; color:var(--color-secundario);">${fmt(otrosSubtotal)}</td>` +
                `<td>${otrosSubtotal > 0 ? `<button class="btn-row-del" onclick="limpiarOtrosTabla()" title="Quitar otros"><svg viewBox="0 0 24 24"><path d="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></button>` : ''}</td>`;
            tbody.appendChild(otrosTr);
        } else if (otrosSubtotal > 0) {
            const otrosTr = document.createElement('tr');
            otrosTr.className = 'tr-otros-row';
            otrosTr.innerHTML =
                `<td class="td-nombre">Otros (producto no en sistema)</td>` +
                `<td>${fmt(otrosSubtotal)}</td>` +
                `<td>1</td>` +
                `<td>${fmt(otrosSubtotal)}</td>` +
                `<td></td>`;
            tbody.appendChild(otrosTr);
        }

        /* ── 2. Separar filas de promo y filas standalone ─────────────────── */
        const promoMap     = new Map(); // idPromocion → { nombre, items:[], envases:[] }
        const standalone   = [];        // { d, i }  (sin idPromocion)
        const seenPromoOrder = [];      // orden de aparición de idPromocion

        detalleActual.forEach((d, i) => {
            if (d.idPromocion) {
                if (!promoMap.has(d.idPromocion)) {
                    promoMap.set(d.idPromocion, { nombre: d.nombrePromocion ?? 'Promoción', items: [], envases: [] });
                    seenPromoOrder.push(d.idPromocion);
                }
                const g = promoMap.get(d.idPromocion);
                if (d.esEnvase) g.envases.push(d);
                else            g.items.push(d);
            } else if (d.esEnvase) {
                // Envase standalone: se pega debajo de su producto normal
                standalone.push({ d, i, esEnvase: true });
            } else {
                standalone.push({ d, i, esEnvase: false });
            }
        });

        /* ── 3. Renderizar grupos de promo (debajo de Otros) ──────────────── */
        seenPromoOrder.forEach(idPromo => {
            const g = promoMap.get(idPromo);

            // Contar instancias únicas de esta promo
            const instIds = [...new Set(
                detalleActual
                    .filter(d => d.idPromocion === idPromo && d.promoInstId != null)
                    .map(d => d.promoInstId)
            )];
            const nInst = instIds.length || 1;

            // Consolidar productos duplicados (mismo idProducto) dentro del grupo
            const itemConsolidado = new Map(); // idProducto → { d acumulado }
            g.items.forEach(d => {
                if (!itemConsolidado.has(d.idProducto)) {
                    itemConsolidado.set(d.idProducto, { ...d });
                } else {
                    const acc = itemConsolidado.get(d.idProducto);
                    acc.cantidad += d.cantidad;
                    acc.subtotal += d.subtotal;
                }
            });
            // Consolidar envases
            const envConsolidado = new Map();
            g.envases.forEach(d => {
                if (!envConsolidado.has(d.idProducto)) {
                    envConsolidado.set(d.idProducto, { ...d });
                } else {
                    const acc = envConsolidado.get(d.idProducto);
                    acc.cantidad += d.cantidad;
                    acc.subtotal += d.subtotal;
                }
            });

            const promoTotal = [...itemConsolidado.values(), ...envConsolidado.values()]
                .reduce((s, d) => s + d.subtotal, 0);
            total += promoTotal;

            envConsolidado.forEach(d => {
                const ret = RETORNABLES_MAP[d.idProducto];
                if (ret?.soloEfectivo) haySoloEfectivo = true;
            });

            // Header row con controles de cantidad iguales a un producto
            const htr = document.createElement('tr');
            htr.className = 'tr-promo-header';
            const promoUnitPrice = nInst > 0 ? Math.round(promoTotal / nInst) : promoTotal;
            const promoQtyHtml = esEdit
                ? `<div class="qty-table-ctrl">
                       <button onclick="cambiarCantidadPromo('${idPromo}', -1)" title="Disminuir 1 promoción">-</button>
                       <input type="number" value="${nInst}" min="1" onchange="cambiarCantidadPromoDirecta('${idPromo}', this.value)" onkeydown="if(event.key==='Enter'){event.preventDefault(); this.blur();}">
                       <button onclick="cambiarCantidadPromo('${idPromo}', 1)" title="Aumentar 1 promoción">+</button>
                   </div>`
                : nInst;

            htr.innerHTML =
                `<td class="td-nombre"><span class="td-badge td-badge-promo">${x(g.nombre)}</span></td>` +
                `<td>${fmt(promoUnitPrice)}</td>` +
                `<td>${promoQtyHtml}</td>` +
                `<td style="font-weight:700; color:#d97706;">${fmt(promoTotal)}</td>` +
                `<td>${esEdit
                    ? `<button class="btn-row-del" onclick="eliminarPromoGrupo('${idPromo}')" title="Quitar todas las promociones de este tipo"><svg viewBox="0 0 24 24"><path d="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></button>`
                    : ''}</td>`;
            tbody.appendChild(htr);

            // Producto rows (consolidados, read-only)
            itemConsolidado.forEach(d => {
                const tr = document.createElement('tr');
                tr.className = 'tr-promo-row';
                tr.innerHTML =
                    `<td class="td-nombre" style="padding-left:1.4rem;">${x(d.nombre)}</td>` +
                    `<td>${fmt(d.precioUnitario)}</td>` +
                    `<td>${d.cantidad}</td>` +
                    `<td>${fmt(d.subtotal)}</td>` +
                    `<td></td>`;
                tbody.appendChild(tr);
            });

            // Envase rows (consolidados, read-only)
            envConsolidado.forEach(d => {
                const ret    = RETORNABLES_MAP[d.idProducto];
                const soloEf = ret?.soloEfectivo ?? false;
                const efBadge = soloEf ? `<span class="td-envase-ef">solo efectivo</span>` : '';
                const tr = document.createElement('tr');
                tr.className = 'tr-envase tr-promo-row';
                tr.innerHTML =
                    `<td style="padding-left:1.4rem;"><span class="td-envase-lbl"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>Envase: ${x(d.nombre)}</span>${efBadge}</td>` +
                    `<td style="color:var(--color-primario);font-weight:700;">${fmt(d.precioUnitario)}</td>` +
                    `<td>${d.cantidad}</td>` +
                    `<td style="color:var(--color-primario);font-weight:700;">${fmt(d.subtotal)}</td>` +
                    `<td></td>`;
                tbody.appendChild(tr);
            });
        });

        /* ── 4. Renderizar ítems standalone (excluyendo idProducto 0) ─────── */
        const standaloneFiltered = standalone.filter(({ d }) => d.idProducto !== 0);
        standaloneFiltered.forEach(({ d, i, esEnvase }) => {
            total += d.subtotal;
            const tr = document.createElement('tr');

            if (esEnvase) {
                const ret    = RETORNABLES_MAP[d.idProducto];
                const soloEf = ret?.soloEfectivo ?? false;
                if (soloEf) haySoloEfectivo = true;
                const efBadge = soloEf ? `<span class="td-envase-ef">solo efectivo</span>` : '';
                tr.className = 'tr-envase';
                tr.innerHTML =
                    `<td><span class="td-envase-lbl"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>Envase: ${x(d.nombre)}</span>${efBadge}</td>` +
                    `<td style="color:var(--color-primario);font-weight:700;">${fmt(d.precioUnitario)}</td>` +
                    `<td>${d.cantidad}</td>` +
                    `<td style="color:var(--color-primario);font-weight:700;">${fmt(d.subtotal)}</td>` +
                    `<td></td>`;
            } else {
                const tieneDesc  = d.precioNormal && d.precioNormal !== d.precioUnitario;
                const precioHtml = tieneDesc
                    ? `<span class="td-precio-normal">${fmt(d.precioNormal)}</span><br><span class="td-precio-descuento">${fmt(d.precioUnitario)}</span>`
                    : fmt(d.precioUnitario);
                
                const qtyHtml = esEdit
                    ? `<div class="qty-table-ctrl">
                           <button onclick="changeRowQty(${i}, -1)">-</button>
                           <input type="number" value="${d.cantidad}" min="1" onchange="cambiarCantidad(${i}, this.value)" onkeydown="if(event.key==='Enter'){event.preventDefault(); this.blur();}">
                           <button onclick="changeRowQty(${i}, 1)">+</button>
                       </div>`
                    : d.cantidad;

                tr.innerHTML =
                    `<td class="td-nombre">${x(d.nombre)}${d.tieneOferta ? `<span class="td-badge td-badge-oferta">Oferta</span>` : ''}</td>` +
                    `<td>${precioHtml}</td>` +
                    `<td>${qtyHtml}</td>` +
                    `<td>${fmt(d.subtotal)}</td>` +
                    `<td>${esEdit
                        ? `<button class="btn-row-del" onclick="eliminarFila(${i})" title="Eliminar"><svg viewBox="0 0 24 24"><path d="M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></button>`
                        : ''}</td>`;
            }
            tbody.appendChild(tr);
        });

        document.getElementById('totalDisplay').textContent = fmt(total);
        const bolHeadTot = document.getElementById('bolHeaderTotal');
        if (bolHeadTot) bolHeadTot.textContent = fmt(total);

        const alertaEl = document.getElementById('cobroEnvaseAlerta');
        if (alertaEl) alertaEl.style.display = haySoloEfectivo ? 'flex' : 'none';

        if (PUEDE_COBRAR && boletaActual && boletaActual.idEstado === 1) {
            boletaActual.montoTotal = total;
            const resTot = document.getElementById('resTotalBoletaModal') || document.getElementById('resTotalBoleta');
            if (resTot) resTot.textContent = fmt(total);
            const princ = metodosCobro.find(m => m.esPrincipal);
            if (princ) {
                const extras = metodosCobro.filter(m => !m.esPrincipal).reduce((s, m) => s + m.monto, 0);
                princ.monto  = Math.max(0, total - extras);
                renderMetodosCobro();
            }
        }
    }

    /* Modificar cantidad de instancias de una promoción (+ / - / input) */
    window.cambiarCantidadPromo = function (idPromoRaw, delta) {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        const idPromo = Number(idPromoRaw) || idPromoRaw;
        const instIds = [...new Set(
            detalleActual
                .filter(d => d.idPromocion == idPromo && d.promoInstId != null)
                .map(d => d.promoInstId)
        )];

        if (delta < 0) {
            if (instIds.length === 0) {
                detalleActual = detalleActual.filter(d => d.idPromocion != idPromo);
                renderDetalle();
                _autoGuardarDebounce();
            } else {
                _quitarInstancia(instIds[instIds.length - 1]);
            }
        } else if (delta > 0) {
            seleccionarPromo(idPromo);
        }
    };

    window.cambiarCantidadPromoDirecta = function (idPromoRaw, val) {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        const idPromo = Number(idPromoRaw) || idPromoRaw;
        const targetQty = Math.max(1, parseInt(val) || 1);
        const instIds = [...new Set(
            detalleActual
                .filter(d => d.idPromocion == idPromo && d.promoInstId != null)
                .map(d => d.promoInstId)
        )];
        const currentQty = instIds.length || 1;

        if (targetQty > currentQty) {
            const aAgregar = targetQty - currentQty;
            for (let i = 0; i < aAgregar; i++) {
                seleccionarPromo(idPromo);
            }
        } else if (targetQty < currentQty) {
            const aQuitar = currentQty - targetQty;
            for (let i = 0; i < aQuitar; i++) {
                const currentInsts = [...new Set(
                    detalleActual
                        .filter(d => d.idPromocion == idPromo && d.promoInstId != null)
                        .map(d => d.promoInstId)
                )];
                if (currentInsts.length > 0) {
                    detalleActual = detalleActual.filter(d => d.promoInstId !== currentInsts[currentInsts.length - 1]);
                }
            }
            renderDetalle();
            _autoGuardarDebounce();
        }
    };

    /* Quita UNA instancia de la promo. Si hay varias con distintos productos → diálogo */
    window.eliminarPromoGrupo = function (idPromoRaw) {
        const idPromo = Number(idPromoRaw) || idPromoRaw;
        const instIds = [...new Set(
            detalleActual
                .filter(d => d.idPromocion == idPromo && d.promoInstId != null)
                .map(d => d.promoInstId)
        )];

        // Sin instIds conocidos (cargado desde servidor sin reconstrucción) → quitar todo
        if (instIds.length === 0) {
            detalleActual = detalleActual.filter(d => d.idPromocion !== idPromo);
            renderDetalle();
            return;
        }

        // Una sola instancia → quitar directamente
        if (instIds.length === 1) {
            _quitarInstancia(instIds[0]);
            return;
        }

        // Varias instancias → ¿son idénticas en productos?
        const firma = instId => detalleActual
            .filter(d => d.promoInstId === instId && !d.esEnvase)
            .map(d => `${d.idProducto}:${d.cantidad}`)
            .sort().join('|');

        const firmas = instIds.map(firma);
        const todasIguales = firmas.every(f => f === firmas[0]);

        if (todasIguales) {
            // Idénticas: quitar la última agregada sin preguntar cuál
            _quitarInstancia(instIds[instIds.length - 1]);
            return;
        }

        // Distintas: mostrar diálogo de selección
        _mostrarSeleccionInst(idPromo, instIds);
    };

    function _quitarInstancia(instId) {
        detalleActual = detalleActual.filter(d => d.promoInstId !== instId);
        renderDetalle();
        _autoGuardarDebounce();
    }

    function _mostrarSeleccionInst(idPromo, instIds) {
        const promo = PROMOS.find(p => p.id === idPromo);
        const promoNombre = promo?.nombre
            ?? detalleActual.find(d => d.idPromocion === idPromo)?.nombrePromocion
            ?? 'Promoción';

        const gruposExclIds = new Set(
            (promo?.grupos ?? []).filter(g => g.esExcluyente).flatMap(g => g.productos.map(r => r.idProducto))
        );

        const itemsHtml = instIds.map((instId, idx) => {
            const filas = detalleActual.filter(d => d.promoInstId === instId && !d.esEnvase);
            const distinguidores = filas.filter(d =>  gruposExclIds.has(d.idProducto));
            const base           = filas.filter(d => !gruposExclIds.has(d.idProducto));
            const partes = [
                ...distinguidores.map(d => `<strong>${x(d.nombre)}</strong> <span>×${d.cantidad}</span>`),
                ...base.map(d => `${x(d.nombre)} <span>×${d.cantidad}</span>`)
            ].join(' · ');
            return `<div class="selinst-item" onclick="event.stopPropagation(); confirmarEliminarInst(${instId})">
                <div class="selinst-item-num">Opción ${idx + 1}</div>
                <div class="selinst-item-prods">${partes}</div>
            </div>`;
        }).join('');

        const overlay = document.getElementById('selInstOverlay');
        overlay.innerHTML = `
        <div class="selinst-card" onclick="event.stopPropagation()">
            <div class="selinst-titulo">Eliminar una promoción</div>
            <div class="selinst-promo-nombre">${x(promoNombre)}</div>
            <div class="selinst-sub">Tenés ${instIds.length} instancias distintas. ¿Cuál querés quitar?</div>
            <div class="selinst-lista">${itemsHtml}</div>
            <button class="selinst-cancelar" onclick="cerrarSelInst()">Cancelar</button>
        </div>`;
        overlay.style.display = 'flex';
    }

    window.confirmarEliminarInst = function (instId) {
        cerrarSelInst();
        detalleActual = detalleActual.filter(d => d.promoInstId !== instId);
        renderDetalle();
        _autoGuardarDebounce();
    };

    window.cerrarSelInst = function () {
        document.getElementById('selInstOverlay').style.display = 'none';
    };

    window.cambiarCantidad = function (i, val) {
        const qty = Math.max(1, parseInt(val) || 1);
        detalleActual[i].cantidad = qty;
        detalleActual[i].subtotal = qty * detalleActual[i].precioUnitario;
        evaluarPromocionesAutomaticasEnDetalle();
        renderDetalle();
        _autoGuardarDebounce();
    };

    window.changeRowQty = function (i, delta) {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        const currentQty = detalleActual[i].cantidad;
        const newQty = Math.max(1, currentQty + delta);
        detalleActual[i].cantidad = newQty;
        detalleActual[i].subtotal = newQty * detalleActual[i].precioUnitario;
        evaluarPromocionesAutomaticasEnDetalle();
        renderDetalle();
        _autoGuardarDebounce();
    };

    window.eliminarFila = function (i) {
        const idProd = detalleActual[i]?.idProducto;
        detalleActual.splice(i, 1);
        if (idProd === 0) {
            const inputOtros = document.getElementById('inputOtrosMonto');
            if (inputOtros) inputOtros.value = '';
        }
        // Si había una fila de envase para el mismo producto, eliminarla también
        if (idProd != null) {
            const idxEnvase = detalleActual.findIndex(d => d.esEnvase && d.idProducto === idProd);
            if (idxEnvase >= 0) detalleActual.splice(idxEnvase, 1);
        }
        renderDetalle();
        _autoGuardarDebounce();
    };

    /* ════════════════════════════════════════════════════
       GUARDAR / ANULAR
    ════════════════════════════════════════════════════ */
    window.guardarCambios = async function () {
        if (!detalleActual.length) { toast('La boleta no puede quedar vacía.', 'error'); return; }
        await _autoGuardar();
    };

    window.confirmarAnular = function () {
        if (!confirm(`¿Seguro que deseas anular la boleta N° ${boletaActual.idBoleta}? Esta acción restaura el stock.`)) return;
        anularBoleta();
    };
    async function anularBoleta() {
        const btn = document.getElementById('btnAnular');
        setBotonCargando(btn, true);
        const res = await post(URL_ANULAR, { idBoleta: boletaActual.idBoleta });
        setBotonCargando(btn, false);
        if (!res.ok) { toast(res.mensaje, 'error'); return; }
        toast(res.mensaje, 'exito');
        boletaActual.idEstado = 2;
        boletaActual.estado   = 'Anulada';
        cargarBoleta(boletaActual);
        cargarBoletasPendientes();
    }

    /* Cerrar modal con Escape */
    document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarModal(); });

    /* ════════════════════════════════════════════════════
       PANEL BOLETAS PENDIENTES (SignalR — push real)
    ════════════════════════════════════════════════════ */
    var _pendIds    = new Set();   // IDs conocidos para detectar nuevas boletas
    var _pendLoaded = false;       // true tras primera carga exitosa → no mostrar "Cargando…" en refrescos

    window.cargarBoletasPendientes = async function (manual) {
        var container  = document.getElementById('pendListContainer');
        var btnRefresh = document.querySelector('.btn-pend-refresh');
        if (!container) return;
        if (manual) {
            if (btnRefresh) btnRefresh.classList.add('girando');
        } else if (!_pendLoaded) {
            container.innerHTML = '<div class="pend-loading">Cargando…</div>';
        }
        var data;
        try {
            var r = await fetch(URL_PENDIENTES, { credentials: 'same-origin' });
            if (!r.ok) throw new Error(r.status);
            data = await r.json();
        } catch {
            if (!_pendLoaded)
                container.innerHTML = '<div class="pend-empty"><svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>Error al cargar</div>';
            if (btnRefresh) btnRefresh.classList.remove('girando');
            return;
        }
        _pendLoaded = true;
        if (btnRefresh) btnRefresh.classList.remove('girando');

        // Detectar nuevas boletas
        var incomingIds = new Set(data.map(b => b.idBoleta));
        var hayNuevas   = data.some(b => !_pendIds.has(b.idBoleta));
        _pendIds        = incomingIds;

        // Actualizar badge
        var badge = document.getElementById('pendCount');
        if (badge) {
            badge.textContent = data.length;
            if (hayNuevas && data.length > 0) {
                badge.classList.remove('nuevo');
                void badge.offsetWidth;
                badge.classList.add('nuevo');
            }
        }

        // Hora de última actualización
        var luEl = document.getElementById('pendLastUpdate');
        if (luEl) luEl.textContent = new Date().toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

        if (!data.length) {
            container.innerHTML =
                '<div class="pend-empty"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>Sin boletas pendientes</div>';
            return;
        }

        var list = document.createElement('div');
        list.className = 'pend-grid';
        data.forEach(b => {
            var card = document.createElement('div');
            card.className = 'pend-card';
            if (hayNuevas && !document.querySelector('.pend-card[data-id="' + b.idBoleta + '"]')) {
                card.classList.add('pend-card-nuevo');
            }
            card.dataset.id = b.idBoleta;
            card.title = b.correlativoDiario 
                ? 'Cargar ticket #' + b.correlativoDiario + ' (ID: ' + b.idBoleta + ')' 
                : 'Cargar boleta #' + b.idBoleta;
            var numHtml = b.correlativoDiario 
                ? '#' + b.correlativoDiario + ' <small style="font-size:.65rem;font-weight:600;color:#c9b8a8;">(ID: ' + b.idBoleta + ')</small>' 
                : '#' + b.idBoleta;
            card.innerHTML =
                '<span class="pend-card-num">' + numHtml + '</span>' +
                '<span class="pend-card-vendedor">' + x(b.vendedor) + '</span>' +
                '<span class="pend-card-monto">' + fmt(b.montoTotal) + '</span>' +
                '<span class="pend-card-meta">' + b.cantProductos + ' prod.</span>';
            card.onclick = () => {
                document.getElementById('inputNBoleta').value = b.idBoleta;
                buscarBoleta();
            };
            list.appendChild(card);
        });
        container.innerHTML = '';
        container.appendChild(list);
    };

    // ── Conexión SignalR ──────────────────────────────────────────────────────
    (function iniciarSignalR() {
        var conn = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/boleta')
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.Warning)
            .build();

        conn.on('NuevaBoleta', function () {
            cargarBoletasPendientes(false);
        });

        // Al volver a conectar tras una interrupción, refrescar por si se perdió algún evento
        conn.onreconnected(function () {
            cargarBoletasPendientes(false);
        });

        conn.start().catch(function (err) {
            console.warn('SignalR Boleta: no se pudo conectar —', err);
        });
    })();

    cargarBoletasPendientes(false);

    /* ════════════════════════════════════════════════════
       MODAL FIADO
    ════════════════════════════════════════════════════ */
    let _fiadoClienteSel = null;  // { idCliente, nombre, rutFormato, saldoAFavor }
    let _fiadoBuscarTimer = null;

    window.abrirModalFiado = function () {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        _fiadoClienteSel = null;
        document.getElementById('fiadoBuscarInput').value = '';
        document.getElementById('fiadoClientList').innerHTML =
            '<div style="text-align:center;padding:1.5rem;color:#b8a898;font-size:.84rem;">Escribe para buscar un cliente</div>';
        document.getElementById('fiadoClientSelInfo').className  = 'fiado-client-sel-info';
        document.getElementById('btnConfirmarFiado').disabled    = true;
        // limpiar form crear
        ['fiadoNuevoNombre','fiadoNuevoTelefono']
            .forEach(id => { var el = document.getElementById(id); if (el) el.value = ''; });
        selFiadoTab('buscar');
        document.getElementById('fiadoModalOverlay').style.display = 'flex';
        setTimeout(() => document.getElementById('fiadoBuscarInput')?.focus(), 80);
    };

    window.cerrarModalFiado = function () {
        document.getElementById('fiadoModalOverlay').style.display = 'none';
    };

    window.selFiadoTab = function (tab) {
        document.getElementById('fiadoTabBtnBuscar').classList.toggle('active', tab === 'buscar');
        document.getElementById('fiadoTabBtnCrear').classList.toggle('active', tab === 'crear');
        document.getElementById('fiadoTabBuscar').classList.toggle('hidden', tab !== 'buscar');
        document.getElementById('fiadoTabCrear').classList.toggle('hidden', tab !== 'crear');
    };

    // Dígito verificador Mod11
    function _calcDv(rut) {
        var mult = 2; var suma = 0;
        while (rut > 0) { suma += (rut % 10) * mult; rut = Math.floor(rut / 10); mult = mult === 7 ? 2 : mult + 1; }
        var res = 11 - (suma % 11);
        if (res === 11) return '0'; if (res === 10) return 'K'; return String(res);
    }

    // Actualizar DV en tiempo real — eliminado (no se usa RUT en fiado)

    window.buscarClientesFiado = function () {
        clearTimeout(_fiadoBuscarTimer);
        var q = (document.getElementById('fiadoBuscarInput')?.value ?? '').trim();
        if (!q) {
            document.getElementById('fiadoClientList').innerHTML =
                '<div style="text-align:center;padding:1.5rem;color:#b8a898;font-size:.84rem;">Escribe para buscar un cliente</div>';
            return;
        }
        document.getElementById('fiadoClientList').innerHTML =
            '<div style="text-align:center;padding:1rem;color:#b8a898;font-size:.82rem;"><span class="spin-sm" style="border-color:rgba(79,70,229,.3);border-top-color:#4f46e5;"></span></div>';
        _fiadoBuscarTimer = setTimeout(async function () {
            var r;
            try {
                r = await fetch(URL_BUSCAR_CLIENTE + '?q=' + encodeURIComponent(q), { credentials: 'same-origin' });
                if (!r.ok) throw new Error(r.status);
                r = await r.json();
            } catch { r = []; }
            _renderClientesFiado(r);
        }, 350);
    };

    function _renderClientesFiado(clientes) {
        var list = document.getElementById('fiadoClientList');
        if (!clientes.length) {
            list.innerHTML = '<div style="text-align:center;padding:1.5rem;color:#b8a898;font-size:.84rem;">Sin resultados</div>';
            return;
        }
        list.innerHTML = '';
        clientes.forEach(function (c) {
            var div = document.createElement('div');
            div.className = 'fiado-client-item';
            var deudaClass = c.saldoAFavor > 0 ? '' : 'cero';
            div.innerHTML =
                '<div style="flex:1;min-width:0;">' +
                    '<div class="fiado-client-nombre">' + x(c.nombre) + '</div>' +
                    (c.telefono ? '<div class="fiado-client-rut">' + x(c.telefono) + '</div>' : '') +
                '</div>' +
                '<span class="fiado-client-deuda ' + deudaClass + '">' +
                    (c.saldoAFavor > 0 ? 'Saldo: $' + Number(c.saldoAFavor).toLocaleString('es-CL') : 'Sin deuda') +
                '</span>';
            div.onclick = function () { _seleccionarClienteFiado(c); };
            list.appendChild(div);
        });
    }

    function _seleccionarClienteFiado(c) {
        _fiadoClienteSel = c;
        var info = document.getElementById('fiadoClientSelInfo');
        info.textContent = 'Seleccionado: ' + c.nombre;
        info.className   = 'fiado-client-sel-info visible';
        document.getElementById('btnConfirmarFiado').disabled = false;
        // Highlight selection
        document.querySelectorAll('.fiado-client-item').forEach(function (el) {
            el.style.borderColor = '';
            el.style.background  = '';
        });
        event.currentTarget.style.borderColor = '#4f46e5';
        event.currentTarget.style.background  = '#f5f4ff';
    }

    window.confirmarFiado = async function () {
        if (!_fiadoClienteSel || !boletaActual) return;
        var btn = document.getElementById('btnConfirmarFiado');
        setBotonCargando(btn, true);
        var res = await post(URL_DEJAR_FIADO, { idBoleta: boletaActual.idBoleta, idClienteFiado: _fiadoClienteSel.idCliente });
        setBotonCargando(btn, false);
        if (!res.ok) { toast(res.mensaje, 'error'); return; }
        cerrarModalFiado();
        toast(res.mensaje, 'exito');
        cargarBoleta(res.boleta);
        cargarBoletasPendientes();
    };

    window.crearYFiado = async function () {
        var nombre   = (document.getElementById('fiadoNuevoNombre')?.value ?? '').trim();
        var telefono = (document.getElementById('fiadoNuevoTelefono')?.value ?? '').trim();

        if (!nombre) { toast('El nombre es obligatorio.', 'error'); return; }

        var btn = document.getElementById('btnCrearYFiado');
        setBotonCargando(btn, true);

        // 1. Crear cliente
        var resCli = await post(URL_CREAR_CLIENTE, {
            nombre: nombre, telefono: telefono || null
        });
        if (!resCli.ok && resCli.idCliente == null) {
            setBotonCargando(btn, false);
            toast(resCli.mensaje, 'error');
            return;
        }

        var idCliente = resCli.idCliente ?? resCli.idCliente;
        if (!idCliente) { setBotonCargando(btn, false); toast('Error al obtener el cliente.', 'error'); return; }

        // 2. Dejar en fiado con el cliente recién creado (o existente)
        var resFiado = await post(URL_DEJAR_FIADO, { idBoleta: boletaActual.idBoleta, idClienteFiado: idCliente });
        setBotonCargando(btn, false);
        if (!resFiado.ok) { toast(resFiado.mensaje, 'error'); return; }
        cerrarModalFiado();
        toast(resCli.mensaje + ' — ' + resFiado.mensaje, 'exito');
        cargarBoleta(resFiado.boleta);
        cargarBoletasPendientes();
    };

    /* ════════════════════════════════════════════════════
       OTROS EN TABLA DE PRODUCTOS
    ════════════════════════════════════════════════════ */
    window.actualizarOtrosDesdeTabla = function (valStr) {
        const val = Math.max(0, parseInt(valStr) || 0);
        let idx = detalleActual.findIndex(d => d.idProducto === 0 && !d.idPromocion);
        if (val > 0) {
            if (idx >= 0) {
                detalleActual[idx].precioUnitario = val;
                detalleActual[idx].subtotal = val;
            } else {
                detalleActual.push({
                    idProducto: 0,
                    nombre: "Otros (producto no en sistema)",
                    precioUnitario: val,
                    cantidad: 1,
                    subtotal: val,
                    esEnvase: false
                });
            }
        } else {
            if (idx >= 0) {
                detalleActual.splice(idx, 1);
            }
        }
        renderDetalle();
        _autoGuardarDebounce();
    };

    window.limpiarOtrosTabla = function () {
        actualizarOtrosDesdeTabla(0);
    };

    /* ════════════════════════════════════════════════════
       MODAL DE COBRO
    ════════════════════════════════════════════════════ */
    window.abrirModalCobro = function () {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        const overlay = document.getElementById('cobroModalOverlay');
        if (!overlay) return;
        
        document.getElementById('resTotalBoletaModal').textContent = fmt(boletaActual.montoTotal);
        const titleEl = document.getElementById('cobroModalTitle');
        if (titleEl) {
            titleEl.textContent = boletaActual.correlativoDiario 
                ? `Procesar Cobro — Ticket N° ${boletaActual.correlativoDiario}` 
                : `Procesar Cobro — Ticket ID ${boletaActual.idBoleta}`;
        }

        inicializarCobro(boletaActual.montoTotal);

        const inputPagaCon = document.getElementById('inputPagaConModal');
        if (inputPagaCon) {
            inputPagaCon.value = '';
            setTimeout(() => inputPagaCon.focus(), 80);
        }

        overlay.style.display = 'flex';
    };

    window.cerrarModalCobro = function () {
        const overlay = document.getElementById('cobroModalOverlay');
        if (overlay) overlay.style.display = 'none';

        // Limpieza completa de campos e inputs
        const inputPagaCon = document.getElementById('inputPagaConModal');
        if (inputPagaCon) inputPagaCon.value = '';

        const inputAdicional = document.getElementById('inputMontoAdicional');
        if (inputAdicional) inputAdicional.value = '';

        const secAdicional = document.getElementById('cobroAdicionalSection');
        if (secAdicional) secAdicional.style.display = 'none';

        const btnToggle = document.getElementById('btnToggleAdicional');
        if (btnToggle) {
            btnToggle.textContent = '+ Pago Dividido';
            btnToggle.style.background = '#faf7f5';
            btnToggle.style.color = 'var(--color-primario)';
        }

        metodosCobro = [];
        activeMetodoPagoId = null;

        const vueltoDisplay = document.getElementById('vueltoModalDisplay');
        if (vueltoDisplay) vueltoDisplay.textContent = '$0';

        const vueltoStatus = document.getElementById('vueltoStatusMsg');
        if (vueltoStatus) {
            vueltoStatus.textContent = '';
            vueltoStatus.style.display = 'none';
        }

        const modalBox = document.querySelector('.cobro-modal-box');
        if (modalBox) modalBox.classList.remove('con-efectivo');
    };

    window.agregarBilleteRapido = function (monto) {
        const input = document.getElementById('inputPagaConModal');
        if (!input) return;
        const current = parseInt(input.value) || 0;
        const totalEfec = metodosCobro.filter(m => m.esEfectivo).reduce((s, m) => s + m.monto, 0);

        if (current === 0 || current >= totalEfec) {
            input.value = monto;
        } else {
            input.value = current + monto;
        }
        calcularVueltoModal();
    };

    window.establecerMontoExacto = function () {
        const input = document.getElementById('inputPagaConModal');
        if (!input) return;
        const totalEfec = metodosCobro.filter(m => m.esEfectivo).reduce((s, m) => s + m.monto, 0);
        input.value = totalEfec;
        calcularVueltoModal();
    };

    window.calcularVueltoModal = function () {
        const totalReg = metodosCobro.reduce((s, m) => s + m.monto, 0);
        const totalBoleta = boletaActual?.montoTotal ?? 0;
        const saldoRestante = Math.max(0, totalBoleta - totalReg);

        const totalEfectivo = metodosCobro.filter(m => m.esEfectivo).reduce((s, m) => s + m.monto, 0);
        const inputPagaCon = document.getElementById('inputPagaConModal');
        const pagaConVal = inputPagaCon?.value;
        const pagaCon = pagaConVal ? (parseInt(pagaConVal) || 0) : 0;

        const vueltoDisplay = document.getElementById('vueltoModalDisplay');
        const vueltoTitleLabel = document.getElementById('vueltoTitleLabel');
        const vueltoStatusMsg = document.getElementById('vueltoStatusMsg');
        const vueltoContainer = document.getElementById('vueltoCardContainer');
        const btnFin = document.getElementById('btnFinalizarVentaModal');

        let cobroListo = (saldoRestante === 0) && (metodosCobro.length > 0);

        if (totalEfectivo === 0) {
            if (vueltoDisplay) vueltoDisplay.textContent = "$0";
            if (vueltoTitleLabel) vueltoTitleLabel.textContent = "PAGO ELECTRÓNICO";
            if (vueltoStatusMsg) vueltoStatusMsg.textContent = "";
            if (vueltoContainer) {
                vueltoContainer.style.background = "#f0fdf4";
                vueltoContainer.style.border = "1.5px solid #bbf7d0";
                vueltoContainer.style.color = "#16a34a";
            }
        } else {
            if (pagaCon >= totalEfectivo) {
                const vuelto = pagaCon - totalEfectivo;
                if (vueltoDisplay) vueltoDisplay.textContent = fmt(vuelto);
                if (vueltoTitleLabel) vueltoTitleLabel.textContent = "VUELTO";
                if (vueltoStatusMsg) vueltoStatusMsg.textContent = "";
                if (vueltoContainer) {
                    vueltoContainer.style.background = "#dcfce7";
                    vueltoContainer.style.border = "1.5px solid #86efac";
                    vueltoContainer.style.color = "#15803d";
                }
            } else if (pagaCon > 0) {
                const faltan = totalEfectivo - pagaCon;
                if (vueltoDisplay) vueltoDisplay.textContent = fmt(pagaCon);
                if (vueltoTitleLabel) vueltoTitleLabel.textContent = "EFECTIVO INSUFICIENTE";
                if (vueltoStatusMsg) vueltoStatusMsg.textContent = "";
                if (vueltoContainer) {
                    vueltoContainer.style.background = "#fef2f2";
                    vueltoContainer.style.border = "1.5px solid #fecaca";
                    vueltoContainer.style.color = "#dc2626";
                }
                cobroListo = false;
            } else {
                if (vueltoDisplay) vueltoDisplay.textContent = "$0";
                if (vueltoTitleLabel) vueltoTitleLabel.textContent = "VUELTO";
                if (vueltoStatusMsg) vueltoStatusMsg.textContent = "";
                if (vueltoContainer) {
                    vueltoContainer.style.background = "#faf7f5";
                    vueltoContainer.style.border = "1.5px solid #e0d5cc";
                    vueltoContainer.style.color = "#7a6050";
                }
                cobroListo = false;
            }
        }

        if (btnFin) {
            btnFin.disabled = !cobroListo;
            btnFin.style.opacity = cobroListo ? "1" : "0.5";
            btnFin.style.cursor = cobroListo ? "pointer" : "not-allowed";
        }
    };

    window.finalizarCobroModal = async function () {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        const total = boletaActual.montoTotal;
        const montoEfec = metodosCobro.filter(m => m.esEfectivo).reduce((s, m) => s + m.monto, 0);
        const hayEfec = metodosCobro.some(m => m.esEfectivo);
        const pagaConVal = document.getElementById('inputPagaConModal')?.value;
        const pagaCon = pagaConVal ? (parseInt(pagaConVal) || 0) : montoEfec;

        if (hayEfec && pagaCon < montoEfec) {
            toast(`El monto ingresado en efectivo (${fmt(pagaCon)}) es menor al total a pagar en efectivo (${fmt(montoEfec)}).`, 'error');
            return;
        }

        cerrarModalCobro();

        const btn = document.getElementById('btnCobrar');
        setBotonCargando(btn, true);
        const pagos = metodosCobro.filter(m => m.monto > 0).map(m => ({ idMetodoPago: m.idMetodoPago, monto: m.monto }));
        const res = await post(URL_COBRAR, { idBoleta: boletaActual.idBoleta, metodosPago: pagos });
        setBotonCargando(btn, false);
        if (!res.ok) { toast(res.mensaje, 'error'); return; }
        toast(res.mensaje, 'exito');
        cargarBoleta(res.boleta);
        cargarBoletasPendientes();
    };

    // ── LECTOR DE CÓDIGO DE BARRAS & ATAJOS ─────────────────────────────
    let barcodeBuffer = '';
    let lastKeyTime   = Date.now();

    if (window._generarVentaKeyDownHandler) {
        window.removeEventListener('keydown', window._generarVentaKeyDownHandler);
        window._generarVentaKeyDownHandler = null;
    }

    if (window._cajaKeyDownHandler) {
        window.removeEventListener('keydown', window._cajaKeyDownHandler);
    }

    window._cajaKeyDownHandler = function(e) {
        if (e.key === 'Shift' || e.key === 'Control' || e.key === 'Alt' || e.key === 'Meta') {
            return;
        }

        if (e.key === 'Escape') {
            const cobroOverlay = document.getElementById('cobroModalOverlay');
            if (cobroOverlay && cobroOverlay.style.display === 'flex') {
                cerrarModalCobro();
                return;
            }
        }

        if (e.key === 'Enter') {
            const cobroOverlay = document.getElementById('cobroModalOverlay');
            if (cobroOverlay && cobroOverlay.style.display === 'flex') {
                e.preventDefault();
                e.stopPropagation();
                finalizarCobroModal();
                return;
            }

            if (barcodeBuffer.length > 0) {
                const code = barcodeBuffer.trim();
                barcodeBuffer = ''; // Limpiar buffer

                const prod = CATALOGO.find(p => p.codigo && p.codigo.trim() === code);
                if (prod) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (!boletaActual || boletaActual.idEstado !== 1) {
                        toast("No se pueden añadir productos a esta boleta porque no está en estado Pendiente.", "error");
                        return;
                    }

                    if (prod.retornable) {
                        pendingEnvase = { p: prod, qty: 1 };
                        cerrarModal();
                        mostrarDialogoEnvase(prod.nombre, prod.retornable.valorEnvase, prod.retornable.soloEfectivo);
                    } else {
                        _agregarProductoADetalle(prod, 1, false);
                        evaluarPromocionesAutomaticasEnDetalle();
                        renderDetalle();
                        _autoGuardarDebounce();
                    }
                    return;
                } else {
                    if (code.length >= 3) {
                        e.preventDefault();
                        e.stopPropagation();
                        toast(`Código "${code}" no encontrado`, 'error');
                        return;
                    }
                }
            }

            // Atajo Enter para abrir Modal de Cobro si hay una boleta activa
            const activeTag = document.activeElement ? document.activeElement.tagName : '';
            if (activeTag !== 'INPUT' && activeTag !== 'SELECT' && activeTag !== 'TEXTAREA') {
                if (boletaActual && boletaActual.idEstado === 1 && PUEDE_COBRAR) {
                    e.preventDefault();
                    e.stopPropagation();
                    abrirModalCobro();
                    return;
                }
            }
            return;
        }

        const currentTime = Date.now();
        const timeDiff = currentTime - lastKeyTime;
        lastKeyTime = currentTime;

        if (timeDiff > 50) {
            barcodeBuffer = '';
        }

        if (e.key.length === 1) {
            barcodeBuffer += e.key;
        }
    };

    window.addEventListener('keydown', window._cajaKeyDownHandler);

})();
</script>
}
