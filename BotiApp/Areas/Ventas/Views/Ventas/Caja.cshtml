.fiado-field { display:flex; flex-direction:column; gap:.25rem; }
.fiado-field label { font-size:.76rem; font-weight:700; color:#a89080; text-transform:uppercase; letter-spacing:.04em; }
.fiado-field input { padding:.5rem .75rem; border:1.5px solid #e0d5cc; border-radius:7px; font-size:.87rem; color:var(--color-secundario); outline:none; transition:border-color .15s; }
.fiado-field input:focus { border-color:#4f46e5; }
.fiado-row2 { display:grid; grid-template-columns:1fr 1fr; gap:.6rem; }
/* Footer botones */
.fiado-modal-footer { display:flex; align-items:center; gap:.65rem; padding:.85rem 1.15rem; border-top:1px solid #f0ebe5; flex-shrink:0; background:#fff; }
.fiado-modal-footer .btn-fiado-confirmar { flex:1; padding:.6rem; background:#4f46e5; color:#fff; border:none; border-radius:8px; font-size:.9rem; font-weight:700; cursor:pointer; transition:background .15s; }
.fiado-modal-footer .btn-fiado-confirmar:hover:not(:disabled) { background:#3730a3; }
.fiado-modal-footer .btn-fiado-confirmar:disabled { opacity:.45; cursor:not-allowed; }
.fiado-modal-footer .btn-fiado-cancel { padding:.6rem 1rem; background:#f0ebe5; color:#7a6050; border:none; border-radius:8px; font-size:.88rem; font-weight:700; cursor:pointer; transition:opacity .15s; }
.fiado-modal-footer .btn-fiado-cancel:hover { opacity:.8; }
.fiado-client-sel-info { background:#f5f4ff; border:1.5px solid #c7d2fe; border-radius:9px; padding:.6rem .85rem; font-size:.84rem; color:#4f46e5; font-weight:600; display:none; }
.fiado-client-sel-info.visible { display:block; }
</style>

<!-- ══ MODAL AGREGAR PRODUCTO ══════════════════════════════════════════════ -->
<div class="modal-overlay" id="modalAgregar" style="display:none;" onclick="if(event.target===this) cerrarModal()">
    <div class="modal-box modal-box-large">
        <div class="modal-header">
            <svg viewBox="0 0 24 24"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L21 8l-9 9z"/></svg>
            <span id="modalHeaderTxt">Agregar producto</span>
            <button class="btn-modal-cerrar" onclick="cerrarModal()" title="Cerrar">
                <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
            </button>
        </div>
        @if (Model.Promociones.Any())
        {
        <div class="modal-tabs">
            <button class="modal-tab-btn active" id="modalTabBtnProductos" onclick="selModalTab('productos')">
                <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                Productos
            </button>
            <button class="modal-tab-btn" id="modalTabBtnPromos" onclick="selModalTab('promos')">
                <svg viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .59 1.42l9 9A2 2 0 0 0 13 22a2 2 0 0 0 1.41-.59l7-7A2 2 0 0 0 22 13a2 2 0 0 0-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
                Promociones
            </button>
        </div>
        }
        <div class="modal-tab-pane" id="modalTabProductos">
            <div class="modal-body">
                <div class="modal-search">
                    <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    <input type="text" id="modalBuscarProd" placeholder="Buscar producto…" oninput="filtrarModalProductos()" autocomplete="off" />
                </div>
                <div class="modal-prod-list" id="modalProdList"></div>
            </div>
            <div class="modal-footer">
                <button class="btn-modal-agregar" id="btnModalAgregar" onclick="confirmarAgregarModal()" disabled>
                    Agregar productos seleccionados
                </button>
            </div>
        </div>
        <div class="modal-tab-pane hidden" id="modalTabPromos">
            <div class="modal-promo-list" id="modalPromoList"></div>
        </div>
    </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>
<div class="envase-overlay" id="envaseOverlay" onclick="cerrarDialogoEnvase()"></div>
<div class="grupos-overlay" id="gruposOverlay" onclick="cerrarDialogoGrupos()"></div>
<div class="selinst-overlay" id="selInstOverlay" onclick="cerrarSelInst()"></div>

<!-- ══ MODAL FIADO ══════════════════════════════════════════════════════════ -->
<div class="fiado-modal-overlay" id="fiadoModalOverlay" onclick="if(event.target===this) cerrarModalFiado()">
    <div class="fiado-modal-box">
        <div class="modal-header">
            <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            <span>Dejar en Fiado — Asignar Cliente</span>
            <button class="btn-modal-cerrar" onclick="cerrarModalFiado()" title="Cerrar">
                <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
            </button>
        </div>
        <div class="fiado-modal-tabs">
            <button class="fiado-modal-tab active" id="fiadoTabBtnBuscar" onclick="selFiadoTab('buscar')">
                <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                Buscar cliente
            </button>
            <button class="fiado-modal-tab" id="fiadoTabBtnCrear" onclick="selFiadoTab('crear')">
                <svg viewBox="0 0 24 24"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                Crear cliente
            </button>
        </div>
        <!-- Tab: buscar -->
        <div class="fiado-tab-pane" id="fiadoTabBuscar">
            <div class="fiado-search-body">
                <div class="modal-search">
                    <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    <input type="text" id="fiadoBuscarInput" placeholder="Nombre o RUT…" oninput="buscarClientesFiado()" autocomplete="off" />
                </div>
                <div class="fiado-client-sel-info" id="fiadoClientSelInfo"></div>
                <div class="fiado-client-list" id="fiadoClientList">
                    <div style="text-align:center;padding:1.5rem;color:#b8a898;font-size:.84rem;">Escribe para buscar un cliente</div>
                </div>
            </div>
            <div class="fiado-modal-footer">
                <button class="btn-fiado-cancel" onclick="cerrarModalFiado()">Cancelar</button>
                <button class="btn-fiado-confirmar" id="btnConfirmarFiado" onclick="confirmarFiado()" disabled>
                    Dejar en fiado
                </button>
            </div>
        </div>
        <!-- Tab: crear -->
        <div class="fiado-tab-pane hidden" id="fiadoTabCrear">
            <div class="fiado-crear-body">
                <div class="fiado-field">
                    <label>Nombre <span style="color:#dc2626">*</span></label>
                    <input type="text" id="fiadoNuevoNombre" placeholder="Ej: Juan González" autocomplete="off" />
                </div>
                <div class="fiado-field">
                    <label>Teléfono</label>
                    <input type="text" id="fiadoNuevoTelefono" placeholder="+56 9 xxxx xxxx" />
                </div>
            </div>
            <div class="fiado-modal-footer">
                <button class="btn-fiado-cancel" onclick="cerrarModalFiado()">Cancelar</button>
                <button class="btn-fiado-confirmar" id="btnCrearYFiado" onclick="crearYFiado()">
                    Crear y dejar en fiado
                </button>
            </div>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()

<div class="cj-wrap">

    <!-- ══ SECTOR IZQUIERDO: Tickets Emitidos ══ -->
    <div class="cj-panel" id="pendPanel" style="width:360px; flex-shrink:0;">
        <div class="cj-panel-header">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zm-3 7H7v-2h3v2zm3-4H7v-2h6v2zm0 4h-2v-2h2v2z"/></svg>
            <span>Tickets Emitidos</span>
        </div>
        <div class="cj-panel-body" style="gap:.85rem; padding:.85rem 1.15rem 0;">
            <div class="cj-search-row">
                <input type="number" id="inputNBoleta" placeholder="N° de ticket" min="1"
                       onkeydown="if(event.key==='Enter') buscarBoleta()" />
                <button class="btn-buscar" onclick="buscarBoleta()" id="btnBuscar">
                    <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    Buscar
                </button>
            </div>
            <div class="pend-subheader">
                <div class="pend-subheader-left">
                    <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
                    <span>Pendientes de pago</span>
                    <span class="pend-header-count" id="pendCount">0</span>
                </div>
                <div style="display:flex; align-items:center; gap:.4rem;">
                    <span id="pendLastUpdate" class="pend-last-update"></span>
                    <button class="btn-pend-refresh" onclick="cargarBoletasPendientes(true)" title="Actualizar lista">
                        <svg viewBox="0 0 24 24"><path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
                    </button>
                </div>
            </div>
        </div>
        <div id="pendListContainer" style="padding-bottom:.5rem;">
            <div class="pend-loading">Cargando…</div>
        </div>
    </div>

    <!-- ══ SECTOR DERECHO: Detalle del Ticket (Ocupa todo el espacio restante) ══ -->
    <div class="cj-panel" style="flex:1;">
        <div class="cj-panel-header">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zm-3 7H7v-2h3v2zm3-4H7v-2h6v2zm0 4h-2v-2h2v2zm5-3h-2v3h-2v-3h-2v-2h6v2z"/></svg>
            <span id="headerBoleta">Detalle del Ticket</span>
        </div>
        <div class="cj-panel-body">

            <div class="bol-info" id="bolInfo">
                <div class="bol-info-header" id="bolInfoHeader"></div>

                <!-- Acciones (en la parte superior) -->
                <div class="bol-actions" id="bolActions" style="margin-bottom:.8rem;">
                    <button class="btn-agregar-modal" id="btnAbrirModal" onclick="abrirModal()" disabled>
                        <svg viewBox="0 0 24 24"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/></svg>
                        Agregar producto
                    </button>

                    @if (Model.PuedeCobrar)
                    {
                    <button class="btn-guardar" id="btnCobrar" onclick="abrirModalCobro()" disabled style="background:var(--color-primario); font-size:0.92rem; padding:0.6rem 1.15rem;">
                        <svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1H6.6c.12 2.19 1.76 3.42 3.7 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                        Cobrar Ticket
                    </button>
                    <button class="btn-fiado" id="btnFiado" onclick="abrirModalFiado()" disabled>
                        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        Fiado
                    </button>
                    }
                    <button class="btn-anular" id="btnAnular" onclick="confirmarAnular()" disabled>
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/></svg>
                        Anular boleta
                    </button>
                </div>

                <!-- Tabla detalle editable -->
                <div class="detalle-wrap">
                    <table class="detalle-table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Cant.</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="detalleTbody"></tbody>
                        <tfoot>
                            <tr class="detalle-total-row">
                                <td colspan="3" style="text-align:right; font-size:.85rem;">Total</td>
                                <td id="totalDisplay" style="font-size:.9rem; color:var(--color-primario);">$0</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Estado final -->
                <div class="estado-final pagada" id="estadoPagada">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    <p>Boleta cobrada exitosamente</p>
                </div>
                <div class="estado-final anulada" id="estadoAnulada">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/></svg>
                    <p>Boleta anulada</p>
                </div>
            </div>

            <!-- Placeholder sin boleta -->
            <div id="bolPlaceholder" style="text-align:center; padding:2rem; color:#b8a898; font-size:.86rem;">
                <svg viewBox="0 0 24 24" style="width:44px;height:44px;fill:#ddd0c4;display:block;margin:0 auto .6rem"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zm-3 7H7v-2h3v2zm3-4H7v-2h6v2zm0 4h-2v-2h2v2z"/></svg>
                Selecciona un ticket o ingresa un N° para comenzar
            </div>
        </div>
    </div>
</div>

@if (Model.PuedeCobrar)
{
    <div class="modal-overlay" id="cobroModalOverlay" style="display:none;">
        <div class="modal-box cobro-modal-box" onclick="event.stopPropagation()">
            
            <!-- Encabezado Limpio sin Fondo Negro -->
            <div style="padding:0.75rem 1.2rem 0.2rem 1.2rem; display:flex; align-items:center; justify-content:space-between; background:#ffffff;">
                <div style="display:flex; align-items:center; gap:0.4rem;">
                    <svg viewBox="0 0 24 24" style="width:20px; height:20px; fill:var(--color-primario);"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                    <span id="cobroModalTitle" style="font-size:1.05rem; font-weight:800; color:var(--color-secundario);">Procesar Cobro</span>
                </div>
                <button class="btn-modal-cerrar" onclick="cerrarModalCobro()" title="Cerrar" style="background:#faf7f5; border:1.5px solid #e0d5cc; border-radius:50%; width:30px; height:30px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#7a6050;">
                    <svg viewBox="0 0 24 24" style="width:18px; height:18px; fill:currentColor;"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                </button>
            </div>

            <!-- Cuerpo Compacto en 2 Columnas -->
            <div class="modal-body cobro-modal-body-compact">
                
                <!-- COLUMNA IZQUIERDA: Resumen & Selección de Método de Pago -->
                <div style="display:flex; flex-direction:column; gap:0.6rem;">
                    
                    <!-- Resumen Totales (Fila Compacta Centrada) -->
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
                        <div style="background:var(--color-secundario); border-radius:8px; padding:0.5rem 0.7rem; text-align:center; color:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:56px;">
                            <div style="font-size:0.68rem; font-weight:800; color:var(--color-primario); text-transform:uppercase; margin-bottom:0.15rem;">TOTAL TICKET</div>
                            <div style="font-size:1.5rem; font-weight:900; line-height:1;" id="resTotalBoletaModal">$0</div>
                        </div>
                        <div style="background:#faf7f5; border:1.5px solid #e0d5cc; border-radius:8px; padding:0.5rem 0.7rem; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:56px;">
                            <div style="font-size:0.68rem; font-weight:800; color:#7a6050; text-transform:uppercase; margin-bottom:0.15rem;" id="lblEstadoSaldo">SALDO PENDIENTE</div>
                            <div style="font-size:1.35rem; font-weight:900; color:#16a34a; line-height:1;" id="resSaldoRestanteModal">$0</div>
                        </div>
                    </div>

                    <!-- Alerta Envase (Si Aplica) -->
                    <div class="cobro-envase-alerta" id="cobroEnvaseAlerta" style="display:none; background:#fef2f2; border:1.5px solid #fecaca; border-radius:8px; padding:0.4rem 0.6rem; color:#dc2626; display:flex; align-items:center; gap:0.4rem; font-size:0.78rem;">
                        <svg viewBox="0 0 24 24" style="width:16px; height:16px; fill:#dc2626; flex-shrink:0;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>
                        <span id="cobroEnvaseAlertaMsg" style="font-weight:700;">Garantía de envase cobrada en efectivo.</span>
                    </div>

                    <!-- Métodos de Pago Principal -->
                    <div style="background:#ffffff; border:1.5px solid #ede5df; border-radius:8px; padding:0.65rem; display:flex; flex-direction:column; gap:0.45rem;">
                        <div style="display:flex; align-items:center; justify-content:space-between;">
                            <span style="font-size:0.8rem; font-weight:800; color:var(--color-secundario); text-transform:uppercase;">Método de Pago:</span>
                            <button type="button" onclick="toggleAdicional()" id="btnToggleAdicional" style="background:#faf7f5; border:1px solid var(--color-primario); border-radius:5px; font-size:0.73rem; font-weight:800; color:var(--color-primario); cursor:pointer; padding:0.2rem 0.45rem;">
                                + Pago Dividido
                            </button>
                        </div>

                        <!-- Grid de Tarjetas de Pago -->
                        <div class="cobro-metodos-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(95px, 1fr)); gap:0.4rem; width:100%;">
                            @foreach (var m in Model.MetodosPago)
                            {
                                <button type="button" class="btn-metodo-pago-card" data-id="@m.IdMetodoPago" data-nombre="@m.NombreMetodoPago" onclick="seleccionarMetodoPrincipalBtn(this)" style="min-height:50px; padding:0.35rem 0.25rem;">
                                    <div class="mp-icon" style="width:18px; height:18px;">
                                        @if (m.NombreMetodoPago.Contains("Efectivo", StringComparison.OrdinalIgnoreCase)) {
                                            <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>
                                        } else if (m.NombreMetodoPago.Contains("Débito", StringComparison.OrdinalIgnoreCase) || m.NombreMetodoPago.Contains("Tarjeta", StringComparison.OrdinalIgnoreCase)) {
                                            <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
                                        } else if (m.NombreMetodoPago.Contains("Crédito", StringComparison.OrdinalIgnoreCase)) {
                                            <svg viewBox="0 0 24 24"><path d="M21 4H3c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h18c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H3V8h18v10z"/></svg>
                                        } else {
                                            <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                                        }
                                    </div>
                                    <span class="mp-name" style="font-size:0.78rem; font-weight:800;">@m.NombreMetodoPago</span>
                                </button>
                            }
                        </div>

                        <!-- Panel desplegable de Pago Dividido -->
                        <div class="cobro-adicional" id="cobroAdicionalSection" style="display:none; background:#faf7f5; border:1.5px dashed #d4c4b7; border-radius:7px; padding:0.45rem; flex-direction:column; gap:0.35rem;">
                            <div style="font-size:0.72rem; font-weight:800; color:#7a6050; text-transform:uppercase;">Agregar pago secundario:</div>
                            <div style="display:flex; gap:0.35rem; align-items:center;">
                                <select id="selMetodoAdicional" style="flex:1; padding:0.3rem; border:1.5px solid #e0d5cc; border-radius:5px; font-size:0.8rem; font-weight:700;">
                                    @foreach (var m in Model.MetodosPago)
                                    {
                                        <option value="@m.IdMetodoPago" data-nombre="@m.NombreMetodoPago">@m.NombreMetodoPago</option>
                                    }
                                </select>
                                <input type="number" class="cobro-monto-input" id="inputMontoAdicional" placeholder="Monto $" min="1" style="width:85px; padding:0.3rem; border:1.5px solid #e0d5cc; border-radius:5px; font-size:0.82rem; font-weight:800;" />
                                <button class="btn-add-metodo" onclick="agregarMetodoAdicional()" style="padding:0.3rem 0.6rem; background:var(--color-secundario); color:#fff; border:none; border-radius:5px; font-weight:800; font-size:0.78rem; cursor:pointer;">+ Agregar</button>
                            </div>
                        </div>

                        <!-- Lista de Desglose Asignado -->
                        <div>
                            <div style="font-size:0.72rem; font-weight:800; color:#a89080; text-transform:uppercase; margin-bottom:0.2rem;">Desglose de Pago:</div>
                            <div class="cobro-list" id="cobroList" style="display:flex; flex-direction:column; gap:0.25rem;"></div>
                        </div>
                    </div>

                </div>

                <!-- COLUMNA DERECHA: Pago en Efectivo & Vuelto -->
                <div id="seccionEfectivoInferior" style="background:#f4efe9; border:1.5px solid #dcd1c4; border-radius:10px; padding:0.75rem; display:flex; flex-direction:column; gap:0.5rem; justify-content:space-between; height:100%;">
                    
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:0.35rem;">
                        <span style="font-size:0.85rem; font-weight:800; color:var(--color-secundario); display:flex; align-items:center; gap:0.3rem;">
                            <svg viewBox="0 0 24 24" style="width:16px; height:16px; fill:var(--color-primario);"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>
                            Cobro en Efectivo
                        </span>
                        <span style="font-size:0.78rem; font-weight:800; color:var(--color-secundario); background:#fff; border:1px solid #d4c4b7; border-radius:5px; padding:0.15rem 0.45rem;">
                            Efectivo Total: <strong id="lblTotalEfectivoRequerido" style="color:var(--color-primario); font-size:0.9rem;">$0</strong>
                        </span>
                    </div>

                    <!-- Input Dinero Recibido -->
                    <div style="display:flex; flex-direction:column; gap:0.25rem;">
                        <label for="inputPagaConModal" style="font-size:0.8rem; font-weight:800; color:var(--color-secundario);">
                            Dinero entregado por el cliente ($):
                        </label>
                        <div style="position:relative; display:flex; align-items:center;">
                            <span style="position:absolute; left:10px; font-size:1.15rem; font-weight:800; color:#7a6050;">$</span>
                            <input type="number" id="inputPagaConModal" class="cobro-monto-input" style="width:100%; height:40px; font-size:1.25rem; font-weight:900; text-align:left; padding:0 0.6rem 0 1.8rem; border-radius:7px; border:2px solid #d4c4b7; background:#fff; color:var(--color-secundario); outline:none;" placeholder="0" min="0" oninput="calcularVueltoModal()" />
                        </div>
                    </div>

                    <!-- Billetes Rápidos (Grid 3x2) -->
                    <div>
                        <div style="font-size:0.7rem; font-weight:800; color:#7a6050; text-transform:uppercase; margin-bottom:0.2rem;">Billetes Rápidos:</div>
                        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:0.3rem;">
                            <button type="button" class="btn-billete-rapido" onclick="agregarBilleteRapido(1000)" style="padding:0.35rem 0.15rem; font-size:0.8rem;">$1.000</button>
                            <button type="button" class="btn-billete-rapido" onclick="agregarBilleteRapido(2000)" style="padding:0.35rem 0.15rem; font-size:0.8rem;">$2.000</button>
                            <button type="button" class="btn-billete-rapido" onclick="agregarBilleteRapido(5000)" style="padding:0.35rem 0.15rem; font-size:0.8rem;">$5.000</button>
                            <button type="button" class="btn-billete-rapido" onclick="agregarBilleteRapido(10000)" style="padding:0.35rem 0.15rem; font-size:0.8rem;">$10.000</button>
                            <button type="button" class="btn-billete-rapido" onclick="agregarBilleteRapido(20000)" style="padding:0.35rem 0.15rem; font-size:0.8rem;">$20.000</button>
                            <button type="button" class="btn-billete-rapido exacto" onclick="establecerMontoExacto()" style="padding:0.35rem 0.15rem; font-size:0.8rem;">Exacto</button>
                        </div>
                    </div>

                    <!-- Tarjeta de Vuelto -->
                    <div id="vueltoCardContainer" style="border-radius:8px; padding:0.6rem; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; transition:all 0.15s ease; min-height:75px;">
                        <div id="vueltoTitleLabel" style="font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.1rem;">VUELTO</div>
                        <div id="vueltoModalDisplay" style="font-size:1.6rem; font-weight:900; line-height:1.1;">$0</div>
                        <div id="vueltoStatusMsg" style="display:none;"></div>
                    </div>

                </div>

            </div>

            <!-- Footer del Modal -->
            <div class="modal-footer" style="padding:0.6rem 1.2rem; background:#ffffff; border-top:1.5px solid #ede5df; display:flex; align-items:center; justify-content:space-between; gap:0.8rem;">
                <button type="button" class="btn-fiado" onclick="cerrarModalCobro()" style="background:#faf7f5; color:#7a6050; border:1.5px solid #e0d5cc; padding:0.55rem 1.1rem; font-size:0.88rem; font-weight:800; border-radius:7px;">
                    Cancelar
                </button>
                <button type="button" class="btn-finalizar" id="btnFinalizarVentaModal" onclick="finalizarCobroModal()" style="flex:1; padding:0.65rem 1.2rem; font-size:1.02rem; font-weight:900; background:#16a34a; border-radius:7px; display:flex; align-items:center; justify-content:center; gap:0.45rem;">
                    <svg viewBox="0 0 24 24" style="width:18px; height:18px; fill:currentColor;"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                    <span>FINALIZAR Y REGISTRAR VENTA</span>
                </button>
            </div>

        </div>
    </div>
}


</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8/dist/browser/signalr.min.js"></script>
<script>
(function () {
    /* ── Datos del servidor ──────────────────────────────────────────────── */
    const PUEDE_COBRAR = @Html.Raw(Model.PuedeCobrar.ToString().ToLower());
    const METODOS_PAGO = @Html.Raw(metodosPagoJson);
    const CATALOGO     = @Html.Raw(catalogoJson);
    const PROMOS       = @Html.Raw(promosJson);
    const TOKEN        = document.querySelector('input[name="__RequestVerificationToken"]').value;

    const URL_BUSCAR      = '@Html.Raw(urlBuscar)';
    const URL_MODIFICA    = '@Html.Raw(urlModifica)';
    const URL_COBRAR      = '@Html.Raw(urlCobrar)';
    const URL_ANULAR      = '@Html.Raw(urlAnular)';
    const URL_PENDIENTES  = '@Html.Raw(urlPendientes)';
    const URL_DEJAR_FIADO    = '@Html.Raw(urlDejarFiado)';
    const URL_BUSCAR_CLIENTE = '@Html.Raw(urlBuscarCliente)';
    const URL_CREAR_CLIENTE  = '@Html.Raw(urlCrearCliente)';
    const URL_CREAR          = '@Html.Raw(urlCrear)';
    const URL_IMG            = '@Html.Raw(urlImagen)';

    /* ── Mapa de retornables ─────────────────────────────────────────────── */
    const RETORNABLES_MAP = {};
    CATALOGO.forEach(p => { if (p.retornable) RETORNABLES_MAP[p.id] = p.retornable; });

    /* ── Estado ──────────────────────────────────────────────────────────── */
    let boletaActual  = null;
    let detalleActual = [];
    let metodosCobro  = [];   // [{idMetodoPago, nombre, monto, esEfectivo}]
    let modalProdSel  = null; // producto seleccionado en el modal
    let modalQty      = 1;
    let adicionalVisible = false;
    let pendingEnvase    = null;  // producto retornable pendiente de confirmación
    let _promoInstCounter = 0;   // Unique ID per promo instance added to detalleActual
    let modalSelectedProds = new Map();
    let activeMetodoPagoId = null;

    /* ── Utilitarios ─────────────────────────────────────────────────────── */
    function fmt(n)  { return '$' + Number(n).toLocaleString('es-CL'); }
    function x(s)    { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }
    function toast(msg, tipo) {
        const wrap = document.getElementById('toastWrap');
        const div  = document.createElement('div');
        div.className = 'toast-msg ' + tipo;
        div.innerHTML = tipo === 'exito'
            ? `<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>`
            : `<svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>`;
        div.innerHTML += x(msg);
        wrap.appendChild(div);
        setTimeout(() => div.remove(), 4000);
    }
    async function post(url, data) {
        let r;
        try {
            r = await fetch(url, {
                method : 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body   : JSON.stringify(data)
            });
        } catch {
            return { ok: false, mensaje: 'Error de red. Verifica tu conexión.' };
        }
        if (!r.ok) {
            const texto = await r.text();
            console.error('Respuesta no-JSON del servidor:', texto);
            if (r.status === 401 || r.status === 403)
                return { ok: false, mensaje: 'No tienes permisos para realizar esta acción.' };
            return { ok: false, mensaje: `Error del servidor (${r.status}).` };
        }
        return r.json();
    }
    function setBotonCargando(btn, cargando) {
        btn.disabled = cargando;
        if (cargando) btn.dataset.oldHtml = btn.innerHTML;
        btn.innerHTML = cargando ? '<span class="spin-sm"></span> Procesando…' : btn.dataset.oldHtml;
    }

    /* Auto-guardar silencioso (sin spinner de botón) */
    let _autoGuardarTimer = null;
    async function _autoGuardar() {
        if (!boletaActual || boletaActual.idEstado !== 1 || !detalleActual.length) return;
        const items = detalleActual.map(d => ({
            idProducto:       d.idProducto,
            cantidad:         d.cantidad,
            precioNormal:     d.precioNormal,
            precioUnitario:   d.precioUnitario,
            idPromocion:      d.idPromocion ?? null,
            idOfertaProducto: d.idOferta ?? null
        }));
        const res = await post(URL_MODIFICA, { idBoleta: boletaActual.idBoleta, items });
        if (!res.ok) {
            toast(res.mensaje, 'error');
        } else {
            // Actualizar montoTotal sin re-renderizar toda la boleta
            if (res.boleta) boletaActual.montoTotal = res.boleta.montoTotal;
        }
    }
    function _autoGuardarDebounce() {
        clearTimeout(_autoGuardarTimer);
        _autoGuardarTimer = setTimeout(_autoGuardar, 600);
    }

    window.nuevaVenta = async function () {
        const btn = document.getElementById('btnNuevaVenta');
        setBotonCargando(btn, true);
        const res = await post(URL_CREAR, { items: [] });
        setBotonCargando(btn, false);
        if (!res.ok) {
            toast(res.mensaje, 'error');
            return;
        }
        cargarBoleta(res.boleta);
        toast(`Nueva Venta N° ${res.boleta.idBoleta} iniciada.`, 'exito');
    };

    window.actualizarOtrosMonto = function () {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        const inputOtros = document.getElementById('inputOtrosMonto');
        if (!inputOtros) return;

        const montoOtros = Math.max(0, parseInt(inputOtros.value) || 0);
        const idx = detalleActual.findIndex(d => d.idProducto === 0 && !d.idPromocion);

        if (montoOtros > 0) {
            if (idx >= 0) {
                detalleActual[idx].precioNormal = montoOtros;
                detalleActual[idx].precioUnitario = montoOtros;
                detalleActual[idx].subtotal = montoOtros;
            } else {
                detalleActual.push({
                    idProducto: 0,
                    nombre: 'Otros',
                    cantidad: 1,
                    precioNormal: montoOtros,
                    precioUnitario: montoOtros,
                    subtotal: montoOtros,
                    esEnvase: false,
                    idPromocion: null,
                    idOferta: null,
                    tieneOferta: false
                });
            }
        } else {
            if (idx >= 0) {
                detalleActual.splice(idx, 1);
            }
            inputOtros.value = '';
        }

        renderDetalle();
        _autoGuardarDebounce();
    };

    /* ════════════════════════════════════════════════════
       MODAL AGREGAR PRODUCTO
    ════════════════════════════════════════════════════ */
    const CATALOGO_ACTIVO = CATALOGO
        .sort((a, b) => a.nombre.localeCompare(b.nombre));

    /* ── Tab switcher ────────────────────────────────────────────────── */
    window.selModalTab = function (tab) {
        ['productos','promos'].forEach(t => {
            document.getElementById('modalTabBtn' + t.charAt(0).toUpperCase() + t.slice(1))?.classList.remove('active');
            document.getElementById('modalTab'    + t.charAt(0).toUpperCase() + t.slice(1))?.classList.add('hidden');
        });
        const key = tab.charAt(0).toUpperCase() + tab.slice(1);
        document.getElementById('modalTabBtn' + key)?.classList.add('active');
        document.getElementById('modalTab'    + key)?.classList.remove('hidden');
        document.getElementById('modalHeaderTxt').textContent = tab === 'promos' ? 'Agregar promoción' : 'Agregar producto';
        if (tab === 'promos') renderModalPromos();
    };

    function renderModalPromos() {
        const list = document.getElementById('modalPromoList');
        if (!list) return;
        if (!PROMOS || PROMOS.length === 0) {
            list.innerHTML = `<div style="text-align:center;padding:2rem;color:#b8a898;font-size:.84rem;">Sin promociones activas</div>`;
            return;
        }
        list.innerHTML = '';
        PROMOS.forEach(p => {
            // Check if at least one product combination has stock
            const sinStock = !puedeAgregarPromo(p.id);
            const div = document.createElement('div');
            div.className = 'modal-promo-item' + (sinStock ? ' modal-promo-sin-stock' : '');
            // Build product description
            const allProds = [
                ...p.productosBase.map(r => { const c = CATALOGO.find(cc => cc.id === r.idProducto); return c ? `${c.nombre} ×${r.cantidad}` : null; }).filter(Boolean),
                ...p.grupos.flatMap(g => g.esExcluyente
                    ? [g.productos.map(r => { const c = CATALOGO.find(cc => cc.id === r.idProducto); return c ? c.nombre : null; }).filter(Boolean).join(' / ')]
                    : g.productos.map(r => { const c = CATALOGO.find(cc => cc.id === r.idProducto); return c ? `${c.nombre} ×${r.cantidad}` : null; }).filter(Boolean))
            ];
            div.innerHTML =
                `<div class="modal-promo-header">` +
                    `<span class="modal-promo-nombre">${x(p.nombre)}</span>` +
                    `<span class="modal-promo-precio">${fmt(p.precio)}</span>` +
                `</div>` +
                `<div class="modal-promo-sub">${allProds.join(' · ')}</div>`;
            if (!sinStock) {
                div.onclick = () => { cerrarModal(); seleccionarPromo(p.id); };
            }
            list.appendChild(div);
        });
    }

    function puedeAgregarPromo(idPromo) {
        return true;
    }

    function renderModalProductos(filtro) {
        const list    = document.getElementById('modalProdList');
        const q       = (filtro || '').toLowerCase().trim();
        const items   = q ? CATALOGO_ACTIVO.filter(p => p.nombre.toLowerCase().includes(q)) : CATALOGO_ACTIVO;
        list.innerHTML = '';
        if (!items.length) {
            list.innerHTML = `<div style="text-align:center;padding:1.5rem;color:#b8a898;font-size:.84rem;grid-column:1/-1;">Sin resultados</div>`;
            return;
        }
        items.forEach(p => {
            if (p.id === 0) return; // Omitir el producto "Otros"
            const tieneOferta = !!p.ofertaId;
            const precio      = tieneOferta ? p.ofertaPrecio : p.precio;
            const qty         = modalSelectedProds.get(p.id) || 0;
            const isSelected  = qty > 0;
            const cardClass   = 'modal-prod-card' + (isSelected ? ' seleccionado' : '');

            const imgHtml = p.tieneImagen
                ? `<img src="${URL_IMG}/${p.id}" alt="${x(p.nombre)}" loading="lazy">`
                : `<svg viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>`;

            const precioHtml = tieneOferta
                ? `<div style="display:flex; flex-direction:column; align-items:flex-start;">
                       <span class="prod-card-precio tachado" style="font-size:.7rem; line-height:1.1; margin-bottom:1px;">${fmt(p.precio)}</span>
                       <span class="prod-card-oferta" style="color:#7c3aed; font-weight:700; font-size:.82rem; line-height:1.1;">${fmt(precio)}</span>
                   </div>`
                : `<span class="prod-card-precio" style="font-size:.82rem; font-weight:700; color:var(--color-secundario);">${fmt(p.precio)}</span>`;

            const selectorHtml = isSelected
                ? `<div class="modal-prod-qty-ctrl" onclick="event.stopPropagation()">
                       <button onclick="changeModalProdQty(${p.id}, -1, event)">-</button>
                       <span>${qty}</span>
                       <button onclick="changeModalProdQty(${p.id}, 1, event)">+</button>
                   </div>`
                : `<button class="btn-modal-seleccionar" onclick="toggleSeleccionProdModal(${p.id}, event)">+ Seleccionar</button>`;

            const div = document.createElement('div');
            div.id = `mpc-${p.id}`;
            div.className = cardClass;
            div.innerHTML = `
                <div class="modal-prod-check-badge" style="${isSelected ? 'display:flex;' : 'display:none;'}">
                    <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                </div>
                <div class="prod-img-wrap">${imgHtml}</div>
                <div class="prod-card-body" style="flex:1; display:flex; flex-direction:column; gap:.12rem; padding:.45rem .55rem;">
                    <div class="prod-card-nombre" style="font-size:.78rem; font-weight:700; color:var(--color-secundario); line-height:1.2; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:1.8em;">${x(p.nombre)}</div>
                    <div class="prod-card-meta" style="font-size:.68rem; color:#a89080;">Stock: ${p.stock}${tieneOferta ? ' · <span style="color:#7c3aed;font-weight:700;">Oferta</span>' : ''}</div>
                </div>
                <div class="prod-card-footer" style="padding:.4rem .55rem; border-top:1px solid #f0ebe5; display:flex; justify-content:space-between; align-items:center; min-height:38px;">
                    ${precioHtml}
                    ${selectorHtml}
                </div>
            `;
            div.onclick = (e) => {
                if (!isSelected) {
                    toggleSeleccionProdModal(p.id, e);
                }
            };
            list.appendChild(div);
        });
    }

    window.toggleSeleccionProdModal = function (id, event) {
        if (event) event.stopPropagation();
        const p = CATALOGO_ACTIVO.find(c => c.id === id);
        if (!p) return;

        if (modalSelectedProds.has(id)) {
            modalSelectedProds.delete(id);
        } else {
            modalSelectedProds.set(id, Math.min(1, p.stock));
        }
        updateModalCard(p);
        updateBtnModalAgregarState();
    };

    window.changeModalProdQty = function (id, delta, event) {
        if (event) event.stopPropagation();
        const p = CATALOGO_ACTIVO.find(c => c.id === id);
        if (!p) return;

        const currentQty = modalSelectedProds.get(id) || 0;
        const newQty = currentQty + delta;
        if (newQty <= 0) {
            modalSelectedProds.delete(id);
        } else {
            modalSelectedProds.set(id, Math.min(newQty, p.stock));
        }
        updateModalCard(p);
        updateBtnModalAgregarState();
    };

    function updateModalCard(p) {
        const card = document.getElementById(`mpc-${p.id}`);
        if (!card) return;

        const qty = modalSelectedProds.get(p.id) || 0;
        const isSelected = qty > 0;

        if (isSelected) {
            card.classList.add('seleccionado');
        } else {
            card.classList.remove('seleccionado');
        }

        const checkBadge = card.querySelector('.modal-prod-check-badge');
        if (checkBadge) {
            checkBadge.style.display = isSelected ? 'flex' : 'none';
        }

        const footer = card.querySelector('.prod-card-footer');
        if (footer) {
            const tieneOferta = !!p.ofertaId;
            const precio = tieneOferta ? p.ofertaPrecio : p.precio;
            const precioHtml = tieneOferta
                ? `<div style="display:flex; flex-direction:column; align-items:flex-start;">
                       <span class="prod-card-precio tachado" style="font-size:.7rem; line-height:1.1; margin-bottom:1px;">${fmt(p.precio)}</span>
                       <span class="prod-card-oferta" style="color:#7c3aed; font-weight:700; font-size:.82rem; line-height:1.1;">${fmt(precio)}</span>
                   </div>`
                : `<span class="prod-card-precio" style="font-size:.82rem; font-weight:700; color:var(--color-secundario);">${fmt(p.precio)}</span>`;

            const selectorHtml = isSelected
                ? `<div class="modal-prod-qty-ctrl" onclick="event.stopPropagation()">
                       <button onclick="changeModalProdQty(${p.id}, -1, event)">-</button>
                       <span>${qty}</span>
                       <button onclick="changeModalProdQty(${p.id}, 1, event)">+</button>
                   </div>`
                : `<button class="btn-modal-seleccionar" onclick="toggleSeleccionProdModal(${p.id}, event)">+ Seleccionar</button>`;

            footer.innerHTML = precioHtml + selectorHtml;
        }
    }

    function updateBtnModalAgregarState() {
        let totalQty = 0;
        for (const qty of modalSelectedProds.values()) {
            totalQty += qty;
        }
        const btn = document.getElementById('btnModalAgregar');
        if (btn) {
            btn.disabled = totalQty === 0;
            btn.textContent = totalQty > 0
                ? `Agregar ${totalQty} producto${totalQty === 1 ? '' : 's'} seleccionados`
                : 'Agregar productos seleccionados';
        }
    }

    window.filtrarModalProductos = function () {
        const q = document.getElementById('modalBuscarProd').value;
        renderModalProductos(q);
    };

    window.abrirModal = function () {
        if (!boletaActual || boletaActual.idEstado !== 1) return;
        modalSelectedProds.clear();
        document.getElementById('modalBuscarProd').value = '';
        document.getElementById('btnModalAgregar').disabled = true;
        renderModalProductos('');
        selModalTab('productos');
        document.getElementById('modalAgregar').style.display = 'flex';
        document.getElementById('modalBuscarProd').focus();
    };

    window.cerrarModal = function () {
        document.getElementById('modalAgregar').style.display = 'none';
    };

    window.confirmarAgregarModal = function () {
        if (modalSelectedProds.size === 0) return;

        const selectedItems = [];
        for (const [id, qty] of modalSelectedProds.entries()) {
            selectedItems.push({ id, qty });
        }

        modalSelectedProds.clear();
        cerrarModal();

        procesarItemsAgregados(selectedItems);
    };

    function procesarItemsAgregados(selectedItems) {
        if (selectedItems.length === 0) {
            evaluarPromocionesAutomaticasEnDetalle();
            renderDetalle();
            _autoGuardarDebounce();
            return;
        }

        const item = selectedItems.shift();
        const p = CATALOGO_ACTIVO.find(c => c.id === item.id);
        if (!p) {
            procesarItemsAgregados(selectedItems);
            return;
        }

        const qty = item.qty;
        if (p.retornable) {
            pendingEnvase = { p, qty, nextItems: selectedItems };
            mostrarDialogoEnvase(p.nombre, p.retornable.valorEnvase, p.retornable.soloEfectivo);
        } else {
            _agregarProductoADetalle(p, qty, false);
            toast(`${x(p.nombre)} ×${qty} agregado.`, 'exito');
            procesarItemsAgregados(selectedItems);
        }
    }

    /* ── Helper: agregar un producto (o su envase) a detalleActual ───────── */
    function _agregarProductoADetalle(p, qty, cobrarEnvase) {
        const tieneOfer = !!p.ofertaId;
        const precio    = tieneOfer ? p.ofertaPrecio : p.precio;
        const existente = detalleActual.find(d => !d.esEnvase && !d.idPromocion && d.idProducto === p.id);
        if (existente) {
            existente.cantidad += qty;
            existente.subtotal  = existente.cantidad * existente.precioUnitario;
        } else {
            detalleActual.push({
                idProducto:     p.id,
                nombre:         p.nombre,
                cantidad:       qty,
                precioNormal:   p.precio,
                precioUnitario: precio,
                subtotal:       qty * precio,
                idPromocion:    null,
                nombrePromocion:null,
                idOferta:       tieneOfer ? p.ofertaId : null,
                tieneOferta:    tieneOfer,
                esEnvase:       false
            });
        }
        if (cobrarEnvase && p.retornable) {
            const ve = p.retornable.valorEnvase;
            const envExist = detalleActual.find(d => d.esEnvase && d.idProducto === p.id);
            if (envExist) {
                envExist.cantidad += qty;
                envExist.subtotal  = envExist.cantidad * envExist.precioUnitario;
            } else {
                detalleActual.push({
                    idProducto:     p.id,
                    nombre:         `Envase ${p.nombre}`,
                    cantidad:       qty,
                    precioNormal:   0,
                    precioUnitario: ve,
                    subtotal:       qty * ve,
                    idPromocion:    null,
                    nombrePromocion:null,
                    idOferta:       null,
                    tieneOferta:    false,
                    esEnvase:       true
                });
            }
        }
    }

    /* ── Evaluador Automático de Promociones en Detalle ───────────────────── */
    function evaluarPromocionesAutomaticasEnDetalle() {
        if (!PROMOS || PROMOS.length === 0) return;

        const standaloneMap = new Map();
        detalleActual.forEach(d => {
            if (!d.idPromocion && !d.esEnvase) {
                standaloneMap.set(d.idProducto, (standaloneMap.get(d.idProducto) || 0) + d.cantidad);
            }
        });

        for (const promo of PROMOS) {
            // eslint-disable-next-line no-constant-condition
            while (true) {
                const baseOk = (promo.productosBase || []).every(
                    req => (standaloneMap.get(req.idProducto) || 0) >= req.cantidad
                );
                if (!baseOk) break;

                let gruposOk = true;
                const gruposResueltos = [];
                for (const grupo of (promo.grupos || [])) {
                    if (grupo.esExcluyente) {
                        const ganador = grupo.productos.find(
                            req => (standaloneMap.get(req.idProducto) || 0) >= req.cantidad
                        );
                        if (!ganador) { gruposOk = false; break; }
                        gruposResueltos.push([ganador]);
                    } else {
                        const todosOk = grupo.productos.every(
                            req => (standaloneMap.get(req.idProducto) || 0) >= req.cantidad
                        );
                        if (!todosOk) { gruposOk = false; break; }
                        gruposResueltos.push([...grupo.productos]);
                    }
                }
                if (!gruposOk) break;

                const totalReqs = (promo.productosBase || []).length + gruposResueltos.reduce((a, g) => a + g.length, 0);
                if (totalReqs === 0) break;

                const promoItems = [];
                const instId = ++_promoInstCounter;

                const consumirReq = req => {
                    const idP = req.idProducto;
                    const cantReq = req.cantidad;
                    standaloneMap.set(idP, standaloneMap.get(idP) - cantReq);

                    let porDeducir = cantReq;
                    for (let i = detalleActual.length - 1; i >= 0; i--) {
                        const r = detalleActual[i];
                        if (!r.idPromocion && !r.esEnvase && r.idProducto === idP) {
                            if (r.cantidad <= porDeducir) {
                                porDeducir -= r.cantidad;
                                detalleActual.splice(i, 1);
                            } else {
                                r.cantidad -= porDeducir;
                                r.subtotal = r.cantidad * r.precioUnitario;
                                porDeducir = 0;
                            }
                            if (porDeducir <= 0) break;
                        }
                    }

                    const prod = CATALOGO.find(c => c.id === idP);
                    if (prod) {
                        promoItems.push({
                            idProducto: prod.id,
                            nombre: prod.nombre,
                            precioNormal: prod.precio,
                            cantidad: cantReq,
                            retornable: prod.retornable
                        });
                    }
                };

                (promo.productosBase || []).forEach(consumirReq);
                gruposResueltos.forEach(ganadores => ganadores.forEach(consumirReq));

                const sumaNormal = promoItems.reduce((s, it) => s + it.precioNormal * it.cantidad, 0);
                let restante = promo.precio;
                promoItems.forEach((it, idx) => {
                    let subtotal;
                    if (idx === promoItems.length - 1) {
                        subtotal = restante;
                    } else {
                        subtotal = sumaNormal > 0
                            ? Math.round((it.precioNormal * it.cantidad / sumaNormal) * promo.precio)
                            : it.precioNormal * it.cantidad;
                        restante -= subtotal;
                    }
                    const precioUnitario = it.cantidad > 0 ? Math.round(subtotal / it.cantidad) : 0;

                    detalleActual.push({
                        idProducto:     it.idProducto,
                        nombre:         it.nombre,
                        cantidad:       it.cantidad,
                        precioNormal:   it.precioNormal,
                        precioUnitario: precioUnitario,
                        subtotal:       subtotal,
                        idPromocion:    promo.id,
                        nombrePromocion:promo.nombre,
                        idOferta:       null,
                        tieneOferta:    false,
                        esEnvase:       false,
                        promoInstId:    instId
                    });

                    if (it.retornable) {
                        const ve = it.retornable.valorEnvase;
                        detalleActual.push({
                            idProducto:     it.idProducto,
                            nombre:         `Envase ${it.nombre}`,
                            cantidad:       it.cantidad,
                            precioNormal:   0,
                            precioUnitario: ve,
                            subtotal:       it.cantidad * ve,
                            idPromocion:    null,
                            nombrePromocion:null,
                            idOferta:       null,
                            tieneOferta:    false,
                            esEnvase:       true,
                            promoInstId:    instId
                        });
                    }
                });
            }
        }
    }

    /* ════════════════════════════════════════════════════
       DIÁLOGO ENVASE RETORNABLE
     ════════════════════════════════════════════════════ */
