.pend-last-update { font-size:.67rem; color:#c9b8a8; }
.pend-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:.55rem; padding:.65rem .85rem; }
.pend-card { border:1.5px solid #ede5df; border-radius:9px; padding:.5rem .6rem; cursor:pointer; transition:border-color .13s,background .13s,box-shadow .13s; display:flex; flex-direction:column; gap:.12rem; background:#faf7f5; min-width:0; }
.pend-card:hover { border-color:var(--color-primario); background:#fff; box-shadow:0 2px 8px rgba(231,111,46,.13); }
.pend-card.pend-card-nuevo { animation:pendNewCard .7s ease; }
@@keyframes pendNewCard { from{background:rgba(231,111,46,.18)} to{background:#faf7f5} }
.pend-card-num { font-size:.82rem; font-weight:800; color:var(--color-secundario); }
.pend-card:hover .pend-card-num { color:var(--color-primario); }
.pend-card-vendedor { font-size:.67rem; font-weight:600; color:#7a6050; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.pend-card-monto { font-size:.78rem; font-weight:700; color:var(--color-primario); margin-top:auto; padding-top:.18rem; }
.pend-card-meta { font-size:.62rem; color:#a89080; }
.pend-empty { text-align:center; padding:1.25rem 1rem; color:#b8a898; font-size:.82rem; }
