@using Infraestructura.Entities.BotiApp
@using System.Text.Json
@model BotiApp.Areas.Ventas.Controllers.FiadoClienteViewModel
@{
    ViewData["Title"] = "Fiado — " + Model.Cliente.Nombre;
    var urlRegistrarAbono = Url.Action("RegistrarAbonoAjax", "Fiado", new { area = "Ventas" })!;
    var metodosPagoJson = JsonSerializer.Serialize(Model.MetodosPago.Select(m => new
    {
        id     = m.IdMetodoPago,
        nombre = m.NombreMetodoPago
    }));
}

<style>
    .fc-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
    }
    .fc-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .85rem;
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 600;
        color: #6b7280;
        background: #f3f4f6;
        text-decoration: none;
        flex-shrink: 0;
        align-self: flex-start;
        margin-top: .3rem;
        transition: background .15s;
    }
    .fc-back-btn:hover { background: #e5e7eb; color: #374151; text-decoration: none; }
    .fc-title-block { flex: 1; min-width: 0; }
    .fc-title-block h1 { font-size: 1.35rem; font-weight: 700; color: var(--color-secundario); margin: 0 0 .2rem; }

    /* ── KPI row ── */
    .fc-kpi-row {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.75rem;
    }
    .fc-kpi-card {
        background: #fff;
        border-radius: 12px;
        padding: 1.1rem 1.3rem;
        display: flex;
        align-items: center;
        gap: .9rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        border-left: 4px solid var(--color-primario);
    }
    .fc-kpi-card.warning { border-left-color: var(--color-warning); }
    .fc-kpi-card.success { border-left-color: var(--color-success); }
    .fc-kpi-card.danger  { border-left-color: var(--color-danger); }
    .fc-kpi-icon {
        width: 40px; height: 40px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        background: rgba(231,111,46,.12);
    }
    .fc-kpi-icon.warning { background: rgba(252,191,73,.15); }
    .fc-kpi-icon.success { background: rgba(92,179,56,.12); }
    .fc-kpi-icon.danger  { background: rgba(255,55,55,.1); }
    .fc-kpi-icon svg { width: 20px; height: 20px; fill: var(--color-primario); }
    .fc-kpi-icon.warning svg { fill: var(--color-warning); }
    .fc-kpi-icon.success svg { fill: var(--color-success); }
    .fc-kpi-icon.danger  svg { fill: var(--color-danger); }
    .fc-kpi-body { display: flex; flex-direction: column; gap: .1rem; }
    .fc-kpi-value { font-size: 1.45rem; font-weight: 800; color: var(--color-secundario); line-height: 1.1; }
    .fc-kpi-label { font-size: .76rem; color: #6b7280; font-weight: 500; }

    /* ── 2-column layout ── */
    .fc-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 1.25rem;
        align-items: start;
    }
    @@media (max-width: 900px) {
        .fc-grid { grid-template-columns: 1fr; }
    }

    /* ── Cards ── */
    .fc-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }
    .fc-card:last-child { margin-bottom: 0; }
    .fc-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .9rem 1.3rem;
        border-bottom: 1px solid #f1ede8;
    }
    .fc-card-header h2 { font-size: .9rem; font-weight: 700; color: var(--color-secundario); margin: 0; }
    .fc-card-header span { font-size: .75rem; color: #9ca3af; }

    /* table */
    .fc-table-responsive { overflow-x: auto; }
    table.fc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .84rem;
    }
    .fc-table th {
        padding: .55rem .9rem;
        text-align: left;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #9ca3af;
        background: #faf7f4;
        border-bottom: 1px solid #f0ebe4;
        white-space: nowrap;
    }
    .fc-table td {
        padding: .65rem .9rem;
        border-bottom: 1px solid #f8f5f1;
        color: var(--color-secundario);
        vertical-align: middle;
    }
    .fc-table tr:last-child td { border-bottom: none; }
    .fc-table tr:hover td { background: #fdf9f5; }

    /* estado badges */
    .fc-badge {
        display: inline-block;
        padding: .18rem .6rem;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 700;
    }
    .fc-badge.pagada   { background: rgba(92,179,56,.15);  color: #16a34a; }
    .fc-badge.fiado    { background: rgba(252,191,73,.2);  color: #b45309; }
    .fc-badge.anulada  { background: rgba(255,55,55,.12);  color: #dc2626; }

    /* ── Abono form ── */
    .fc-abono-form { padding: 1.1rem 1.3rem; display: flex; flex-direction: column; gap: .75rem; }
    .fc-form-group { display: flex; flex-direction: column; gap: .3rem; }
    .fc-form-group label { font-size: .78rem; font-weight: 600; color: var(--color-secundario); }
    .fc-form-input {
        border: 1px solid #e5e0d8;
        border-radius: 8px;
        padding: .45rem .75rem;
        font-size: .85rem;
        color: var(--color-secundario);
        outline: none;
        transition: border-color .2s;
        width: 100%;
        box-sizing: border-box;
    }
    .fc-form-input:focus { border-color: var(--color-primario); }
    .fc-form-hint { font-size: .73rem; color: #9ca3af; }
    .btn-registrar-abono {
        width: 100%;
        padding: .6rem 1rem;
        background: var(--color-primario);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: .85rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity .15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
    }
    .btn-registrar-abono:hover { opacity: .9; }
    .btn-registrar-abono:disabled { opacity: .55; cursor: default; }

    /* ── Multi-método abono ── */
    .abono-metodo-lista { display: flex; flex-direction: column; gap: .45rem; }
    .abono-metodo-fila  { display: flex; align-items: center; gap: .4rem; }
    .abono-metodo-fila select { flex: 1; padding: .42rem .6rem; border: 1px solid #e5e0d8; border-radius: 7px;
        font-size: .82rem; color: var(--color-secundario); outline: none; }
    .abono-metodo-fila select:focus { border-color: var(--color-primario); }
    .abono-metodo-fila input  { width: 110px; padding: .42rem .6rem; border: 1px solid #e5e0d8; border-radius: 7px;
        font-size: .82rem; color: var(--color-secundario); outline: none; }
    .abono-metodo-fila input:focus  { border-color: var(--color-primario); }
    .btn-quitar-metodo-fi { width: 24px; height: 24px; border: none; border-radius: 5px;
        background: rgba(239,68,68,.12); color: #dc2626; cursor: pointer; font-size: .85rem;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .btn-quitar-metodo-fi:hover { background: rgba(239,68,68,.22); }
    .btn-add-metodo-fi { align-self: flex-start; padding: .35rem .75rem; background: var(--color-secundario);
        color: #fff; border: none; border-radius: 7px; font-size: .78rem; font-weight: 600; cursor: pointer; }
    .btn-add-metodo-fi:hover { background: var(--color-primario); }
    .abono-total-row { display: flex; justify-content: space-between; align-items: center;
        padding: .35rem .1rem; font-size: .82rem; color: var(--color-secundario); font-weight: 600; }

    /* abono history list */
    .fc-abono-list { padding: .5rem 0; }
    .fc-abono-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: .6rem 1.3rem;
        border-bottom: 1px solid #f8f5f1;
        gap: .75rem;
    }
    .fc-abono-item:last-child { border-bottom: none; }
    .fc-abono-fecha { font-size: .75rem; color: #9ca3af; }
    .fc-abono-monto { font-size: .9rem; font-weight: 700; color: var(--color-success); white-space: nowrap; }
    .fc-abono-obs   { font-size: .75rem; color: #6b7280; margin-top: .1rem; }

    .fc-empty { text-align: center; padding: 1.75rem 1rem; color: #9ca3af; font-size: .84rem; }

    /* filtros año/mes */
    .fc-filter-sel {
        border: 1px solid #e5e0d8;
        border-radius: 7px;
        padding: .25rem .55rem;
        font-size: .78rem;
        color: var(--color-secundario);
        background: #fff;
        outline: none;
        cursor: pointer;
        transition: border-color .2s;
    }
    .fc-filter-sel:focus { border-color: var(--color-primario); }

    /* toast (reutiliza el global de _Layout si existe, o lo definimos aquí) */
    .fc-toast {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: .5rem;
        pointer-events: none;
    }
    .fc-toast-item {
        padding: .65rem 1.1rem;
        border-radius: 9px;
        font-size: .84rem;
        font-weight: 600;
        color: #fff;
        box-shadow: 0 4px 14px rgba(0,0,0,.15);
        animation: fcToastIn .25s ease;
        pointer-events: auto;
    }
    .fc-toast-item.ok    { background: var(--color-success); }
    .fc-toast-item.error { background: var(--color-danger); }
    @@keyframes fcToastIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>

@* Toast container *@
<div class="fc-toast" id="fcToastContainer"></div>

@* ── Header ── *@
<div class="fc-header">
    <a class="fc-back-btn" href="@Url.Action("Index","Fiado",new{area="Ventas"})">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" style="fill:#6b7280">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z"/>
        </svg>
        Volver
    </a>
    <div class="fc-title-block">
        <h1>@Model.Cliente.Nombre</h1>
        <p>
            @if (!string.IsNullOrWhiteSpace(Model.Cliente.Telefono))
            {
                <span style="margin-right:.75rem">📞 @Model.Cliente.Telefono</span>
            }
            Registrado: @Model.Cliente.FechaRegistro.ToString("dd/MM/yyyy")
        </p>
    </div>
</div>

@* ── KPIs ── *@
<div class="fc-kpi-row">
    <div class="fc-kpi-card @(Model.DeudaTotal > 0 ? "warning" : "success")">
        <div class="fc-kpi-icon @(Model.DeudaTotal > 0 ? "warning" : "success")">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
            </svg>
        </div>
        <div class="fc-kpi-body">
            <span class="fc-kpi-value" id="kpi-deuda-total">$@Model.DeudaTotal.ToString("N0")</span>
            <span class="fc-kpi-label">Deuda en boletas</span>
        </div>
    </div>
    <div class="fc-kpi-card success">
        <div class="fc-kpi-icon success">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
            </svg>
        </div>
        <div class="fc-kpi-body">
            <span class="fc-kpi-value" id="kpi-saldo-favor">$@Model.Cliente.SaldoAFavor.ToString("N0")</span>
            <span class="fc-kpi-label">Saldo a favor</span>
        </div>
    </div>
    <div class="fc-kpi-card">
        <div class="fc-kpi-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6zm0 4h8v2H6zm10 0h2v2h-2zm-6-4h8v2h-8z"/>
            </svg>
        </div>
        <div class="fc-kpi-body">
            <span class="fc-kpi-value">@Model.BoletasHistorial.Count(b => b.IdEstadoBoleta == 4)</span>
            <span class="fc-kpi-label">Boletas fiadas activas</span>
        </div>
    </div>
</div>

@* ── Main grid ── *@
<div class="fc-grid">

    @* Left column: boletas *@
    <div>
        <div class="fc-card">
            <div class="fc-card-header">
                <h2>Historial de boletas</h2>
                <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
                    <select class="fc-filter-sel" id="filtroAnio" onchange="filtrarBoletas()">
                        <option value="">Todos los años</option>
                        @foreach (var anio in Model.BoletasHistorial
                            .Where(b => b.FechaEmision.HasValue)
                            .Select(b => b.FechaEmision!.Value.Year)
                            .Distinct().OrderByDescending(y => y))
                        {
                            <option value="@anio">@anio</option>
                        }
                    </select>
                    <select class="fc-filter-sel" id="filtroMes" onchange="filtrarBoletas()">
                        <option value="">Todos los meses</option>
                        @{ var meses = new[]{"","Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"}; }
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@meses[m]</option>
                        }
                    </select>
                    <span id="fcBoletaCount" style="font-size:.75rem;color:#9ca3af;white-space:nowrap">
                        @Model.BoletasHistorial.Count boleta(s)
                    </span>
                </div>
            </div>
            @if (!Model.BoletasHistorial.Any())
            {
                <div class="fc-empty">Sin boletas registradas.</div>
            }
            else
            {
                <div class="fc-table-responsive">
                    <table class="fc-table" id="fcBoletasTabla">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th style="text-align:right">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.BoletasHistorial)
                            {
                                var estadoClass = b.IdEstadoBoleta switch { 3 => "pagada", 4 => "fiado", 2 => "anulada", _ => "fiado" };
                                var estadoLabel = b.IdEstadoBoleta switch { 3 => "Pagada", 4 => "Fiado", 2 => "Anulada", _ => "—" };
                                var anio = b.FechaEmision?.Year.ToString() ?? "";
                                var mes  = b.FechaEmision?.Month.ToString() ?? "";
                                <tr data-anio="@anio" data-mes="@mes">
                                    <td style="color:#9ca3af">@b.IdBoleta</td>
                                    <td style="white-space:nowrap">@(b.FechaEmision?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                    <td><span class="fc-badge @estadoClass">@estadoLabel</span></td>
                                    <td style="text-align:right;font-weight:600">$@b.MontoTotal.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="fc-empty" id="fcBoletasVacio" style="display:none">Sin boletas para el período seleccionado.</div>
            }
        </div>

        @* Historial abonos *@
        <div class="fc-card">
            <div class="fc-card-header">
                <h2>Historial de abonos</h2>
                <span id="fcAbonoCount">@Model.Abonos.Count abono(s)</span>
            </div>
            <div id="fcAbonoListContainer">
                @if (!Model.Abonos.Any())
                {
                    <div class="fc-empty" id="fcAbonoEmpty">Sin abonos registrados.</div>
                }
                else
                {
                    <div class="fc-abono-list" id="fcAbonoList">
                        @foreach (var a in Model.Abonos.OrderByDescending(a => a.Fecha))
                        {
                            <div class="fc-abono-item">
                                <div>
                                    <div class="fc-abono-fecha">@a.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="fc-abono-obs" style="color:#6b7280">@(a.IdMetodoPagoNavigation?.NombreMetodoPago ?? "—")</div>
                                    @if (!string.IsNullOrWhiteSpace(a.Observaciones))
                                    {
                                        <div class="fc-abono-obs">@a.Observaciones</div>
                                    }
                                </div>
                                <span class="fc-abono-monto">+$@a.Monto.ToString("N0")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* Right column: registrar abono *@
    <div>
        <div class="fc-card">
            <div class="fc-card-header">
                <h2>Registrar abono</h2>
            </div>
            <div class="fc-abono-form">
                @Html.AntiForgeryToken()

                @* Lista de filas de métodos *@
                <div class="fc-form-group">
                    <label>Métodos de pago</label>
                    <div class="abono-metodo-lista" id="abonoMetodoLista"></div>
                    <button type="button" class="btn-add-metodo-fi" onclick="agregarFilaMetodo()">+ Agregar método</button>
                </div>

                @* Total calculado *@
                <div class="abono-total-row">
                    <span>Total abono:</span>
                    <span id="abonoTotalDisplay">$0</span>
                </div>

                <div class="fc-form-group">
                    <label for="abonoObs">Observaciones <span style="color:#9ca3af;font-weight:400">(opcional)</span></label>
                    <textarea class="fc-form-input" id="abonoObs" rows="2"
                              placeholder="Notas adicionales…"></textarea>
                </div>
                <button class="btn-registrar-abono" id="btnRegistrarAbono" onclick="registrarAbono()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" style="fill:#fff">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                    Registrar abono
                </button>
            </div>
        </div>

        @* Info cliente *@
        <div class="fc-card">
            <div class="fc-card-header">
                <h2>Datos del cliente</h2>
            </div>
            <div style="padding:.9rem 1.3rem;font-size:.84rem;color:var(--color-secundario);line-height:1.8">
                <div><strong>Nombre:</strong> @Model.Cliente.Nombre</div>
                @if (!string.IsNullOrWhiteSpace(Model.Cliente.Telefono))
                {
                    <div><strong>Teléfono:</strong> @Model.Cliente.Telefono</div>
                }
                <div style="margin-top:.5rem;color:#9ca3af;font-size:.75rem">
                    Registrado el @Model.Cliente.FechaRegistro.ToString("dd/MM/yyyy")
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var URL_ABONO    = '@Html.Raw(urlRegistrarAbono)';
    var ID_CLIENTE   = @Model.Cliente.IdCliente;
    var METODOS_PAGO = @Html.Raw(metodosPagoJson);

    // ── Filtro año/mes boletas ────────────────────────────────────────────────
    window.filtrarBoletas = function () {
        var anio = document.getElementById('filtroAnio')?.value ?? '';
        var mes  = document.getElementById('filtroMes')?.value  ?? '';
        var filas = document.querySelectorAll('#fcBoletasTabla tbody tr');
        var visibles = 0;
        filas.forEach(function (tr) {
            var match = (!anio || tr.dataset.anio === anio) &&
                        (!mes  || tr.dataset.mes  === mes);
            tr.style.display = match ? '' : 'none';
            if (match) visibles++;
        });
        var vacio = document.getElementById('fcBoletasVacio');
        if (vacio) vacio.style.display = visibles === 0 ? '' : 'none';
        var count = document.getElementById('fcBoletaCount');
        if (count) count.textContent = visibles + ' boleta(s)';
    };

    function _toast(msg, tipo) {
        var cont = document.getElementById('fcToastContainer');
        if (!cont) return;
        var el = document.createElement('div');
        el.className = 'fc-toast-item ' + (tipo === 'ok' ? 'ok' : 'error');
        el.textContent = msg;
        cont.appendChild(el);
        setTimeout(function () { el.remove(); }, 3500);
    }

    function _fmtPeso(n) { return '$' + Number(n).toLocaleString('es-CL'); }

    function _setVal(id, val) {
        var el = document.getElementById(id);
        if (el) el.textContent = val;
    }

    // ── Multi-método: lista de filas ──────────────────────────────────────────
    function _buildSelect(selectedId) {
        var opts = METODOS_PAGO.map(function(m) {
            var sel = m.id === selectedId ? ' selected' : '';
            return '<option value="' + m.id + '"' + sel + '>' + m.nombre + '</option>';
        }).join('');
        return '<select onchange="_recalcTotal()">' + opts + '</select>';
    }

    window.agregarFilaMetodo = function () {
        var lista = document.getElementById('abonoMetodoLista');
        if (!lista) return;
        var firstId = METODOS_PAGO.length ? METODOS_PAGO[0].id : 0;
        var fila = document.createElement('div');
        fila.className = 'abono-metodo-fila';
        fila.innerHTML =
            _buildSelect(firstId) +
            '<input type="number" placeholder="Monto $" min="1" step="1" oninput="_recalcTotal()" />' +
            '<button type="button" class="btn-quitar-metodo-fi" onclick="_quitarFila(this)" title="Quitar">×</button>';
        lista.appendChild(fila);
        _recalcTotal();
    };

    window._quitarFila = function (btn) {
        var fila = btn.closest('.abono-metodo-fila');
        if (fila) { fila.remove(); _recalcTotal(); }
    };

    window._recalcTotal = function () {
        var total = _calcTotal();
        var el = document.getElementById('abonoTotalDisplay');
        if (el) el.textContent = _fmtPeso(total);
    };

    function _calcTotal() {
        var lista = document.getElementById('abonoMetodoLista');
        if (!lista) return 0;
        var total = 0;
        lista.querySelectorAll('.abono-metodo-fila input').forEach(function(inp) {
            total += parseInt(inp.value) || 0;
        });
        return total;
    }

    function _recogerMetodos() {
        var lista = document.getElementById('abonoMetodoLista');
        if (!lista) return [];
        var result = [];
        lista.querySelectorAll('.abono-metodo-fila').forEach(function(fila) {
            var sel   = fila.querySelector('select');
            var input = fila.querySelector('input');
            var id    = parseInt(sel?.value ?? '0');
            var monto = parseInt(input?.value ?? '0');
            if (id > 0 && monto > 0) result.push({ idMetodoPago: id, monto: monto });
        });
        return result;
    }

    // ── Prepend abono al historial ────────────────────────────────────────────
    function _prependAbono(abono) {
        var empty = document.getElementById('fcAbonoEmpty');
        if (empty) empty.style.display = 'none';

        var list = document.getElementById('fcAbonoList');
        if (!list) {
            var cont = document.getElementById('fcAbonoListContainer');
            list = document.createElement('div');
            list.id        = 'fcAbonoList';
            list.className = 'fc-abono-list';
            if (cont) cont.appendChild(list);
        }
        var metodoHtml = abono.metodoPago ? '<div class="fc-abono-obs" style="color:#6b7280">' + abono.metodoPago + '</div>' : '';
        var obs = abono.observaciones ? '<div class="fc-abono-obs">' + abono.observaciones + '</div>' : '';
        var item = document.createElement('div');
        item.className = 'fc-abono-item';
        item.innerHTML =
            '<div><div class="fc-abono-fecha">' + abono.fecha + '</div>' + metodoHtml + obs + '</div>' +
            '<span class="fc-abono-monto">+' + _fmtPeso(abono.monto) + '</span>';
        list.insertBefore(item, list.firstChild);
    }

    // ── Registrar abono ───────────────────────────────────────────────────────
    window.registrarAbono = async function () {
        var metodos = _recogerMetodos();
        var obs     = (document.getElementById('abonoObs')?.value ?? '').trim();

        if (!metodos.length) { _toast('Agrega al menos un método de pago con monto.', 'error'); return; }

        var btn = document.getElementById('btnRegistrarAbono');
        btn.disabled = true;
        var oldHtml  = btn.innerHTML;
        btn.innerHTML = '<span style="width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;display:inline-block;animation:fcToastIn .7s linear infinite"></span> Procesando…';

        var res;
        try {
            var resp = await fetch(URL_ABONO, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                credentials: 'same-origin',
                body: JSON.stringify({ idCliente: ID_CLIENTE, metodos: metodos, observaciones: obs || null })
            });
            res = await resp.json();
        } catch {
            res = { ok: false, mensaje: 'Error de red.' };
        }

        btn.disabled  = false;
        btn.innerHTML = oldHtml;

        if (!res.ok) { _toast(res.mensaje, 'error'); return; }
        _toast(res.mensaje, 'ok');

        // Actualizar KPIs
        _setVal('kpi-deuda-total', _fmtPeso(res.deudaTotal));
        _setVal('kpi-saldo-favor', _fmtPeso(res.saldoAFavor));

        // Agregar cada abono al historial (los devuelve el servidor con nombre de método)
        if (Array.isArray(res.abonos)) {
            res.abonos.forEach(function(a) { _prependAbono(a); });

            // Actualizar contador
            var countEl = document.getElementById('fcAbonoCount');
            if (countEl) {
                var cur = parseInt(countEl.textContent) || 0;
                countEl.textContent = (cur + res.abonos.length) + ' abono(s)';
            }
        }

        // Limpiar form: quitar todas las filas, limpiar obs, agregar fila inicial
        document.getElementById('abonoMetodoLista').innerHTML = '';
        document.getElementById('abonoObs').value = '';
        agregarFilaMetodo();
    };

    // ── Inicializar con una fila por defecto ──────────────────────────────────
    agregarFilaMetodo();
})();
</script>
}
