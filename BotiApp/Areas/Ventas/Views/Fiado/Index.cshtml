@* @using BotiApp.Helpers *@
@using Infraestructura.Entities.BotiApp
@model BotiApp.Areas.Ventas.Controllers.FiadoIndexViewModel
@{
    ViewData["Title"] = "Fiados";
}

<style>
    /* ── Page header ── */
    .fiado-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1.75rem;
    }
    .fiado-header h1 {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--color-secundario);
        margin: 0 0 .2rem;
    }
    .fiado-header p { color: #6b7280; font-size: .88rem; margin: 0; }

    /* ── KPI row ── */
    .fiado-kpi-row {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 1rem;
        margin-bottom: 1.75rem;
    }
    .fiado-kpi-card {
        background: #fff;
        border-radius: 12px;
        padding: 1.2rem 1.4rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        border-left: 4px solid var(--color-primario);
    }
    .fiado-kpi-card.warning { border-left-color: var(--color-warning); }
    .fiado-kpi-icon {
        width: 44px; height: 44px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        background: rgba(231,111,46,.12);
    }
    .fiado-kpi-icon.warning { background: rgba(252,191,73,.15); }
    .fiado-kpi-icon svg { width: 22px; height: 22px; fill: var(--color-primario); }
    .fiado-kpi-icon.warning svg { fill: var(--color-warning); }
    .fiado-kpi-body { display: flex; flex-direction: column; gap: .1rem; }
    .fiado-kpi-value { font-size: 1.55rem; font-weight: 800; color: var(--color-secundario); line-height: 1.1; }
    .fiado-kpi-label { font-size: .78rem; color: #6b7280; font-weight: 500; }

    /* ── Table card ── */
    .fiado-table-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        overflow: hidden;
    }
    .fiado-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.4rem;
        border-bottom: 1px solid #f1ede8;
        flex-wrap: wrap;
        gap: .5rem;
    }
    .fiado-table-header h2 { font-size: .95rem; font-weight: 700; color: var(--color-secundario); margin: 0; }

    /* search box */
    .fiado-search-wrap {
        position: relative;
        flex-shrink: 0;
    }
    .fiado-search-wrap svg {
        position: absolute;
        left: .65rem;
        top: 50%;
        transform: translateY(-50%);
        width: 15px; height: 15px;
        fill: #9ca3af;
        pointer-events: none;
    }
    .fiado-search-input {
        border: 1px solid #e5e0d8;
        border-radius: 8px;
        padding: .35rem .75rem .35rem 2rem;
        font-size: .83rem;
        color: var(--color-secundario);
        outline: none;
        transition: border-color .2s;
        width: 220px;
    }
    .fiado-search-input:focus { border-color: var(--color-primario); }

    /* table */
    .fiado-table-responsive { overflow-x: auto; }
    table.fiado-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }
    .fiado-table th {
        padding: .6rem 1rem;
        text-align: left;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #9ca3af;
        background: #faf7f4;
        border-bottom: 1px solid #f0ebe4;
        white-space: nowrap;
    }
    .fiado-table td {
        padding: .7rem 1rem;
        border-bottom: 1px solid #f8f5f1;
        color: var(--color-secundario);
        vertical-align: middle;
    }
    .fiado-table tr:last-child td { border-bottom: none; }
    .fiado-table tr:hover td { background: #fdf9f5; }

    /* deuda badge */
    .badge-deuda {
        display: inline-block;
        padding: .2rem .65rem;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
    }
    .badge-deuda.alta  { background: rgba(255,55,55,.12);  color: #dc2626; }
    .badge-deuda.media { background: rgba(252,191,73,.2);  color: #b45309; }
    .badge-deuda.baja  { background: rgba(92,179,56,.15);  color: #16a34a; }
    .badge-deuda.cero  { background: #f3f4f6; color: #9ca3af; }

    /* link button */
    .btn-ver-cliente {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .3rem .7rem;
        border-radius: 7px;
        font-size: .78rem;
        font-weight: 600;
        color: #4f46e5;
        background: rgba(99,102,241,.1);
        border: none;
        text-decoration: none;
        transition: background .15s;
        white-space: nowrap;
    }
    .btn-ver-cliente:hover { background: rgba(99,102,241,.18); color: #4f46e5; text-decoration: none; }

    .fiado-empty { text-align: center; padding: 2.5rem 1rem; color: #9ca3af; font-size: .88rem; }

    /* estado del cliente */
    .badge-estado {
        display: inline-block;
        padding: .15rem .55rem;
        border-radius: 20px;
        font-size: .68rem;
        font-weight: 700;
        margin-left: .4rem;
        background: #f1f0ee;
        color: #78716c;
        vertical-align: middle;
    }
    .fiado-table tr.inactivo td { background: #fbfaf9; }
    .fiado-table tr.inactivo td:first-child strong { color: #a8a29e; }
    .fiado-toggle {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        font-size: .8rem;
        color: #6b7280;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }
    .fiado-toggle input { cursor: pointer; }
</style>

<div class="fiado-header">
    <div>
        <h1>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                 style="fill:var(--color-primario);vertical-align:sub;margin-right:.4rem">
                <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v10zm-7-7h-2v2h2v-2zm-4 0H7v2h2v-2zm8 0h-2v2h2v-2z"/>
            </svg>
            Fiados
        </h1>
        <p>Clientes con boletas fiadas — deuda y abonos</p>
    </div>
</div>

@* ── KPIs ── *@
<div class="fiado-kpi-row">
    <div class="fiado-kpi-card warning">
        <div class="fiado-kpi-icon warning">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
            </svg>
        </div>
        <div class="fiado-kpi-body">
            <span class="fiado-kpi-value">$@Model.TotalGlobalAdeudado.ToString("N0")</span>
            <span class="fiado-kpi-label">Total adeudado global</span>
        </div>
    </div>
    <div class="fiado-kpi-card">
        <div class="fiado-kpi-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
        </div>
        <div class="fiado-kpi-body">
            <span class="fiado-kpi-value">@Model.CantClientesConDeuda</span>
            <span class="fiado-kpi-label">Clientes con deuda activa</span>
        </div>
    </div>
    <div class="fiado-kpi-card">
        <div class="fiado-kpi-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/>
            </svg>
        </div>
        <div class="fiado-kpi-body">
            <span class="fiado-kpi-value">@Model.Clientes.Count(c => c.Estado)</span>
            <span class="fiado-kpi-label">
                Clientes activos@(Model.Clientes.Any(c => !c.Estado) ? $" · {Model.Clientes.Count(c => !c.Estado)} desactivado(s)" : "")
            </span>
        </div>
    </div>
</div>

@* ── Table ── *@
<div class="fiado-table-card">
    <div class="fiado-table-header">
        <h2>Clientes fiados</h2>
        <div style="display:flex;align-items:center;gap:.9rem;flex-wrap:wrap">
            @{ var cantInactivos = Model.Clientes.Count(c => !c.Estado); }
            @if (cantInactivos > 0)
            {
                <label class="fiado-toggle">
                    <input type="checkbox" id="fiadoVerInactivos" onchange="filtrarClientes()" />
                    Ver desactivados (@cantInactivos)
                </label>
            }
            <div class="fiado-search-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <input class="fiado-search-input" type="text" id="fiadoSearchInput"
                       placeholder="Buscar cliente…" oninput="filtrarClientes()" />
            </div>
        </div>
    </div>

    @if (!Model.Clientes.Any())
    {
        <div class="fiado-empty">No hay clientes registrados aún.</div>
    }
    else
    {
        <div class="fiado-table-responsive">
            <table class="fiado-table" id="fiadoTabla">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th style="text-align:right">Saldo a favor</th>
                        <th style="text-align:right">Deuda boletas</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Clientes.OrderByDescending(c => c.VenBoletas.Where(b => b.IdEstadoBoleta == 4).Sum(b => b.MontoTotal) - c.SaldoAFavor))
                    {
                        var deudaBoletas = c.VenBoletas.Where(b => b.IdEstadoBoleta == 4).Sum(b => b.MontoTotal);
                        var balance      = deudaBoletas - c.SaldoAFavor;
                        var badgeClass   = balance > 50000 ? "alta" : balance > 10000 ? "media" : balance > 0 ? "baja" : "cero";
                        <tr data-nombre="@c.Nombre.ToLower()" data-activo="@(c.Estado ? "1" : "0")"
                            class="@(c.Estado ? "" : "inactivo")">
                            <td>
                                <strong>@c.Nombre</strong>
                                @if (!c.Estado)
                                {
                                    <span class="badge-estado">Desactivado</span>
                                }
                            </td>
                            <td style="color:#6b7280">@(c.Telefono ?? "—")</td>
                            <td style="text-align:right;color:#16a34a;font-weight:600">
                                @(c.SaldoAFavor > 0 ? "$" + c.SaldoAFavor.ToString("N0") : "—")
                            </td>
                            <td style="text-align:right">
                                <span class="badge-deuda @badgeClass">
                                    @(balance > 0 ? "$" + balance.ToString("N0") : "Sin deuda")
                                </span>
                            </td>
                            <td style="text-align:right;white-space:nowrap">
                                <a class="btn-ver-cliente" href="@Url.Action("Cliente","Fiado",new{area="Ventas",id=c.IdCliente})">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" style="fill:#4f46e5">
                                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                    </svg>
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="fiado-empty" id="fiadoNoResults" style="display:none">Sin resultados para la búsqueda.</div>
    }
</div>

@section Scripts {
<script>
(function () {
    function filtrarClientes() {
        var q = (document.getElementById('fiadoSearchInput')?.value ?? '').toLowerCase().trim();
        // Los desactivados quedan ocultos salvo que se pidan explícitamente
        var verInactivos = document.getElementById('fiadoVerInactivos')?.checked ?? false;
        var filas = document.querySelectorAll('#fiadoTabla tbody tr');
        var visibles = 0;
        filas.forEach(function (tr) {
            var nombre = tr.dataset.nombre ?? '';
            var activo = tr.dataset.activo !== '0';
            var match  = (!q || nombre.includes(q)) && (activo || verInactivos);
            tr.style.display = match ? '' : 'none';
            if (match) visibles++;
        });
        var noRes = document.getElementById('fiadoNoResults');
        if (noRes) noRes.style.display = visibles === 0 ? '' : 'none';
    }
    window.filtrarClientes = filtrarClientes;
    filtrarClientes();   // oculta los desactivados en la carga inicial
})();
</script>
}
