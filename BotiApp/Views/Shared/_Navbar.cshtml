@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var area       = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    bool IsActive(string ctrl, string act = "Index", string ar = "")
        => string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, act, StringComparison.OrdinalIgnoreCase)
        && (string.IsNullOrEmpty(ar) || string.Equals(area, ar, StringComparison.OrdinalIgnoreCase));

    var nombreCompleto = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "Usuario";
    // El usuario puede tener rol combinado (ej. "Cajero/Vendedor"): hay una claim
    // "TipoUsuario" por cada rol individual, por eso se chequea con HasClaim.
    var tipoUsuario    = User.FindFirst("TipoUsuarioLabel")?.Value ?? User.FindFirst("TipoUsuario")?.Value ?? "";
    bool esVendedor    = User.HasClaim("TipoUsuario", "Vendedor");
    bool esCajero      = User.HasClaim("TipoUsuario", "Cajero");
    bool esAdmin       = User.HasClaim("TipoUsuario", "Administrador");

    // Solo el administrador en Generar/Caja despliega el sidebar desde el navbar.
    bool mostrarMenuLateral = ViewData["MostrarMenuLateral"] as bool? ?? false;
}

<!-- NAVBAR SUPERIOR -->
<header class="navbar-vendedor">
    <!-- Izquierda: Navegación -->
    <div class="navbar-vendedor-left">
        @if (mostrarMenuLateral)
        {
            <button type="button" class="btn-navbar-menu" onclick="toggleSidebar()"
                    title="Mostrar / ocultar menú" aria-label="Mostrar u ocultar menú">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                </svg>
            </button>
        }
        <nav class="navbar-vendedor-nav">
            @if (esVendedor || esAdmin)
            {
                <a class="nav-vendedor-item @(IsActive("Ventas", "Generar") ? "active" : "")" asp-area="Ventas" asp-controller="Ventas" asp-action="Generar">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z" /></svg>
                    Generar Venta
                </a>
            }
            @if (esCajero || esAdmin)
            {
                <a class="nav-vendedor-item @(IsActive("Ventas", "Caja") ? "active" : "")" asp-area="Ventas" asp-controller="Ventas" asp-action="Caja">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
                    Caja
                </a>
                <a class="nav-vendedor-item @(IsActive("Fiado", "Index") ? "active" : "")" asp-area="Ventas" asp-controller="Fiado" asp-action="Index">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                    Fiados
                </a>
            }
            <a class="nav-vendedor-item @(IsActive("Ventas", "Historial") ? "active" : "")" asp-area="Ventas" asp-controller="Ventas" asp-action="Historial">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" /></svg>
                @(esCajero ? "Historial Cobros" : "Historial Ventas")
            </a>
        </nav>
    </div>

    <!-- Centro: Cuatro Ases y Reloj en tiempo real abajo -->
    <div class="navbar-vendedor-center">
        <span class="vendedor-brand-title">Cuatro Ases</span>
        <div class="vendedor-clock-sub">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z" /></svg>
            <span id="navbar-time">--:--:--</span>
        </div>
    </div>

    <!-- Derecha: Usuario y Cerrar Sesión (el cierre de sesión del administrador
         vive en el sidebar, accesible desde el botón de menú) -->
    <div class="navbar-vendedor-right">
        <div class="navbar-vendedor-user">
            <div class="user-avatar">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
                </svg>
            </div>
            <div class="user-info">
                <span class="user-name">@nombreCompleto</span>
                <span class="user-role">@(string.IsNullOrEmpty(tipoUsuario) ? "Usuario" : tipoUsuario)</span>
            </div>
        </div>

        @if (!esAdmin)
        {
            <a class="btn-vendedor-logout" asp-area="" asp-controller="Login" asp-action="Logout">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" /></svg>
                Cerrar sesión
            </a>
        }
    </div>
</header>
