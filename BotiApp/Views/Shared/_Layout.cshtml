                Cerrar sesión
            </a>
        </div>

    </aside>
    }

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-wrapper">
        <main class="page-content" role="main">
            @RenderBody()
        </main>
        <footer class="page-footer">
            &copy; @DateTime.Now.Year BotiApp — Botillería Cuatro Ases
        </footer>
    </div>

    @if (!useNavbar)
    {
        <!-- Botón hamburguesa flotante (solo móvil) -->
        <button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Abrir menú">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
            </svg>
        </button>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <div id="page-scripts-zone" hidden>
        @await RenderSectionAsync("Scripts", required: false)
    </div>

    <script>
            function updateClock() {
                const now = new Date();
                const h = String(now.getHours()).padStart(2, '0');
                const m = String(now.getMinutes()).padStart(2, '0');
                const s = String(now.getSeconds()).padStart(2, '0');
                const el = document.getElementById('sidebar-time');
                if (el) el.textContent = `${h}:${m}:${s}`;
                const elNav = document.getElementById('navbar-time');
                if (elNav) elNav.textContent = `${h}:${m}:${s}`;
            }
            updateClock();
            setInterval(updateClock, 1000);

            function toggleSidebar(forzarCerrar) {
                const sidebar = document.getElementById('sidebar');
                if (!sidebar) return;
                const overlay = document.getElementById('sidebarOverlay');
                const abrir = forzarCerrar === true ? false : !sidebar.classList.contains('open');
                sidebar.classList.toggle('open', abrir);
                overlay?.classList.toggle('open', abrir);
            }

            // Cerrar el menú lateral desplegable con Escape
            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') toggleSidebar(true);
            });

            function toggleSubmenu(parentEl) {
                const submenu = parentEl.nextElementSibling;
                const isOpen = parentEl.classList.contains('open');
                parentEl.classList.toggle('open', !isOpen);
                submenu.classList.toggle('open', !isOpen);
            }
    </script>

</body>

</html>
