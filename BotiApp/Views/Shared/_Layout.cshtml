<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BotiApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/colores.css" />
    <link rel="stylesheet" href="~/css/ui-system.css" />
    <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                display: flex;
                min-height: 100vh;
                font-family: var(--font-body);
                background-color: var(--surface-soft);
                color: var(--color-secundario);
            }

            /* ── SIDEBAR ── */
            .sidebar {
                width: 260px;
                height: 100vh;
                background-color: var(--color-secundario);
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                position: sticky;
                top: 0;
                /* SIN overflow-y: el scroll solo está en .sidebar-nav */
            }

            /* ── ZONA 1: Marca (fija arriba) ── */
            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 1.25rem 1.25rem 1rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.07);
                flex-shrink: 0;
            }

            .sidebar-brand .brand-icon {
                width: 38px;
                height: 38px;
                background-color: var(--color-primario);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .sidebar-brand .brand-icon svg {
                width: 21px;
                height: 21px;
                fill: var(--blanco);
            }

            .sidebar-brand span {
                color: var(--blanco);
                font-size: 0.9rem;
                font-weight: 700;
                line-height: 1.2;
                letter-spacing: 0.3px;
                font-family: var(--font-heading);
            }

            /* ── ZONA 2: Usuario (fijo bajo la marca) ── */
            .sidebar-user {
                display: flex;
                align-items: center;
                gap: 0.65rem;
                padding: 0.9rem 1.25rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.07);
                flex-shrink: 0;
                background-color: rgba(255, 255, 255, 0.03);
            }

            .sidebar-user .user-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background-color: var(--color-primario);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .sidebar-user .user-avatar svg {
                width: 20px;
                height: 20px;
                fill: var(--blanco);
            }

            .sidebar-user-info {
                display: flex;
                flex-direction: column;
                gap: 0.1rem;
                overflow: hidden;
            }

            .sidebar-user-info .user-name {
                color: var(--blanco);
                font-size: 0.82rem;
                font-weight: 700;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .sidebar-user-info .user-role {
                color: var(--color-primario);
                font-size: 0.72rem;
                font-weight: 500;
                opacity: 0.85;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* ── ZONA 3: Nav (scrolleable) ── */
            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
            }

            .sidebar-nav::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-nav::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar-nav::-webkit-scrollbar-thumb {
                background-color: rgba(255, 255, 255, 0.12);
                border-radius: 4px;
            }

            /* Categorías */
            .nav-category {
                padding: 1.1rem 1.25rem 0.35rem;
                font-size: 0.7rem;
                font-weight: 700;
                letter-spacing: 1.2px;
                text-transform: uppercase;
                color: var(--color-primario);
                opacity: 0.8;
            }

            .nav-item {
                list-style: none;
            }

            .nav-link {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.65rem 1.25rem;
                color: rgba(255, 255, 255, 0.65);
                text-decoration: none;
                font-size: 0.9rem;
                font-weight: 500;
                border-left: 3px solid transparent;
                transition: background-color 0.2s, color 0.2s, border-color 0.2s;
                border-radius: 0 6px 6px 0;
                margin: 0.1rem 0.5rem 0.1rem 0;
            }

            .nav-link svg {
                width: 18px;
                height: 18px;
                fill: currentColor;
                flex-shrink: 0;
                opacity: 0.8;
            }

            .nav-link:hover {
                background-color: rgba(231, 111, 46, 0.12);
                color: var(--blanco);
                border-left-color: var(--color-primario);
            }

            .nav-link.active {
                background-color: rgba(231, 111, 46, 0.18);
                color: var(--color-primario);
                border-left-color: var(--color-primario);
                font-weight: 700;
            }

            .nav-link.active svg {
                opacity: 1;
            }

            .nav-divider {
                height: 1px;
                background-color: rgba(255, 255, 255, 0.07);
                margin: 0.5rem 1.25rem;
            }

            /* ── SUBMENU ── */
            .nav-parent {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.65rem 1.25rem;
                color: rgba(255, 255, 255, 0.65);
                font-size: 0.9rem;
                font-weight: 500;
                border-left: 3px solid transparent;
                border-radius: 0 6px 6px 0;
                margin: 0.1rem 0.5rem 0.1rem 0;
                cursor: pointer;
                user-select: none;
                transition: background-color 0.2s, color 0.2s, border-color 0.2s;
                list-style: none;
            }

            .nav-parent svg.icon-main {
                width: 18px;
                height: 18px;
                fill: currentColor;
                flex-shrink: 0;
                opacity: 0.8;
            }

            .nav-parent:hover {
                background-color: rgba(231, 111, 46, 0.12);
                color: var(--blanco);
                border-left-color: var(--color-primario);
            }

            .nav-parent.open,
            .nav-parent.has-active {
                color: var(--color-primario);
                border-left-color: var(--color-primario);
            }

            .nav-parent-label {
                flex: 1;
            }

            .nav-chevron {
                width: 14px;
                height: 14px;
                fill: currentColor;
                flex-shrink: 0;
                opacity: 0.6;
                transition: transform 0.25s ease;
                margin-left: auto;
            }

            .nav-parent.open .nav-chevron {
                transform: rotate(180deg);
                opacity: 1;
            }

            .nav-submenu {
                list-style: none;
                padding: 0;
                margin: 0;
                overflow: hidden;
                max-height: 0;
                transition: max-height 0.3s ease;
            }

            .nav-submenu.open {
                max-height: 300px;
            }

            .nav-sublink {
                display: flex;
                align-items: center;
                gap: 0.65rem;
                padding: 0.55rem 1.25rem 0.55rem 2.9rem;
                color: rgba(255, 255, 255, 0.5);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 400;
                border-left: 3px solid transparent;
                border-radius: 0 6px 6px 0;
                margin: 0.05rem 0.5rem 0.05rem 0;
                transition: background-color 0.2s, color 0.2s, border-color 0.2s;
            }

            .nav-sublink svg {
                width: 15px;
                height: 15px;
                fill: currentColor;
                flex-shrink: 0;
                opacity: 0.7;
            }

            .nav-sublink:hover {
                background-color: rgba(231, 111, 46, 0.1);
                color: var(--blanco);
                border-left-color: rgba(231, 111, 46, 0.5);
            }

            .nav-sublink.active {
                background-color: rgba(231, 111, 46, 0.15);
                color: var(--color-primario);
                border-left-color: var(--color-primario);
                font-weight: 600;
            }

            .nav-sublink.active svg {
                opacity: 1;
            }

            /* ── ZONA 4: Footer (fijo abajo) ── */
            .sidebar-footer {
                flex-shrink: 0;
                padding: 0.9rem 1.25rem;
                border-top: 1px solid rgba(255, 255, 255, 0.07);
                display: flex;
                flex-direction: column;
                gap: 0.7rem;
                background-color: var(--color-secundario);
            }

            .sidebar-clock {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                color: rgba(255, 255, 255, 0.4);
                font-size: 0.78rem;
            }

            .sidebar-clock svg {
                width: 14px;
                height: 14px;
                fill: var(--color-primario);
                flex-shrink: 0;
                opacity: 0.8;
            }

            .sidebar-clock #sidebar-time {
                font-variant-numeric: tabular-nums;
                letter-spacing: 0.5px;
            }

            .btn-logout {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                width: 100%;
                padding: 0.6rem 1rem;
                background-color: transparent;
                border: 1.5px solid rgba(255, 255, 255, 0.15);
                border-radius: 8px;
                color: rgba(255, 255, 255, 0.55);
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
                transition: background-color 0.2s, border-color 0.2s, color 0.2s;
                letter-spacing: 0.3px;
            }

            .btn-logout svg {
                width: 16px;
                height: 16px;
                fill: currentColor;
                flex-shrink: 0;
            }

            .btn-logout:hover {
                background-color: rgba(255, 55, 55, 0.15);
                border-color: var(--rojo);
                color: #ff6b6b;
            }

            /* ── CONTENIDO PRINCIPAL ── */
            .main-wrapper {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                min-height: 100vh;
            }

            .page-content {
                flex: 1;
                padding: var(--ui-page-padding-y) var(--ui-page-padding-x);
                overflow-y: auto;
            }

            .page-footer {
                padding: 0.85rem 1.75rem;
                border-top: 1px solid #e8ddd4;
                background-color: var(--color-secundario);
                font-size: 0.78rem;
                color: var(--crema);
                text-align: center;
                flex-shrink: 0;
            }

            /* ── NAVBAR VENDEDOR ── */
            body.vendedor-mode {
                flex-direction: column;
            }

            .navbar-vendedor {
                height: 64px;
                background-color: var(--naranja, #E76F2E);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 1.5rem;
                color: #ffffff;
                box-shadow: 0 3px 12px rgba(231, 111, 46, 0.25);
                position: sticky;
                top: 0;
                z-index: 1000;
                flex-shrink: 0;
            }

            .navbar-vendedor-left {
                display: flex;
                align-items: center;
                gap: 1.5rem;
            }

            .navbar-vendedor-center {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
            }

            .vendedor-brand-title {
                font-family: var(--font-heading);
                font-size: 1.15rem;
                font-weight: 800;
                color: #ffffff;
                letter-spacing: 0.5px;
                line-height: 1.1;
            }

            .vendedor-clock-sub {
                display: flex;
                align-items: center;
                gap: 0.35rem;
                font-size: 0.78rem;
                font-weight: 600;
                color: rgba(255, 255, 255, 0.9);
                font-variant-numeric: tabular-nums;
                letter-spacing: 0.5px;
                margin-top: 0.1rem;
            }

            .vendedor-clock-sub svg {
                width: 13px;
                height: 13px;
                fill: currentColor;
                opacity: 0.85;
            }

            .navbar-vendedor-nav {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                background-color: rgba(0, 0, 0, 0.12);
                padding: 0.25rem;
                border-radius: 10px;
            }

            .nav-vendedor-item {
                display: flex;
                align-items: center;
                gap: 0.45rem;
                padding: 0.45rem 0.9rem;
                border-radius: 8px;
                color: rgba(255, 255, 255, 0.88);
                font-size: 0.88rem;
                font-weight: 600;
                text-decoration: none;
                transition: background-color 0.15s, color 0.15s;
            }

            .nav-vendedor-item svg {
                width: 17px;
                height: 17px;
                fill: currentColor;
            }

            .nav-vendedor-item:hover {
                background-color: rgba(255, 255, 255, 0.18);
                color: #ffffff;
            }

            .nav-vendedor-item.active {
                background-color: #ffffff;
                color: var(--color-secundario, #2C2C2C);
                font-weight: 700;
                box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            }

            .nav-vendedor-item.active svg {
                fill: var(--color-primario, #E76F2E);
            }

            .navbar-vendedor-right {
                display: flex;
                align-items: center;
                gap: 1.25rem;
            }

            .navbar-vendedor-user {
                display: flex;
                align-items: center;
                gap: 0.65rem;
                background-color: rgba(255, 255, 255, 0.15);
                padding: 0.35rem 0.85rem;
                border-radius: 20px;
            }

            .navbar-vendedor-user .user-avatar {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background-color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .navbar-vendedor-user .user-avatar svg {
                width: 16px;
                height: 16px;
                fill: var(--naranja, #E76F2E);
            }

            .navbar-vendedor-user .user-info {
                display: flex;
                flex-direction: column;
                line-height: 1.1;
            }

            .navbar-vendedor-user .user-name {
                font-size: 0.82rem;
                font-weight: 700;
                color: #ffffff;
            }

            .navbar-vendedor-user .user-role {
                font-size: 0.68rem;
                font-weight: 600;
                color: rgba(255, 255, 255, 0.85);
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .btn-vendedor-logout {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                padding: 0.45rem 0.9rem;
                background-color: rgba(0, 0, 0, 0.2);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 8px;
                color: #ffffff;
                font-size: 0.82rem;
                font-weight: 700;
                text-decoration: none;
                transition: background-color 0.15s, border-color 0.15s;
            }

            .btn-vendedor-logout svg {
                width: 15px;
                height: 15px;
                fill: currentColor;
            }

            .btn-vendedor-logout:hover {
                background-color: rgba(239, 68, 68, 0.85);
                border-color: #ef4444;
                color: #ffffff;
            }

            /* ── BOTÓN HAMBURGUESA DEL NAVBAR (admin en Generar / Caja) ── */
            .btn-navbar-menu {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 42px;
                height: 42px;
                flex-shrink: 0;
                background-color: rgba(0, 0, 0, 0.18);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 10px;
                color: #ffffff;
                cursor: pointer;
                transition: background-color 0.15s, transform 0.12s;
            }

            .btn-navbar-menu svg {
                width: 21px;
                height: 21px;
                fill: currentColor;
            }

            .btn-navbar-menu:hover {
                background-color: rgba(255, 255, 255, 0.22);
                transform: translateY(-1px);
            }

            /* ── SIDEBAR DESPLEGABLE (admin con navbar) ── */
            /* Se despliega bajo el navbar para que el botón hamburguesa siga accesible. */
            body.admin-navbar-mode .sidebar {
                position: fixed;
                top: 64px;
                left: -260px;
                height: calc(100vh - 64px);
                z-index: 1100;
                transition: left 0.25s ease;
                box-shadow: 4px 0 18px rgba(0, 0, 0, 0.18);
            }

            body.admin-navbar-mode .sidebar.open {
                left: 0;
            }

            body.admin-navbar-mode .sidebar-overlay {
                display: none;
                position: fixed;
                top: 64px;
                right: 0;
                bottom: 0;
                left: 0;
                background: rgba(0, 0, 0, 0.45);
                z-index: 1099;
            }

            body.admin-navbar-mode .sidebar-overlay.open {
                display: block;
            }

            /* ── TOGGLE SIDEBAR MÓVIL (flotante) ── */
            .sidebar-toggle {
                display: none;
                position: fixed;
                bottom: 1.25rem;
                right: 1.25rem;
                z-index: 300;
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background-color: var(--color-primario);
                border: none;
                cursor: pointer;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 14px rgba(231, 111, 46, 0.5);
                transition: background-color 0.2s, transform 0.15s;
            }

            .sidebar-toggle svg {
                width: 22px;
                height: 22px;
                fill: var(--blanco);
            }

            .sidebar-toggle:hover {
                background-color: #cf5f22;
                transform: scale(1.07);
            }

            /* ── Transiciones SPA ── */
            @@keyframes spaEnter {
                from { opacity: 0; transform: translateY(18px); }
                to   { opacity: 1; transform: translateY(0); }
            }

            .page-content.spa-exit {
                opacity: 0;
                transform: translateY(-8px);
                transition: opacity .15s ease, transform .15s ease;
                pointer-events: none;
            }

            .page-content.spa-enter {
                animation: spaEnter .3s cubic-bezier(.25, .46, .45, .94) both;
            }

            @@media (max-width: 768px) {
                .sidebar {
                    position: fixed;
                    left: -260px;
                    z-index: 200;
                    transition: left 0.25s ease;
                }

                .sidebar.open {
                    left: 0;
                }

                .sidebar-toggle {
                    display: flex;
                }

                .sidebar-overlay {
                    display: none;
                    position: fixed;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.45);
                    z-index: 199;
                }

                .sidebar-overlay.open {
                    display: block;
                }
            }
    </style>
    <link rel="stylesheet" href="~/css/ui-overrides.css" asp-append-version="true" />
</head>

@{
    var densityClass = ViewData["Density"]?.ToString();
    if (string.IsNullOrWhiteSpace(densityClass))
    {
        densityClass = "ui-density-compact";
    }
}

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var area       = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    bool IsActive(string ctrl, string act = "Index")
        => string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, act, StringComparison.OrdinalIgnoreCase);

    bool IsController(string ctrl)
        => string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase);

    bool IsArea(string a)
        => string.Equals(area, a, StringComparison.OrdinalIgnoreCase);

    bool configSubmenuOpen = IsController("Configuracion") || IsController("Usuarios")
                          || IsController("Productos")     || IsController("Promociones")
                          || IsController("Empleados")     || IsArea("Compras");

    var nombreCompleto = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name ?? "Usuario";
    var tipoUsuario    = User.FindFirst("TipoUsuario")?.Value ?? "";
    bool esAdmin       = tipoUsuario == "Administrador";
    bool esVendedor    = tipoUsuario == "Vendedor";
    bool esCajero      = tipoUsuario == "Cajero";

    // Vistas de operación (Generar venta / Caja / Historial): el administrador las ve
    // igual que vendedor y cajero — con navbar — pero con acceso al sidebar por
    // hamburguesa. Historial se alcanza tanto desde el navbar como desde el sidebar
    // y en ambos casos se muestra con este mismo shell.
    bool vistaOperacion = IsActive("Ventas", "Generar")
                       || IsActive("Ventas", "Caja")
                       || IsActive("Ventas", "Historial");
    bool adminNavbar    = esAdmin && IsArea("Ventas") && vistaOperacion;
    bool useNavbar      = esVendedor || esCajero || adminNavbar;

    // El sidebar se renderiza siempre salvo para vendedor y cajero; en modo
    // admin-navbar queda oculto como menú lateral desplegable.
    bool mostrarSidebar = !esVendedor && !esCajero;

    ViewData["MostrarMenuLateral"] = adminNavbar;
}

<body class="@densityClass @(useNavbar ? "vendedor-mode" : "") @(adminNavbar ? "admin-navbar-mode" : "")">

    @if (useNavbar)
    {
        <partial name="_Navbar" />
    }

    @if (mostrarSidebar)
    {
        <!-- Overlay del menú lateral -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">

        <!-- ZONA 1: Marca -->
        <div class="sidebar-brand">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <!-- Corcho / tapa -->
                    <rect x="10.5" y="1" width="3" height="1.8" rx="0.4" />
                    <!-- Cuello y cuerpo de la botella -->
                    <path
                    d="M10 2.8h4v2c0 .4.22.76.55.95C16.5 6.9 18 9.2 18 11.5V20a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-8.5c0-2.3 1.5-4.6 3.45-5.75.33-.19.55-.55.55-.95V2.8z" />
                    <!-- Etiqueta en la botella -->
                    <rect x="8.5" y="13.5" width="7" height="4.5" rx="0.8" opacity="0.3" />
                    <!-- Cruz/detalle en la etiqueta (el "4" de Cuatro Ases simplificado) -->
                    <line x1="12" y1="14.3" x2="12" y2="17.2" stroke="currentColor" stroke-width="0.9"
                          stroke-linecap="round" opacity="0.7" />
                    <line x1="10.3" y1="15.75" x2="13.7" y2="15.75" stroke="currentColor" stroke-width="0.9"
                          stroke-linecap="round" opacity="0.7" />
                </svg>
            </div>
            <span>Cuatro Ases</span>
        </div>

        <!-- ZONA 2: Usuario -->
        <div class="sidebar-user">
            <div class="user-avatar">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path
