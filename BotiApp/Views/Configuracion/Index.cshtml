@using Infraestructura.Entities.BotiApp
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Configuración del sistema";
    ViewData["Density"] = "ui-density-comfortable";

    var tiposProducto = (ViewBag.TiposProducto as IEnumerable<ProTiposProductos>) ?? [];
    var marcas        = (ViewBag.Marcas        as IEnumerable<ProMarcas>)          ?? [];
    var metodosPago   = (ViewBag.MetodosPago   as IEnumerable<VenMetodosPago>)      ?? [];
}

<style>
    .config-page-header {
        display: flex;
        align-items: center;
        gap: 0.95rem;
        background: var(--surface-base);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: 1.15rem 1.35rem;
        margin-bottom: 1.4rem;
    }

    .config-page-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: rgba(231, 111, 46, 0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .config-page-icon svg {
        width: 23px;
        height: 23px;
        fill: var(--color-primario);
    }

    .config-page-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--color-secundario);
        margin: 0;
    }

    .config-page-subtitle {
        font-size: 0.86rem;
        color: var(--text-muted);
        margin: 0.15rem 0 0;
    }

    .config-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1.5rem;
    }

    .config-card {
        background: var(--blanco);
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        padding: 1.05rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 520px;
        max-height: 520px;
    }

    .config-card.hidden {
        display: none;
    }

    .config-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .config-card-title {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-secundario);
    }

    .config-card-title svg {
        width: 20px;
        height: 20px;
        fill: var(--color-primario);
        flex-shrink: 0;
    }

    .btn-add {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.45rem 0.9rem;
        background-color: var(--color-primario);
        color: var(--blanco);
        border: none;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
        white-space: nowrap;
    }

    .btn-add svg {
        width: 16px;
        height: 16px;
        fill: currentColor;
    }

    .btn-add:hover { background-color: #cf5f22; }

    .config-card-search {
        position: relative;
    }

    .config-card-search svg {
        position: absolute;
        left: 0.65rem;
        top: 50%;
        transform: translateY(-50%);
        width: 15px;
        height: 15px;
        fill: #9ca3af;
        pointer-events: none;
    }

    .config-search-input {
        width: 100%;
        border: 1px solid #e5e0d8;
        border-radius: 8px;
        padding: 0.5rem 0.7rem 0.5rem 2rem;
        font-size: 0.82rem;
        color: var(--color-secundario);
        outline: none;
        transition: border-color 0.2s;
    }

    .config-search-input:focus {
        border-color: var(--color-primario);
    }

    .config-table-wrap {
        border: 1px solid #f0e8e0;
        border-radius: 10px;
        overflow: auto;
        flex: 1;
        min-height: 0;
    }

    .config-table-wrap tbody tr.hidden {
        display: none;
    }

    .config-empty-search {
        padding: 0.9rem;
        text-align: center;
        color: #9a8070;
        font-size: 0.82rem;
        display: none;
    }

    .config-empty-search.visible {
        display: block;
    }

    .config-table-wrap::-webkit-scrollbar {
        width: 8px;
    }

    .config-table-wrap::-webkit-scrollbar-thumb {
        background: #d8cbbf;
        border-radius: 10px;
    }

    .config-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

    .config-table th {
        text-align: left;
        padding: 0.5rem 0.6rem;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--color-primario);
        border-bottom: 2px solid #f0e8e0;
        background: #faf7f4;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .config-table td {
        padding: 0.5rem 0.6rem;
        border-bottom: 1px solid #f5f0eb;
        vertical-align: middle;
    }

    .config-table tr:last-child td { border-bottom: none; }
    .config-table tr:hover td { background-color: #faf6f2; }

    .config-table .td-acciones {
        text-align: right;
        white-space: nowrap;
    }

    .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.3rem;
        border-radius: 6px;
        color: var(--color-secundario);
        opacity: 0.55;
        transition: opacity 0.2s, background-color 0.2s;
    }

    .btn-icon:hover { opacity: 1; background-color: #f0e8e0; }

    .btn-icon svg {
        width: 17px;
        height: 17px;
        fill: currentColor;
        display: block;
    }

    .btn-icon.danger:hover { background-color: #ffe0e0; color: var(--color-danger); }

    .badge-estado {
        display: inline-block;
        padding: 0.15rem 0.55rem;
        border-radius: 12px;
        font-size: 0.73rem;
        font-weight: 700;
    }

    .badge-estado.activo  { background: #e9f9ee; color: var(--color-success); }
    .badge-estado.inactivo { background: #fff0f0; color: var(--color-danger); }

    /* Modal inline */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 500;
        align-items: center;
        justify-content: center;
    }

    .modal-overlay.open { display: flex; }

    .modal-box {
        background: var(--blanco);
        border-radius: 14px;
        padding: 1.75rem;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .modal-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-secundario);
    }

    .modal-input {
        width: 100%;
        padding: 0.7rem 0.9rem;
        border: 2px solid #e0d5cc;
        border-radius: 8px;
        font-size: 0.93rem;
        outline: none;
        transition: border-color 0.2s;
    }

    .modal-input:focus { border-color: var(--color-primario); }

    .modal-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    .btn-confirm {
        padding: 0.55rem 1.2rem;
        background-color: var(--color-primario);
        color: var(--blanco);
        border: none;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-confirm:hover { background-color: #cf5f22; }

    .btn-cancel {
        padding: 0.55rem 1.1rem;
        background: transparent;
        border: 1.5px solid #ddd;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        color: var(--color-secundario);
        transition: border-color 0.2s;
    }

    .btn-cancel:hover { border-color: var(--color-secundario); }

    .toast-container {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 900;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .toast {
        padding: 0.75rem 1.1rem;
        border-radius: 10px;
        font-size: 0.87rem;
        font-weight: 600;
        color: var(--blanco);
        box-shadow: 0 4px 14px rgba(0,0,0,0.2);
        animation: slideIn 0.25s ease;
    }

    .toast.ok    { background-color: var(--color-success); }
    .toast.error { background-color: var(--color-danger); }

    @@keyframes slideIn {
        from { transform: translateX(60px); opacity: 0; }
        to   { transform: translateX(0);    opacity: 1; }
    }

    @@media (max-width: 768px) {
        .config-grid {
            grid-template-columns: 1fr;
        }

        .config-page-header {
            align-items: flex-start;
        }

        .config-card {
            min-height: 420px;
            max-height: 420px;
        }
    }

    .btn-icon.toggle-off {
        color: var(--color-success);
    }

    .btn-icon.toggle-on {
        color: var(--color-danger);
    }
</style>

<div class="config-page-header">
    <div class="config-page-icon">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M19.14 12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.01 7.01 0 0 0-1.62-.94l-.36-2.54A.484.484 0 0 0 14 2h-4c-.25 0-.46.18-.49.42l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.74 8.87a.47.47 0 0 0 .12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.37 1.04.7 1.62.94l.36 2.54c.05.24.26.42.49.42h4c.25 0 .46-.18.49-.42l.36-2.54c.59-.24 1.13-.57 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.47.47 0 0 0-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
        </svg>
    </div>
    <div>
        <h1 class="config-page-title">Configuración del sistema</h1>
        <p class="config-page-subtitle">Administra los catálogos base utilizados en el sistema.</p>
    </div>
</div>

<div class="config-grid">

    <!-- ── TIPOS DE PRODUCTO ─────────────────────────────────────────────── -->
    <div class="config-card">
        <div class="config-card-header">
            <div class="config-card-title">
                <svg viewBox="0 0 24 24"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/></svg>
                Tipos de Producto
            </div>
            <button class="btn-add" onclick="abrirModal('tipo', null, null)">
                <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                Nuevo
            </button>
        </div>
        <div class="config-card-search">
            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <input class="config-search-input" data-card-search="tipo" type="text" placeholder="Buscar tipo de producto..." oninput="filtrarCard('tipo', this.value)" />
        </div>
        <div class="config-table-wrap">
            <table class="config-table" id="tabla-tipos">
                <thead>
                    <tr><th>Nombre</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in tiposProducto)
                    {
                        <tr id="tipo-@t.IdTipoProducto" data-search="@t.NombreTipoProducto.ToLower()">
                            <td>@t.NombreTipoProducto</td>
                            <td class="td-acciones">
                                <button class="btn-icon" title="Editar" onclick="abrirModal('tipo', @t.IdTipoProducto, '@Html.Raw(t.NombreTipoProducto.Replace("'","\\'"  ))')">
                                    <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.46a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                </button>
                                <button class="btn-icon danger" title="Eliminar" onclick="eliminar('tipo', @t.IdTipoProducto)">
                                    <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm13-15h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="config-empty-search" id="empty-tipo">No hay resultados para esta búsqueda.</div>
        </div>
    </div>

    <!-- ── MARCAS ─────────────────────────────────────────────────────────── -->
    <div class="config-card">
        <div class="config-card-header">
            <div class="config-card-title">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>
                Marcas
            </div>
            <button class="btn-add" onclick="abrirModal('marca', null, null)">
                <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                Nueva
            </button>
        </div>
        <div class="config-card-search">
            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <input class="config-search-input" data-card-search="marca" type="text" placeholder="Buscar marca..." oninput="filtrarCard('marca', this.value)" />
        </div>
        <div class="config-table-wrap">
            <table class="config-table" id="tabla-marcas">
                <thead>
                    <tr><th>Nombre</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var m in marcas)
                    {
                        <tr id="marca-@m.IdMarca" data-search="@($"{m.NombreMarca} {(m.Estado ? "activo" : "inactivo")}".ToLower())">
                            <td>@m.NombreMarca</td>
                            <td>
                                <span class="badge-estado @(m.Estado ? "activo" : "inactivo")">
                                    @(m.Estado ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="td-acciones">
                                <button class="btn-icon" title="Editar" onclick="abrirModal('marca', @m.IdMarca, '@Html.Raw(m.NombreMarca.Replace("'","\\'"  ))')">
                                    <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.46a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                </button>
                                <button class="btn-icon @(m.Estado ? "toggle-on" : "toggle-off")" data-toggle-marca="@m.IdMarca" title="@(m.Estado ? "Desactivar" : "Activar")" onclick="toggleMarca(@m.IdMarca)">
                                    <svg viewBox="0 0 24 24"><path d="@(m.Estado ? "M19 13H5v-2h14v2z" : "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z")"/></svg>
                                </button>
                                <button class="btn-icon danger" title="Eliminar" onclick="eliminar('marca', @m.IdMarca)">
                                    <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm13-15h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="config-empty-search" id="empty-marca">No hay resultados para esta búsqueda.</div>
        </div>
    </div>

    <!-- ── MÉTODOS DE PAGO ────────────────────────────────────────────────── -->
    <div class="config-card">
        <div class="config-card-header">
            <div class="config-card-title">
                <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
                Métodos de Pago
            </div>
            <button class="btn-add" onclick="abrirModal('pago', null, null)">
                <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                Nuevo
            </button>
        </div>
        <div class="config-card-search">
            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            <input class="config-search-input" data-card-search="pago" type="text" placeholder="Buscar método de pago..." oninput="filtrarCard('pago', this.value)" />
        </div>
        <div class="config-table-wrap">
            <table class="config-table" id="tabla-pagos">
                <thead>
                    <tr><th>Nombre</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var p in metodosPago)
                    {
                        <tr id="pago-@p.IdMetodoPago" data-search="@p.NombreMetodoPago.ToLower()">
                            <td>@p.NombreMetodoPago</td>
                            <td class="td-acciones">
                                <button class="btn-icon" title="Editar" onclick="abrirModal('pago', @p.IdMetodoPago, '@Html.Raw(p.NombreMetodoPago.Replace("'","\\'"  ))')">
                                    <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.46a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                </button>
                                <button class="btn-icon danger" title="Eliminar" onclick="eliminar('pago', @p.IdMetodoPago)">
                                    <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm13-15h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="config-empty-search" id="empty-pago">No hay resultados para esta búsqueda.</div>
        </div>
    </div>

</div>

<!-- ── MODAL ────────────────────────────────────────────────────────────── -->
<div class="modal-overlay" id="modal" onclick="cerrarModalSiOverlay(event)">
    <div class="modal-box">
        <div class="modal-title" id="modal-title">Nuevo registro</div>
        <input class="modal-input" id="modal-input" type="text" placeholder="Nombre" maxlength="100" />
        <div class="modal-actions">
            <button class="btn-cancel" onclick="cerrarModal()">Cancelar</button>
            <button class="btn-confirm" onclick="guardarModal()">Guardar</button>
        </div>
    </div>
</div>

<!-- ── TOAST ─────────────────────────────────────────────────────────────── -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
<script>
    let modalTipo = null;
    let modalId   = null;

    function abrirModal(tipo, id, nombreActual) {
        modalTipo = tipo;
        modalId   = id;
        const titulos = { tipo: 'Tipo de Producto', marca: 'Marca', pago: 'Método de Pago' };
        document.getElementById('modal-title').textContent = (id ? 'Editar ' : 'Nuevo ') + titulos[tipo];
        document.getElementById('modal-input').value = nombreActual ?? '';
        document.getElementById('modal').classList.add('open');
        document.getElementById('modal-input').focus();
    }

    function cerrarModal() {
        document.getElementById('modal').classList.remove('open');
        modalTipo = null; modalId = null;
    }

    function cerrarModalSiOverlay(e) {
        if (e.target.id === 'modal') cerrarModal();
    }

    async function guardarModal() {
        const nombre = document.getElementById('modal-input').value.trim();
        if (!nombre) { mostrarToast('El nombre no puede estar vacío.', false); return; }

        const urls = {
            tipo:  modalId ? '/Configuracion/EditarTipoProducto'  : '/Configuracion/CrearTipoProducto',
            marca: modalId ? '/Configuracion/EditarMarca'          : '/Configuracion/CrearMarca',
            pago:  modalId ? '/Configuracion/EditarMetodoPago'     : '/Configuracion/CrearMetodoPago'
        };

        const body = modalId ? { Id: modalId, Nombre: nombre } : { Nombre: nombre };
        const res  = await post(urls[modalTipo], body);

        if (!res.ok) { mostrarToast(res.mensaje, false); return; }

        // Actualizar fila si edición, o agregar si creación
        if (modalId) {
            const row = document.getElementById(`${modalTipo}-${res.id}`);
            if (row) {
                const firstCell = row.querySelector('td');
                if (firstCell) {
                    firstCell.textContent = res.nombre;
                }
                // marcas: actualizar badge si existe
                if (modalTipo === 'marca') {
                    const estadoActual = row.querySelector('.badge-estado')?.classList.contains('activo') === true;
                    const estadoFinal = typeof res.estado === 'boolean' ? res.estado : estadoActual;
                    const badge = row.querySelector('.badge-estado');
                    if (badge) {
                        badge.textContent = estadoFinal ? 'Activo' : 'Inactivo';
                        badge.className = `badge-estado ${estadoFinal ? 'activo' : 'inactivo'}`;
                    }
                    row.dataset.search = `${res.nombre} ${estadoFinal ? 'activo' : 'inactivo'}`.toLowerCase();
                } else {
                    row.dataset.search = (res.nombre || '').toLowerCase();
                }

                const searchInput = document.querySelector(`[data-card-search="${modalTipo}"]`);
                const term = searchInput ? searchInput.value : '';
                filtrarCard(modalTipo, term);
            }
        } else {
            agregarFila(modalTipo, res);
        }

        mostrarToast('Guardado correctamente.', true);
        cerrarModal();
    }

    function agregarFila(tipo, res) {
        const tbodies = { tipo: '#tabla-tipos tbody', marca: '#tabla-marcas tbody', pago: '#tabla-pagos tbody' };
        const tbody = document.querySelector(tbodies[tipo]);

        let celdas = '';
        if (tipo === 'tipo') {
            celdas = `<td>${res.nombre}</td>
                      <td class="td-acciones">
                        <button class="btn-icon" onclick="abrirModal('tipo',${res.id},'${esc(res.nombre)}')" title="Editar"><svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.46a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg></button>
                        <button class="btn-icon danger" onclick="eliminar('tipo',${res.id})" title="Eliminar"><svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm13-15h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></button>
                      </td>`;
        } else if (tipo === 'marca') {
            celdas = `<td>${res.nombre}</td>
                      <td><span class="badge-estado activo">Activo</span></td>
                      <td class="td-acciones">
                        <button class="btn-icon" onclick="abrirModal('marca',${res.id},'${esc(res.nombre)}')" title="Editar"><svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.46a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg></button>
                        <button class="btn-icon toggle-on" data-toggle-marca="${res.id}" onclick="toggleMarca(${res.id})" title="Desactivar"><svg viewBox="0 0 24 24"><path d="M19 13H5v-2h14v2z"/></svg></button>
                        <button class="btn-icon danger" onclick="eliminar('marca',${res.id})" title="Eliminar"><svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm13-15h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></button>
                      </td>`;
        } else {
            celdas = `<td>${res.nombre}</td>
                      <td class="td-acciones">
                        <button class="btn-icon" onclick="abrirModal('pago',${res.id},'${esc(res.nombre)}')" title="Editar"><svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.46a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg></button>
                        <button class="btn-icon danger" onclick="eliminar('pago',${res.id})" title="Eliminar"><svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm13-15h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></button>
                      </td>`;
        }

        const tr = document.createElement('tr');
        tr.id = `${tipo}-${res.id}`;
        tr.dataset.search = `${res.nombre || ''} ${tipo === 'marca' ? 'activo' : ''}`.trim().toLowerCase();
        tr.innerHTML = celdas;
        tbody.appendChild(tr);

        const searchInput = document.querySelector(`[data-card-search="${tipo}"]`);
        const term = searchInput ? searchInput.value : '';
        filtrarCard(tipo, term);
    }

    async function eliminar(tipo, id) {
        if (!confirm('¿Estás seguro de que deseas eliminar este registro?')) return;

        const urls = {
            tipo:  '/Configuracion/EliminarTipoProducto',
            marca: '/Configuracion/EliminarMarca',
            pago:  '/Configuracion/EliminarMetodoPago'
        };

        const res = await post(urls[tipo], { Id: id });
        if (res.ok) {
            document.getElementById(`${tipo}-${id}`)?.remove();
            mostrarToast('Eliminado correctamente.', true);
            const searchInput = document.querySelector(`[data-card-search="${tipo}"]`);
            const term = searchInput ? searchInput.value : '';
            filtrarCard(tipo, term);
        } else {
            mostrarToast(res.mensaje, false);
        }
    }

    async function toggleMarca(id) {
        const res = await post('/Configuracion/ToggleMarca', { Id: id });
        if (!res.ok) { mostrarToast(res.mensaje, false); return; }

        const row   = document.getElementById(`marca-${id}`);
        const badge = row?.querySelector('.badge-estado');
        const btn = row?.querySelector('[data-toggle-marca]');
        const nombre = row?.querySelector('td')?.textContent?.trim() || '';
        if (badge) {
            badge.textContent = res.estado ? 'Activo' : 'Inactivo';
            badge.className   = `badge-estado ${res.estado ? 'activo' : 'inactivo'}`;
        }
        if (btn) {
            btn.title = res.estado ? 'Desactivar' : 'Activar';
            btn.className = `btn-icon ${res.estado ? 'toggle-on' : 'toggle-off'}`;
            const path = btn.querySelector('path');
            if (path) {
                path.setAttribute('d', res.estado
                    ? 'M19 13H5v-2h14v2z'
                    : 'M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z');
            }
        }
        if (row) {
            row.dataset.search = `${nombre} ${res.estado ? 'activo' : 'inactivo'}`.toLowerCase();
        }
        const searchInput = document.querySelector('[data-card-search="marca"]');
        const term = searchInput ? searchInput.value : '';
        filtrarCard('marca', term);
        mostrarToast(res.estado ? 'Marca activada.' : 'Marca desactivada.', true);
    }

    function filtrarCard(tipo, value) {
        const q = (value || '').toLowerCase().trim();
        const rows = document.querySelectorAll(`#tabla-${tipo === 'tipo' ? 'tipos' : tipo === 'marca' ? 'marcas' : 'pagos'} tbody tr`);
        let visibles = 0;

        rows.forEach(row => {
            const text = row.dataset.search || row.textContent.toLowerCase();
            const match = !q || text.includes(q);
            row.classList.toggle('hidden', !match);
            if (match) {
                visibles++;
            }
        });

        const empty = document.getElementById(`empty-${tipo}`);
        if (empty) {
            empty.classList.toggle('visible', visibles === 0);
        }
    }

    async function post(url, data) {
        const tok = document.cookie.split(';').map(c => c.trim()) || [];
        const headers = {
            'Content-Type': 'application/json',
            'RequestVerificationToken': getToken()
        };
        const resp = await fetch(url, { method: 'POST', headers, body: JSON.stringify(data) });
        return resp.json();
    }

    function getToken() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    function esc(s) { return s.replace(/'/g, "\\'"); }

    function mostrarToast(msg, ok) {
        const c = document.getElementById('toastContainer');
        const t = document.createElement('div');
        t.className = `toast ${ok ? 'ok' : 'error'}`;
        t.textContent = msg;
        c.appendChild(t);
        setTimeout(() => t.remove(), 3500);
    }

    ['tipo', 'marca', 'pago'].forEach(tipo => {
        const searchInput = document.querySelector(`[data-card-search="${tipo}"]`);
        filtrarCard(tipo, searchInput ? searchInput.value : '');
    });
</script>

