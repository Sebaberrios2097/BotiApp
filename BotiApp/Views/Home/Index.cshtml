@if (ClaimHelper.EsCajero(User))
{
    <div class="kpi-grid kpi-grid-cajero">
        <div class="kpi-card success">
            <div class="kpi-icon success">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">@Model.CajeroBoletasCobradas</span>
                <span class="kpi-label">Boletas cobradas</span>
            </div>
        </div>
        <div class="kpi-card danger">
            <div class="kpi-icon danger">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">@Model.CajeroBoletasAnuladas</span>
                <span class="kpi-label">Boletas anuladas</span>
            </div>
        </div>
        <div class="kpi-card info">
            <div class="kpi-icon info">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">$@Model.CajeroMontoGestionado.ToString("N0")</span>
                <span class="kpi-label">Monto gestionado</span>
            </div>
        </div>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <h2>Boletas gestionadas en @mesNombre @Model.Anio</h2>
            <span>Últimas @Model.CajeroUltimasBoletas.Count() registradas</span>
        </div>
        @if (!Model.CajeroUltimasBoletas.Any())
        {
            <div class="dash-empty">No has gestionado boletas este mes.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Fecha pago / anulación</th>
                            <th>Vendedor</th>
                            <th>Estado</th>
                            <th style="text-align:right">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.CajeroUltimasBoletas)
                        {
                            var vendedor = b.IdVendedorNavigation?.IdEmpleadoNavigation is { } ve
                                ? $"{ve.NombresEmpleado} {ve.Apellido1}"
                                : "—";
                            var (badgeClass, estadoText) = b.IdEstadoBoleta switch
                            {
                                2 => ("badge-anulada", "Anulada"),
                                3 => ("badge-pagada",  "Pagada"),
                                _ => ("badge-otro",    b.IdEstadoBoletaNavigation?.NombreEstadoBoleta ?? "—")
                            };
                            var fechaGestion = (b.FechaPago ?? b.FechaEmision)?.ToString("dd/MM/yyyy HH:mm") ?? "—";
                            <tr>
                                 <td><strong>@b.IdBoleta</strong></td>
                                 <td>@fechaGestion</td>
                                 <td>@vendedor</td>
                                 <td><span class="badge-estado @badgeClass">@estadoText</span></td>
                                 <td style="text-align:right;font-weight:600">$@b.MontoTotal.ToString("N0")</td>
                             </tr>
                         }
                     </tbody>
                 </table>
             </div>
         }
    </div>
}

@if (ClaimHelper.EsAdmin(User))
{
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        // ── Colores corporativos ──────────────────────────────────────────────
        var C_PRIMARY = getComputedStyle(document.documentElement).getPropertyValue('--color-primario').trim() || '#e76f2e';
        var C_SUCCESS = getComputedStyle(document.documentElement).getPropertyValue('--color-success').trim()  || '#5cb338';
        var C_WARNING = getComputedStyle(document.documentElement).getPropertyValue('--color-warning').trim()  || '#fcbf49';
        var C_DANGER  = getComputedStyle(document.documentElement).getPropertyValue('--color-danger').trim()   || '#ff3737';
        var C_INFO    = '#6366f1';

        Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
        Chart.defaults.font.size   = 12;

        // ── 1. Pie: Boletas por tipo ──────────────────────────────────────────
        var ctxPie = document.getElementById('chartBoletasTipo');
        if (ctxPie) {
            Chart.getChart(ctxPie)?.destroy();
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Pagadas', 'Pendientes', 'Anuladas'],
                    datasets: [{
                        data: [
                            @Model.TotalBoletasPagadasMes,
                            @Model.TotalBoletasPendientesMes,
                            @Model.TotalBoletasAnuladasMes
                        ],
                        backgroundColor: [C_SUCCESS, C_WARNING, C_DANGER],
                        borderWidth: 2,
                        borderColor: '#fff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 14, boxWidth: 12 } },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` ${ctx.label}: ${ctx.parsed} boleta(s)`
                            }
                        }
                    }
                }
            });
        }

        // ── 2. Line: Ventas del mes por día ───────────────────────────────────
        var ctxLine = document.getElementById('chartVentasDia');
        if (ctxLine) {
            Chart.getChart(ctxLine)?.destroy();
            var diasLabels = @Html.Raw(JsonSerializer.Serialize(diasLabels));
            var diasData   = @Html.Raw(JsonSerializer.Serialize(diasData));

            new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: diasLabels,
                    datasets: [{
                        label: 'Ventas ($)',
                        data: diasData,
                        borderColor: C_PRIMARY,
                        backgroundColor: C_PRIMARY + '22',
                        borderWidth: 2.5,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        fill: true,
                        tension: 0.35
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` $${ctx.parsed.y.toLocaleString('es-CL')}`
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9ca3af', maxTicksLimit: 16 }
                        },
                        y: {
                            grid: { color: '#f3f0ec' },
                            ticks: {
                                color: '#9ca3af',
                                callback: v => '$' + v.toLocaleString('es-CL')
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        // ── 3. Bar: Montos por método de pago ─────────────────────────────────
        var ctxBar = document.getElementById('chartMetodosPago');
        if (ctxBar) {
            Chart.getChart(ctxBar)?.destroy();
            var metLabels = @Html.Raw(JsonSerializer.Serialize(metodosLabels));
            var metData   = @Html.Raw(JsonSerializer.Serialize(metodosData));

            var barColors = [C_PRIMARY, C_INFO, C_SUCCESS, C_WARNING, C_DANGER,
                             '#0ea5e9', '#a855f7', '#f97316', '#14b8a6', '#ec4899'];

            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: metLabels,
                    datasets: [{
                        label: 'Monto ($)',
                        data: metData,
                        backgroundColor: metLabels.map((_, i) => barColors[i % barColors.length] + 'cc'),
                        borderColor:     metLabels.map((_, i) => barColors[i % barColors.length]),
                        borderWidth: 1.5,
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` $${ctx.parsed.y.toLocaleString('es-CL')}`
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#9ca3af' } },
                        y: {
                            grid: { color: '#f3f0ec' },
                            ticks: {
                                color: '#9ca3af',
                                callback: v => '$' + v.toLocaleString('es-CL')
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        // ── Panel bajo stock ──────────────────────────────────────────────────
        function toggleBajoStock() {
            var card  = document.getElementById('card-bajo-stock');
            var panel = document.getElementById('panel-bajo-stock');
            card.classList.toggle('active');
            panel.classList.toggle('open');
        }
    </script>
}
}
