@section Scripts {
<script>
    // ── Selector cascada Año / Mes (todos los roles) ──────────────────────────
    var _PERIODOS  = @Html.Raw(periodosJson);
    var _ANIO_SEL  = @Model.Anio;
    var _MES_SEL   = @Model.Mes;
    var _MESES_ES  = ['','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

    function _poblarMeses(anio, mesSel) {
        var sel   = document.getElementById('selectMes');
        if (!sel) return;
        var meses = _PERIODOS[anio] || [];
        sel.innerHTML = '';
        meses.forEach(function(m) {
            var opt = document.createElement('option');
            opt.value = m;
            opt.textContent = _MESES_ES[m];
            if (m === mesSel) opt.selected = true;
            sel.appendChild(opt);
        });
    }

    function onAnioChange() {
        var anio  = parseInt(document.getElementById('selectAnio').value);
        var meses = _PERIODOS[anio] || [];
        _poblarMeses(anio, meses[0] || null);
        if (meses.length > 0) _cargarDashboard(meses[0], anio);
    }

    function onMesChange() {
        var anio = parseInt(document.getElementById('selectAnio').value);
        var mes  = parseInt(document.getElementById('selectMes').value);
        _cargarDashboard(mes, anio);
    }

    // ── AJAX: carga datos del período sin recargar la página ─────────────────
    function _cargarDashboard(mes, anio) {
        var overlay = document.getElementById('dash-overlay');
        if (overlay) overlay.classList.add('visible');

        fetch('/Home/DashboardDataAjax?mes=' + mes + '&anio=' + anio, { credentials: 'same-origin' })
            .then(function(r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(function(d) {
                _actualizarDashboard(d);
                history.replaceState({}, '', '/Home/Index?mes=' + mes + '&anio=' + anio);
            })
            .catch(function(err) {
                console.error('Error cargando dashboard:', err);
            })
            .finally(function() {
                if (overlay) overlay.classList.remove('visible');
            });
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    function _setText(id, val) {
        var el = document.getElementById(id);
        if (el) el.textContent = val;
    }
    function _setHtml(id, html) {
        var el = document.getElementById(id);
        if (el) el.innerHTML = html;
    }
    function _esc(s) {
        var d = document.createElement('div');
        d.textContent = s == null ? '' : String(s);
        return d.innerHTML;
    }
    function _fmtPeso(n) {
        return '$' + Number(n).toLocaleString('es-CL');
    }
    function _badgeEstado(estado) {
        var m = {1:['badge-pendiente','Pendiente'],2:['badge-anulada','Anulada'],3:['badge-pagada','Pagada']};
        var b = m[estado] || ['badge-otro', estado];
        return '<span class="badge-estado ' + b[0] + '">' + b[1] + '</span>';
    }
    function _toggleChart(canvasId, hasData) {
        var wrap  = document.getElementById(canvasId + '-wrap');
        var empty = document.getElementById(canvasId + '-empty');
        if (wrap)  wrap.hidden  = !hasData;
        if (empty) empty.hidden =  hasData;
    }

    // ── Render helpers para tablas ────────────────────────────────────────────
    function _renderAdminBoletasContent(boletas) {
        if (!boletas || !boletas.length)
            return '<div class="dash-empty">No hay boletas registradas este mes.</div>';
        var rows = boletas.map(function(b) {
            return '<tr>' +
                '<td><strong>' + b.id + '</strong></td>' +
                '<td>' + _esc(b.fechaEmision) + '</td>' +
                '<td>' + _esc(b.vendedor) + '</td>' +
                '<td>' + _esc(b.cajero) + '</td>' +
                '<td>' + _badgeEstado(b.estado) + '</td>' +
                '<td style="text-align:right;font-weight:600">' + _fmtPeso(b.monto) + '</td>' +
                '</tr>';
        }).join('');
        return '<div class="table-responsive"><table class="dash-table">' +
            '<thead><tr><th>#</th><th>Fecha emisión</th><th>Vendedor</th><th>Cajero</th><th>Estado</th>' +
            '<th style="text-align:right">Monto</th></tr></thead>' +
            '<tbody>' + rows + '</tbody></table></div>';
    }
    function _renderVendBoletasContent(boletas) {
        if (!boletas || !boletas.length)
            return '<div class="dash-empty">No tienes ventas registradas este mes.</div>';
        var rows = boletas.map(function(b) {
            return '<tr>' +
                '<td><strong>' + b.id + '</strong></td>' +
                '<td>' + _esc(b.fechaEmision) + '</td>' +
                '<td>' + _badgeEstado(b.estado) + '</td>' +
                '<td>' + b.productos + '</td>' +
                '<td style="text-align:right;font-weight:600">' + _fmtPeso(b.monto) + '</td>' +
                '</tr>';
        }).join('');
        return '<div class="table-responsive"><table class="dash-table">' +
            '<thead><tr><th>#</th><th>Fecha</th><th>Estado</th><th>Productos</th>' +
            '<th style="text-align:right">Monto</th></tr></thead>' +
            '<tbody>' + rows + '</tbody></table></div>';
    }
    function _renderCajBoletasContent(boletas) {
        if (!boletas || !boletas.length)
            return '<div class="dash-empty">No has gestionado boletas este mes.</div>';
        var rows = boletas.map(function(b) {
            return '<tr>' +
                '<td><strong>' + b.id + '</strong></td>' +
                '<td>' + _esc(b.fechaGestion) + '</td>' +
                '<td>' + _esc(b.vendedor) + '</td>' +
                '<td>' + _badgeEstado(b.estado) + '</td>' +
                '<td style="text-align:right;font-weight:600">' + _fmtPeso(b.monto) + '</td>' +
                '</tr>';
        }).join('');
        return '<div class="table-responsive"><table class="dash-table">' +
            '<thead><tr><th>#</th><th>Fecha pago / anulación</th><th>Vendedor</th><th>Estado</th>' +
            '<th style="text-align:right">Monto</th></tr></thead>' +
            '<tbody>' + rows + '</tbody></table></div>';
    }
    function _renderBajoStockBody(productos) {
        if (!productos || !productos.length)
            return '<div class="dash-empty">No hay productos con stock bajo.</div>';
        var rows = productos.map(function(p) {
            var badge = p.stock === 0 ? 'badge-stock-cero' : 'badge-stock-low';
            return '<tr>' +
                '<td><strong>' + _esc(p.nombre) + '</strong></td>' +
                '<td style="color:#9ca3af">' + _esc(p.codigo) + '</td>' +
                '<td>' + _esc(p.tipo) + '</td>' +
                '<td>' + _esc(p.marca) + '</td>' +
                '<td style="text-align:right">$' + Number(p.precio).toLocaleString('es-CL') + '</td>' +
                '<td style="text-align:center"><span class="badge-estado ' + badge + '">' + p.stock + '</span></td>' +
                '</tr>';
        }).join('');
        return '<div class="panel-bajo-stock-body"><div class="table-responsive">' +
            '<table class="dash-table"><thead><tr>' +
            '<th>Producto</th><th>Código</th><th>Tipo</th><th>Marca</th>' +
            '<th style="text-align:right">Precio</th><th style="text-align:center">Stock</th>' +
            '</tr></thead><tbody>' + rows + '</tbody></table></div></div>';
    }

    // ── Actualización in-place del dashboard ──────────────────────────────────
    function _actualizarDashboard(d) {
        var lbl = d.mesNombre + ' ' + d.anio;

        // Header
        _setText('dash-period-label', lbl);

        // ── Admin KPIs ────────────────────────────────────────────────────────
        _setText('kpi-boletas-total',      d.totalBoletasMes);
        _setText('kpi-boletas-pagadas',    d.totalBoletasPagadasMes);
        _setText('kpi-boletas-pendientes', d.totalBoletasPendientesMes);
        _setText('kpi-boletas-anuladas',   d.totalBoletasAnuladasMes);
        _setText('kpi-monto-total',        _fmtPeso(d.montoTotalMes));
        _setText('kpi-bajo-stock',         d.totalProductosBajoStock);
        if (d.totalFiadoGlobal  != null) _setText('kpi-fiado-total',   _fmtPeso(d.totalFiadoGlobal));
        if (d.cantFiadosActivos != null) _setText('kpi-fiado-activos', d.cantFiadosActivos);

        // ── Admin — bajo stock panel ──────────────────────────────────────────
        _setText('bajo-stock-count', d.totalProductosBajoStock + ' producto(s)');
        // Cerrar panel y reconstruir contenido
        var cardBajoStock  = document.getElementById('card-bajo-stock');
        var panelBajoStock = document.getElementById('panel-bajo-stock');
        if (cardBajoStock)  cardBajoStock.classList.remove('active');
        if (panelBajoStock) panelBajoStock.classList.remove('open');
        _setHtml('bajo-stock-body', _renderBajoStockBody(d.productosBajoStock));

        // ── Admin — gráficos ──────────────────────────────────────────────────
        _setText('chart-boletas-subtitle', lbl);
        _setText('chart-ventas-subtitle',  'montos pagados por día — ' + lbl);
        _setText('chart-metodos-subtitle', lbl);

        // Pie: Boletas por tipo
        var hasBoletas = d.totalBoletasMes > 0;
        _toggleChart('chartBoletasTipo', hasBoletas);
        if (hasBoletas) {
            var pie = Chart.getChart(document.getElementById('chartBoletasTipo'));
            if (pie) {
                pie.data.datasets[0].data = [d.totalBoletasPagadasMes, d.totalBoletasPendientesMes, d.totalBoletasAnuladasMes];
                pie.update();
            } else {
                _crearChartBoletasTipo(d.totalBoletasPagadasMes, d.totalBoletasPendientesMes, d.totalBoletasAnuladasMes);
            }
        }

        // Line: Ventas por día
        var hasVentas = d.ventasPorDiaMes && d.ventasPorDiaMes.some(function(v){ return v > 0; });
        _toggleChart('chartVentasDia', hasVentas);
        if (hasVentas) {
            var line = Chart.getChart(document.getElementById('chartVentasDia'));
            if (line) {
                line.data.labels = d.diasLabels;
                line.data.datasets[0].data = d.ventasPorDiaMes;
                line.update();
            } else {
                _crearChartVentasDia(d.diasLabels, d.ventasPorDiaMes);
            }
        }

        // Bar: Métodos de pago
        var hasMetodos = d.montosPorMetodoPagoLabels && d.montosPorMetodoPagoLabels.length > 0;
        _toggleChart('chartMetodosPago', hasMetodos);
        if (hasMetodos) {
            var bar = Chart.getChart(document.getElementById('chartMetodosPago'));
            if (bar) {
                var barColors = [C_PRIMARY, C_INFO, C_SUCCESS, C_WARNING, C_DANGER,
                                 '#0ea5e9', '#a855f7', '#f97316', '#14b8a6', '#ec4899'];
                bar.data.labels = d.montosPorMetodoPagoLabels;
                bar.data.datasets[0].data = d.montosPorMetodoPagoData;
                bar.data.datasets[0].backgroundColor = d.montosPorMetodoPagoLabels.map(function(_,i){ return barColors[i % barColors.length] + 'cc'; });
                bar.data.datasets[0].borderColor      = d.montosPorMetodoPagoLabels.map(function(_,i){ return barColors[i % barColors.length]; });
                bar.update();
            } else {
                _crearChartMetodosPago(d.montosPorMetodoPagoLabels, d.montosPorMetodoPagoData);
            }
        }

        // ── Admin — tabla boletas ─────────────────────────────────────────────
        _setText('admin-boletas-period', lbl);
        _setHtml('admin-boletas-content', _renderAdminBoletasContent(d.ultimasBoletas));

        // ── Vendedor ──────────────────────────────────────────────────────────
        _setText('kpi-vend-boletas',    d.vendedorBoletasMes);
        _setText('kpi-vend-monto',      _fmtPeso(d.vendedorMontoMes));
        _setText('kpi-vend-pendientes', d.vendedorBoletasPendientes);
        _setText('vend-tabla-title',    'Mis ventas de ' + lbl);
        _setText('vend-tabla-count',    'Últimas ' + (d.vendedorUltimasBoletas ? d.vendedorUltimasBoletas.length : 0) + ' registradas');
        _setHtml('vend-boletas-content', _renderVendBoletasContent(d.vendedorUltimasBoletas));

        // ── Cajero ────────────────────────────────────────────────────────────
        _setText('kpi-caj-cobradas', d.cajeroBoletasCobradas);
        _setText('kpi-caj-anuladas', d.cajeroBoletasAnuladas);
        _setText('kpi-caj-monto',    _fmtPeso(d.cajeroMontoGestionado));
        _setText('caj-tabla-title',  'Boletas gestionadas en ' + lbl);
        _setText('caj-tabla-count',  'Últimas ' + (d.cajeroUltimasBoletas ? d.cajeroUltimasBoletas.length : 0) + ' registradas');
        _setHtml('caj-boletas-content', _renderCajBoletasContent(d.cajeroUltimasBoletas));
    }

    _poblarMeses(_ANIO_SEL, _MES_SEL);
</script>
@if (ClaimHelper.EsAdmin(User))
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        // ── Colores corporativos ──────────────────────────────────────────────
        var C_PRIMARY = getComputedStyle(document.documentElement).getPropertyValue('--color-primario').trim() || '#e76f2e';
        var C_SUCCESS = getComputedStyle(document.documentElement).getPropertyValue('--color-success').trim()  || '#5cb338';
        var C_WARNING = getComputedStyle(document.documentElement).getPropertyValue('--color-warning').trim()  || '#fcbf49';
        var C_DANGER  = getComputedStyle(document.documentElement).getPropertyValue('--color-danger').trim()   || '#ff3737';
        var C_INFO    = '#6366f1';

        Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
        Chart.defaults.font.size   = 12;

        // ── Funciones de creación de gráficos (reutilizadas desde AJAX) ───────
        function _crearChartBoletasTipo(pagadas, pendientes, anuladas) {
            var ctxPie = document.getElementById('chartBoletasTipo');
            if (!ctxPie) return;
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Pagadas', 'Pendientes', 'Anuladas'],
                    datasets: [{
                        data: [pagadas, pendientes, anuladas],
                        backgroundColor: [C_SUCCESS, C_WARNING, C_DANGER],
                        borderWidth: 2,
                        borderColor: '#fff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 14, boxWidth: 12 } },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) { return ' ' + ctx.label + ': ' + ctx.parsed + ' boleta(s)'; }
                            }
                        }
                    }
                }
            });
        }

        function _crearChartVentasDia(labels, data) {
            var ctxLine = document.getElementById('chartVentasDia');
            if (!ctxLine) return;
            new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Ventas ($)',
                        data: data,
                        borderColor: C_PRIMARY,
                        backgroundColor: C_PRIMARY + '22',
                        borderWidth: 2.5,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        fill: true,
                        tension: 0.35
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) { return ' $' + ctx.parsed.y.toLocaleString('es-CL'); }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9ca3af', maxTicksLimit: 16 }
                        },
                        y: {
                            grid: { color: '#f3f0ec' },
                            ticks: {
                                color: '#9ca3af',
                                callback: function(v) { return '$' + v.toLocaleString('es-CL'); }
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function _crearChartMetodosPago(metLabels, metData) {
            var ctxBar = document.getElementById('chartMetodosPago');
            if (!ctxBar) return;
            var barColors = [C_PRIMARY, C_INFO, C_SUCCESS, C_WARNING, C_DANGER,
                             '#0ea5e9', '#a855f7', '#f97316', '#14b8a6', '#ec4899'];
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: metLabels,
                    datasets: [{
                        label: 'Monto ($)',
                        data: metData,
                        backgroundColor: metLabels.map(function(_,i){ return barColors[i % barColors.length] + 'cc'; }),
                        borderColor:     metLabels.map(function(_,i){ return barColors[i % barColors.length]; }),
                        borderWidth: 1.5,
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) { return ' $' + ctx.parsed.y.toLocaleString('es-CL'); }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#9ca3af' } },
                        y: {
                            grid: { color: '#f3f0ec' },
                            ticks: {
                                color: '#9ca3af',
                                callback: function(v) { return '$' + v.toLocaleString('es-CL'); }
                            },
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        // ── Inicialización de gráficos en el primer render ────────────────────
        // Solo se crean si el canvas está visible (no hidden)
        var ctxPie = document.getElementById('chartBoletasTipo');
        if (ctxPie && !ctxPie.closest('[hidden]')) {
            _crearChartBoletasTipo(
                @Model.TotalBoletasPagadasMes,
                @Model.TotalBoletasPendientesMes,
                @Model.TotalBoletasAnuladasMes
            );
        }

        var ctxLine = document.getElementById('chartVentasDia');
        if (ctxLine && !ctxLine.closest('[hidden]')) {
            _crearChartVentasDia(
                @Html.Raw(JsonSerializer.Serialize(diasLabels)),
                @Html.Raw(JsonSerializer.Serialize(diasData))
            );
        }

        var ctxBar = document.getElementById('chartMetodosPago');
        if (ctxBar && !ctxBar.closest('[hidden]')) {
            _crearChartMetodosPago(
                @Html.Raw(JsonSerializer.Serialize(metodosLabels)),
                @Html.Raw(JsonSerializer.Serialize(metodosData))
            );
        }

        // ── Panel bajo stock ──────────────────────────────────────────────────
        function toggleBajoStock() {
            var card  = document.getElementById('card-bajo-stock');
            var panel = document.getElementById('panel-bajo-stock');
            card.classList.toggle('active');
            panel.classList.toggle('open');
        }
    </script>
}
}
