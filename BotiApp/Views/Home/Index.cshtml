            <div class="table-responsive">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Fecha emisión</th>
                            <th>Vendedor</th>
                            <th>Cajero</th>
                            <th>Estado</th>
