@model BotiApp.Models.DashboardViewModel
@using BotiApp.Helpers
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var mesNombre = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Mes);
    mesNombre = char.ToUpper(mesNombre[0]) + mesNombre[1..];

    // Datos para gráficos (admin)
    var diasLabels    = Enumerable.Range(1, Model.VentasPorDiaMes.Length).Select(d => d.ToString()).ToArray();
    var diasData      = Model.VentasPorDiaMes;
    var metodosLabels = Model.MontosPorMetodoPago.Keys.ToArray();
    var metodosData   = Model.MontosPorMetodoPago.Values.ToArray();

    // Selector cascada: año → meses disponibles
    var mesesPorAnio = Model.PeriodosDisponibles
        .GroupBy(p => p.Anio)
        .OrderByDescending(g => g.Key)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(p => p.Mes).Select(p => p.Mes).ToList());
    var periodosJson = JsonSerializer.Serialize(mesesPorAnio);
    var aniosDisponibles = mesesPorAnio.Keys.ToList();
}

<style>
    /* ── Page header ── */
    .dash-header {
        margin-bottom: 1.75rem;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
    }
    .dash-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-secundario);
        margin: 0 0 0.2rem;
    }
    .dash-header p {
        color: #6b7280;
        font-size: 0.88rem;
        margin: 0;
    }
    .dash-period-select {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-shrink: 0;
        flex-wrap: wrap;
    }
    .dash-period-select label {
        font-size: .78rem;
        font-weight: 600;
        color: #6b7280;
        white-space: nowrap;
    }
    .dash-period-select select {
        font-size: .83rem;
        border: 1px solid #e5e0d8;
        border-radius: 8px;
        padding: .35rem .75rem;
        background: #fff;
        color: var(--color-secundario);
        cursor: pointer;
        outline: none;
        transition: border-color .2s;
    }
    .dash-period-select select:focus { border-color: var(--color-primario); }
    .dash-period-sep { color: #d1d5db; font-size: .9rem; }

    /* ── KPI cards ── */
    .kpi-grid {
        display: grid;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }
    .kpi-grid-admin  { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
    .kpi-grid-vendor { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
    .kpi-grid-cajero { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }

    .kpi-card {
        background: #fff;
        border-radius: 12px;
        padding: 1.25rem 1.4rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        border-left: 4px solid var(--color-primario);
        transition: box-shadow .2s;
    }
    .kpi-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,.11); }
    .kpi-card.success { border-left-color: var(--color-success); }
    .kpi-card.warning { border-left-color: var(--color-warning); }
    .kpi-card.danger  { border-left-color: var(--color-danger);  }
    .kpi-card.info    { border-left-color: #6366f1; }

    /* Card seleccionable (productos bajo stock) */
    .kpi-card.clickable {
        cursor: pointer;
        user-select: none;
        position: relative;
    }
    .kpi-card.clickable:active { transform: scale(.98); }
    .kpi-card-chevron {
        margin-left: auto;
        flex-shrink: 0;
        transition: transform .25s;
        fill: #9ca3af;
    }
    .kpi-card.active .kpi-card-chevron { transform: rotate(180deg); }

    .kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: rgba(231,111,46,.12);
    }
    .kpi-icon.success { background: rgba(92,179,56,.12); }
    .kpi-icon.warning { background: rgba(252,191,73,.15); }
    .kpi-icon.danger  { background: rgba(255,55,55,.1);  }
    .kpi-icon.info    { background: rgba(99,102,241,.12); }
    .kpi-icon svg { width: 22px; height: 22px; fill: var(--color-primario); }
    .kpi-icon.success svg { fill: var(--color-success); }
    .kpi-icon.warning svg { fill: var(--color-warning); }
    .kpi-icon.danger  svg { fill: var(--color-danger);  }
    .kpi-icon.info    svg { fill: #6366f1; }

    .kpi-body { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
    .kpi-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--color-secundario);
        line-height: 1.1;
    }
    .kpi-label {
        font-size: 0.78rem;
        color: #6b7280;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Panel bajo stock ── */
    .panel-bajo-stock {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        overflow: hidden;
        margin-top: -0.5rem;
        margin-bottom: 1.75rem;
        max-height: 0;
        opacity: 0;
        transition: max-height .35s ease, opacity .25s ease;
    }
    .panel-bajo-stock.open {
        max-height: 500px;
        opacity: 1;
    }
    .panel-bajo-stock-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .85rem 1.4rem;
        border-bottom: 1px solid #f1ede8;
    }
    .panel-bajo-stock-header h2 {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--color-secundario);
        margin: 0;
    }
    .panel-bajo-stock-body { overflow-y: auto; max-height: 380px; }

    /* ── Charts row ── */
    .charts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
        margin-bottom: 1.75rem;
    }
    .chart-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        padding: 1.25rem 1.4rem;
        display: flex;
        flex-direction: column;
    }
    .chart-card-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--color-secundario);
        margin: 0 0 1rem;
    }
    .chart-card-subtitle {
        font-size: 0.75rem;
        color: #9ca3af;
        font-weight: 400;
        margin-left: .4rem;
    }
    .chart-wrap {
        position: relative;
        flex: 1;
    }
    .chart-empty {
        text-align: center;
        padding: 2rem 1rem;
        color: #9ca3af;
        font-size: .83rem;
    }

    /* ── Table card ── */
    .table-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .table-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.4rem;
        border-bottom: 1px solid #f1ede8;
    }
    .table-card-header h2 {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-secundario);
        margin: 0;
    }
    .table-card-header span {
        font-size: 0.78rem;
        color: #9ca3af;
    }
    .table-responsive { overflow-x: auto; }
    table.dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }
    .dash-table th {
        padding: .65rem 1rem;
        text-align: left;
        font-size: .73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #9ca3af;
        background: #faf7f4;
        border-bottom: 1px solid #f0ebe4;
    }
    .dash-table td {
        padding: .7rem 1rem;
        border-bottom: 1px solid #f8f5f1;
        color: var(--color-secundario);
        vertical-align: middle;
    }
    .dash-table tr:last-child td { border-bottom: none; }
    .dash-table tr:hover td { background: #fdf9f5; }

    /* badges de estado */
    .badge-estado {
        display: inline-block;
        padding: .2rem .65rem;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .3px;
    }
    .badge-pendiente { background: rgba(252,191,73,.2);  color: #b45309; }
    .badge-anulada   { background: rgba(255,55,55,.12);  color: #dc2626; }
    .badge-pagada    { background: rgba(92,179,56,.15);  color: #16a34a; }
    .badge-otro      { background: rgba(99,102,241,.12); color: #4f46e5; }

    /* badge stock */
    .badge-stock-cero { background: rgba(255,55,55,.12); color: #dc2626; }
    .badge-stock-low  { background: rgba(252,191,73,.2); color: #b45309; }

    .dash-empty {
        text-align: center;
        padding: 2.5rem 1rem;
        color: #9ca3af;
        font-size: .88rem;
    }

    /* ── Loading overlay ── */
    .dash-loading-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,.45);
        backdrop-filter: blur(1px);
        z-index: 999;
        display: none;
        align-items: center;
        justify-content: center;
    }
    .dash-loading-overlay.visible { display: flex; }
    .dash-spinner {
        width: 36px; height: 36px;
        border: 3px solid #e5e0d8;
        border-top-color: var(--color-primario);
        border-radius: 50%;
        animation: dashSpin .7s linear infinite;
    }
    @@keyframes dashSpin { to { transform: rotate(360deg); } }
</style>

<div class="dash-loading-overlay" id="dash-overlay"><div class="dash-spinner"></div></div>

<div class="dash-header">
    <div>
        <h1>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                 style="fill:var(--color-primario);vertical-align:sub;margin-right:.4rem">
                <path d="M3 13h8V3H3zm0 8h8v-6H3zm10 0h8v-8h-8zm0-18v6h8V3z"/>
            </svg>
            Dashboard
        </h1>
        <p>Bienvenido, <strong>@Model.NombreUsuario</strong> — Resumen de <strong id="dash-period-label">@mesNombre @Model.Anio</strong></p>
    </div>
    @if (aniosDisponibles.Count > 0)
    {
        <div class="dash-period-select">
            <label for="selectAnio">Año</label>
            <select id="selectAnio" onchange="onAnioChange()">
                @foreach (var a in aniosDisponibles)
                {
                    if (a == Model.Anio)
                    {
                        <option value="@a" selected="selected">@a</option>
                    }
                    else
                    {
                        <option value="@a">@a</option>
                    }
                }
            </select>
            <span class="dash-period-sep">/</span>
            <label for="selectMes">Mes</label>
            <select id="selectMes" onchange="onMesChange()">
                @* Poblado por JS al cargar *@
            </select>
        </div>
    }
</div>

@* ═══════════════════════════════════════════════════ *@
@*                    ADMINISTRADOR                    *@
@* ═══════════════════════════════════════════════════ *@
@if (ClaimHelper.EsAdmin(User))
{
    <div class="kpi-grid kpi-grid-admin">
        <div class="kpi-card">
            <div class="kpi-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6zm0 4h8v2H6zm10 0h2v2h-2zm-6-4h8v2h-8z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" id="kpi-boletas-total">@Model.TotalBoletasMes</span>
                <span class="kpi-label">Boletas emitidas</span>
            </div>
        </div>
        <div class="kpi-card success">
            <div class="kpi-icon success">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" id="kpi-boletas-pagadas">@Model.TotalBoletasPagadasMes</span>
                <span class="kpi-label">Boletas pagadas</span>
            </div>
        </div>
        <div class="kpi-card warning">
            <div class="kpi-icon warning">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" id="kpi-boletas-pendientes">@Model.TotalBoletasPendientesMes</span>
                <span class="kpi-label">Boletas pendientes</span>
            </div>
        </div>
        <div class="kpi-card danger">
            <div class="kpi-icon danger">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" id="kpi-boletas-anuladas">@Model.TotalBoletasAnuladasMes</span>
                <span class="kpi-label">Boletas anuladas</span>
            </div>
        </div>
        <div class="kpi-card info">
            <div class="kpi-icon info">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" id="kpi-monto-total">$@Model.MontoTotalMes.ToString("N0")</span>
                <span class="kpi-label">Ingresos del mes</span>
            </div>
        </div>

        @* Card productos bajo stock — clickable *@
        <div class="kpi-card danger clickable" id="card-bajo-stock" onclick="toggleBajoStock()" title="Click para ver detalle">
            <div class="kpi-icon danger">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" id="kpi-bajo-stock">@Model.TotalProductosBajoStock</span>
                <span class="kpi-label">Productos bajo stock</span>
            </div>
            <svg class="kpi-card-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
                <path d="M7 10l5 5 5-5z"/>
            </svg>
        </div>

        @* Card fiados — total adeudado *@
        <a class="kpi-card warning" href="@Url.Action("Index","Fiado",new{area="Ventas"})" style="text-decoration:none">
            <div class="kpi-icon warning">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v10zm-7-7h-2v2h2v-2zm-4 0H7v2h2v-2zm8 0h-2v2h2v-2z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" id="kpi-fiado-total">$@Model.TotalFiadoGlobal.ToString("N0")</span>
                <span class="kpi-label">Total en fiados</span>
            </div>
        </a>

        @* Card fiados — clientes con deuda *@
        <a class="kpi-card warning" href="@Url.Action("Index","Fiado",new{area="Ventas"})" style="text-decoration:none">
            <div class="kpi-icon warning">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" id="kpi-fiado-activos">@Model.CantFiadosActivos</span>
                <span class="kpi-label">Clientes con fiado activo</span>
            </div>
        </a>
    </div>

    @* Panel expandible: productos bajo stock *@
    <div class="panel-bajo-stock" id="panel-bajo-stock">
        <div class="panel-bajo-stock-header">
            <h2>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                     style="fill:var(--color-danger);vertical-align:middle;margin-right:.35rem">
                    <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                </svg>
                Productos con stock bajo (≤ 5 unidades)
            </h2>
            <span id="bajo-stock-count">@Model.ProductosBajoStock.Count producto(s)</span>
        </div>
        @if (!Model.ProductosBajoStock.Any())
        {
            <div id="bajo-stock-body"><div class="dash-empty">No hay productos con stock bajo.</div></div>
        }
        else
        {
            <div id="bajo-stock-body">
            <div class="panel-bajo-stock-body">
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Código</th>
                                <th>Tipo</th>
                                <th>Marca</th>
                                <th style="text-align:right">Precio</th>
                                <th style="text-align:center">Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.ProductosBajoStock)
                            {
                                var stockBadge = p.Stock == 0 ? "badge-stock-cero" : "badge-stock-low";
                                <tr>
                                    <td><strong>@p.NombreProducto</strong></td>
                                    <td style="color:#9ca3af">@(p.Codigo ?? "—")</td>
                                    <td>@(p.IdTipoProductoNavigation?.NombreTipoProducto ?? "—")</td>
                                    <td>@(p.IdMarcaNavigation?.NombreMarca ?? "—")</td>
                                    <td style="text-align:right">$@p.Precio.ToString("N0")</td>
                                    <td style="text-align:center">
                                        <span class="badge-estado @stockBadge">@p.Stock</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            </div>
        }
    </div>

    @* Gráficos *@
    <div class="charts-grid">
        @* Pie — Boletas por tipo *@
        <div class="chart-card">
            <p class="chart-card-title">
                Boletas por tipo
                <span class="chart-card-subtitle" id="chart-boletas-subtitle">@mesNombre @Model.Anio</span>
            </p>
            <div class="chart-empty" id="chartBoletasTipo-empty" @(Model.TotalBoletasMes == 0 ? "" : "hidden")>Sin datos este mes.</div>
            <div class="chart-wrap" id="chartBoletasTipo-wrap" style="height:220px" @(Model.TotalBoletasMes > 0 ? "" : "hidden")>
                <canvas id="chartBoletasTipo"></canvas>
            </div>
        </div>

        @* Line — Ventas del mes por día *@
        <div class="chart-card" style="grid-column: span 2; min-width:0">
            <p class="chart-card-title">
                Ventas del mes
                <span class="chart-card-subtitle" id="chart-ventas-subtitle">montos pagados por día — @mesNombre @Model.Anio</span>
            </p>
            <div class="chart-empty" id="chartVentasDia-empty" @(!Model.VentasPorDiaMes.Any(v => v > 0) ? "" : "hidden")>No hay ventas pagadas este mes.</div>
            <div class="chart-wrap" id="chartVentasDia-wrap" style="height:220px" @(Model.VentasPorDiaMes.Any(v => v > 0) ? "" : "hidden")>
                <canvas id="chartVentasDia"></canvas>
            </div>
        </div>

        @* Bar — Montos por método de pago *@
        <div class="chart-card">
            <p class="chart-card-title">
                Métodos de pago
                <span class="chart-card-subtitle" id="chart-metodos-subtitle">@mesNombre @Model.Anio</span>
            </p>
            <div class="chart-empty" id="chartMetodosPago-empty" @(!Model.MontosPorMetodoPago.Any() ? "" : "hidden")>Sin datos este mes.</div>
            <div class="chart-wrap" id="chartMetodosPago-wrap" style="height:220px" @(Model.MontosPorMetodoPago.Any() ? "" : "hidden")>
                <canvas id="chartMetodosPago"></canvas>
            </div>
        </div>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <h2>Últimas boletas del sistema</h2>
            <span id="admin-boletas-period">@mesNombre @Model.Anio</span>
        </div>
