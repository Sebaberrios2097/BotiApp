@{
    ViewData["Title"] = "Privacy Policy";
}
<style>
    .simple-page-header {
        display: flex;
        align-items: center;
        gap: .85rem;
        background: var(--surface-base);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: 1rem 1.2rem;
        margin-bottom: 1.2rem;
    }

    .simple-page-header .icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: rgba(231, 111, 46, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .simple-page-header .icon svg {
        width: 21px;
        height: 21px;
        fill: var(--color-primario);
    }

    .simple-page-header h1 {
        margin: 0;
        font-size: 1.25rem;
        color: var(--color-secundario);
    }

    .simple-page-content {
        background: var(--surface-base);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: 1rem 1.2rem;
        color: var(--text-muted);
        font-size: .9rem;
        line-height: 1.5;
    }
</style>

<div class="simple-page-header">
    <div class="icon">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm.5 15h-1v-6h1v6zm0-8h-1V7h1v2z"/></svg>
    </div>
    <h1>@ViewData["Title"]</h1>
</div>

<div class="simple-page-content">
    Use this page to detail your site's privacy policy.
</div>
